#!/usr/bin/env bash
# haseen:summary Change one setting by name, routed to the command that owns it
# haseen:args <key> [value] [--dry-run]
#
# This command owns no state. It looks the key up in the index
# (share/haseen/lib/settings.sh) and runs the command that already owns that
# setting, so there is exactly one implementation of every change.
set -Eeuo pipefail
# shellcheck source=../share/haseen/lib/settings.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/settings.sh"

usage() {
    cat <<EOF
Usage: haseen settings set <key> [value] [--dry-run]

Runs the command that owns <key> with <value> appended. With no value, the
owning command runs bare, which is how the toggles flip.

  haseen settings set nightlight on
  haseen settings set theme tokyo-night
  haseen settings set default.editor nvim
  haseen settings set dnd                 # toggles

Keys: haseen settings list
Settings whose owner is an editor (bar.height, frame.*) open that file.
EOF
}

parse_common_flags "$@"
set -- "${REST[@]}"
(($# >= 1 && $# <= 2)) || {
    usage >&2
    exit 2
}
key="$1"
shift

setter="$(settings_setter "$key" || true)"
[[ -n $setter ]] || die "unknown setting '$key' (see haseen settings list)"

# The setter is a haseen command line from our own table, so word splitting it
# is intentional; nothing the user typed reaches it except the value, which is
# appended as one argument. argv[0] is always the literal "haseen": the router
# next to this command runs the rest, which keeps one resolution path.
read -r -a argv <<<"$setter"
[[ ${argv[0]} == haseen ]] || die "settings table: setter does not start with haseen: $setter"
argv=("${argv[@]:1}")
(($# == 1)) && argv+=("$1")
$DRY_RUN && argv+=(--dry-run)

exec "$HASEEN_BIN_DIR/haseen" "${argv[@]}"
