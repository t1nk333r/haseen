#!/usr/bin/env bash
# haseen:summary Build a theme from a wallpaper's own colours and switch to it
# haseen:args <image> [--mode M] [--light] [--name N] [--no-apply] [--dry-run]
#
# Colour extraction is `haseen-palette` (core/palette, a port of
# aether's median-cut extractor, MIT, Copyright (c) Bjarne Overli). The cache,
# the serialised regeneration and the "unchanged seed writes nothing" rule
# follow DankMaterialShell core/internal/matugen (seedcache.go, queue.go,
# renderColors; MIT, Copyright (c) 2025 Avenge Media LLC).
#
# The result is an ordinary haseen theme: colors.toml in
# ~/.config/haseen/themes/<name>/ plus the wallpaper as its background, so
# `haseen theme set` renders every template exactly as it does for a stock one.
set -Eeuo pipefail

BIN_DIR="$(dirname "$(readlink -f "$0")")"
HASEEN_PATH="${HASEEN_PATH:-$BIN_DIR/../share/haseen}"
export PATH="$BIN_DIR:$PATH"
# shellcheck source=../share/haseen/lib/common.sh
source "$HASEEN_PATH/lib/common.sh"
# shellcheck source=../share/haseen/layers/theme/theme-lib.sh
source "$HASEEN_PATH/layers/theme/theme-lib.sh"

PALETTE_BIN="${HASEEN_PALETTE_BIN:-$HASEEN_PATH/sidecar/haseen-palette}"
# The first line of every colors.toml haseen-palette writes. A theme directory
# whose colors.toml starts otherwise is the user's and is never replaced
# (haseen theme generate's rule, plan 194).
WALLPAPER_MARK='# Generated by `haseen theme wallpaper`'

usage() {
    cat <<EOF
Usage: haseen theme wallpaper <image> [--mode M] [--light] [--name N]
                              [--no-apply] [--dry-run] [--yes]

Extracts the image's 16-colour ANSI palette, writes it as the theme <name>
(default: wallpaper) and switches to it. The image becomes that theme's
background.

  --mode M     extraction mode (normal, monochromatic, analogous, pastel,
               material, colorful, muted, bright, complementary, triadic,
               split-complementary, tetradic, high-contrast, duotone)
  --light      build a light palette
  --name N     theme name to write (default: wallpaper). A stock theme's
               name, or a theme of yours that this command did not write,
               is refused.
  --no-apply   write the theme but do not switch to it

The palette is cached on the image's content, so re-running it for the same
wallpaper reads the cache and rewrites nothing.
EOF
}

mode=normal
light=false
name=wallpaper
apply=true
REST=()
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
    case "${args[i]}" in
    --mode) mode="${args[++i]:-}" ;;
    --name) name="${args[++i]:-}" ;;
    --light) light=true ;;
    --no-apply) apply=false ;;
    *) REST+=("${args[i]}") ;;
    esac
done
parse_common_flags "${REST[@]+"${REST[@]}"}"
set -- "${REST[@]+"${REST[@]}"}"
(($# == 1)) || {
    usage >&2
    exit 2
}
image="$(readlink -f -- "$1")" || die "no such image: $1"
[[ -f $image ]] || die "no such image: $1"
# The background link is named after the image's extension, and only those
# THEME_BG_EXTS names are backgrounds; checked before anything is written.
theme_background_named "$image" ||
    die "not an image haseen can use as a background (${THEME_BG_EXTS[*]}): $1"
[[ $name =~ ^[a-z0-9][a-z0-9._-]*$ ]] || die "invalid theme name: $name"
[[ -x $PALETTE_BIN ]] || die "no palette generator at $PALETTE_BIN (haseen sidecar build)"

theme_dir="$THEME_USER_DIR/$name"
background_dir="$THEME_USER_BACKGROUNDS_DIR/$name"
colors="$theme_dir/colors.toml"
link="$background_dir/${name}.${image##*.}"

# Whose the name is: a stock theme, a theme of the user's own (an installed
# one, a hand-written one), or new or an earlier run of this command. An
# empty directory, or one holding only the .lock an older version left, is
# what a failed earlier run leaves behind.
[[ ! -d $THEME_STOCK_DIR/$name ]] || die "$name is a stock theme; pick another --name"
if [[ -e $theme_dir || -L $theme_dir ]]; then
    ours=false
    if [[ -d $theme_dir && ! -L $theme_dir ]]; then
        if [[ -f $colors && ! -L $colors ]]; then
            [[ "$(head -n 1 -- "$colors")" == "$WALLPAPER_MARK"* ]] && ours=true
        elif [[ ! -e $colors && ! -L $colors &&
            -z "$(find "$theme_dir" -mindepth 1 -maxdepth 1 ! -name .lock -print -quit)" ]]; then
            ours=true
        fi
    fi
    $ours || die "$theme_dir is a theme of yours that haseen theme wallpaper did not write; pick another --name"
fi

flags=()
$light && flags+=(--light)

if $DRY_RUN; then
    echo "DRYRUN: $PALETTE_BIN ${flags[*]} --mode $mode $image > $colors"
    echo "DRYRUN: link $image as $link"
    $apply && echo "DRYRUN: haseen theme set $name"
    exit 0
fi

# One generator at a time: two wallpaper changes in a row would otherwise race
# on the same colors.toml. The second waits and then finds the cache warm. A
# lock on the directory itself, so no lock file lands in the theme (a git
# checkout stays clean); the .lock older versions made goes.
mkdir -p "$theme_dir" "$background_dir"
exec 9<"$theme_dir"
flock 9
rm -f -- "$theme_dir/.lock"

generated="$("$PALETTE_BIN" "${flags[@]+"${flags[@]}"}" --mode "$mode" "$image")" ||
    die "could not read a palette out of $image"

# Byte-compare before writing: an unchanged palette must not touch the file, so
# nothing downstream (theme set, the shell's FileView, hooks) reacts to a
# wallpaper that produced the same colours.
if [[ -f $colors ]] && [[ "$(cat "$colors")" == "$generated" ]]; then
    info "palette unchanged for $name"
else
    printf '%s' "$generated" >"$theme_dir/colors.toml.new"
    mv "$theme_dir/colors.toml.new" "$colors"
    info "wrote $colors"
fi

ln -sfn -- "$image" "$link"
# The link of an earlier run under another extension (wallpaper.jpg before
# wallpaper.png) would stay, and theme set would keep showing that old
# picture in the new colours. Only this command's own links go: a picture
# the user put in the folder stays.
find "$background_dir" -mindepth 1 -maxdepth 1 -type l -name "$name.*" ! -name "${link##*/}" -delete
# theme set shows the background remembered for a theme first: that is now
# the new picture, whichever one was shown with this theme before.
if theme_bg_memory_file "$name" && [[ "$(theme_remembered_background "$name")" != "$link" ]]; then
    printf '%s\n' "$link" | replace_user_file "$REPLY"
fi

$apply || exit 0
# theme set first records the picture shown under the current theme as that
# theme's own. When this theme is the current one and shows another picture
# (one of the user's, picked with haseen theme bg), that record would undo
# the line above: show the new picture first, so theme set records it.
if [[ "$(theme_current_name 2>/dev/null || true)" == "$name" &&
    "$(readlink "$THEME_BACKGROUND_LINK" 2>/dev/null || true)" != "$link" ]]; then
    theme_set_background_link "$link"
fi
haseen-theme-set "$name"
