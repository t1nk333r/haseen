#!/usr/bin/env bash
# haseen:summary Print the connected Wi-Fi network's join QR code as rows of 0 and 1, or its password
# haseen:args [--meta] [--password] [interface]
#
# Adapted from Omarchy bin/omarchy-network-qr and bin/omarchy-network-password
# (MIT, Copyright (c) David Heinemeier Hansson): the interface choice, the
# WIFI: payload with its escaping and WPA/WEP/open/hidden handling, and the
# output are Omarchy's. haseen reads /sys through sysroot_path, pins nmcli to
# the C locale, and folds the password into --password so the haseen.network
# panel's QR card has one command (plan 166). Read-only.
set -Eeuo pipefail

HASEEN_PATH="${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}"
# shellcheck source=../share/haseen/lib/common.sh
source "$HASEEN_PATH/lib/common.sh"

usage() {
    cat <<EOF
Usage: haseen network qr [--meta] [--password] [interface]

Prints the QR code that joins the connected Wi-Fi network, one row of 0 and 1
per line (1 is a dark module), the spec's 4-module quiet zone included. With
--meta, a first line 'meta<TAB>IFACE<TAB>SECURITY<TAB>SSID' (SECURITY is WPA,
WEP or nopass). With --password, prints the network's password instead.

INTERFACE defaults to the device of the default route when it is Wi-Fi, else
the first connected Wi-Fi device. Enterprise (802.1X) networks have no code to
share. The password goes to stdout only. Read-only.
EOF
}

# One line on stderr that the panel recognises and translates (Model.js).
fail() {
    printf '%s\n' "$1" >&2
    exit 1
}

parse_common_flags "$@"
interface="" emit_meta=false want_password=false
for arg in "${REST[@]}"; do
    case "$arg" in
    --meta) emit_meta=true ;;
    --password) want_password=true ;;
    -*)
        usage >&2
        exit 2
        ;;
    *) interface=$arg ;;
    esac
done
require_cmds nmcli
$want_password || require_cmds qrencode

if [[ -z $interface ]]; then
    # The default-route device is the connection the panel describes; else the
    # first connected Wi-Fi device. nmcli localizes state names: pin the locale.
    route_device=$(ip route get 1.1.1.1 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }' || true)
    if [[ -n $route_device && -d $(sysroot_path "/sys/class/net/$route_device/wireless") ]]; then
        interface=$route_device
    else
        interface=$(LC_ALL=C nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null |
            awk -F: '$2 == "wifi" && $3 ~ /^connected/ { print $1; exit }' || true)
    fi
fi
[[ -n $interface ]] || fail "No active Wi-Fi connection"
uuid=$(LC_ALL=C nmcli --get-values GENERAL.CON-UUID device show "$interface" 2>/dev/null | head -n 1 || true)
[[ -n $uuid && $uuid != "--" ]] || fail "No active Wi-Fi connection"

mapfile -t fields < <(LC_ALL=C nmcli --show-secrets --escape no --get-values \
    802-11-wireless.ssid,802-11-wireless-security.key-mgmt,802-11-wireless-security.psk,802-11-wireless.hidden,802-11-wireless-security.wep-key0 \
    connection show uuid "$uuid" 2>/dev/null || true)
ssid=${fields[0]:-}
key_management=${fields[1]:-}
password=${fields[2]:-}
hidden=${fields[3]:-no}
wep_key=${fields[4]:-}

[[ -n $ssid ]] || fail "Could not read the Wi-Fi name"
[[ $key_management != *eap* && $key_management != *ieee8021x* ]] ||
    fail "Enterprise Wi-Fi cannot be shared with a QR code"

if [[ -n $key_management && $key_management != none ]]; then
    [[ -n $password ]] || fail "Could not read the Wi-Fi password"
    security=WPA
elif [[ -n $wep_key ]]; then
    # WEP is key-mgmt "none" plus a wep-key; as an open network the code
    # would fail to join without saying why.
    password=$wep_key
    security=WEP
else
    security=nopass
fi

if $want_password; then
    [[ $security != nopass ]] || fail "This network has no password"
    printf '%s\n' "$password"
    exit 0
fi

# The WIFI: format escapes backslash, semicolon, comma and colon (and a
# double quote, which ZXing's reader also unescapes).
escape_wifi_qr() {
    local value=$1
    value=${value//\\/\\\\}
    value=${value//;/\\;}
    value=${value//,/\\,}
    value=${value//:/\\:}
    value=${value//\"/\\\"}
    printf '%s' "$value"
}

payload="WIFI:T:$security;S:$(escape_wifi_qr "$ssid");"
[[ $security == nopass ]] || payload+="P:$(escape_wifi_qr "$password");"
[[ $hidden == yes ]] && payload+="H:true;"
payload+=";"

# The SSID goes last so it may contain tabs.
$emit_meta && printf 'meta\t%s\t%s\t%s\n' "$interface" "$security" "$ssid"

# qrencode's ASCII uses two characters per module: one 0/1 each, margin 4
# (the spec's quiet zone). The payload goes over stdin, never argv.
ascii=$(printf '%s' "$payload" | qrencode --type ASCII --margin 4 --output -)
while IFS= read -r line; do
    row=
    for ((column = 0; column < ${#line}; column += 2)); do
        if [[ ${line:column:2} == *#* ]]; then row+="1"; else row+="0"; fi
    done
    printf '%s\n' "$row"
done <<<"$ascii"
