#!/usr/bin/env bash
# haseen:summary Take a screenshot: Omasnap's picker, or a region, window or output to the clipboard and ~/Pictures
# haseen:args [smart|region|scroll|window|output|screen] [--geometry "X,Y WxH"] [--output NAME] [--file PATH] [--format png|jpg|ppm] [--quality N] [--cursor] [--edit] [--upload] [--upload-to BACKEND] [--stdout] [--no-save] [--no-copy] [--no-notify] [--dry-run]
#
# Adapted from Omarchy bin/omarchy-capture-screenshot and omarchy-capture-region
# (MIT, Copyright (c) David Heinemeier Hansson): region picking with slurp,
# window geometry from Hyprland, copy and save in one pass, optional editor.
# The picks hand over to Omasnap when it is installed, as Omarchy 4.5's
# omarchy-capture-screenshot does (`exec omasnap`, Omarchy ee8ebf615, #9446),
# and Omasnap is the editor (owner, 2026-10-21, plan 107).
set -Eeuo pipefail

# shellcheck source=../share/haseen/lib/common.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"
# shellcheck source=../share/haseen/lib/i18n.sh
source "$HASEEN_PATH/lib/i18n.sh"
# shellcheck source=../share/haseen/lib/omasnap.sh
source "$HASEEN_PATH/lib/omasnap.sh"

usage() {
    cat <<EOF
Usage: haseen capture screenshot [smart|region|scroll|window|output|screen] [options]

Modes (default smart):
  smart    drag a region, click a window, or click open space for the whole
           monitor (Omasnap; without it, pick a rectangle with slurp)
  region   pick a rectangle (Omasnap's region mode, or slurp)
  scroll   a region taller or wider than the screen, stitched while it
           scrolls (Omasnap only)
  window   the focused window, at once
  output   the focused monitor (or --output NAME), at once
  screen   every monitor, at once

With Omasnap installed, smart, region and scroll open it over the frozen
screen: it saves, copies and shows a preview to pin, edit, copy or drag, and
the same key pressed again dismisses it. --no-save copies only, --no-copy
saves only, --edit opens its editor before anything is kept. Any other option
takes haseen's own capture (slurp and grim), which prints the saved path.

Options:
  --geometry "X,Y WxH"  capture this rectangle (no picker; slurp's format)
  --output NAME         capture this monitor (implies output)
  --file PATH           save here; a bare file name goes into the screenshot folder
  --format FMT          png (default), jpg or ppm
  --quality N           JPEG quality 1-100 (default 90)
  --cursor              include the pointer
  --edit                annotate before anything is kept: in Omasnap (else
                        Tensaku, else swappy)
  --upload              upload the result and copy the link (haseen upload)
  --upload-to BACKEND   upload with this backend (implies --upload)
  --stdout              write the image to stdout; nothing is saved, copied or announced
  --no-save             clipboard only
  --no-copy             file only
  --no-notify           no desktop notification
  --dry-run             print the plan

With --edit in haseen's own capture, what the editor saves is what is kept,
copied and uploaded. In Omasnap, Enter saves and copies (so --no-copy still
copies), Ctrl+S saves without copying, Ctrl+C only copies and keeps nothing,
and Escape cancels the capture: nothing is saved, copied or uploaded. If
Omasnap fails, haseen says so. Tensaku is the same with Enter; swappy saves
whenever it closes.
--edit keeps PNG only, so it takes no other --format. --edit --upload ends
with the link on the clipboard.

Files go to \$HASEEN_SCREENSHOT_DIR or \$(xdg-user-dir PICTURES), Omasnap's too
unless \$OMASNAP_SCREENSHOT_DIR or its own [output] directory (omasnap.conf)
names another folder. Omasnap reads text in \$HASEEN_OCR_LANGS
(default $HASEEN_OCR_DEFAULT). HASEEN_SCREENSHOT_TOOL=grim never starts Omasnap.
EOF
}

notify() { have notify-send && notify-send -a haseen "$@" || true; }

parse_common_flags "$@"
set -- "${REST[@]}"
mode=smart geometry="" output="" file="" format=png quality=90
cursor=false edit=false stdout=false save=true copy=true announce=true
upload=false upload_backend=""
# own: an option only haseen's own capture has, so the pick is not Omasnap's.
own=false
set_option() {
    own=true
    case $1 in
    geometry) geometry=$2 ;;
    output) output=$2 ;;
    file) file=$2 ;;
    format) format=$2 ;;
    quality) quality=$2 ;;
    esac
}
while (($#)); do
    case "$1" in
    smart | region | scroll | window | output | screen) mode=$1 ;;
    --geometry | --output | --file | --format | --quality)
        (($# > 1)) || { usage >&2; exit 2; }
        set_option "${1#--}" "$2"
        shift
        ;;
    --geometry=* | --output=* | --file=* | --format=* | --quality=*)
        name=${1%%=*}
        set_option "${name#--}" "${1#*=}"
        ;;
    --cursor) cursor=true own=true ;;
    --edit) edit=true ;;
    --upload) upload=true own=true ;;
    --upload-to)
        (($# > 1)) || { usage >&2; exit 2; }
        upload=true upload_backend=$2 own=true
        shift
        ;;
    --upload-to=*) upload=true upload_backend=${1#*=} own=true ;;
    --stdout) stdout=true own=true ;;
    --no-save) save=false ;;
    --no-copy) copy=false ;;
    --no-notify) announce=false own=true ;;
    *) usage >&2; exit 2 ;;
    esac
    shift
done
[[ -z $output ]] || mode=output
case $format in
png) grim_type=png mime=image/png ;;
jpg | jpeg) format=jpg grim_type=jpeg mime=image/jpeg ;;
ppm) grim_type=ppm mime=image/x-portable-pixmap ;;
*)
    echo "Error: --format wants png, jpg or ppm, got: $format" >&2
    exit 2
    ;;
esac
if [[ ! $quality =~ ^[0-9]+$ ]] || ((quality < 1 || quality > 100)); then
    echo "Error: --quality wants 1-100, got: $quality" >&2
    exit 2
fi
# The editor writes a private edited.png, and swappy writes PNG bytes whatever
# the name (swappy pixbuf.c), so an edited shot is PNG under either editor.
if $edit && [[ $format != png ]]; then
    echo "Error: --edit saves PNG only; drop --format $format" >&2
    exit 2
fi
if $stdout; then
    if $edit || $upload; then
        echo "Error: --stdout with --edit or --upload: pipe stdout into the next step instead" >&2
        exit 2
    fi
    save=false copy=false announce=false
fi
$stdout || $save || $copy || $edit || $upload || die "--no-save and --no-copy together leave nothing to do"
if [[ -n $geometry && ! $geometry =~ ^-?[0-9]+,-?[0-9]+\ [0-9]+x[0-9]+$ ]]; then
    echo "Error: --geometry wants \"X,Y WxH\", got: $geometry" >&2
    exit 2
fi

# A pick goes to Omasnap, which owns the rest: where the file goes (haseen's
# folder, lib/omasnap.sh), the clipboard, its preview and its notification.
# It has one switch for the output (--copy, --save or both by default) and
# --editor to annotate first; the editor then decides the output, so --edit
# with --no-save or --no-copy stays with haseen's capture.
if [[ $mode == smart || $mode == region || $mode == scroll ]] && ! $own &&
    { ! $edit || { $save && $copy; }; } && omasnap_use; then
    omasnap_args=("$mode")
    $save || omasnap_args+=(--copy)
    $copy || omasnap_args+=(--save)
    if $edit; then omasnap_args+=(--editor "$(omasnap_editor_mode)"); fi
    omasnap_exec "${omasnap_args[@]}"
fi
[[ $mode != scroll ]] ||
    die "a scrolling screenshot is Omasnap's: it needs Omasnap installed (haseen layer apply omarchy-repo desktop) and HASEEN_SCREENSHOT_TOOL other than grim, and takes only --no-save, --no-copy or --edit"
# Without Omasnap, smart is a rectangle picked with slurp, as region always was.
[[ $mode != smart ]] || mode=region

grim_args=()
if [[ -n $geometry ]]; then
    grim_args=(-g "$geometry")
else
    case $mode in
    region)
        if $DRY_RUN; then
            grim_args=(-g '<slurp selection>')
        else
            geometry="$(slurp -d 2>/dev/null)" || exit 0 # cancelled
            [[ -n $geometry ]] || exit 0
            grim_args=(-g "$geometry")
        fi
        ;;
    window)
        if $DRY_RUN; then
            grim_args=(-g '<focused window>')
        else
            geometry="$(hyprctl activewindow -j | jq -r 'select(.at) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')"
            [[ -n $geometry ]] || die "no focused window"
            grim_args=(-g "$geometry")
        fi
        ;;
    output)
        if [[ -n $output ]]; then
            grim_args=(-o "$output")
        elif $DRY_RUN; then
            grim_args=(-o '<focused monitor>')
        else
            out="$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')"
            [[ -n $out ]] || die "no focused monitor"
            grim_args=(-o "$out")
        fi
        ;;
    screen) ;;
    esac
fi
# grim writes PNG without the pointer unless told otherwise.
[[ $grim_type == png ]] || grim_args+=(-t "$grim_type")
[[ $grim_type != jpeg ]] || grim_args+=(-q "$quality")
if $cursor; then grim_args+=(-c); fi

if $stdout; then
    if $DRY_RUN; then
        echo "DRYRUN: grim ${grim_args[*]} -"
        exit 0
    fi
    exec grim "${grim_args[@]}" -
fi

editor=""
if $edit; then
    if omasnap_use; then
        editor=omasnap
    elif have tensaku; then
        editor=tensaku
    elif have swappy; then
        editor=swappy
    else
        warn "none of omasnap, tensaku or swappy is installed; saving without editing"
    fi
fi

dir="$(screenshot_dir)"
if [[ -z $file ]]; then
    file="$dir/screenshot-$(date +%Y-%m-%d_%H-%M-%S).$format"
elif [[ $file != */* ]]; then
    file="$dir/$file"
fi

# Every file but the saved one lives in a private directory (mktemp -d, 0700)
# that is removed on every exit: a cancelled edit, a failed upload, a signal.
edit_dir=""
if $DRY_RUN; then
    work='<private temp dir>'
else
    work="$(mktemp -d)"
    trap 'rm -rf -- "$work" ${edit_dir:+"$edit_dir"}' EXIT
    trap 'exit 143' TERM INT HUP
fi
original="$work/original.png"
edited="$work/edited.png"
# Unsaved, the shot keeps the name it would have had: that is the name an
# upload host, or an rclone bucket, stores it under.
shot="$work/${file##*/}"
if $save; then shot=$file; fi

# The editor writes to a second file, so "saved" and "left without saving"
# differ. Tensaku's own Enter (the seeded save-to-clipboard) copies without
# writing a file, so Enter is made a save here, and Escape is made an exit:
# Tensaku's default keeps the window open on Escape, and a user's config may
# not set it. --early-exit closes the window after the save.
#
# Omasnap saves into its screenshot folder under a name of its own
# (src/capture.cpp@v1.21.0 screenshotTargetPath), so it is given a private
# folder and what appears there is what it saved; the editor closes after any
# output (Enter, Ctrl+S, Ctrl+C, P pins) or Escape. It announces through
# omarchy-notification-send, by PATH (src/capture.cpp sendCaptureNotification),
# and its "Screenshot saved" notices would name that private file
# (src/editor.cpp@v1.21.0:4013-4019), so that name is a stub first on its PATH
# that drops those two and passes every other notice (OCR, a copy, a failure)
# to the real command: haseen announces the kept file. The folder lives in the
# private runtime directory: a pin made in the editor inherits it and saves
# there later (its link button, src/pin.cpp@v1.21.0:1190-1201), after this run
# removed it and Omasnap made it again, so that copy lasts until logout.
edit_cmd=()
edit_show=()
case $editor in
omasnap)
    quiet="$work/quiet"
    if $DRY_RUN; then
        edit_dir='<private runtime dir>'
    elif [[ -n ${XDG_RUNTIME_DIR:-} && -d $XDG_RUNTIME_DIR && -O $XDG_RUNTIME_DIR ]]; then
        edit_dir="$(mktemp -d -p "$XDG_RUNTIME_DIR" haseen-screenshot.XXXXXX)"
    else
        edit_dir="$work/omasnap"
        mkdir -m 700 -- "$edit_dir"
    fi
    omasnap_env
    edit_env=("OMASNAP_SCREENSHOT_DIR=$edit_dir")
    for word in "${OMASNAP_ENV[@]}"; do
        [[ $word == OMASNAP_SCREENSHOT_DIR=* ]] || edit_env+=("$word")
    done
    edit_cmd=(env "PATH=$quiet:$PATH" "${edit_env[@]}" omasnap --file "$original")
    edit_show=(env "PATH=$quiet:\$PATH" "${edit_env[@]}" omasnap --file "$original")
    ;;
tensaku) edit_cmd=(tensaku --filename "$original" --output-filename "$edited" --actions-on-enter save-to-file --actions-on-escape exit --early-exit --copy-command wl-copy) ;;
swappy) edit_cmd=(swappy -f "$original" -o "$edited") ;;
esac
((${#edit_show[@]})) || edit_show=("${edit_cmd[@]}")

upload_cmd=(haseen-upload "$shot" --quiet)
[[ -z $upload_backend ]] || upload_cmd+=(--backend "$upload_backend")

if $DRY_RUN; then
    if [[ -n $editor ]]; then
        echo "DRYRUN: grim ${grim_args[*]} $original"
        [[ $editor != omasnap ]] || echo "DRYRUN: write $quiet/omarchy-notification-send (drops Omasnap's \"Screenshot saved\" notices, which name the private file; passes every other one on)"
        echo "DRYRUN: ${edit_show[*]}"
        if [[ $editor == omasnap ]]; then
            echo "DRYRUN: mv <the PNG Omasnap saved in $edit_dir> $shot (if the editor saved; otherwise stop: nothing is saved, copied or uploaded)"
        else
            echo "DRYRUN: mv $edited $shot (if the editor saved; otherwise stop: nothing is saved, copied or uploaded)"
        fi
    else
        echo "DRYRUN: grim ${grim_args[*]} $shot"
    fi
    $copy && echo "DRYRUN: wl-copy -t $mime < $shot"
    $upload && echo "DRYRUN: ${upload_cmd[*]} (the link replaces the image on the clipboard)"
    echo "DRYRUN: rm -r $work${edit_dir:+ $edit_dir}"
    $announce || echo "DRYRUN: no notification"
    exit 0
fi

mkdir -p -- "$(dirname -- "$shot")"
if [[ -n $editor ]]; then
    grim "${grim_args[@]}" "$original"
    if [[ $editor == omasnap ]]; then
        mkdir -p -- "$quiet"
        cat >"$quiet/omarchy-notification-send" <<'STUB'
#!/bin/sh
# haseen capture screenshot --edit (plan 107): Omasnap's save notices name
# the private file haseen moves at once, and haseen announces the kept one.
# Every other notice goes to the real command, found on PATH without this
# directory (a pin started now keeps that PATH after the directory is gone).
for a in "$@"; do
    case $a in
    "Screenshot saved" | "Screenshot saved and copied") exit 0 ;;
    esac
done
set -f
self=${0%/*} rest=""
IFS=:
for d in $PATH; do [ "$d" = "$self" ] || rest=${rest:+$rest:}$d; done
unset IFS
real=$(PATH=$rest; command -v omarchy-notification-send) || exit 0
[ "$real" != "$0" ] || exit 0
exec "$real" "$@"
STUB
        chmod 700 -- "$quiet/omarchy-notification-send"
    fi
    # Omasnap exits 0 on Escape too, and 1 when it cannot open or save the
    # image (README.md@v1.21.0 "Exit codes"; src/main.cpp:344-347 only prints
    # a file it cannot load), which nobody would see from a key bind.
    status=0
    "${edit_cmd[@]}" || status=$?
    if ((status != 0)); then
        [[ $editor == omasnap ]] || exit "$status"
        if $announce; then
            notify -u critical "$(i18n "Screenshot not edited")" "$(i18n "Omasnap failed (exit %1): nothing was saved, copied or uploaded" "$status")"
        fi
        warn "omasnap failed (exit $status): nothing was saved, copied or uploaded"
        exit "$status"
    fi
    if [[ $editor == omasnap ]]; then
        saved=""
        for f in "$edit_dir"/*.png; do
            [[ -f $f ]] || continue
            [[ -z $saved || $f -nt $saved ]] && saved=$f
        done
        [[ -n $saved ]] || exit 0 # left without saving: cancelled
        mv -fT -- "$saved" "$edited"
    fi
    [[ -s $edited ]] || exit 0 # left without saving: cancelled
    mv -fT -- "$edited" "$shot"
else
    grim "${grim_args[@]}" "$shot"
fi

$copy && wl-copy -t "$mime" <"$shot"

# Upload last, so the link is what ends up on the clipboard: once a shot is
# shared, the link is what you paste.
link=""
if $upload; then
    link="$("${upload_cmd[@]}")" || die "the upload failed"
fi

if $save; then
    printf '%s\n' "$file"
    if ! $announce; then
        :
    elif [[ -n $link ]]; then
        notify -i "$file" "$(i18n "Screenshot uploaded")" "$link"
    else
        notify -i "$file" "$(i18n "Screenshot saved")" "${file/#"$HOME"/\~}"
    fi
elif ! $announce; then
    :
elif [[ -n $link ]]; then
    notify "$(i18n "Screenshot uploaded")" "$link"
else
    notify "$(i18n "Screenshot copied to clipboard")"
fi
[[ -z $link ]] || printf '%s\n' "$link"
