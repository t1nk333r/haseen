#!/usr/bin/env bash
# haseen:summary Screenshot a region, window or output to the clipboard and ~/Pictures
# haseen:args [region|window|output|screen] [--geometry "X,Y WxH"] [--output NAME] [--file PATH] [--format png|jpg|ppm] [--quality N] [--cursor] [--edit] [--upload] [--stdout] [--no-save] [--no-copy] [--no-notify] [--dry-run]
#
# Adapted from Omarchy bin/omarchy-capture-screenshot and omarchy-capture-region
# (MIT, Copyright (c) David Heinemeier Hansson): region picking with slurp,
# window geometry from Hyprland, copy and save in one pass, optional editor.
set -Eeuo pipefail

# shellcheck source=../share/haseen/lib/common.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"

usage() {
    cat <<EOF
Usage: haseen capture screenshot [region|window|output|screen] [options]

Modes (default region):
  region   pick a rectangle with slurp
  window   the focused window
  output   the focused monitor (or --output NAME)
  screen   every monitor

Options:
  --geometry "X,Y WxH"  capture this rectangle (no picker; slurp's format)
  --output NAME         capture this monitor (implies output)
  --file PATH           save here; a bare file name goes into the screenshot folder
  --format FMT          png (default), jpg or ppm
  --quality N           JPEG quality 1-100 (default 90)
  --cursor              include the pointer
  --edit                open the shot in satty or swappy, whichever is installed
  --upload              upload the result and copy the link (haseen upload)
  --upload-to BACKEND   upload with this backend (implies --upload)
  --stdout              write the image to stdout; nothing is saved, copied or announced
  --no-save             clipboard only
  --no-copy             file only
  --no-notify           no desktop notification
  --dry-run             print the plan

--edit --upload is the annotate-then-share path: annotate, save, upload, and
the link lands on the clipboard.

Files go to \$HASEEN_SCREENSHOT_DIR or \$(xdg-user-dir PICTURES).
EOF
}

notify() { have notify-send && notify-send -a haseen "$@" || true; }

pictures_dir() {
    local d=${HASEEN_SCREENSHOT_DIR:-}
    [[ -n $d ]] || d="$(xdg-user-dir PICTURES 2>/dev/null || true)"
    [[ -n $d && $d != "$HOME" ]] || d="$HOME/Pictures"
    printf '%s\n' "$d"
}

parse_common_flags "$@"
set -- "${REST[@]}"
mode=region geometry="" output="" file="" format=png quality=90
cursor=false edit=false stdout=false save=true copy=true announce=true
upload=false upload_backend=""
set_option() {
    case $1 in
    geometry) geometry=$2 ;;
    output) output=$2 ;;
    file) file=$2 ;;
    format) format=$2 ;;
    quality) quality=$2 ;;
    esac
}
while (($#)); do
    case "$1" in
    region | window | output | screen) mode=$1 ;;
    --geometry | --output | --file | --format | --quality)
        (($# > 1)) || { usage >&2; exit 2; }
        set_option "${1#--}" "$2"
        shift
        ;;
    --geometry=* | --output=* | --file=* | --format=* | --quality=*)
        name=${1%%=*}
        set_option "${name#--}" "${1#*=}"
        ;;
    --cursor) cursor=true ;;
    --edit) edit=true ;;
    --upload) upload=true ;;
    --upload-to)
        (($# > 1)) || { usage >&2; exit 2; }
        upload=true upload_backend=$2
        shift
        ;;
    --upload-to=*) upload=true upload_backend=${1#*=} ;;
    --stdout) stdout=true ;;
    --no-save) save=false ;;
    --no-copy) copy=false ;;
    --no-notify) announce=false ;;
    *) usage >&2; exit 2 ;;
    esac
    shift
done
[[ -z $output ]] || mode=output
case $format in
png) grim_type=png mime=image/png ;;
jpg | jpeg) format=jpg grim_type=jpeg mime=image/jpeg ;;
ppm) grim_type=ppm mime=image/x-portable-pixmap ;;
*)
    echo "Error: --format wants png, jpg or ppm, got: $format" >&2
    exit 2
    ;;
esac
if [[ ! $quality =~ ^[0-9]+$ ]] || ((quality < 1 || quality > 100)); then
    echo "Error: --quality wants 1-100, got: $quality" >&2
    exit 2
fi
if $stdout; then
    if $edit || $upload; then
        echo "Error: --stdout with --edit or --upload: pipe stdout into the next step instead" >&2
        exit 2
    fi
    save=false copy=false announce=false
fi
$stdout || $save || $copy || $edit || $upload || die "--no-save and --no-copy together leave nothing to do"
if [[ -n $geometry && ! $geometry =~ ^-?[0-9]+,-?[0-9]+\ [0-9]+x[0-9]+$ ]]; then
    echo "Error: --geometry wants \"X,Y WxH\", got: $geometry" >&2
    exit 2
fi

grim_args=()
if [[ -n $geometry ]]; then
    grim_args=(-g "$geometry")
else
    case $mode in
    region)
        if $DRY_RUN; then
            grim_args=(-g '<slurp selection>')
        else
            geometry="$(slurp -d 2>/dev/null)" || exit 0 # cancelled
            [[ -n $geometry ]] || exit 0
            grim_args=(-g "$geometry")
        fi
        ;;
    window)
        if $DRY_RUN; then
            grim_args=(-g '<focused window>')
        else
            geometry="$(hyprctl activewindow -j | jq -r 'select(.at) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')"
            [[ -n $geometry ]] || die "no focused window"
            grim_args=(-g "$geometry")
        fi
        ;;
    output)
        if [[ -n $output ]]; then
            grim_args=(-o "$output")
        elif $DRY_RUN; then
            grim_args=(-o '<focused monitor>')
        else
            out="$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')"
            [[ -n $out ]] || die "no focused monitor"
            grim_args=(-o "$out")
        fi
        ;;
    screen) ;;
    esac
fi
# grim writes PNG without the pointer unless told otherwise.
[[ $grim_type == png ]] || grim_args+=(-t "$grim_type")
[[ $grim_type != jpeg ]] || grim_args+=(-q "$quality")
if $cursor; then grim_args+=(-c); fi

editor=""
if $edit; then
    if have satty; then
        editor=satty
    elif have swappy; then
        editor=swappy
    else
        warn "neither satty nor swappy is installed; saving without editing"
    fi
fi

dir="$(pictures_dir)"
if [[ -z $file ]]; then
    file="$dir/screenshot-$(date +%Y-%m-%d_%H-%M-%S).$format"
elif [[ $file != */* ]]; then
    file="$dir/$file"
fi

if $DRY_RUN; then
    if $stdout; then
        echo "DRYRUN: grim ${grim_args[*]} -"
        exit 0
    fi
    echo "DRYRUN: grim ${grim_args[*]} $file"
    [[ $editor == satty ]] && echo "DRYRUN: satty --filename $file --output-filename $file --early-exit --copy-command wl-copy"
    [[ $editor == swappy ]] && echo "DRYRUN: swappy -f $file -o $file"
    $copy && echo "DRYRUN: wl-copy -t $mime < $file"
    $upload && echo "DRYRUN: haseen-upload $file${upload_backend:+ --backend $upload_backend} (the link replaces the image on the clipboard)"
    $save || echo "DRYRUN: rm $file (clipboard only)"
    $announce || echo "DRYRUN: no notification"
    exit 0
fi

$stdout && exec grim "${grim_args[@]}" -
$save || file="$(mktemp --suffix=".$format")"
mkdir -p "$(dirname "$file")"
grim "${grim_args[@]}" "$file"

case $editor in
satty) satty --filename "$file" --output-filename "$file" --early-exit --copy-command wl-copy ;;
swappy) swappy -f "$file" -o "$file" ;;
esac

$copy && wl-copy -t "$mime" <"$file"

# Upload last, so the link is what ends up on the clipboard: once a shot is
# shared, the link is what you paste. This is the ShareX annotate-then-upload
# path in one keystroke: --edit --upload.
link=""
if $upload; then
    up=(haseen-upload "$file" --quiet)
    [[ -z $upload_backend ]] || up+=(--backend "$upload_backend")
    link="$("${up[@]}")" || die "the upload failed"
fi

if $save; then
    printf '%s\n' "$file"
    if ! $announce; then
        :
    elif [[ -n $link ]]; then
        notify -i "$file" "Screenshot uploaded" "$link"
    else
        notify -i "$file" "Screenshot saved" "${file/#"$HOME"/\~}"
    fi
else
    rm -f "$file"
    if ! $announce; then
        :
    elif [[ -n $link ]]; then
        notify "Screenshot uploaded" "$link"
    else
        notify "Screenshot copied to clipboard"
    fi
fi
[[ -z $link ]] || printf '%s\n' "$link"
