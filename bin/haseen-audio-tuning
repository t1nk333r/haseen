#!/usr/bin/env bash
# haseen:summary Show, apply or remove the speaker tuning for this laptop model
# haseen:args <show|apply|remove> [--force] [--quiet] [--dry-run]
#
# Adapted from Omarchy bin/omarchy-audio-tuning, default/audio/tunings/,
# default/wireplumber/ and install/hardware/speaker-tuning.sh (MIT, Copyright
# (c) David Heinemeier Hansson).
#
# A tuning is an EQ curve plus a lookahead limiter, hosted as a PipeWire
# filter-chain sink in front of the laptop's internal speakers. Upstream runs
# the chain in a PipeWire client of its own, started by a user systemd unit;
# haseen puts the same graph in a WirePlumber config fragment, so a tuning is
# one file in ~/.config/wireplumber/wireplumber.conf.d/ and switching it is one
# `systemctl --user restart wireplumber`, with no unit to install and nothing
# that can outlive this command. Restarting the session manager relinks the
# graph; it does not restart PipeWire, so PulseAudio clients keep their
# connections.
#
# Which tuning a machine gets is data, not code: a tuning is a directory under
# share/haseen/audio/tunings/ that declares the hardware it belongs to, so
# adding one is a directory and never a change here. Matching goes through
# share/haseen/lib/hardware.sh, the same DMI matcher `haseen hw` uses, and
# therefore through sysroot_path -- `HASEEN_SYSROOT=tests/fixtures/<name>` shows
# what another machine would get.
set -Eeuo pipefail

# shellcheck source=../share/haseen/lib/hardware.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/hardware.sh"

TUNINGS_DIR="$HASEEN_PATH/audio/tunings"
WP_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/wireplumber/wireplumber.conf.d"
# 90-, so the tuning is merged after any device rule that shapes the sink it
# targets.
FRAGMENT="$WP_DIR/90-haseen-speaker-tuning.conf"
SOFT_MIXER="$WP_DIR/50-haseen-alsa-soft-mixer.conf"
SOFT_MIXER_SRC="$HASEEN_PATH/default/wireplumber/wireplumber.conf.d/50-haseen-alsa-soft-mixer.conf"
SINK_NAME=haseen_speaker_tuning
# Every tuning ends in a lookahead limiter, which is an LV2 plugin. Without it
# the graph fails to instantiate and the tuning sink silently never appears, so
# the package is a hard requirement wherever a tuning applies.
LIMITER_TTL=/usr/lib/lv2/lsp-plugins.lv2/limiter_stereo.ttl
LIMITER_PKG=lsp-plugins-lv2

# Filled by load_tuning from a tuning's own tuning.conf.
description=""
match=""
sink_pattern=""
match_sku=()
# The physical sink the matched tuning is applied in front of, once found in the
# live graph. Global, so the poll predicates below can read it.
SPEAKER_SINK=""

usage() {
    cat <<EOF
Usage: haseen audio tuning <show|apply|remove> [--force] [--quiet] [--dry-run]

  show    what this machine matches and whether the tuning is in place.
          --quiet prints only the matched tuning id and exits 1 when nothing
          matches, which is the predicate to guard installing $LIMITER_PKG.
  apply   write the matched tuning to
          $FRAGMENT
          and restart WirePlumber. --force rewrites an already current tuning.
  remove  take it out again and hand the speakers back the default output.

Tunings ship in $TUNINGS_DIR.
Nothing is applied on a machine no tuning was measured for.
EOF
}

# --- the shipped tunings ---------------------------------------------------

# load_tuning DIR — read a tuning's definition into this shell. Cleared first,
# so a key the tuning leaves out reads empty rather than carrying over from the
# tuning looked at before it.
load_tuning() {
    description=""
    match=""
    sink_pattern=""
    match_sku=()
    # shellcheck disable=SC1091 # a shipped data file, not code to follow
    source "$1/tuning.conf"
}

# sku_matches WANT... — the DMI product SKU is exactly one of WANT. Dell keys
# its Cirrus speaker firmware on the SKU, which makes it the most precise
# identifier these machines have: narrower than a product name, and it tells
# apart models whose names differ only by marketing. Compared case-insensitively
# against whole values, never a substring, so a tuning cannot widen to a product
# line by accident.
sku_matches() {
    local sku want
    sku="$(hw_dmi product_sku)"
    [[ -n $sku ]] || return 1
    for want in "$@"; do
        [[ ${sku,,} == "${want,,}" ]] && return 0
    done
    return 1
}

# tuning_match — print the directory of the tuning this machine gets, if any.
# Deliberately does not look at the live audio graph: the answer has to be the
# same before the session is up, so an installer can pull in the limiter.
tuning_match() {
    local dir
    shopt -s nullglob
    for dir in "$TUNINGS_DIR"/*/; do
        dir="${dir%/}"
        [[ -r $dir/tuning.conf ]] || continue
        load_tuning "$dir"
        # Every rule a tuning states has to hold. A tuning that states none
        # matches nothing, rather than everything.
        [[ -n $match || ${#match_sku[@]} -gt 0 ]] || continue
        [[ -z $match ]] || hw_matches "$match" || continue
        ((${#match_sku[@]} == 0)) || sku_matches "${match_sku[@]}" || continue
        # Required whichever way it matched: the graph's target sink comes from
        # it, so a tuning without one cannot be installed and must not be
        # reported as a match.
        [[ -n $sink_pattern ]] || continue
        printf '%s\n' "$dir"
        return 0
    done
    return 1
}

limiter_present() { [[ -r "$(sysroot_path "$LIMITER_TTL")" ]]; }

# --- the live audio graph --------------------------------------------------
# Reads only. Everything here answers empty when there is no audio server, which
# is the state at first boot and in a test sandbox.

pactl_sinks() {
    have pactl || return 0
    pactl list sinks short 2>/dev/null || true
}

sink_matching() { pactl_sinks | awk -v p="$1" '$2 ~ p {print $2; exit}'; }

sink_present() { pactl_sinks | awk '{print $2}' | grep -qx "$1"; }

speaker_sink_present() { [[ -n "$(sink_matching "$sink_pattern")" ]]; }

tuning_sink_present() { sink_present "$SINK_NAME"; }
tuning_sink_gone() { ! sink_present "$SINK_NAME"; }

# The physical sink the matched tuning was measured for, taken from the tuning's
# own sink_pattern rather than a regex hard-coded here.
tuned_hardware_sink() {
    local dir
    dir="$(tuning_match)" || return 1
    load_tuning "$dir"
    sink_matching "$sink_pattern"
}

# tuning_downstream_sink — the sink the tuning's own output is linked to.
# WirePlumber can link that output elsewhere if the target is missing when the
# graph loads; node.dont-fallback guards against it, but tuning the wrong device
# silently is the failure worth verifying rather than assuming.
tuning_downstream_sink() {
    local index
    have pactl || return 0
    index="$(pactl list sink-inputs 2>/dev/null | awk -v n="\"${SINK_NAME}_output\"" '
        /^Sink Input #/ { sink = "" }
        /^[[:space:]]*Sink: / { sink = $2 }
        index($0, n) { print sink; exit }')"
    [[ -n $index ]] || return 0
    pactl_sinks | awk -v i="$index" '$1 == i {print $2; exit}'
}

downstream_is_speaker() { [[ "$(tuning_downstream_sink)" == "$SPEAKER_SINK" ]]; }

# Only real application streams may be moved. The filter-chain's own output is
# also a sink input but carries no application.name, and moving it would rewire
# the tuning itself.
app_streams() {
    have pactl || return 0
    pactl list sink-inputs 2>/dev/null | awk '
        /^Sink Input #/ {id = substr($3, 2)}
        /application\.name = / {
            app = $0
            sub(/.*application\.name = "/, "", app)
            sub(/"$/, "", app)
            if (app != "EasyEffects") print id
        }'
}

move_apps_to() {
    local target="$1" id
    for id in $(app_streams); do
        pactl move-sink-input "$id" "$target" 2>/dev/null || true
    done
}

# EasyEffects moves every stream that follows the default sink onto its own
# sink, so a tuning installed underneath it would simply be bypassed. Detected
# from the graph alone: asking systemd or pgrep would reach for state a dry run
# must leave alone.
easyeffects_running() { sink_present easyeffects_sink; }

# --- actions ---------------------------------------------------------------

# render_tuning DIR SINK — the fragment as it would be written.
render_tuning() { sed "s|@SPEAKER_SINK@|$2|g" "$1/filter-chain.conf"; }

# wait_for TRIES PREDICATE — poll a live-graph condition. Never waits in a dry
# run, where nothing was started that could become true.
wait_for() {
    local tries="$1" i
    shift
    $DRY_RUN && return 0
    for ((i = 0; i < tries; i++)); do
        "$@" && return 0
        sleep 0.25
    done
    return 1
}

restart_wireplumber() { run systemctl --user restart wireplumber.service; }

# undo_fragment — back out of a half-working install. Only ever reached on a
# real run, after the fragment was written.
undo_fragment() {
    run rm -f "$FRAGMENT"
    restart_wireplumber
}

cmd_show() {
    local dir sku found
    printf 'Machine:      %s\n' "$(hw_dmi_line)"
    sku="$(hw_dmi product_sku)"
    [[ -z $sku ]] || printf 'SKU:          %s\n' "$sku"
    if dir="$(tuning_match)"; then
        load_tuning "$dir"
        printf 'Tuning:       %s (%s)\n' "${description:-?}" "${dir##*/}"
        found="$(sink_matching "$sink_pattern")"
        printf 'Speaker sink: %s\n' "${found:-none matching $sink_pattern}"
    else
        printf 'Tuning:       nothing ships for this laptop\n'
    fi
    if limiter_present; then
        printf 'Limiter:      present\n'
    else
        printf 'Limiter:      missing (needs %s)\n' "$LIMITER_PKG"
    fi
    if [[ -r $FRAGMENT ]]; then
        printf 'Installed:    yes (%s)\n' "$FRAGMENT"
    else
        printf 'Installed:    no\n'
    fi
    [[ ! -r $SOFT_MIXER ]] || printf 'Soft mixer:   yes (%s)\n' "$SOFT_MIXER"
    if tuning_sink_present; then
        printf 'Tuning sink:  present\n'
    else
        printf 'Tuning sink:  absent\n'
    fi
    return 0
}

cmd_show_quiet() {
    local dir
    dir="$(tuning_match)" || return 1
    printf '%s\n' "${dir##*/}"
}

cmd_apply() {
    local selected rendered downstream
    selected="$(tuning_match)" || {
        echo "No speaker tuning matches this laptop, so nothing was installed."
        return 0
    }
    load_tuning "$selected"

    limiter_present ||
        die "$LIMITER_PKG is required for the tuning limiter: install it, then re-run."

    # At first run the session can be up while the sink is still settling.
    speaker_sink_present || wait_for 20 speaker_sink_present || true
    SPEAKER_SINK="$(sink_matching "$sink_pattern")"
    [[ -n $SPEAKER_SINK ]] || {
        echo "A tuning applies to this laptop (${description:-?}) but no sink matching" >&2
        echo "$sink_pattern is present, so there is no audio server yet." >&2
        die "re-run after login: haseen audio tuning apply"
    }

    ! easyeffects_running || {
        echo "EasyEffects is running. It moves any stream that follows the default" >&2
        echo "sink to its own sink, so a tuning installed now would be bypassed." >&2
        die "stop it first: systemctl --user disable --now easyeffects.service"
    }

    rendered="$(render_tuning "$selected" "$SPEAKER_SINK")"
    if ! $FORCE && [[ -r $FRAGMENT ]] && [[ $rendered == "$(cat "$FRAGMENT")" ]] &&
        tuning_sink_present; then
        echo "Speaker tuning already current: ${description:-?}"
        return 0
    fi

    # The soft mixer is a machine-wide default rather than part of this tuning:
    # seeded once, never overwritten, and left behind by `remove`.
    seed_user_file "$SOFT_MIXER_SRC" "$SOFT_MIXER"
    printf '%s\n' "$rendered" | write_user_file "$FRAGMENT"
    restart_wireplumber
    echo "Installed speaker tuning: ${description:-?} (in front of $SPEAKER_SINK)"
    $DRY_RUN && return 0

    # A graph that never loaded is worse than no tuning: the fragment would keep
    # failing at every login while the speakers look fine.
    if ! wait_for 40 tuning_sink_present; then
        undo_fragment
        echo "The tuning sink never appeared, so the tuning was removed again." >&2
        die "check: journalctl --user -u wireplumber -b"
    fi

    wait_for 20 downstream_is_speaker || true
    downstream="$(tuning_downstream_sink)"
    if [[ $downstream != "$SPEAKER_SINK" ]]; then
        undo_fragment
        echo "The tuning output linked to ${downstream:-nothing} instead of $SPEAKER_SINK," >&2
        echo "so it was removed rather than left tuning the wrong device." >&2
        die "audio is untouched."
    fi

    run pactl set-default-sink "$SINK_NAME"
    # A default sink only captures new streams, so anything already playing
    # would bypass the tuning until its application was restarted.
    move_apps_to "$SINK_NAME"
    echo "Speakers now play through the tuning."
}

cmd_remove() {
    local speakers
    [[ -r $FRAGMENT ]] || {
        echo "No speaker tuning installed."
        return 0
    }
    # Read the hardware sink before the fragment goes: streams left on a
    # vanished sink reconnect wherever PipeWire puts them, not necessarily on
    # the speakers.
    speakers="$(tuned_hardware_sink || true)"
    run rm -f "$FRAGMENT"
    restart_wireplumber
    echo "Speaker tuning removed ($SOFT_MIXER stays: it is not part of a tuning)."
    $DRY_RUN && return 0
    wait_for 20 tuning_sink_gone || true
    [[ -n $speakers ]] || return 0
    run pactl set-default-sink "$speakers"
    move_apps_to "$speakers"
}

# --- dispatch --------------------------------------------------------------

FORCE=false
QUIET=false
ARGS=()
parse_common_flags "$@"
set -- "${REST[@]}"
for arg in "$@"; do
    case "$arg" in
    --force) FORCE=true ;;
    --quiet | -q) QUIET=true ;;
    *) ARGS+=("$arg") ;;
    esac
done
set -- "${ARGS[@]}"
(($# == 1)) || {
    usage >&2
    exit 2
}

case "$1" in
show)
    if $QUIET; then cmd_show_quiet; else cmd_show; fi
    ;;
apply)
    require_not_root
    cmd_apply
    ;;
remove)
    require_not_root
    cmd_remove
    ;;
*)
    usage >&2
    exit 2
    ;;
esac
