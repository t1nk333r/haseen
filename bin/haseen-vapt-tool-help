#!/usr/bin/env bash
# haseen:summary Display the installed tool own usage without starting a workflow
# haseen:args [--dry-run] TOOL [--entry ENTRY_ID]
set -Eeuo pipefail
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"
source "$HASEEN_PATH/layers/vapt/workflow.sh"
usage() { echo "Usage: haseen vapt tool-help [--dry-run] TOOL [--entry ENTRY_ID]"; }
parse_common_flags "$@"
flags=()
$DRY_RUN && flags+=(--dry-run)
vapt_workflow tool-help "${flags[@]}" "${REST[@]}"
