#!/usr/bin/env bash
# haseen:summary List installed VAPT tools and the commands VAPT runs for each
# haseen:args [--json] [--dry-run] [--group GROUP] [--all]
set -Eeuo pipefail
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"
source "$HASEEN_PATH/layers/vapt/workflow.sh"
usage() { echo "Usage: haseen vapt tool-list [--json] [--dry-run] [--group GROUP] [--all]"; }
parse_common_flags "$@"
flags=()
$DRY_RUN && flags+=(--dry-run)
vapt_workflow tool-list "${flags[@]}" "${REST[@]}"
