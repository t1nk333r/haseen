#!/usr/bin/env bash
# haseen:summary Reset a user config to haseen's default (Hyprland, shell, nightlight), keeping a backup
# haseen:args <hyprland|shell|nightlight> [--dry-run] [--yes]
#
# Backup-then-replace adapted from omarchy bin/omarchy-refresh-config (MIT,
# Copyright (c) David Heinemeier Hansson).
#
# haseen never rewrites a user file on its own (AGENTS.md); this command is
# the explicit "give me the default back" the user asks for, and the old file
# is always kept next to it as <file>.bak.<timestamp>.
set -Eeuo pipefail
# shellcheck source=../share/haseen/lib/catalog.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/catalog.sh"

CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
SHELL_JSON="$HASEEN_USER_CONFIG/shell.json"

usage() {
    cat <<EOF
Usage: haseen refresh <hyprland|shell|nightlight> [--dry-run] [--yes]

hyprland     $CFG/hypr/<file> from $HASEEN_PATH/default/hypr/user/
             (hyprland.lua), then reloads Hyprland
shell        $SHELL_JSON from the shell layer's seed; the shell
             picks it up by itself. Plugins are never touched.
nightlight   drops plugins."haseen.nightlight".settings from shell.json so the
             plugin's defaults apply, then restarts hyprsunset over IPC

Each replaced file is first copied to <file>.bak.<timestamp>.
EOF
}

in_floating_terminal "$@"
parse_common_flags "$@"
set -- "${REST[@]}"
(($# == 1)) || {
    usage >&2
    exit 2
}
require_not_root

stamp() { date +%Y%m%d-%H%M%S; }

# backup FILE — copy FILE to FILE.bak.<timestamp>; prints the backup path.
backup() {
    local b
    b="$1.bak.$(stamp)"
    run cp -a -- "$1" "$b" >&2
    printf '%s\n' "$b"
}

# refresh_file SRC DEST — DEST becomes a copy of SRC, after a backup.
refresh_file() {
    local src="$1" dest="$2" b=""
    [[ -r $src ]] || die "default missing: $src"
    if [[ -e $dest ]] && cmp -s -- "$src" "$dest"; then
        info "$dest is already the default"
        return 0
    fi
    confirm "Replace $dest with haseen's default? (the current file is kept as a backup)" ||
        die "cancelled; nothing changed"
    [[ ! -e $dest ]] || b="$(backup "$dest")"
    run install -Dm644 -- "$src" "$dest"
    if [[ -n $b ]] && ! $DRY_RUN; then
        info "replaced $dest (backup: $b). Changes from your version:"
        diff -u -- "$b" "$dest" || true
    fi
}

shell_ipc() {
    run "$HASEEN_EXE" shell ipc "$@" || warn "the shell did not answer (is it running?)"
}

case "$1" in
hyprland)
    for src in "$HASEEN_PATH"/default/hypr/user/*; do
        [[ -f $src ]] || continue
        refresh_file "$src" "$CFG/hypr/${src##*/}"
    done
    if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
        run hyprctl reload
    fi
    ;;
shell)
    refresh_file "$HASEEN_PATH/layers/shell/files/shell.json" "$SHELL_JSON"
    ;;
nightlight)
    if [[ -r $SHELL_JSON ]] && jq -e '.plugins["haseen.nightlight"].settings? != null' "$SHELL_JSON" >/dev/null 2>&1; then
        confirm "Reset the nightlight settings in $SHELL_JSON to the defaults? (a backup is kept)" ||
            die "cancelled; nothing changed"
        new="$(jq --indent 2 'del(.plugins["haseen.nightlight"].settings)' "$SHELL_JSON")" ||
            die "$SHELL_JSON is not valid JSON; fix it or run: haseen refresh shell"
        b="$(backup "$SHELL_JSON")"
        printf '%s\n' "$new" | write_user_file "$SHELL_JSON"
        $DRY_RUN || info "nightlight settings reset (backup: $b)"
    else
        info "nightlight already uses the default settings"
    fi
    shell_ipc nightlight refresh
    ;;
*)
    usage >&2
    exit 2
    ;;
esac
