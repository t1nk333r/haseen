#!/usr/bin/env bash
# haseen:summary Screen and keyboard brightness: laptop backlights, keyboard backlights, DDC monitors
# haseen:args list|get [DEVICE]|set [DEVICE] VALUE|up [DEVICE]|down [DEVICE] [--step N] [--dry-run]
#
# Plan 077. Backlights (/sys/class/backlight) and keyboard backlights
# (/sys/class/leds/*::kbd_backlight) are written by brightnessctl, which goes
# through logind, so no root and no udev rule are needed. External monitors
# are written over DDC/CI by ddcutil (VCP 0x10) when it is installed and
# /dev/i2c-* exists (`haseen setup ddc on`). `ddcutil detect` takes seconds,
# so the bus of each monitor is cached in $XDG_CACHE_HOME/haseen; a cached bus
# that stops answering triggers one fresh detect.
#
# The percentage maths is done here and brightnessctl/ddcutil get raw values,
# so one rule covers all three kinds and the tests can check it. The shell's
# OSD (haseen.osd) watches actual_brightness, so the brightness keys still
# show it whatever writes the backlight.
set -Eeuo pipefail
# shellcheck source=../share/haseen/lib/common.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"

DDC_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/haseen/ddc-displays.tsv"
# The old brightness binds ran `brightnessctl -e4 -n2`: steps on a 4th-power
# curve, so the dim end moves in small steps, and never below raw 2, so the
# keys cannot turn the panel black.
CURVE=4
BACKLIGHT_FLOOR=2

usage() {
    cat <<EOF
Usage: haseen brightness <command> [--dry-run]

  list [--kind KINDS] [--rescan]
                        every device, one per line (tab-separated):
                        ID KIND PERCENT VALUE MAX NAME WATCH
                        KIND is backlight, keyboard or ddc; WATCH is the
                        sysfs file that changes with it ("-" for DDC).
                        --kind backlight,keyboard limits the kinds; --rescan
                        runs ddcutil detect again instead of using the cache.
  get [DEVICE]          the same line for DEVICE
  set [DEVICE] VALUE    VALUE is N% (absolute), +N% or -N% (relative) or N
                        (a raw value, 0..MAX)
  up [DEVICE]           one step brighter (--step N, default 5 %)
  down [DEVICE]         one step darker

DEVICE is an ID from 'list' (intel_backlight, tpacpi::kbd_backlight,
ddc:DP-1), or kbd for the first keyboard backlight, backlight for the first
backlight, or ddc for every DDC monitor. Without DEVICE: the first backlight,
or every DDC monitor on a machine without one.

Backlights move on a 4th-power curve for up/down (finer steps when dim) and
never go below raw $BACKLIGHT_FLOOR. Keyboard backlights and monitors move linearly; a
step always moves at least one raw unit.

DDC monitors need ddcutil and the i2c-dev module: 'haseen setup ddc on'.
--dry-run prints the brightnessctl/ddcutil call instead of running it.
EOF
}

# --- maths (awk: the shell has no floats) ----------------------------------------

# percent VALUE MAX — the linear percentage, rounded.
percent() { awk -v v="$1" -v m="$2" 'BEGIN { printf "%d\n", (m > 0 ? int(v * 100 / m + 0.5) : 0) }'; }

# floor_for KIND MAX — the lowest raw value a write may set.
floor_for() {
    if [[ $1 == backlight ]]; then
        echo $((BACKLIGHT_FLOOR < $2 ? BACKLIGHT_FLOOR : $2))
    else
        echo 0
    fi
}

# clamp RAW KIND MAX
clamp() {
    local raw="$1" lo
    lo="$(floor_for "$2" "$3")"
    ((raw < lo)) && raw=$lo
    ((raw > $3)) && raw=$3
    echo "$raw"
}

# target VALUE CUR MAX KIND — the raw value VALUE asks for, clamped. Relative
# changes move at least one raw unit.
target() {
    local value="$1" cur="$2" max="$3" kind="$4" raw
    case "$value" in
    +*% | -*%)
        raw="$(awk -v c="$cur" -v m="$max" -v d="${value%\%}" 'BEGIN {
            delta = d * m / 100
            r = (delta < 0) ? -int(-delta + 0.5) : int(delta + 0.5)
            if (r == 0) r = (d > 0) ? 1 : (d < 0 ? -1 : 0)
            print c + r }')"
        ;;
    *%) raw="$(awk -v m="$max" -v p="${value%\%}" 'BEGIN { printf "%d\n", int(p * m / 100 + 0.5) }')" ;;
    *) raw="$value" ;;
    esac
    clamp "$raw" "$kind" "$max"
}

# step DIR CUR MAX KIND STEP — up (DIR 1) or down (DIR -1) by STEP percent:
# on the curve for backlights, linear otherwise.
step() {
    local dir="$1" cur="$2" max="$3" kind="$4" pct="$5" raw
    raw="$(awk -v dir="$dir" -v c="$cur" -v m="$max" -v s="$pct" -v e="$([[ $kind == backlight ]] && echo "$CURVE" || echo 1)" 'BEGIN {
        p = (c / m) ^ (1 / e) * 100 + dir * s
        if (p < 0) p = 0
        if (p > 100) p = 100
        r = int((p / 100) ^ e * m + 0.5)
        if (r == c) r = c + dir
        print r }')"
    clamp "$raw" "$kind" "$max"
}

# --- devices -------------------------------------------------------------------------
# A device is one tab-separated record: ID KIND VALUE MAX NAME WATCH HANDLE.
# HANDLE is the sysfs directory, or the i2c bus number for DDC.

read_int() {
    local v
    v="$(cat -- "$1" 2>/dev/null)" || return 1
    [[ $v =~ ^[0-9]+$ ]] || return 1
    echo "$v"
}

# sysfs_devices KIND — backlights or keyboard backlights, sorted by name.
sysfs_devices() {
    local kind="$1" dir id name file value max
    if [[ $kind == backlight ]]; then
        set -- "$(sysroot_path /sys/class/backlight)"/*
    else
        set -- "$(sysroot_path /sys/class/leds)"/*::kbd_backlight
    fi
    for dir in "$@"; do
        [[ -d $dir ]] || continue
        id="${dir##*/}"
        file="$dir/brightness"
        name="Keyboard backlight"
        if [[ $kind == backlight ]]; then
            name="Built-in display"
            # The kernel notifies actual_brightness on every change, firmware
            # hotkeys included; brightness only on writes from userspace.
            [[ -r $dir/actual_brightness ]] && file="$dir/actual_brightness"
        fi
        value="$(read_int "$file")" || continue
        max="$(read_int "$dir/max_brightness")" || continue
        ((max > 0)) || continue
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$kind" "$value" "$max" "$name" "$file" "$dir"
    done
}

ddc_present() { have ddcutil && compgen -G "$(sysroot_path /dev)/i2c-*" >/dev/null; }

# ddc_detect — BUS CONNECTOR MODEL per DDC-capable monitor, from
# `ddcutil detect --brief`. "Invalid display" blocks have no DDC/CI.
ddc_detect() {
    ddcutil detect --brief 2>/dev/null | awk '
        /^Display [0-9]+/ { flush(); on = 1; next }
        /^[^ \t]/ { flush(); on = 0; next }
        on && /I2C bus:/ { b = $NF; sub(/.*i2c-/, "", b); bus = b }
        on && /DRM[ _]connector:/ { c = $NF; sub(/^card[0-9]+-/, "", c); conn = c }
        on && /Monitor:/ { m = $0; sub(/^[^:]*:[ \t]*/, "", m); n = split(m, f, ":"); model = (n >= 2 ? f[2] : m) }
        function flush() { if (on && bus != "") printf "%s\t%s\t%s\n", bus, conn, model; bus = conn = model = "" }
        END { flush() }'
}

DDC_RESCANNED=false

# ddc_rescan — detect again and replace the cache (a cache, so no dry run).
ddc_rescan() {
    local tmp
    DDC_RESCANNED=true
    mkdir -p "${DDC_CACHE%/*}"
    tmp="$(mktemp "$DDC_CACHE.XXXXXX")"
    ddc_detect >"$tmp"
    mv -f -- "$tmp" "$DDC_CACHE"
}

ddc_cached() {
    [[ -f $DDC_CACHE ]] || ddc_rescan
    cat -- "$DDC_CACHE"
}

# ddc_read BUS — "VALUE MAX" of VCP 0x10 ("VCP 10 C 50 100").
ddc_read() {
    ddcutil --bus "$1" getvcp 10 --brief 2>/dev/null | awk '$1 == "VCP" && $3 == "C" && $5 > 0 { print $4, $5; ok = 1 } END { exit !ok }'
}

# ddc_devices — DDC monitors with their current value. A monitor that does
# not answer from the cache means the buses moved: detect once more.
ddc_devices() {
    ddc_present || return 0
    local bus conn model id name vm out="" failed=false
    while IFS=$'\t' read -r bus conn model; do
        [[ -n $bus ]] || continue
        if ! vm="$(ddc_read "$bus")"; then
            failed=true
            continue
        fi
        id="ddc:${conn:-i2c-$bus}"
        name="${model:-Monitor}${conn:+ ($conn)}"
        out+="$(printf '%s\tddc\t%s\t%s\t%s\t-\t%s' "$id" "${vm% *}" "${vm#* }" "$name" "$bus")"$'\n'
    done < <(ddc_cached)
    if $failed && ! $DDC_RESCANNED; then
        ddc_rescan
        ddc_devices
        return
    fi
    printf '%s' "$out"
}

# all_devices KINDS — comma-separated kinds, in the order backlight, keyboard, ddc.
all_devices() {
    local kinds=",$1,"
    [[ $kinds == *,backlight,* ]] && sysfs_devices backlight
    [[ $kinds == *,keyboard,* ]] && sysfs_devices keyboard
    [[ $kinds == *,ddc,* ]] && ddc_devices
    return 0
}

# resolve [DEVICE] — the records DEVICE names. DDC is only probed when
# DEVICE asks for it, or when there is no backlight to default to.
resolve() {
    local want="${1:-}" rows
    case "$want" in
    "")
        rows="$(sysfs_devices backlight | head -n1)"
        [[ -n $rows ]] || rows="$(ddc_devices)"
        [[ -n $rows ]] || die "no backlight and no DDC monitor found (haseen brightness list)"
        ;;
    backlight) rows="$(sysfs_devices backlight | head -n1)" ;;
    kbd | keyboard) rows="$(sysfs_devices keyboard | head -n1)" ;;
    ddc) rows="$(ddc_devices)" ;;
    ddc:*) rows="$(ddc_devices | awk -F'\t' -v id="$want" '$1 == id')" ;;
    *) rows="$(all_devices backlight,keyboard | awk -F'\t' -v id="$want" '$1 == id')" ;;
    esac
    [[ -n $rows ]] || die "no brightness device '${want}' (haseen brightness list)"
    printf '%s\n' "$rows"
}

# row RECORD [VALUE] — the line list/get print, with VALUE in place of the
# record's current one.
row() {
    local id kind value max name watch
    IFS=$'\t' read -r id kind value max name watch _ <<<"$1"
    value="${2:-$value}"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$kind" "$(percent "$value" "$max")" "$value" "$max" "$name" "$watch"
}

# write RECORD RAW — brightnessctl for sysfs (through logind, as the user),
# ddcutil for DDC.
write() {
    local id kind handle
    IFS=$'\t' read -r id kind _ _ _ _ handle <<<"$1"
    case "$kind" in
    backlight) run brightnessctl --quiet --class=backlight --device="$id" set "$2" ;;
    keyboard) run brightnessctl --quiet --class=leds --device="$id" set "$2" ;;
    ddc) run ddcutil --bus "$handle" setvcp 10 "$2" ;;
    esac
}

# lock_writes — one change at a time. A held key repeats faster than DDC
# answers (and a relative step is a read, then a write), so each set/up/down
# waits for the one before it to finish before it reads.
lock_writes() {
    $DRY_RUN && return 0
    have flock || return 0
    exec 9>"${XDG_RUNTIME_DIR:-/tmp}/haseen-brightness.lock"
    flock -w 5 9 || die "another haseen brightness change is still running"
}

# apply RECORD MODE ARG — compute the new value, write it, print the line.
apply() {
    local record="$1" mode="$2" arg="$3" kind value max new
    IFS=$'\t' read -r _ kind value max _ <<<"$record"
    if [[ $mode == set ]]; then
        new="$(target "$arg" "$value" "$max" "$kind")"
    else
        new="$(step "$mode" "$value" "$max" "$kind" "$arg")"
    fi
    if ((new != value)); then
        write "$record" "$new"
    fi
    $DRY_RUN || row "$record" "$new"
}

# --- commands --------------------------------------------------------------------------

valid_value() { [[ $1 =~ ^[+-][0-9]+%$ || $1 =~ ^[0-9]+%?$ ]]; }

usage_error() {
    printf 'haseen brightness: %s\n' "$1" >&2
    usage >&2
    exit 2
}

parse_common_flags "$@"
args=()
step_pct=5
kinds=backlight,keyboard,ddc
rescan=false
for ((i = 0; i < ${#REST[@]}; i++)); do
    a="${REST[i]}"
    case "$a" in
    --step) step_pct="${REST[i + 1]:-}" && i=$((i + 1)) ;;
    --step=*) step_pct="${a#--step=}" ;;
    --kind) kinds="${REST[i + 1]:-}" && i=$((i + 1)) ;;
    --kind=*) kinds="${a#--kind=}" ;;
    --rescan) rescan=true ;;
    --*) usage_error "unknown option $a" ;;
    *) args+=("$a") ;;
    esac
done
[[ $step_pct =~ ^[0-9]+$ ]] && ((step_pct >= 1 && step_pct <= 100)) || usage_error "--step takes 1-100"
[[ $kinds =~ ^(backlight|keyboard|ddc)(,(backlight|keyboard|ddc))*$ ]] || usage_error "--kind takes backlight, keyboard and ddc"

verb="${args[0]:-}"
set -- "${args[@]:1}"
case "$verb" in
list)
    (($# == 0)) || usage_error "list takes no device"
    $rescan && [[ ,$kinds, == *,ddc,* ]] && ddc_present && ddc_rescan
    while IFS= read -r record; do
        [[ -n $record ]] && row "$record"
    done < <(all_devices "$kinds")
    ;;
get)
    (($# <= 1)) || usage_error "get takes one device"
    records="$(resolve "${1:-}")"
    while IFS= read -r record; do
        row "$record"
    done <<<"$records"
    ;;
set)
    (($# == 1 || $# == 2)) || usage_error "set takes [DEVICE] VALUE"
    value="${!#}"
    valid_value "$value" || usage_error "VALUE is N%, +N%, -N% or a raw N, not '$value'"
    device=""
    (($# == 2)) && device="$1"
    lock_writes
    records="$(resolve "$device")"
    while IFS= read -r record; do
        apply "$record" set "$value"
    done <<<"$records"
    ;;
up | down)
    (($# <= 1)) || usage_error "$verb takes one device"
    lock_writes
    records="$(resolve "${1:-}")"
    dir=1
    [[ $verb == down ]] && dir=-1
    while IFS= read -r record; do
        apply "$record" "$dir" "$step_pct"
    done <<<"$records"
    ;;
"") usage_error "a command is required" ;;
*) usage_error "unknown command '$verb'" ;;
esac
