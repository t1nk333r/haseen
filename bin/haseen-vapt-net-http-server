#!/usr/bin/env bash
# haseen:summary Serve an explicitly selected local directory in the foreground
# haseen:args [--dry-run] [--yes] [--bind ADDRESS] [DIR] [PORT]
set -Eeuo pipefail
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"
source "$HASEEN_PATH/layers/vapt/workflow_actions.sh"
usage() { echo "Usage: haseen vapt net-http-server [--dry-run] [--yes] [--bind ADDRESS] [DIR] [PORT]"; }
parse_common_flags "$@"
vapt_endpoint_action http-server "${REST[@]}"
