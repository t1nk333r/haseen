#!/usr/bin/env bash
# haseen:summary Arrange the bar: drag widgets, tuck them in the overflow panel, move the bar to another edge
# haseen:args [on|off|toggle] [--dry-run]
set -Eeuo pipefail
# shellcheck source=../share/haseen/lib/common.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"
BIN_DIR="$(dirname "$(readlink -f "$0")")"

usage() {
    cat <<EOF
Usage: haseen bar arrange [on|off|toggle] [--dry-run]

Turns arrange mode on or off (default: toggle) on the focused screen's bar
(IPC: bar arrange). The overflow panel opens; drag a widget to move it
within the bar, to another section or into the panel, click one to move it
between the bar and the panel, and pick the screen edge for the bar. Every
move is saved in shell.json (\`haseen bar move\`, \`haseen bar overflow\`,
\`haseen bar position\`). A right click on empty bar space or on the
chevron does the same as this command.
EOF
}

parse_common_flags "$@"
((${#REST[@]} <= 1)) && [[ ${REST[0]:-toggle} =~ ^(on|off|toggle)$ ]] || {
    usage >&2
    exit 2
}
run "$BIN_DIR/haseen-shell-ipc" bar arrange "${REST[0]:-toggle}"
