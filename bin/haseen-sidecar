#!/usr/bin/env bash
# haseen:summary Show, start or stop haseen-sidecar, the sampling and border wipe daemon
# haseen:args [status|start|stop|build] [--dry-run]
#
# The shell starts the daemon itself when a widget needs it (plan 032) or the
# theme asks for a border wipe (plan 069); this is for looking at it and for
# building it from a checkout.
set -Eeuo pipefail

# shellcheck source=../share/haseen/lib/common.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"

BINARY="$HASEEN_PATH/sidecar/haseen-sidecar"
SOCKET="${XDG_RUNTIME_DIR:-/tmp}/haseen/sidecar.sock"

usage() {
    cat <<EOF
Usage: haseen sidecar [status|start|stop|build] [--dry-run]

  status   binary, version, socket, the capabilities it announces and, while
           it runs, the border wipe: off, waiting, native (Hyprland turns the
           border), paused or running, with the reason
  start    run the daemon in the background (the shell does this on demand)
  stop     ask the running daemon to exit
  build    compile it from core/sidecar/ into $BINARY, haseen-palette
           beside it from core/palette/ (both need cargo; plan 167) and
           wootingd from core/wootingd/ (cargo; plan 099); what cannot be
           built is fetched from the sidecar release (plan 127)
EOF
}

parse_common_flags "$@"
set -- "${REST[@]+"${REST[@]}"}"
action="${1:-status}"
(($# <= 1)) || {
    usage >&2
    exit 2
}

# socket_listener — the `ss` row of whatever listens on the socket (with its
# pid), empty when nothing does. ss is iproute2, which Arch's base pulls in;
# socat is not installed by default, and a daemon that was SIGKILLed or
# aborted leaves its socket file behind (plan 199).
socket_listener() {
    ss -xlnpH src "$SOCKET" 2>/dev/null
}

# socket_state — running, not running, or unknown when neither socat nor ss
# can tell a live socket from a stale one.
socket_state() {
    if [[ ! -S $SOCKET ]]; then
        echo "not running"
    elif have socat; then
        if timeout 2 socat -u /dev/null UNIX-CONNECT:"$SOCKET" 2>/dev/null; then
            echo running
        else
            echo "not running"
        fi
    elif have ss; then
        if [[ -n $(socket_listener) ]]; then echo running; else echo "not running"; fi
    else
        echo unknown
    fi
}

# wipe_status — the border wipe line, from the daemon's `status` answer.
wipe_status() {
    have socat && have jq || return 0
    local line
    line="$(printf '{"id":1,"method":"status"}\n' | timeout 2 socat -t1 - UNIX-CONNECT:"$SOCKET" 2>/dev/null |
        jq -r 'select(.type == "reply") | .data.borderwipe // empty |
            .state
            + (if .reason then " (" + .reason + ")" else "" end)
            + (if .secondsPerTurn then ", \(.secondsPerTurn) s a turn" else "" end)
            + (if .state == "running" or .state == "paused" then ", angle \(.angle), \(.frames) frames" else "" end)' 2>/dev/null)" || line=""
    if [[ -n $line ]]; then
        printf 'border wipe:  %s\n' "$line"
    fi
}

case "$action" in
status)
    if [[ -x $BINARY ]]; then
        printf 'binary:       %s (%s)\n' "$BINARY" "$("$BINARY" -version)"
        printf 'capabilities: %s\n' "$("$BINARY" -capabilities)"
    else
        printf 'binary:       missing (%s)\n' "$BINARY"
        printf 'capabilities: none; features that need the daemon stay hidden\n'
    fi
    state="$(socket_state)"
    printf 'socket:       %s (%s)\n' "$SOCKET" "$state"
    if [[ $state == running ]]; then
        if have socat && have jq; then
            wipe_status
        else
            printf 'border wipe:  unknown (asking the daemon needs socat and jq)\n'
        fi
    fi
    ;;
start)
    [[ -x $BINARY ]] || die "no daemon at $BINARY (haseen sidecar build)"
    if [[ $(socket_state) == running ]]; then
        info "already running on $SOCKET"
        exit 0
    fi
    if $DRY_RUN; then
        echo "DRYRUN: $BINARY &"
        exit 0
    fi
    setsid "$BINARY" >/dev/null 2>&1 &
    info "started $BINARY"
    ;;
stop)
    case "$(socket_state)" in
    "not running")
        info "not running"
        exit 0
        ;;
    unknown) die "cannot tell whether the daemon on $SOCKET runs: install socat or iproute2" ;;
    esac
    if $DRY_RUN; then
        echo "DRYRUN: ask the daemon on $SOCKET to shut down"
        exit 0
    fi
    if have socat; then
        printf '{"id":1,"method":"shutdown"}\n' | timeout 2 socat - UNIX-CONNECT:"$SOCKET" >/dev/null || true
    else
        # Without socat, SIGTERM does the same: the daemon removes its socket
        # and exits.
        pid="$(socket_listener | sed -n 's/.*pid=\([0-9][0-9]*\).*/\1/p' | head -n 1)"
        [[ -n $pid ]] || die "no process listens on $SOCKET"
        kill -TERM "$pid"
    fi
    info "asked the daemon to exit"
    ;;
build)
    if $DRY_RUN; then
        echo "DRYRUN: $HASEEN_PATH/../tools/build-sidecar.sh"
        exit 0
    fi
    script="$HASEEN_PATH/../tools/build-sidecar.sh"
    [[ -x $script ]] || die "build-sidecar.sh is only in a checkout, not in an installed tree"
    "$script" "$BINARY"
    ;;
*)
    usage >&2
    exit 2
    ;;
esac
