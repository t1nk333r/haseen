#!/usr/bin/env bash
# haseen:summary Seed haseen's config defaults into your home, once each
# haseen:args [--dry-run]
#
# Seeds are copied once. A file the user has edited is never touched again,
# so running this after every upgrade is safe and nearly always a no-op.
#
# Each seed is one file in share/haseen/seeds/*.sh. It defines seed_main and
# declares what it writes with `# haseen:seed <path>|<description>` lines,
# which is where --help gets its list. Files run in name order, so a seed that
# depends on an earlier one is numbered after it. A slice adds a seed by adding
# a file; this command never changes.
set -Eeuo pipefail
# shellcheck source=../share/haseen/lib/common.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"

# Every seed module may use these.
DEFAULTS="$HASEEN_PATH/default"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
COMPOSE="$HOME/.XCompose"
SEEDS="$HASEEN_PATH/seeds"

# seed_modules — the module files, in run order.
seed_modules() {
    local f
    shopt -s nullglob
    for f in "$SEEDS"/*.sh; do printf '%s\n' "$f"; done
    shopt -u nullglob
}

# seed_declared — "path|description" for every `# haseen:seed` line, with the
# module's own variables expanded, so --help shows real paths.
seed_declared() {
    local f line path desc
    while IFS= read -r f; do
        while IFS= read -r line; do
            line="${line#*haseen:seed }"
            path="${line%%|*}"
            desc="${line#*|}"
            # Only the four names a module may use; eval-free expansion.
            path="${path//\$CONFIG/$CONFIG}"
            path="${path//\$COMPOSE/$COMPOSE}"
            path="${path//\$DEFAULTS/$DEFAULTS}"
            path="${path//\$HOME/$HOME}"
            printf '%s|%s\n' "$path" "$desc"
        done < <(grep -o '# haseen:seed .*' "$f" || true)
    done < <(seed_modules)
}

usage() {
    cat <<EOF
Usage: haseen seed user [--dry-run]

Copies haseen's defaults into \$HOME, once each:

$(seed_declared | while IFS='|' read -r p d; do printf '  %-50s %s\n' "$p" "$d"; done)

Files that already exist are left alone: they are yours after the first seed.
EOF
}

parse_common_flags "$@"
set -- "${REST[@]}"
(($# == 0)) || {
    usage >&2
    exit 2
}
require_not_root

while IFS= read -r module; do
    # shellcheck disable=SC1090  # module list is this tree's own seeds/
    source "$module"
    declare -F seed_main >/dev/null || die "${module##*/}: no seed_main"
    seed_main
    unset -f seed_main
done < <(seed_modules)

info "seeds are in place; log out and back in for the input method to load"
