#!/usr/bin/env bash
# haseen:summary Seed the btop, fcitx5, input-method and XCompose configs into your home
# haseen:args [--dry-run]
#
# Config seeds adapted from Omarchy (MIT, Copyright (c) David Heinemeier
# Hansson): config/btop/btop.conf, config/fcitx5/conf/{xcb,clipboard}.conf,
# default/environment.d/10-omarchy-fcitx.conf, default/xcompose and
# install/user/xcompose.sh.
#
# Seeds are copied once. A file the user has edited is never touched again,
# so running this after every upgrade is safe and nearly always a no-op.
set -Eeuo pipefail
# shellcheck source=../share/haseen/lib/common.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"

DEFAULTS="$HASEEN_PATH/default"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
COMPOSE="$HOME/.XCompose"

usage() {
    cat <<EOF
Usage: haseen seed user [--dry-run]

Copies haseen's defaults into \$HOME, once each:

  $CONFIG/btop/btop.conf          resource monitor settings
  $CONFIG/btop/themes/current.theme  link to the theme pipeline's colours
  $CONFIG/fcitx5/{config,profile}    English <-> Arabic on Control+space
  $CONFIG/fcitx5/conf/*.conf         fcitx5 addon settings
  $CONFIG/environment.d/10-haseen-fcitx.conf  QT_IM_MODULE and friends
  $COMPOSE                           includes haseen's compose sequences

Files that already exist are left alone: they are yours after the first seed.
EOF
}

parse_common_flags "$@"
set -- "${REST[@]}"
(($# == 0)) || {
    usage >&2
    exit 2
}
require_not_root

# --- btop -------------------------------------------------------------------
# The colours belong to the theme pipeline: `haseen theme set` renders
# share/haseen/themed/btop.theme.tpl to current/theme/btop.theme. The seed adds
# only what that does not cover — btop's own settings, and the themes link that
# makes `color_theme = "current"` resolve to the rendered file.
seed_btop() {
    seed_user_file "$DEFAULTS/btop/btop.conf" "$CONFIG/btop/btop.conf"
    local link="$CONFIG/btop/themes/current.theme"
    local target="$HASEEN_USER_STATE/current/theme/btop.theme"
    # -L too: a dangling link is still the user's (no theme applied yet).
    if [[ -e $link || -L $link ]]; then
        return 0
    fi
    run mkdir -p "$CONFIG/btop/themes"
    run ln -snf "$target" "$link"
}

# --- fcitx5 -----------------------------------------------------------------
seed_fcitx5() {
    local f
    for f in config profile conf/xcb.conf conf/clipboard.conf; do
        seed_user_file "$DEFAULTS/fcitx5/$f" "$CONFIG/fcitx5/$f"
    done
    seed_user_file "$DEFAULTS/environment.d/10-haseen-fcitx.conf" \
        "$CONFIG/environment.d/10-haseen-fcitx.conf"
}

# --- XCompose ---------------------------------------------------------------
# Generated rather than copied: it carries the absolute path of the installed
# tree, which differs between the checkout, /usr/local and /usr.
seed_xcompose() {
    [[ -e $COMPOSE ]] && return 0
    write_user_file "$COMPOSE" <<EOF
# Your compose sequences. haseen writes this file once and never again.
# The Compose key is CapsLock (hypr input option compose:caps).

# The sequences of your locale.
include "%L"

# haseen's emoji, Arabic punctuation and typography sequences.
include "$DEFAULTS/xcompose/compose"
EOF
}

seed_btop
seed_fcitx5
seed_xcompose

info "seeds are in place; log out and back in for the input method to load"
