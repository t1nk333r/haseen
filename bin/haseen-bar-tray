#!/usr/bin/env bash
# haseen:summary Pin the tray icons open, or collapse them behind the chevron (saved in shell.json)
# haseen:args [pin|unpin|toggle] [--dry-run]
set -Eeuo pipefail
# shellcheck source=../share/haseen/shell/lib/plugin.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/shell/lib/plugin.sh"
BIN_DIR="$(dirname "$(readlink -f "$0")")"

usage() {
    cat <<EOF
Usage: haseen bar tray [pin|unpin|toggle] [--dry-run]

Sets plugins."haseen.tray".settings.pinned in $SHELL_USER_CONFIG (default:
toggle), then tells the running shell. Unpinned, the tray shows only a chevron
and hovering it reveals the icons; pinned, they stay out. Clicking the chevron
does the same as this.

--no-apply   only save; used by the shell itself, which already applied it
EOF
}

APPLY=true
args=()
for a in "$@"; do
    if [[ $a == --no-apply ]]; then APPLY=false; else args+=("$a"); fi
done
parse_common_flags "${args[@]+"${args[@]}"}"
((${#REST[@]} <= 1)) || {
    usage >&2
    exit 2
}

# At top level, so an unreadable user file stops here (exit 1), untouched.
# Under the transaction lock, so the value written below is computed from the
# shell.json no other writer can replace until this one renames its own.
shell_config_lock
user="$(shell_user_json)"
current="$(shell_merged_json | jq '.plugins["haseen.tray"].settings.pinned == true')"
case "${REST[0]:-toggle}" in
pin) want=true ;;
unpin) want=false ;;
toggle) if [[ $current == true ]]; then want=false; else want=true; fi ;;
*)
    usage >&2
    exit 2
    ;;
esac
word=unpin
[[ $want == true ]] && word=pin

if [[ $current != "$want" ]]; then
    updated="$(jq --argjson v "$want" '.plugins["haseen.tray"].settings.pinned = $v' <<<"$user")"
    printf '%s\n' "$updated" | shell_config_write
fi
info "tray: ${word}ned"

if $APPLY; then
    if $DRY_RUN; then
        echo "DRYRUN: haseen shell ipc bar tray $word"
    else
        "$BIN_DIR/haseen-shell-ipc" bar tray "$word" >/dev/null 2>&1 ||
            info "no running haseen shell answered; it applies at the next start"
    fi
fi
