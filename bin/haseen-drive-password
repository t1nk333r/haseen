#!/usr/bin/env bash
# haseen:summary Change the disk-encryption passphrase of a LUKS drive
# haseen:args [device] [--dry-run] [--yes]
#
# Adapted from Omarchy bin/omarchy-drive-password (MIT, Copyright (c) David
# Heinemeier Hansson): the new key reaches cryptsetup as a keyfile through
# <(cat), so the terminal stays free for the current-passphrase prompt.
# Changes: read -rs instead of gum, and the device can be given on the command
# line so a scripted run never opens a picker.
set -Eeuo pipefail

# shellcheck source=../share/haseen/lib/common.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"

usage() {
    cat <<EOF
Usage: haseen drive password [device] [--dry-run] [--yes]

Changes one passphrase on a LUKS container (the key slot you unlock with).
Without a device it lists the encrypted ones and asks. Your other key slots,
including a FIDO2 or TPM enrolment, are untouched.
EOF
}

parse_common_flags "$@"
set -- "${REST[@]+"${REST[@]}"}"
(($# <= 1)) || {
    usage >&2
    exit 2
}
require_not_root
require_cmds cryptsetup lsblk

device="${1:-}"
if [[ -z $device ]]; then
    device="$(haseen-drive-select --luks)" || exit 1
fi
# A dry run plans against a device it may not be able to stat, but the type
# check runs either way: it is the one that stops the wrong disk being rekeyed.
$DRY_RUN || [[ -b $device ]] || die "not a block device: $device"
[[ $(lsblk -prno NAME,FSTYPE "$device" 2>/dev/null | awk -v d="$device" '$1 == d { print $2 }') == crypto_LUKS ]] ||
    die "$device is not a LUKS container (haseen drive select --luks)"

if $DRY_RUN; then
    echo "DRYRUN: prompt for a new passphrase, then: sudo cryptsetup luksChangeKey --pbkdf argon2id --iter-time 2000 $device"
    exit 0
fi

confirm "Change a passphrase on $(haseen-drive-info "$device")?" || exit 1

read -rsp "New passphrase: " new_key
echo
[[ -n $new_key ]] || die "the passphrase cannot be empty"
read -rsp "Confirm new passphrase: " confirmation
echo
[[ $new_key == "$confirmation" ]] || die "the passphrases do not match"

info "cryptsetup asks for a passphrase you already have, then replaces its slot"
# The new key never appears in the command line or the environment.
printf '%s' "$new_key" |
    run_root bash -c 'exec cryptsetup luksChangeKey --pbkdf argon2id --iter-time 2000 "$1" <(cat) </dev/tty' bash "$device"
info "passphrase changed on $device"
