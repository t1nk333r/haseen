#!/usr/bin/env bash
# haseen:summary Print the weather condition icon, adjusted for sunrise and sunset
# haseen:args
#
# Adapted from Omarchy bin/omarchy-weather-icon (MIT, Copyright (c) David
# Heinemeier Hansson). Changes: the location is whatever
# haseen-weather-location resolves (manual, GeoClue, else wttr.in's IP lookup).
set -Eeuo pipefail
# shellcheck source=../share/haseen/lib/common.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"

usage() {
    echo "Usage: haseen weather icon   (prints a Nerd Font glyph, or exits 1 offline)"
}
parse_common_flags "$@"
((${#REST[@]} == 0)) || { usage >&2; exit 2; }

query="$(haseen-weather-location --query 2>/dev/null)" || query=""
weather_data=$(curl -fsS --max-time 3 "https://wttr.in/${query}?format=j1" 2>/dev/null | jq -er '[.current_condition[0].weatherCode, .weather[0].astronomy[0].sunrise, .weather[0].astronomy[0].sunset] | select(all(. != null and . != "")) | @tsv' 2>/dev/null) || exit 1

IFS=$'\t' read -r weather_code sunrise sunset <<<"$weather_data"
if [[ ! $weather_code =~ ^[0-9]+$ || ! $sunrise =~ ^[0-9]{1,2}:[0-9]{2}\ [AP]M$ || ! $sunset =~ ^[0-9]{1,2}:[0-9]{2}\ [AP]M$ ]]; then
    exit 1
fi

now_epoch=$(date +%s)
sunrise_epoch=$(date -d "today $sunrise" +%s 2>/dev/null || echo 0)
sunset_epoch=$(date -d "today $sunset" +%s 2>/dev/null || echo 0)

night=false
if ((sunrise_epoch > 0 && sunset_epoch > 0 && (now_epoch < sunrise_epoch || now_epoch >= sunset_epoch))); then
    night=true
fi

day_night() { if $night; then printf '%s\n' "$2"; else printf '%s\n' "$1"; fi; }

case $weather_code in
113) day_night $'\xee\x8c\x8d' $'\xee\x8c\xab' ;;
116) day_night $'\xee\x8c\x82' $'\xee\x8c\xae' ;;
119 | 122) printf '%s\n' $'\xee\x8c\xbd' ;;
143 | 248 | 260) printf '%s\n' $'\xee\x8c\x93' ;;
176 | 263 | 353) day_night $'\xee\x8c\x88' $'\xee\x8c\xb3' ;;
179 | 227 | 230 | 323 | 326 | 368) day_night $'\xee\x8c\x8a' $'\xee\x8c\xa7' ;;
182 | 185 | 281 | 284 | 311 | 314 | 317 | 320 | 350 | 362 | 365 | 374 | 377) printf '%s\n' $'\xee\x8e\xad' ;;
200 | 386 | 389 | 392 | 395) printf '%s\n' $'\xee\x8c\x9d' ;;
266 | 293 | 296 | 299 | 302 | 305 | 308 | 356 | 359) printf '%s\n' $'\xee\x8c\x98' ;;
329 | 332 | 335 | 338 | 371) printf '%s\n' $'\xee\x8c\x9a' ;;
*) printf '%s\n' $'\xee\x8c\xbd' ;;
esac
