#!/usr/bin/env bash
# haseen:summary The login screen greetd starts (haseen setup greeter haseen)
# haseen:args [--print-config]
#
# Adapted from DankMaterialShell quickshell/Modules/Greetd/assets/dms-greeter
# (MIT, Copyright (c) 2025 Avenge Media LLC): greetd runs a compositor whose
# only job is to run the greeter shell and quit when it exits. The keyboard
# layout from /etc/vconsole.conf is adapted from Omarchy
# default/sddm/hyprland.lua (MIT, Copyright (c) David Heinemeier Hansson).
#
# This is not a command to run by hand: greetd runs it as the `greeter` user,
# with $GREETD_SOCK in the environment, and the shell authenticates through
# that socket. `haseen setup greeter haseen` points greetd at it.
set -Eeuo pipefail

# shellcheck source=../share/haseen/lib/greeter.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/greeter.sh"

usage() {
    cat <<EOF
Usage: haseen greeter [--print-config]

Started by greetd. --print-config writes the generated Hyprland config to
stdout and exits, which is how the test and a human inspect it.
EOF
}

# The greeter has no login session: no systemd user manager, no XDG runtime dir
# of its own unless greetd made one. Everything it writes goes under its state
# directory, which the setup command creates and chowns.
# Always the state dir, never the greeter user's passwd home (`/` for greetd's
# user): `haseen setup greeter haseen` creates it, owned by greeter, and the
# remembered user and session live there.
export HOME="$GREETER_STATE_DIR"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/haseen-greeter}"
export HASEEN_GREETER=1
# Quickshell renders the greeter in software: the greeter user has no GPU
# session of its own, and a failed GL context here is a machine you cannot log
# into. QT_QUICK_BACKEND is what the shell already uses (architecture 6).
export QT_QUICK_BACKEND=software QT_QPA_PLATFORM=wayland

# greeter_vconsole KEY — KEY's value in /etc/vconsole.conf, read the way
# default/hypr/input.lua reads it: KEY=value lines, the last one wins, a
# surrounding pair of double and then of single quotes is dropped. Fails when
# the file or the key is missing; a key set to nothing is empty.
greeter_vconsole() {
    local file line value="" seen=false v
    file="$(sysroot_path /etc/vconsole.conf)"
    [[ -r $file ]] || return 1
    while IFS= read -r line || [[ -n $line ]]; do
        [[ $line =~ ^[[:space:]]*([A-Za-z0-9_]+)[[:space:]]*=[[:space:]]*(.*)$ ]] || continue
        [[ ${BASH_REMATCH[1]} == "$1" ]] || continue
        v="${BASH_REMATCH[2]}"
        v="${v%"${v##*[![:space:]]}"}"
        [[ $v =~ ^\"(.*)\"$ ]] && v="${BASH_REMATCH[1]}"
        [[ $v =~ ^\'(.*)\'$ ]] && v="${BASH_REMATCH[1]}"
        value="$v"
        seen=true
    done <"$file"
    $seen && printf '%s' "$value"
}

# lua_string TEXT — TEXT as a Lua string literal. vconsole.conf is root's, but
# one stray quote must never turn the login screen's config into a syntax error.
lua_string() {
    local t="${1//\\/\\\\}"
    printf '"%s"' "${t//\"/\\\"}"
}

# The login screen types with the layout the desktop types with:
# default/hypr/input.lua's rule, which the test keeps in step. The greeter runs
# as greetd's user, so the layout comes from /etc/vconsole.conf, never from a
# home; a layout that cannot type Latin letters gets "us" in front, so a
# password typed in Latin still works, with both Alts to switch (plan 103).
greeter_input() {
    local layout variant options="compose:caps" first
    local latin=" us gb de fr es it pt br nl be ch at se no dk fi pl cz sk hu ro tr latam ca ie "
    layout="$(greeter_vconsole XKBLAYOUT)" || layout=us
    variant="$(greeter_vconsole XKBVARIANT)" || variant=""
    first="${layout%%,*}"
    case $latin in
    *" $first "*) ;;
    *)
        layout="us,$layout"
        variant=",$variant"
        options+=",grp:alts_toggle"
        ;;
    esac
    printf '  input = { kb_layout = %s, kb_variant = %s, kb_options = %s },\n' \
        "$(lua_string "$layout")" "$(lua_string "$variant")" "$(lua_string "$options")"
}

# Lua, like haseen's own Hyprland config: Hyprland 0.56 already warns that the
# hyprlang .conf format goes away in 0.57, and a login screen is the last
# place to find that out.
greeter_config() {
    cat <<EOF
-- Generated by haseen-greeter for the login screen; not a user config.
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })
hl.config({
$(greeter_input)
  general = { border_size = 0, gaps_in = 0, gaps_out = 0 },
  decoration = { blur = { enabled = false }, shadow = { enabled = false } },
  animations = { enabled = false },
  misc = { disable_hyprland_logo = true, disable_splash_rendering = true, force_default_wallpaper = 0 },
})
-- The greeter is the whole session: when it exits (greetd launched the user's
-- session, or it failed), the compositor goes with it and greetd takes over.
hl.on("hyprland.start", function()
  hl.exec_cmd("$QS -p $HASEEN_PATH/shell/greeter; hyprctl dispatch 'hl.dsp.exit()'")
end)
EOF
}

QS="$(command -v qs || command -v quickshell || echo qs)"

[[ ${1:-} == --print-config ]] && {
    greeter_config
    exit 0
}
[[ ${1:-} == -h || ${1:-} == --help ]] && {
    usage
    exit 0
}

[[ -n ${GREETD_SOCK:-} ]] || die "no \$GREETD_SOCK: this is started by greetd, not by hand"
require_cmds Hyprland

mkdir -p "$XDG_CONFIG_HOME/hypr" "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true
greeter_config >"$XDG_CONFIG_HOME/hypr/hyprland.lua"

# start-hyprland is Hyprland's watchdog launcher (same package). Started bare,
# Hyprland 0.56 paints a red "started without start-hyprland" banner, which on
# a login screen reads like something is broken.
if have start-hyprland; then
    exec start-hyprland -- -c "$XDG_CONFIG_HOME/hypr/hyprland.lua"
fi
exec Hyprland -c "$XDG_CONFIG_HOME/hypr/hyprland.lua"
