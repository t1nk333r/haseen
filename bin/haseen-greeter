#!/usr/bin/env bash
# haseen:summary The login screen greetd starts (haseen setup greeter haseen)
# haseen:args [--print-config]
#
# Adapted from DankMaterialShell quickshell/Modules/Greetd/assets/dms-greeter
# (MIT, Copyright (c) 2025 Avenge Media LLC): greetd runs a compositor whose
# only job is to run the greeter shell and quit when it exits.
#
# This is not a command to run by hand: greetd runs it as the `greeter` user,
# with $GREETD_SOCK in the environment, and the shell authenticates through
# that socket. `haseen setup greeter haseen` points greetd at it.
set -Eeuo pipefail

# shellcheck source=../share/haseen/lib/greeter.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/greeter.sh"

usage() {
    cat <<EOF
Usage: haseen greeter [--print-config]

Started by greetd. --print-config writes the generated Hyprland config to
stdout and exits, which is how the test and a human inspect it.
EOF
}

# The greeter has no login session: no systemd user manager, no XDG runtime dir
# of its own unless greetd made one. Everything it writes goes under its state
# directory, which the setup command creates and chowns.
export HOME="${HOME:-$GREETER_STATE_DIR}"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/haseen-greeter}"
export HASEEN_GREETER=1
# Quickshell renders the greeter in software: the greeter user has no GPU
# session of its own, and a failed GL context here is a machine you cannot log
# into. QT_QUICK_BACKEND is what the shell already uses (architecture 6).
export QT_QUICK_BACKEND=software QT_QPA_PLATFORM=wayland

greeter_config() {
    cat <<EOF
# Generated by haseen-greeter for the login screen; not a user config.
monitor = , preferred, auto, 1
general { border_size = 0; gaps_in = 0; gaps_out = 0 }
decoration { blur { enabled = false } shadow { enabled = false } }
animations { enabled = false }
misc { disable_hyprland_logo = true; disable_splash_rendering = true; force_default_wallpaper = 0 }
exec-once = $QS -p $HASEEN_PATH/shell/greeter; hyprctl dispatch exit
EOF
}

QS="$(command -v qs || command -v quickshell || echo qs)"

[[ ${1:-} == --print-config ]] && {
    greeter_config
    exit 0
}
[[ ${1:-} == -h || ${1:-} == --help ]] && {
    usage
    exit 0
}

[[ -n ${GREETD_SOCK:-} ]] || die "no \$GREETD_SOCK: this is started by greetd, not by hand"
require_cmds Hyprland

mkdir -p "$XDG_CONFIG_HOME/hypr" "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true
greeter_config >"$XDG_CONFIG_HOME/hypr/hyprland.conf"

exec Hyprland -c "$XDG_CONFIG_HOME/hypr/hyprland.conf"
