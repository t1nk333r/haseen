#!/usr/bin/env bash
# haseen:summary Copy the text in a screen region (OCR with tesseract)
# haseen:args [--geometry "X,Y WxH" | --image FILE] [--lang LANGS] [--print] [--dry-run]
#
# Adapted from Omarchy bin/omarchy-capture-text (MIT, Copyright (c) David
# Heinemeier Hansson): freeze the screen with hyprpicker while slurp picks,
# then grim | tesseract into the clipboard.
#
# The tesseract invocation is not Omarchy's. Measured on rendered Arabic screen
# text (2026-10-05): --oem 1 is mandatory, because the Arabic model ships no
# legacy engine at all ("Tesseract (legacy) engine requested, but components
# are not present"); -l ara+eng is mandatory, because -l ara alone turns
# embedded Latin into garbage, and Arabic UI text is almost always mixed; and
# Omarchy's --dpi 300 is dropped, because it merged words that came out spaced
# correctly without it. Arabic needs extra/tesseract-data-ara installed.
set -Eeuo pipefail

# shellcheck source=../share/haseen/lib/common.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"

usage() {
    cat <<EOF
Usage: haseen capture text [--geometry "X,Y WxH" | --image FILE] [--lang LANGS] [--print] [--dry-run]

Pick a region (or pass one), recognise its text with tesseract and copy it.
--image reads an existing picture instead of the screen. --print also writes
the text to stdout. LANGS defaults to \$HASEEN_OCR_LANGS or ara+eng, which is
what mixed Arabic/English screen text needs.
EOF
}

notify() { have notify-send && notify-send -a haseen "$@" || true; }

parse_common_flags "$@"
set -- "${REST[@]}"
geometry="" image="" lang=${HASEEN_OCR_LANGS:-ara+eng} print=false
while (($#)); do
    case "$1" in
    --geometry | --image | --lang)
        (($# > 1)) || { usage >&2; exit 2; }
        case $1 in --geometry) geometry=$2 ;; --image) image=$2 ;; --lang) lang=$2 ;; esac
        shift
        ;;
    --print) print=true ;;
    *) usage >&2; exit 2 ;;
    esac
    shift
done
[[ -z $image || -r $image ]] || die "cannot read $image"

# One argv, used by the plan and by both real paths, so they cannot drift.
ocr_argv=("${image:-stdin}" stdout --oem 1 --psm 6 -l "$lang" -c preserve_interword_spaces=1)

if $DRY_RUN; then
    src="grim -g ${geometry:-<slurp selection>} -"
    [[ -n $image ]] && src="cat $image"
    echo "DRYRUN: $src | tesseract ${ocr_argv[*]} | wl-copy"
    exit 0
fi
require_cmds tesseract

if [[ -z $image && -z $geometry ]]; then
    # Freeze the screen so the picked content cannot shift under the selection.
    hyprpicker -r -z >/dev/null 2>&1 &
    freeze=$!
    trap 'kill "$freeze" 2>/dev/null || true' EXIT
    sleep 0.1
    geometry="$(slurp 2>/dev/null)" || exit 0
    [[ -n $geometry ]] || exit 0
fi

if [[ -n $image ]]; then
    text="$(tesseract "${ocr_argv[@]}" 2>/dev/null)" || die "OCR failed"
else
    text="$(grim -g "$geometry" - | tesseract "${ocr_argv[@]}" 2>/dev/null)" || die "OCR failed"
fi
if [[ -z ${text//[[:space:]]/} ]]; then
    notify "No text found"
    exit 1
fi
printf '%s' "$text" | wl-copy
$print && printf '%s\n' "$text"
notify "Copied text from the selection"
