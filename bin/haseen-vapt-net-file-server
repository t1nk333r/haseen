#!/usr/bin/env bash
# haseen:summary Serve one selected package-owned file as bytes without executing it
# haseen:args [--dry-run] [--yes] [--file FILE] [--bind ADDRESS] [PORT]
set -Eeuo pipefail
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"
source "$HASEEN_PATH/layers/vapt/workflow_actions.sh"
usage() { echo "Usage: haseen vapt net-file-server [--dry-run] [--yes] [--file FILE] [--bind ADDRESS] [PORT]"; }
parse_common_flags "$@"
vapt_endpoint_action enumeration-host "${REST[@]}"
