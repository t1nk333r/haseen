#!/usr/bin/env bash
# haseen:summary Open LocalSend to receive files
# haseen:args [--dry-run]
#
# Adapted from Omarchy bin/omarchy-menu-share (MIT, Copyright (c) David
# Heinemeier Hansson): hand the files to LocalSend in its own systemd unit, so
# closing the caller does not kill the transfer.
set -Eeuo pipefail

# shellcheck source=../share/haseen/lib/common.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"

usage() {
    cat <<EOF
Usage: haseen share receive [--dry-run]

Starts the LocalSend window (it listens for incoming transfers while open).
Uses the localsend package, or the Flathub app org.localsend.localsend_app.
EOF
}

# localsend_cmd — set LOCALSEND to the LocalSend command line.
localsend_cmd() {
    if have localsend; then
        LOCALSEND=(localsend)
    elif have flatpak && flatpak info org.localsend.localsend_app &>/dev/null; then
        LOCALSEND=(flatpak run org.localsend.localsend_app)
    else
        die "LocalSend is not installed (haseen install package localsend)"
    fi
}

parse_common_flags "$@"
set -- "${REST[@]}"
(($# == 0)) || { usage >&2; exit 2; }
localsend_cmd
run systemd-run --user --quiet --collect "${LOCALSEND[@]}"
