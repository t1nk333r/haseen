#!/usr/bin/env bash
# haseen:summary Create keys, sign the boot chain, enroll with Microsoft + firmware keys
# haseen:args    [--dry-run] [--yes]
set -Eeuo pipefail
# shellcheck source=../share/haseen/lib/common.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"
# shellcheck source=../share/haseen/layers/secureboot/secureboot.sh
source "$HASEEN_PATH/layers/secureboot/secureboot.sh"

usage() {
    cat <<'EOF'
Usage: haseen secureboot setup [--dry-run] [--yes]

The guided Secure Boot flow (docs/architecture.md §8). Needs UEFI firmware in
Setup Mode; otherwise it prints the firmware steps and exits 1.

  1. sbctl create-keys (skipped when keys exist)
  2. sign the boot chain:
       limine        ENABLE_ENROLL_LIMINE_CONFIG=yes, #blake2b on the wallpaper,
                     limine-update, limine-enroll-config, sign Limine and its
                     EFI/BOOT/BOOTX64.EFI fallback
       systemd-boot  sign the loader (and its .signed source), UKIs, kernels
       grub          grub-install --modules=tpm --disable-shim-lock, sign GRUB
                     and the kernels (the weakest path)
  3. sbctl verify: enrollment stops unless every boot-chain file is signed
  4. sbctl enroll-keys --microsoft --firmware-builtin, after you type ENROLL.
     Microsoft's and the firmware's keys are always enrolled: Windows, GPU
     option ROMs and anti-cheat depend on them.

--yes answers the first question only. It never answers the typed ENROLL
confirmation. Run as a normal user: the command reruns itself as root when the
ESP is readable only by root.
EOF
}
parse_common_flags "$@"
((${#REST[@]} == 0)) || {
    usage >&2
    exit 2
}

preflight_all
[[ $FIRMWARE == uefi ]] || die "Secure Boot needs UEFI firmware; this machine booted in legacy BIOS mode. Nothing to do."
case "$HASEEN_DISTRO" in
cachyos | arch | omarchy) ;;
nixos) die "on NixOS, Secure Boot belongs to the flake (lanzaboote), not to this command" ;;
*) die "unsupported distro: $HASEEN_DISTRO" ;;
esac
if [[ $SECUREBOOT_STATE != setup ]]; then
    sb_firmware_steps
    exit 1
fi
SBCTL_VERSION="$(sb_sbctl_version)" || die "sbctl is not installed: run 'haseen layer apply secureboot' first"
sb_version_ge "$SBCTL_VERSION" "$SB_SBCTL_MIN" ||
    die "sbctl $SBCTL_VERSION is too old: before $SB_SBCTL_MIN, --microsoft enrolls only Microsoft's 2011 CAs, which expired in June 2026. Update sbctl, then run setup again."
case "$BOOTLOADER" in
limine)
    sb_limine_tools || die "Limine needs limine-entry-tool (package limine-mkinitcpio-hook): it rewrites limine.conf hashes on every kernel update. Without it the next update leaves the enrolled config stale and Limine panics under Secure Boot."
    def="$(sysroot_path "$SB_LIMINE_DEFAULT")"
    if [[ -r $def ]] && grep -qE '^[[:space:]]*ENABLE_VERIFICATION[[:space:]]*=' "$def" &&
        [[ $(sb_limine_value ENABLE_VERIFICATION) != yes ]]; then
        die "$SB_LIMINE_DEFAULT sets ENABLE_VERIFICATION to something other than yes: Limine would boot kernels without #blake2b and panic under Secure Boot. Set it to yes, then run setup again."
    fi
    ;;
systemd-boot | grub) ;;
*) die "could not detect the bootloader on the ESP (see: haseen doctor)" ;;
esac
sb_reexec_as_root "$(readlink -f "$0")" "$@"

KEYDIR="$(sb_keydir)"
HAVE_KEYS=false
sb_keys_exist && HAVE_KEYS=true

# --- plan --------------------------------------------------------------------
echo "Secure Boot setup: $BOOTLOADER on $ESP_PATH ($HASEEN_DISTRO)"
echo "  firmware:   Setup Mode (keys can be enrolled)"
echo "  sbctl:      $SBCTL_VERSION"
if $HAVE_KEYS; then
    echo "  keys:       present in $KEYDIR (create-keys skipped)"
else
    echo "  keys:       created in $KEYDIR"
fi
echo "  enrollment: your keys + Microsoft's (2011 and 2023 CAs) + the firmware's built-in keys"
$WINDOWS_ON_ESP && echo "  windows:    Boot Manager on the ESP; have the BitLocker recovery key ready ($SB_RECOVERY_URL)"
sb_esp_readable || echo "  note:       the ESP is readable only by root; this dry-run cannot list its files"
if [[ $BOOTLOADER == grub ]]; then
    warn "GRUB is the weakest Secure Boot path: GRUB's own image and the kernels are signed, but grub.cfg, the initramfs and the kernel command line are not verified, so anyone who can write /boot can change them. Limine (config hash enrolled) and systemd-boot (signed UKIs) close that gap."
fi
echo

confirm "Create the keys (if missing) and sign the $BOOTLOADER boot chain now?" ||
    die "cancelled; nothing changed"

# --- 1. keys -----------------------------------------------------------------
info "step 1/4: keys"
if $HAVE_KEYS; then
    info "keys exist in $KEYDIR; create-keys skipped"
else
    sb_root sbctl create-keys
fi

# --- 2. sign -----------------------------------------------------------------
info "step 2/4: sign the $BOOTLOADER boot chain"
case "$BOOTLOADER" in
limine)
    if [[ $(sb_limine_value ENABLE_VERIFICATION) != yes ]]; then
        printf '%s\n' "# haseen secureboot: limine-entry-tool appends #blake2b to every path it writes." \
            "ENABLE_VERIFICATION=yes" | write_root_file "$SB_LIMINE_DROPIN" 0644
    fi
    if [[ $(sb_limine_value ENABLE_ENROLL_LIMINE_CONFIG) != yes ]]; then
        # limine-entry-tool reads this key only from /etc/default/limine: its
        # load_config resets it after the limine-entry-tool.d drop-ins.
        printf '\n%s\n%s\n' "# haseen secureboot: enroll limine.conf's hash into the Limine binary (see haseen secureboot status)." \
            "ENABLE_ENROLL_LIMINE_CONFIG=yes" | append_root_file "$SB_LIMINE_DEFAULT"
    fi
    sb_limine_assets || true
    # Rebuilds initramfs/UKIs (mkinitcpio's sbctl hook signs UKIs before they
    # are hashed), rewrites the entries with #blake2b, deploys Limine and runs
    # the post hooks that enroll the config and sign the binary.
    sb_root limine-update
    sb_root limine-enroll-config
    if main="$(sb_limine_main)"; then
        :
    elif $DRY_RUN || ! sb_esp_readable; then
        main="$ESP_PATH/EFI/limine/limine_x64.efi"
    else
        die "no Limine binary in $ESP_PATH/EFI/limine/ after limine-update; the keys were NOT enrolled"
    fi
    sb_root sbctl sign -s "$main"
    sb_limine_refresh_fallback force
    sb_root sbctl sign-all
    ;;
systemd-boot)
    # bootctl update and systemd-boot-update.service install the .signed
    # variant when it exists, so loader updates arrive signed.
    if [[ -f $(sysroot_path "$SB_SDBOOT_SRC") ]]; then
        sb_root sbctl sign -s -o "$SB_SDBOOT_SRC.signed" "$SB_SDBOOT_SRC"
    fi
    sb_esp_readable || echo "    (the loader, UKIs and entry kernels on $ESP_PATH are signed with sbctl sign -s when this runs)"
    sb_track_chain
    sb_root sbctl sign-all
    ;;
grub)
    # CachyOS wiki, "Secure Boot Setup" → GRUB: embed tpm, drop the shim lock.
    if gid="$(sb_grub_id)"; then
        :
    elif sb_esp_readable; then
        die "no EFI/<id>/grubx64.efi on $ESP_PATH: install GRUB for UEFI first"
    else
        gid="<id of EFI/<id>/grubx64.efi>"
    fi
    sb_root grub-install --target=x86_64-efi --efi-directory="$ESP_PATH" --bootloader-id="$gid" --modules=tpm --disable-shim-lock
    sb_esp_readable || echo "    (grubx64.efi and /boot/vmlinuz-* are signed with sbctl sign -s when this runs)"
    sb_track_chain
    sb_root sbctl sign-all
    ;;
esac

# --- 3. verify ---------------------------------------------------------------
info "step 3/4: verify"
if $DRY_RUN; then
    sb_root sbctl verify --json
    if [[ $BOOTLOADER == limine ]]; then
        echo "    (stops here unless every boot-chain file is signed and Limine's config is enrolled with every path hashed)"
    else
        echo "    (stops here unless every boot-chain file is signed)"
    fi
else
    json="$(sb_root sbctl verify --json)" || die "sbctl verify failed; keys were NOT enrolled"
    sb_classify_verify "$json"
    blockers=("${SB_BLOCKERS[@]}")
    if [[ $BOOTLOADER == limine ]]; then
        while IFS= read -r l; do
            case "$l" in
            blocker:*) blockers+=("${l#blocker: }") ;;
            note:*) warn "${l#note: }" ;;
            esac
        done < <(sb_limine_problems)
    fi
    for l in "${SB_NOTES[@]}"; do warn "$l"; done
    if ((${#blockers[@]} > 0)); then
        printf '  not ready: %s\n' "${blockers[@]}" >&2
        die "the boot chain is not ready, so the keys were NOT enrolled. Fix the files above, then run haseen secureboot setup again."
    fi
    info "boot chain verified: $SB_SIGNED signed file(s)"
fi

# --- 4. enroll ---------------------------------------------------------------
info "step 4/4: enroll"
if $WINDOWS_ON_ESP || sb_bitlocker_present; then
    sb_warn_bitlocker
fi
sb_warn_tpm
cat <<'EOF'

Enrolling writes your keys, Microsoft's and the firmware's built-in keys into
the firmware (PK, KEK, db) and ends Setup Mode. Only the firmware menu can undo it.
EOF
confirm_typed "Enroll the keys now?" ENROLL ||
    die "not confirmed: the keys were NOT enrolled. The boot chain stays signed; run haseen secureboot setup again when ready."
sb_root sbctl enroll-keys --microsoft --firmware-builtin

if $DRY_RUN; then
    printf '\nAfter enrollment Secure Boot is still off; turn it on in the firmware:\n'
else
    printf '\nKeys enrolled. Secure Boot is still off; turn it on in the firmware:\n'
fi
cat <<'EOF'
  1. systemctl reboot --firmware-setup
  2. Enable Secure Boot. ASUS: OS Type "Windows UEFI mode", Secure Boot Mode
     "Custom". Save and exit.
  3. Back in this system:  haseen secureboot status   (expect: enabled, signed)
If the firmware reports a Secure Boot violation, disable Secure Boot again in
the same menu; nothing else needs undoing.
EOF
