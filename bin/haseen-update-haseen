#!/usr/bin/env bash
# haseen:summary Install the latest haseen and reload the desktop
# haseen:args [--source DIR] [--check] [--tree-only] [--no-reload] [--force] [--dry-run]
#
# `haseen update haseen` (plan 134): pulling a checkout changes nothing on
# screen — the compositor and the shell read the installed tree — so this does
# the whole step at once: fetch, move the checkout to the new commit, run its
# install.sh, then reload Hyprland (binds, rules, look) and restart the shell.
# It is what the owner did by hand for SUPER + O on 2026-10-26, turned into one
# command.
#
# The checkout is haseen's own copy of the repository (lib/self-update.sh,
# plan 182), unless --source or $HASEEN_SOURCE names one of your own.
# `haseen update` runs this first, then the packages.
set -Eeuo pipefail
# shellcheck source=../share/haseen/lib/common.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"
# shellcheck source=../share/haseen/lib/terminal.sh
source "$HASEEN_PATH/lib/terminal.sh"
# shellcheck source=../share/haseen/lib/install-stamp.sh
source "$HASEEN_PATH/lib/install-stamp.sh"
# shellcheck source=../share/haseen/lib/self-update.sh
source "$HASEEN_PATH/lib/self-update.sh"

usage() {
    cat <<EOF
Usage: haseen update haseen [--source DIR] [--prefix DIR] [--check]
                            [--tree-only] [--no-reload] [--force] [--dry-run]

Brings the running desktop to the latest haseen: fetch haseen's own copy of
the repository ($(self_update_dir), cloned the first time, following
$SELF_UPDATE_BRANCH of $SELF_UPDATE_REMOTE), run its install.sh --yes, then
reload Hyprland and restart the shell. An installed tree newer than the
branch is left alone. 'haseen update' runs this first, then the packages.

  --source DIR   install a checkout of your own instead (also \$HASEEN_SOURCE):
                 it is fetched and fast-forwarded, never over uncommitted
                 changes
  --prefix DIR   the install prefix (default: the running tree's own, else
                 the prefix an install stamp names, else /usr/local)
  --check        report the commit to install, the installed one and whether
                 an update is available; fetches, installs nothing
  --tree-only    install bin/ and share/ only: no layers, no migrations, no
                 package work — a fast refresh for shell and keybind changes
  --no-reload    install and stop; the next session picks up the new tree
  --force        install even when the installed stamp names this commit or
                 a newer one

It needs sudo for the install, so started without a terminal (the menu) it
opens a floating one first.
EOF
}

# --check is a report: it opens no terminal.
open_terminal=true
for a in "$@"; do
    if [[ $a == --check ]]; then
        open_terminal=false
    fi
done
if $open_terminal; then
    in_floating_terminal "$@"
fi
parse_common_flags "$@"
set -- "${REST[@]}"

want_source="" want_prefix="" check=false tree_only=false do_reload=true force=false
while (($#)); do
    case $1 in
    --source)
        (($# >= 2)) || {
            usage >&2
            exit 2
        }
        want_source=$2
        shift
        ;;
    --prefix)
        (($# >= 2)) || {
            usage >&2
            exit 2
        }
        want_prefix=$2
        shift
        ;;
    --check) check=true ;;
    --tree-only) tree_only=true ;;
    --no-reload) do_reload=false ;;
    --force) force=true ;;
    *)
        usage >&2
        exit 2
        ;;
    esac
    shift
done
require_not_root
require_cmds git

prefix="$(self_update_prefix "$want_prefix")"
installed_commit="$(install_stamp_get "$prefix" commit || true)"
installed_version="$(install_stamp_get "$prefix" version || true)"
installed_at="$(install_stamp_get "$prefix" date || true)"

# The checkout to install: --source, else $HASEEN_SOURCE, else haseen's own
# copy. ~/.config/haseen/source (the checkout `haseen bar edit` writes to) is
# not read here: a developer's checkout, dirty or on a topic branch, kept
# updates from installing main on IO and luna (owner, 2026-11-21, plan 182).
src="${want_source:-${HASEEN_SOURCE:-}}"
src="${src%/}"
if [[ -z $src ]]; then
    src="$(self_update_dir)"
    rc=0
    self_update_fetch || rc=$?
    if ((rc == 3)); then
        info "haseen's copy is cloned on the first real run; there is nothing to compare yet"
        exit 0
    fi
    ((rc == 0)) || exit "$rc"
    target="$(git -C "$src" rev-parse --short "$SELF_UPDATE_REF")"
    relation="$(self_update_relation "$src" "$installed_commit" "$target" "$installed_at")"

    if $check; then
        printf 'source     %s (haseen'"'"'s copy of %s %s)\n' "$src" "$SELF_UPDATE_REMOTE" "$SELF_UPDATE_BRANCH"
        printf 'latest     %s (%s)\n' "$target" "$(git -C "$src" show -s --format=%cs "$target")"
        if [[ -n $installed_commit ]]; then
            printf 'installed  %s (%s)\n' "$installed_commit" "${installed_version:-unknown}"
        else
            printf 'installed  unknown: no install stamp under %s\n' "$prefix"
        fi
        case $relation in
        same) printf 'update     none: the installed tree is the latest\n' ;;
        ahead) printf 'update     none: the installed tree is newer than %s\n' "$SELF_UPDATE_REF" ;;
        local)
            printf 'update     none: the installed tree is not on %s but was installed after its latest commit\n' \
                "$SELF_UPDATE_REF"
            ;;
        behind)
            printf 'update     available: %s new commit(s)\n' \
                "$(self_update_new_commits "$src" "$installed_commit" "$target" | grep -c .)"
            ;;
        *) printf 'update     available: the installed tree is not on %s\n' "$SELF_UPDATE_REF" ;;
        esac
        exit 0
    fi

    if [[ $relation == ahead ]] && ! $force; then
        info "the installed tree ($installed_commit) is newer than $SELF_UPDATE_REF ($target); leaving it (--force installs $target)"
        exit 0
    fi
    if [[ $relation == local ]] && ! $force; then
        info "the installed tree ($installed_commit) is not on $SELF_UPDATE_REF but was installed after its latest commit ($target); leaving it until $SELF_UPDATE_BRANCH moves on (--force installs $target)"
        exit 0
    fi
    # Compared as commits, not as text: a stamp written from another clone
    # may abbreviate the same commit to more characters.
    if [[ $relation == same ]] && ! $force; then
        info "haseen ${installed_version:-} ($installed_commit) is already installed under $prefix"
        exit 0
    fi
    if $DRY_RUN; then
        echo "DRYRUN: git -C $src checkout --quiet --detach $SELF_UPDATE_REF"
    else
        self_update_checkout
    fi
else
    [[ -d $src ]] || die "not a directory: $src"
    [[ -x $src/install.sh && -f $src/share/haseen/VERSION ]] ||
        die "not a haseen checkout: $src (install.sh and share/haseen/VERSION are required)"
    git -C "$src" rev-parse --git-dir >/dev/null 2>&1 ||
        die "$src is not a git checkout; haseen update pulls from one"
    upstream="$(git -C "$src" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
    [[ -n $upstream ]] ||
        die "$src has no upstream branch: set one with: git -C $src branch --set-upstream-to=origin/main"
    remote="${upstream%%/*}"

    # Uncommitted work is the owner's: a fast-forward over it would either
    # fail halfway or, worse, look like it worked.
    dirty="$(git -C "$src" status --porcelain --untracked-files=no)"
    [[ -z $dirty ]] ||
        die "the checkout has uncommitted changes; commit or stash them first (first: $(head -n1 <<<"$dirty"))"

    run git -C "$src" fetch --quiet "$remote"
    checkout_commit="$(git -C "$src" rev-parse --short HEAD)"
    upstream_commit="$(git -C "$src" rev-parse --short "$upstream")"
    behind="$(git -C "$src" rev-list --count "HEAD..$upstream")"
    # A checkout left on a topic branch pulls only that branch, and a branch
    # whose pull request was squash-merged never moves again: luna stayed on
    # compat/summon-answers at 5944f3e while main went on (owner, 2026-10-31,
    # plan 147). Installing a branch under test is legitimate (plan 136), so
    # this warns rather than refuses, and only when the remote names its
    # default branch and that branch has commits the checkout lacks.
    default_branch="$(git -C "$src" symbolic-ref --quiet --short "refs/remotes/$remote/HEAD" 2>/dev/null || true)"
    if [[ -n $default_branch && $default_branch != "$upstream" ]]; then
        ahead="$(git -C "$src" rev-list --count "HEAD..$default_branch" 2>/dev/null || true)"
        if [[ $ahead =~ ^[0-9]+$ ]] && ((ahead > 0)); then
            warn "the checkout follows $upstream, not $default_branch ($ahead commit(s) there are not in this checkout); to follow it: git -C $src switch ${default_branch#"$remote"/}"
        fi
    fi

    if $check; then
        printf 'source     %s\n' "$src"
        printf 'branch     %s, %s commit(s) to pull\n' "$upstream" "$behind"
        printf 'checkout   %s (%s)\n' "$checkout_commit" "$(install_build_version "$src")"
        if [[ -n $installed_commit ]]; then
            printf 'installed  %s (%s)\n' "$installed_commit" "${installed_version:-unknown}"
        else
            printf 'installed  unknown: no install stamp under %s\n' "$prefix"
        fi
        if ((behind > 0)); then
            printf 'update     available: %s commit(s) to pull, then install\n' "$behind"
        elif [[ $installed_commit == "$upstream_commit" ]]; then
            printf 'update     none: the installed tree is this commit\n'
        else
            printf 'update     the checkout is current; the installed tree is not (%s --force to install it)\n' \
                "haseen update haseen"
        fi
        exit 0
    fi

    # What the checkout will be at: the upstream after a fast-forward, else
    # its own commit (work not pushed yet).
    target=$checkout_commit
    ((behind > 0)) && target=$upstream_commit
    if [[ $(self_update_relation "$src" "$installed_commit" "$target" "$installed_at") == ahead ]] && ! $force; then
        info "the installed tree ($installed_commit) is newer than $src ($target); leaving it (--force installs $target)"
        exit 0
    fi

    if ((behind > 0)); then
        info "pulling $behind commit(s) into $src"
        run git -C "$src" merge --ff-only --quiet "$upstream"
    else
        info "the checkout is already at $upstream_commit"
    fi
fi

commit="$(git -C "$src" rev-parse --short HEAD)"
$DRY_RUN && commit=$target
version="$(install_build_version "$src")"

# The stamp is what the last install wrote; a tree installed before haseen
# knew about stamps has none, and that is never taken as current.
if ! $force && [[ -n $installed_commit && $installed_commit == "$commit" ]]; then
    info "haseen $version ($commit) is already installed under $prefix"
    exit 0
fi

install_args=(--yes --prefix "$prefix")
if $tree_only; then
    install_args+=(--tree-only)
fi
info "installing $src ($version, $commit) under $prefix"
if $DRY_RUN; then
    echo "DRYRUN: (cd $src && ./install.sh ${install_args[*]})"
else
    (cd "$src" && ./install.sh "${install_args[@]}")
fi

if ! $do_reload; then
    info "not reloading (--no-reload): the next session picks up the new tree"
    exit 0
fi
self_update_reload_desktop
