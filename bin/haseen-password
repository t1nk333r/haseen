#!/usr/bin/env bash
# haseen:summary Change your login password or the disk-encryption (LUKS) passphrase
# haseen:args <user|drive> [--dry-run]
#
# The drive flow follows omarchy bin/omarchy-drive-password (MIT, Copyright
# (c) David Heinemeier Hansson), narrowed to the device that holds / and put
# behind a typed confirmation.
set -Eeuo pipefail
# shellcheck source=../share/haseen/lib/terminal.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/terminal.sh"

CONFIRM_WORD=CHANGE

usage() {
    cat <<EOF
Usage: haseen password user [--dry-run]
       haseen password drive [--dry-run]

user    runs passwd for $USER
drive   changes a passphrase of the LUKS volume that holds / (found through
        /proc/self/mountinfo and /sys/block, LVM-on-LUKS included). cryptsetup
        asks for the current passphrase and the new one twice. You must type
        $CONFIRM_WORD first; --yes does not skip that.

Started without a terminal (menu), it opens a floating one.
EOF
}

in_floating_terminal "$@"
parse_common_flags "$@"
set -- "${REST[@]}"
(($# == 1)) || {
    usage >&2
    exit 2
}

# root_source — the device mounted on / (the last mount there wins).
root_source() {
    awk '$5 == "/" { for (i = 7; $i != "-"; i++) {}; src = $(i + 2) } END { if (src) print src }' \
        "$(sysroot_path /proc/self/mountinfo)"
}

# dm_node SOURCE — the dm-N name behind /dev/mapper/NAME or /dev/dm-N.
dm_node() {
    local src="$1" d
    case "$src" in
    /dev/dm-*) printf '%s\n' "${src#/dev/}" ;;
    /dev/mapper/*)
        for d in "$(sysroot_path /sys/block)"/dm-*; do
            [[ -r $d/dm/name && $(<"$d/dm/name") == "${src#/dev/mapper/}" ]] || continue
            basename "$d"
            return 0
        done
        ;;
    esac
}

# luks_backing DM — "LUKSn /dev/<partition>" for the LUKS container under DM,
# following LVM and other dm layers down through slaves/.
luks_backing() {
    local dm="$1" depth="${2:-0}" uuid s
    ((depth < 6)) || return 1
    local sys
    sys="$(sysroot_path /sys/block)/$dm"
    [[ -r $sys/dm/uuid ]] || return 1
    uuid="$(<"$sys/dm/uuid")"
    if [[ $uuid =~ ^CRYPT-(LUKS[12])- ]]; then
        for s in "$sys"/slaves/*; do
            [[ -e $s ]] || continue
            printf '%s /dev/%s\n' "${BASH_REMATCH[1]}" "$(basename "$s")"
            return 0
        done
        return 1
    fi
    for s in "$sys"/slaves/dm-*; do
        [[ -e $s ]] || continue
        luks_backing "$(basename "$s")" $((depth + 1)) && return 0
    done
    return 1
}

change_drive() {
    local src dm found version dev
    src="$(root_source)"
    [[ -n $src ]] || die "cannot find the root filesystem in /proc/self/mountinfo"
    dm="$(dm_node "$src")"
    [[ -n $dm ]] || die "/ is on $src, which is not a device-mapper volume: no disk encryption to change"
    found="$(luks_backing "$dm")" || die "/ is on $src, which is not inside a LUKS container"
    read -r version dev <<<"$found"

    cat <<EOF

  Disk-encryption passphrase for $dev ($version, holds / via $src)

  - You will type the CURRENT passphrase, then the new one twice.
  - Only the key slot that matches the current passphrase changes. Other
    passphrases, recovery keys and TPM2/FIDO2 tokens stay as they are.
  - If you forget the new passphrase and have no other key slot, the data
    on this disk is gone for good. Write it down before you continue.
  - A header backup protects against slot damage:
      cryptsetup luksHeaderBackup $dev --header-backup-file <file on another disk>   (as root)

EOF
    confirm_typed "Change the passphrase of $dev?" "$CONFIRM_WORD" ||
        die "not confirmed; nothing was changed"
    local opts=(--verify-passphrase)
    # Argon2id is LUKS2-only; LUKS1 keeps its PBKDF2 slot type.
    [[ $version == LUKS2 ]] && opts+=(--pbkdf argon2id)
    run_root cryptsetup luksChangeKey "${opts[@]}" "$dev"
    $DRY_RUN || info "passphrase changed for $dev"
}

case "$1" in
user)
    require_not_root
    run passwd
    ;;
drive)
    require_not_root
    change_drive
    ;;
*)
    usage >&2
    exit 2
    ;;
esac
