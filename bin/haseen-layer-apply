#!/usr/bin/env bash
# haseen:summary Apply layers (and what they require); idempotent
# haseen:args    <layer...> [--dry-run] [--yes] [-- layer args]
set -Eeuo pipefail
# shellcheck source=../share/haseen/lib/layers.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/layers.sh"
BIN_DIR="$(dirname "$(readlink -f "$0")")"

usage() {
    cat <<EOF
Usage: haseen layer apply <layer...> [--dry-run] [--yes] [-- ARGS]

ARGS after -- go to the last named layer only (e.g. its own flags):
  haseen layer apply ai -- --backend llama.cpp
Required layers are applied first. Run 'haseen layer list' for names.
After each layer it applies, the layer-applied hooks run with the layer's
name (haseen hook install layer-applied SCRIPT).
EOF
}

layers=()
layer_args=()
while (($# > 0)); do
    case "$1" in
    --) shift; layer_args=("$@"); break ;;
    --dry-run) DRY_RUN=true ;;
    --yes | -y) ASSUME_YES=true ;;
    -h | --help) usage; exit 0 ;;
    -*) die "unknown flag: $1 (layer flags go after --)" ;;
    *) layers+=("$1") ;;
    esac
    shift
done
((${#layers[@]} > 0)) || { usage >&2; exit 2; }
require_not_root

mapfile -t order < <(resolve_layers "${layers[@]}")
((${#order[@]} > 0)) || exit 1
check_conflicts "${order[@]}"

last="${layers[-1]}"
info "apply order: ${order[*]}"
# Read by pkg_install_omarchy: a dry run plans omarchy: entries from a repo an
# earlier layer of this run would have enabled.
export HASEEN_APPLY_LAYERS="${order[*]}"
for n in "${order[@]}"; do
    if [[ $n != "$last" ]] && layer_is_applied "$n" && [[ ! " ${layers[*]} " == *" $n "* ]]; then
        info "layer $n already applied; skipping (re-apply explicitly to refresh)"
        continue
    fi
    if [[ $n == "$last" ]]; then
        layer_run_apply "$n" "${layer_args[@]}"
    else
        layer_run_apply "$n"
    fi
    # The layer-applied hooks (architecture 7), once for each layer this run
    # applied, with its name; a failing hook is reported, never fatal (plan 200).
    run "$BIN_DIR/haseen-hook" run layer-applied "$n"
done
