#!/usr/bin/env bash
# haseen:summary Update the system (pacman, AUR, Flatpak) or the firmware (fwupd)
# haseen:args [system|firmware] [--dry-run] [--yes]
#
# Firmware steps adapted from omarchy bin/omarchy-update-firmware (MIT,
# Copyright (c) David Heinemeier Hansson). The pacman scope and the cold AUR
# phase are adapted from omarchy bin/omarchy-update-pacman and
# bin/omarchy-update (MIT, same notice), plan 103.
set -Eeuo pipefail
# shellcheck source=../share/haseen/lib/catalog.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/catalog.sh"
# shellcheck source=../share/haseen/lib/preflight.sh
source "$HASEEN_PATH/lib/preflight.sh"
# shellcheck source=../share/haseen/lib/branding.sh
source "$HASEEN_PATH/lib/branding.sh"

FWUPD_EFI=/usr/lib/fwupd/efi/fwupdx64.efi

usage() {
    cat <<EOF
Usage: haseen update [system|firmware] [--dry-run] [--yes]

  system     (default) pacman -Syu as root, then AUR packages with paru/yay
             (-Sua), then 'flatpak update' for the user and, when it holds
             apps, the system installation. Runs the post-update hooks.
             pacman runs in its own systemd scope, so a session that ends
             mid-upgrade cannot kill it; the AUR builds start with sudo's
             cached password dropped, and every sudo they run asks again.
  firmware   fwupdmgr refresh + update (installs fwupd first if missing).
             With Secure Boot on and sbctl keys, signs fwupd's EFI helper so
             UEFI capsule updates still boot.

Started without a terminal (menu), it opens a floating one.
EOF
}

in_floating_terminal "$@"
parse_common_flags "$@"
((${#REST[@]} <= 1)) || {
    usage >&2
    exit 2
}
require_not_root
what="${REST[0]:-system}"

# The update opens on haseen's name: the selected mark's terminal logo (the
# one `haseen about` and the screensaver show) when a person watches the
# terminal, then one line naming the update. The logo is decoration: a
# missing file must never stop an update before it starts (plan 060).
banner() {
    local logo
    logo="$(branding_file logo)"
    if [[ -t 1 && -r $logo ]] && ! $DRY_RUN; then
        cat "$logo"
        echo
    fi
    info "haseen update: $what"
}

update_system() {
    local yes=()
    $ASSUME_YES && yes=(--noconfirm)
    info "official repositories"
    # On a machine that still has the omarchy package, its pre-transaction hook
    # (00-omarchy-update-guard.hook) aborts every `pacman -Syu` that does not
    # come from `omarchy update`. haseen update is the update path here, so it
    # says so with the variable the guard reads; nothing else changes.
    local guard=()
    [[ -e $(sysroot_path /usr/share/libalpm/hooks/00-omarchy-update-guard.hook) ]] &&
        guard=(env OMARCHY_ALLOW_DIRECT_PACMAN=1)
    # Upgrading systemd re-executes the system manager and every user manager
    # mid-transaction; a pacman inside the desktop session's cgroup can be
    # killed by that, or by a logout, halfway through. A scope of PID 1's keeps
    # it out of the session and survives the manager's own re-exec. The scope
    # runs pacman as its own child, so the guard's variable still reaches it.
    local scope=()
    local systemd
    systemd="$(sysroot_path /run/systemd/system)"
    [[ -d $systemd && ! -L $systemd ]] && scope=(systemd-run --scope --quiet --collect)
    run_root "${guard[@]}" "${scope[@]}" pacman -Syu "${yes[@]}"

    local helper
    helper="$(aur_helper)"
    if [[ -n $helper ]]; then
        info "AUR ($helper)"
        # A PKGBUILD is code from whoever maintains it, and pacman's step just
        # left sudo's timestamp warm. run_cold drops it and makes every sudo
        # the build runs ask afresh; the helper is told to use the `sudo` on
        # PATH (whatever its config names) and not to keep sudo alive in a
        # loop, which with nothing cached would only prompt again and again.
        local cold=(--sudo sudo)
        case $helper in
        paru) cold+=(--nosudoloop) ;;
        yay) cold+=(--sudoloop=false) ;;
        esac
        run_cold "$helper" "${cold[@]}" -Sua "${yes[@]}"
    fi

    if have flatpak || $DRY_RUN; then
        local fyes=()
        $ASSUME_YES && fyes=(-y)
        info "Flatpak"
        run flatpak update --user "${fyes[@]}"
        if compgen -G "$(sysroot_path /var/lib/flatpak/app)/*" >/dev/null; then
            run flatpak update --system "${fyes[@]}"
        fi
    fi

    local hook=(run post-update)
    $DRY_RUN && hook+=(--dry-run)
    "$HASEEN_EXE" hook "${hook[@]}"
}

update_firmware() {
    have fwupdmgr || pkg_install fwupd
    preflight_firmware
    if [[ $FIRMWARE == uefi && $SECUREBOOT_STATE == enabled ]] && have sbctl &&
        [[ -e $(sysroot_path "$FWUPD_EFI") && ! -e $(sysroot_path "$FWUPD_EFI.signed") ]]; then
        # fwupd boots fwupdx64.efi.signed when it exists; with haseen's own
        # Secure Boot keys the unsigned helper would be refused at reboot.
        run_root sbctl sign -s -o "$FWUPD_EFI.signed" "$FWUPD_EFI"
    fi
    run fwupdmgr refresh --force
    run fwupdmgr get-updates || {
        info "no firmware updates (or none for this hardware)"
        return 0
    }
    run_root fwupdmgr update
}

case "$what" in
system)
    banner
    update_system
    ;;
firmware)
    banner
    update_firmware
    ;;
*)
    usage >&2
    exit 2
    ;;
esac
