#!/usr/bin/env bash
# haseen:summary Set up fingerprint login, sudo and lock screen (fprintd), then enroll a finger
# haseen:args [--dry-run] [--yes]
#
# Steps adapted from Omarchy bin/omarchy-setup-security-fingerprint (MIT,
# Copyright (c) David Heinemeier Hansson).
set -Eeuo pipefail
# shellcheck source=../share/haseen/lib/common.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"
# shellcheck source=../share/haseen/lib/terminal.sh
source "$HASEEN_PATH/lib/terminal.sh"

PAM_LINE="auth      sufficient pam_fprintd.so"
PAM_FILES=(/etc/pam.d/sudo /etc/pam.d/polkit-1 /etc/pam.d/hyprlock)
# The lock screen (haseen.lock) runs this service next to its password field.
# A file of its own, so haseen does not depend on Omarchy's
# omarchy-lock-fingerprint, and pam_fprintd is `required`: the password is
# checked separately (the `login` service), never through this stack.
LOCK_PAM=/etc/pam.d/haseen-lock-fingerprint

lock_pam() {
    cat <<'EOF'
#%PAM-1.0
# haseen lock screen, fingerprint only (written by haseen setup fingerprint)
auth       required                    pam_fprintd.so
account    include                     system-local-login
EOF
}

usage() {
    cat <<EOF
Usage: haseen setup fingerprint [--dry-run] [--yes]

Installs fprintd, puts "$PAM_LINE" first in
${PAM_FILES[*]} (those that exist), writes the lock screen's
fingerprint service $LOCK_PAM, then runs fprintd-enroll (skipped when
a finger is already enrolled; run fprintd-enroll yourself to add another) and
fprintd-verify. Runs in a floating terminal when started from the menu.
EOF
}

# pam_prepend FILE LINE — FILE with LINE inserted before its first rule.
pam_prepend() {
    local src
    src="$(sysroot_path "$1")"
    [[ -r $src ]] || return 0
    grep -qF "${2##* }" "$src" && return 0
    awk -v line="$2" '!done && /^[[:space:]]*[a-z-]+[[:space:]]/ && !/^[[:space:]]*#/ { print line; done = 1 } { print } END { if (!done) print line }' "$src" | write_root_file "$1" 0644
}

# finger_enrolled — fprintd lists one " - #0: right-index-finger" line per
# enrolled finger ("has no fingers enrolled" otherwise). A live D-Bus probe,
# so never against a fixture tree.
finger_enrolled() {
    ! in_sysroot && have fprintd-list &&
        fprintd-list "${USER:-$(id -un)}" 2>/dev/null | grep -qE '^[[:space:]]*-[[:space:]]*#[0-9]+:'
}

in_floating_terminal "$@"
parse_common_flags "$@"
((${#REST[@]} == 0)) || {
    usage >&2
    exit 2
}
require_not_root

if ! $DRY_RUN && ! in_sysroot && have lsusb && ! lsusb 2>/dev/null | grep -qiE 'fingerprint|synaptics|goodix|elan|validity|egis|focaltech'; then
    warn "no fingerprint reader recognised on USB; continuing anyway"
fi
confirm "Enable fingerprint authentication for sudo, polkit and the lock screen?" || exit 1
[[ -x $(sysroot_path /usr/bin/fprintd-enroll) ]] || run_root pacman -S --needed --noconfirm fprintd
for f in "${PAM_FILES[@]}"; do
    pam_prepend "$f" "$PAM_LINE"
done
if [[ "$(cat "$(sysroot_path "$LOCK_PAM")" 2>/dev/null)" != "$(lock_pam)" ]]; then
    lock_pam | write_root_file "$LOCK_PAM" 0644
fi
if finger_enrolled; then
    info "a finger is already enrolled; skipping fprintd-enroll"
else
    run fprintd-enroll
fi
run fprintd-verify
info "fingerprint set up; the lock screen offers it from the next lock"
