#!/usr/bin/env bash
# haseen:summary Print what haseen detects about this machine, then layer health
set -Eeuo pipefail
# shellcheck source=../share/haseen/lib/layers.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/layers.sh"
# shellcheck source=../share/haseen/lib/doctor.sh
source "$HASEEN_PATH/lib/doctor.sh"

usage() { echo "Usage: haseen doctor"; }
parse_common_flags "$@"

printf 'haseen %s (%s)\n' "$(haseen_version)" "$HASEEN_PATH"
preflight_all
preflight_report

# The running haseen shell's memory: the budget in docs/architecture.md §6.
if ! in_sysroot; then
    shell_dir="$(readlink -f -- "$HASEEN_PATH/shell")"
    shell_seen=false
    for pid in $(pgrep -u "$EUID" -x 'qs|quickshell' || true); do
        if ! doctor_shell_cmdline_matches "$shell_dir" "/proc/$pid/cwd" "/proc/$pid/cmdline"; then
            continue
        fi
        rss="$(sed -n 's/^Rss: *\([0-9]*\) kB/\1/p' "/proc/$pid/smaps_rollup")"
        pss="$(sed -n 's/^Pss: *\([0-9]*\) kB/\1/p' "/proc/$pid/smaps_rollup")"
        printf 'shell=pid %s rss=%s MiB pss=%s MiB (budget < 200 MiB rss)\n' "$pid" "$((rss / 1024))" "$((pss / 1024))"
        shell_seen=true
    done
    $shell_seen || echo "shell=not running"

    # Omarchy's command names reach haseen only while haseen's links come
    # first on PATH (plan 093); an Omarchy shell running beside haseen's is a
    # second bar.
    omarchy_cmd="$(type -P omarchy-launch-shell || true)"
    if [[ -z $omarchy_cmd ]]; then
        echo "omarchy commands=not installed (./install.sh links them into PREFIX/bin)"
    elif [[ $(readlink -f -- "$omarchy_cmd") == "$(readlink -f -- "$HASEEN_PATH/omarchy/bin/omarchy-launch-shell")" ]]; then
        echo "omarchy commands=haseen's ($omarchy_cmd)"
    else
        echo "omarchy commands=Omarchy's come first on PATH ($omarchy_cmd): put haseen's PREFIX/bin before it"
    fi
    # shellcheck source=../share/haseen/omarchy/lib.sh
    omarchy_pids="$(source "$HASEEN_PATH/omarchy/lib.sh" && omarchy_shell_pids | paste -sd' ')"
    [[ -z $omarchy_pids ]] || echo "omarchy shell=running beside haseen's (pid $omarchy_pids): omarchy-restart-shell stops it"
fi
echo
exec "$(dirname "$(readlink -f "$0")")/haseen-layer-status"
