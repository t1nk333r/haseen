#!/usr/bin/env bash
# haseen:summary Print what haseen detects about this machine, then layer health
set -Eeuo pipefail
# shellcheck source=../share/haseen/lib/layers.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/layers.sh"
# shellcheck source=../share/haseen/lib/doctor.sh
source "$HASEEN_PATH/lib/doctor.sh"
# shellcheck source=../share/haseen/lib/omarchy-guard.sh
source "$HASEEN_PATH/lib/omarchy-guard.sh"

usage() { echo "Usage: haseen doctor"; }
parse_common_flags "$@"

printf 'haseen %s (%s)\n' "$(haseen_version)" "$HASEEN_PATH"
preflight_all
preflight_report

# The running haseen shell's memory: the budget in docs/architecture.md §6.
if ! in_sysroot; then
    shell_dir="$(readlink -f -- "$HASEEN_PATH/shell")"
    shell_seen=false
    for pid in $(pgrep -u "$EUID" -x 'qs|quickshell' || true); do
        if ! doctor_shell_cmdline_matches "$shell_dir" "/proc/$pid/cwd" "/proc/$pid/cmdline"; then
            continue
        fi
        rss="$(sed -n 's/^Rss: *\([0-9]*\) kB/\1/p' "/proc/$pid/smaps_rollup")"
        pss="$(sed -n 's/^Pss: *\([0-9]*\) kB/\1/p' "/proc/$pid/smaps_rollup")"
        printf 'shell=pid %s rss=%s MiB pss=%s MiB (budget < 200 MiB rss)\n' "$pid" "$((rss / 1024))" "$((pss / 1024))"
        shell_seen=true
    done
    $shell_seen || echo "shell=not running"

    # An Omarchy shell running beside haseen's is a second bar (plan 093).
    # shellcheck source=../share/haseen/omarchy/lib.sh
    if omarchy_pids="$(source "$HASEEN_PATH/omarchy/lib.sh" && omarchy_shell_pids)"; then
        omarchy_pids="$(paste -sd' ' <<<"$omarchy_pids")"
        [[ -z $omarchy_pids ]] || echo "omarchy shell=running (pid $omarchy_pids): a second bar beside haseen's; omarchy-restart-shell stops it"
    else
        echo "omarchy shell=unknown: Quickshell could not list its instances"
    fi
fi

# Omarchy's command names reach haseen's answers only where haseen's come
# first on PATH (plan 093). The compositor's PATH is the one Hyprland's
# exec_cmd, binds and units use, which an Omarchy-seeded ~/.config/uwsm/env
# can order differently from this terminal's.
omarchy_ok=true
doctor_omarchy_path terminal "$PATH" \
    "open a new terminal: haseen's shell init (default/shell/init.sh) puts haseen's first" || omarchy_ok=false
if hyprland_pid="$(doctor_hyprland_pid)"; then
    if compositor_path="$(doctor_environ_path "$(sysroot_path "/proc/$hyprland_pid/environ")")"; then
        doctor_omarchy_path compositor "$compositor_path" \
            "haseen layer apply desktop puts haseen's first (~/.config/uwsm/env.d/10-haseen); log in again" || omarchy_ok=false
    else
        echo "compositor omarchy commands=unknown: cannot read Hyprland's environment (pid $hyprland_pid)"
    fi
else
    echo "compositor omarchy commands=no Hyprland session"
fi

# Omarchy's own packages, where they are still installed (plan 101): its
# migrations sealed, the pacman hook that seals the next ones, the splash its
# omarchy-settings resets, and every Omarchy user unit still enabled.
guard_ok=true
omarchy_guard_doctor || guard_ok=false

echo
status=0
"$(dirname "$(readlink -f "$0")")/haseen-layer-status" || status=$?
if ! $omarchy_ok; then
    echo "haseen doctor: Omarchy's commands come before haseen's (see above)" >&2
    ((status != 0)) || status=1
fi
if ! $guard_ok; then
    echo "haseen doctor: Omarchy's packages can still undo haseen (see above)" >&2
    ((status != 0)) || status=1
fi
exit "$status"
