#!/usr/bin/env bash
# haseen:summary Open a TCP listener in the foreground and never run what it receives
# haseen:args [--dry-run] [--yes] [--bind ADDRESS] [PORT]
set -Eeuo pipefail
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"
source "$HASEEN_PATH/layers/vapt/workflow_actions.sh"
usage() { echo "Usage: haseen vapt net-listener [--dry-run] [--yes] [--bind ADDRESS] [PORT]"; }
parse_common_flags "$@"
vapt_endpoint_action listener "${REST[@]}"
