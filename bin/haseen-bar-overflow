#!/usr/bin/env bash
# haseen:summary Choose which bar widgets live in the overflow panel (saved in shell.json)
# haseen:args <add|remove|pin|unpin|list> [<id>] [--dry-run]
set -Eeuo pipefail
# shellcheck source=../share/haseen/shell/lib/plugin.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/shell/lib/plugin.sh"
BIN_DIR="$(dirname "$(readlink -f "$0")")"

usage() {
    cat <<EOF
Usage: haseen bar overflow <add|remove|pin|unpin|list> [<id>] [--dry-run]

When the bar's widgets do not fit its length, some move into a panel behind
a chevron at the end of the bar. This edits bar.overflow and bar.pinned in
$SHELL_USER_CONFIG, then tells the running shell.

  add <id>     always keep <id> in the overflow panel (and unpin it)
  remove <id>  let <id> come back to the bar when there is room
  pin <id>     keep <id> in the bar: never move it to the panel on its own
               (this is "Keep in bar")
  unpin <id>   let <id> move to the panel again when the bar is full
  list         print both lists, and what each running bar has in its panel

In the shell, "Arrange" in the panel (or a right click on the chevron) turns
clicks into moves: a click on a bar widget does "add", one in the panel does
"pin". The tray never moves to the panel.

--no-apply   only save; used by the shell itself, which already applied it
EOF
}

APPLY=true
args=()
for a in "$@"; do
    if [[ $a == --no-apply ]]; then APPLY=false; else args+=("$a"); fi
done
parse_common_flags "${args[@]+"${args[@]}"}"
verb="${REST[0]:-}"
case "$verb" in
add | remove | pin | unpin) ((${#REST[@]} == 2)) || {
    usage >&2
    exit 2
} ;;
list) ((${#REST[@]} == 1)) || {
    usage >&2
    exit 2
} ;;
*)
    usage >&2
    exit 2
    ;;
esac

if [[ $verb == list ]]; then
    merged="$(shell_merged_json)"
    jq -r '"overflow: " + ((.bar.overflow // []) | join(" ")), "pinned: " + ((.bar.pinned // []) | join(" "))' <<<"$merged"
    if status="$("$BIN_DIR/haseen-shell-ipc" bar status 2>/dev/null)" && jq -e '.overflow | type == "object"' <<<"$status" >/dev/null 2>&1; then
        jq -r '.overflow | to_entries[] | "\(.key): \(.value.ids | join(" "))"' <<<"$status"
    fi
    exit 0
fi

id="${REST[1]}"
[[ $id =~ ^[a-z0-9-]+(\.[a-z0-9-]+)+$ ]] || die "not a plugin id: $id"
[[ $verb == add && $id == haseen.tray ]] && die "the tray anchors the bar and never moves to the overflow panel"

# At top level, so an unreadable user file stops here (exit 1), untouched.
# Under the transaction lock, so the value written below is computed from the
# shell.json no other writer can replace until this one renames its own.
shell_config_lock
user="$(shell_user_json)"
merged="$(shell_merged_json)"
if [[ $verb == add || $verb == pin ]]; then
    jq -e --arg id "$id" '[.bar.left, .bar.center, .bar.right] | map(. // []) | add | index($id) != null' <<<"$merged" >/dev/null ||
        die "$id is not in the bar (bar.left, bar.center or bar.right)"
fi

# The same rule as Overflow.edit in the shell. The lists are read from the
# merged config (the defaults may hold them) and written whole, as arrays
# replace in the merge.
updated="$(jq --argjson m "$merged" --arg verb "$verb" --arg id "$id" '
    ($m.bar.overflow // []) as $o | ($m.bar.pinned // []) as $p |
    (if $verb == "add" then {o: (if ($o | index($id)) then $o else ($o - [$id]) + [$id] end), p: ($p - [$id])}
     elif $verb == "remove" then {o: ($o - [$id]), p: $p}
     elif $verb == "pin" then {o: ($o - [$id]), p: (if ($p | index($id)) then $p else $p + [$id] end)}
     else {o: $o, p: ($p - [$id])} end) as $r |
    .bar.overflow = $r.o | .bar.pinned = $r.p' <<<"$user")"
if [[ "$(jq -c '[.bar.overflow, .bar.pinned]' <<<"$updated")" != "$(jq -c '[.bar.overflow // [], .bar.pinned // []]' <<<"$merged")" ]]; then
    printf '%s\n' "$updated" | shell_config_write
fi
case "$verb" in
add) info "$id: in the overflow panel" ;;
remove) info "$id: back in the bar when it fits" ;;
pin) info "$id: kept in the bar" ;;
unpin) info "$id: may move to the overflow panel when the bar is full" ;;
esac

if $APPLY; then
    if $DRY_RUN; then
        echo "DRYRUN: haseen shell ipc bar overflow $verb $id"
    else
        "$BIN_DIR/haseen-shell-ipc" bar overflow "$verb" "$id" >/dev/null 2>&1 ||
            info "no running haseen shell answered; it applies at the next start"
    fi
fi
