#!/usr/bin/env bash
# haseen:summary Set, record and restore the battery charge limit (charge_control thresholds)
# haseen:args [status|set END [START]|off|save|restore] [--dry-run]
#
# The limit lives in the battery controller, which can forget it: on io a
# drained battery (upowerd's suspend-then-hibernate, 2026-10-06) came back at
# 0-100%. This command writes the kernel's charge_control_*_threshold files
# and records the window in /etc/haseen/charge-limit. haseen-charge-limit.service
# and the system-sleep hook, both installed by `haseen setup battery-limit on`
# (off by default), run `restore` at boot and after resume and `save` at
# shutdown (plan 060).
set -Eeuo pipefail
# shellcheck source=../share/haseen/lib/common.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"
# shellcheck source=../share/haseen/lib/terminal.sh
source "$HASEEN_PATH/lib/terminal.sh"
# shellcheck source=../share/haseen/layers/base/lib.sh
source "$HASEEN_PATH/layers/base/lib.sh"

CONF=/etc/haseen/charge-limit
UNIT=haseen-charge-limit.service

usage() {
    cat <<EOF
Usage: haseen battery limit [status|set END [START]|off|save|restore] [--dry-run]

  status       the window the battery holds now, the recorded one and
               whether it is restored at boot (default)
  set END      stop charging at END% (1-100) and resume below START%
  [START]      (default END-5; 0 when END is 100). Writes the thresholds
               as root and records them in $CONF.
  off          charge to 100% (thresholds 0-100), recorded the same way.
  save         record the thresholds the battery holds now, e.g. a limit a
               power panel set itself.
  restore      apply $CONF to the battery; nothing when there is no record
               or no battery with thresholds. Run as root by $UNIT
               and the system-sleep hook.

Recording alone restores nothing: 'haseen setup battery-limit on' installs
the boot and resume restore. Off by default.
EOF
}

# The unit and the sleep hook run this as root: the root helpers' sudo is then
# a plain call (and the boot path does not depend on sudo's policy).
if [[ $EUID -eq 0 ]]; then
    sudo() { "$@"; }
fi

# BAT — the first battery whose controller takes an end threshold; empty
# when there is none (a desktop, or a laptop without the driver support).
BAT=""
for d in "$(sysroot_path /sys/class/power_supply)"/*; do
    [[ -e $d/charge_control_end_threshold ]] || continue
    BAT="$d"
    break
done

need_battery() {
    [[ -n $BAT ]] || die "no battery with charge_control thresholds here: nothing to limit"
}

has_start() { [[ -e $BAT/charge_control_start_threshold ]]; }

# current — "START END" as the battery holds them now (START 0 when the
# controller has no start threshold).
current() {
    local s=0 e
    has_start && s="$(<"$BAT/charge_control_start_threshold")"
    e="$(<"$BAT/charge_control_end_threshold")"
    printf '%s %s\n' "$s" "$e"
}

# recorded — "START END" from $CONF; nothing when there is no valid record.
recorded() {
    local f s="" e=""
    f="$(sysroot_path "$CONF")"
    [[ -r $f ]] || return 0
    s="$(sed -n 's/^start=\([0-9]\{1,3\}\)$/\1/p' "$f" | head -n1)"
    e="$(sed -n 's/^end=\([0-9]\{1,3\}\)$/\1/p' "$f" | head -n1)"
    valid "$e" "${s:-0}" || return 0
    printf '%s %s\n' "${s:-0}" "$e"
}

# valid END START — 1 <= END <= 100, 0 <= START <= END.
valid() {
    [[ $1 =~ ^[0-9]+$ && $2 =~ ^[0-9]+$ ]] || return 1
    ((10#$1 >= 1 && 10#$1 <= 100 && 10#$2 <= 10#$1))
}

write_threshold() { # NAME VALUE
    local f="$BAT/charge_control_$1_threshold"
    if $DRY_RUN; then
        echo "DRYRUN: echo $2 | sudo tee $f"
        return 0
    fi
    printf '%s\n' "$2" | run_root tee "$f" >/dev/null
}

# apply START END — the kernel refuses a start above the current end (and an
# end below the current start), so the order follows the direction: lower the
# floor first when the window moves down, raise the ceiling first when it
# moves up.
apply() {
    local start="$1" end="$2" cur_end
    if ! has_start; then
        write_threshold end "$end"
        return 0
    fi
    read -r _ cur_end < <(current)
    if ((start <= cur_end)); then
        write_threshold start "$start"
        write_threshold end "$end"
    else
        write_threshold end "$end"
        write_threshold start "$start"
    fi
}

record() { # START END
    local f
    f="$(sysroot_path "$CONF")"
    [[ $(recorded) == "$1 $2" ]] && return 0
    write_root_file "$f" 0644 <<EOF
# haseen battery limit (plan 060): restored at boot and after resume by
# $UNIT when 'haseen setup battery-limit' is on.
start=$1
end=$2
EOF
}

window() { # START END
    if (($2 >= 100)); then echo "off (charges to 100%)"; else echo "$1-$2%"; fi
}

status() {
    if [[ -z $BAT ]]; then
        echo "battery:   no charge_control thresholds (not a laptop, or no driver support)"
        return 0
    fi
    local now rec persist=off
    now="$(current)"
    rec="$(recorded)"
    unit_enabled "$UNIT" && persist=on
    # "START END" pairs split into window's two arguments on purpose.
    # shellcheck disable=SC2086
    printf 'battery:   %s\nnow:       %s\nrecorded:  %s\nrestore:   %s (haseen setup battery-limit)\n' \
        "${BAT##*/}" "$(window $now)" "$([[ -n $rec ]] && window $rec || echo none)" "$persist"
}

parse_common_flags "$@"
verb="${REST[0]:-status}"
case "$verb" in
status)
    ((${#REST[@]} == 1 || ${#REST[@]} == 0)) || {
        usage >&2
        exit 2
    }
    status
    ;;
set | off)
    if [[ $verb == off ]]; then
        ((${#REST[@]} == 1)) || {
            usage >&2
            exit 2
        }
        end=100 start=0
    else
        ((${#REST[@]} == 2 || ${#REST[@]} == 3)) || {
            usage >&2
            exit 2
        }
        end="${REST[1]}"
        if ((${#REST[@]} == 3)); then
            start="${REST[2]}"
        elif [[ $end =~ ^[0-9]+$ ]] && ((10#$end >= 100)); then
            start=0
        elif [[ $end =~ ^[0-9]+$ ]]; then
            start=$((10#$end > 5 ? 10#$end - 5 : 0))
        else
            start=0
        fi
        valid "$end" "$start" || die "END must be 1-100 and START 0-END (got END=$end START=$start)"
        end=$((10#$end)) start=$((10#$start))
    fi
    need_battery
    [[ $EUID -eq 0 ]] || in_floating_terminal "$@"
    apply "$start" "$end"
    record "$start" "$end"
    info "charge limit: $(window "$start" "$end")"
    unit_enabled "$UNIT" || info "not restored after a reboot until 'haseen setup battery-limit on'"
    ;;
save)
    ((${#REST[@]} == 1)) || {
        usage >&2
        exit 2
    }
    need_battery
    [[ $EUID -eq 0 ]] || in_floating_terminal "$@"
    read -r start end < <(current)
    valid "$end" "$start" || die "the battery reports an invalid window: $start-$end"
    record "$start" "$end"
    info "recorded: $(window "$start" "$end")"
    ;;
restore)
    ((${#REST[@]} == 1)) || {
        usage >&2
        exit 2
    }
    [[ -n $BAT ]] || exit 0
    rec="$(recorded)"
    [[ -n $rec ]] || exit 0
    read -r start end <<<"$rec"
    [[ $(current) == "$start $end" ]] && exit 0
    apply "$start" "$end"
    info "charge limit restored: $(window "$start" "$end")"
    ;;
*)
    usage >&2
    exit 2
    ;;
esac
