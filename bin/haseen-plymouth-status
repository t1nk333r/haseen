#!/usr/bin/env bash
# haseen:summary What the boot splash is, whether it will show, and whether it matches the current theme
# haseen:args
set -Eeuo pipefail

# shellcheck source=../share/haseen/lib/plymouth.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/plymouth.sh"

parse_common_flags "$@"

if ! plymouth_installed; then
    echo "plymouth:  not installed"
    exit 0
fi

theme_note=""
plymouth_reset_by_omarchy &&
    theme_note=" (Omarchy's omarchy-settings package put it back over haseen's: sudo haseen omarchy guard)"
printf 'theme:     %s%s\n' "$(plymouth_current_theme || echo "(none)")" "$theme_note"
printf 'installed: %s\n' \
    "$([[ -r $(sysroot_path "$PLYMOUTH_THEME_DIR/haseen.script") ]] && echo "$PLYMOUTH_THEME_DIR" || echo "haseen's theme is not installed")"
hook=0
plymouth_hook_present || hook=$?
case $hook in
0) hook_text="plymouth is in HOOKS" ;;
2) hook_text="unknown (mkinitcpio's configuration does not evaluate)" ;;
*) hook_text="missing from HOOKS (no splash)" ;;
esac
printf 'hook:      %s\n' "$hook_text"
printf 'cmdline:   %s\n' "$(boot_cmdline_has splash && echo "splash is on the kernel command line" || echo "no 'splash' (the kernel keeps the screen)")"

ready=true
((hook == 0)) || ready=false
boot_cmdline_has splash || ready=false
[[ $(plymouth_current_theme) == haseen ]] || ready=false
if $ready; then
    echo "ready:     yes"
else
    echo "ready:     no (haseen plymouth set)"
fi
# Plan 110: whether the boot image carries the current theme's colours and
# mark, and whether it follows them by itself.
if plymouth_follow_on; then
    echo "follows:   on (rebuilt in the background about 2 minutes after a theme or mark change)"
else
    echo "follows:   off (haseen plymouth follow on)"
fi
echo "matches:   $(plymouth_matches)"
# A theme colour the splash replaces to keep the password prompt readable.
colors="$HASEEN_USER_STATE/current/theme/colors.toml"
if [[ -r $colors ]]; then
    read -r bg fg accent <<<"$(plymouth_theme_colors "$colors")"
    while IFS= read -r line; do
        [[ -n $line ]] && echo "readable:  $line"
    done < <(plymouth_readability_note "$bg" "$fg" "$accent")
fi
