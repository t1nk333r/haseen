#!/usr/bin/env bash
# haseen:summary Show the key bindings this session actually has
# haseen:args [--json] [--reload]
#
# Model adapted from DankMaterialShell core/internal/keybinds (MIT, Copyright
# (c) 2025 Avenge Media LLC): one record per bind with key, modifiers,
# description, action and category, grouped for a cheat sheet.
#
# Changes: the binds come from the running compositor (`hyprctl binds -j`), not
# from parsing a config file, so a bind added by any Lua file, submap or plugin
# is listed the moment Hyprland reloads. Only the category comes from the Lua
# sources, where it is the `-- Section ---` comment the bind was written under.
#
# Key names and Lua binds adapted from Omarchy bin/omarchy-menu-keybindings
# (MIT, Copyright (c) David Heinemeier Hansson): `code:N` resolved to its key
# symbol through `xkbcli compile-keymap`, mouse buttons named, and each `__lua`
# bind's key and dispatcher read back from the Lua config
# (share/haseen/lib/keybinds-scan.lua), which Hyprland 0.56 does not report.
set -Eeuo pipefail

# shellcheck source=../share/haseen/lib/common.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"

usage() {
    cat <<EOF
Usage: haseen keybinds [--json] [--reload]

Lists the live bindings, grouped by the section they were written under.

  --json     [{"key","mods","combo","description","action","dispatcher",
              "arg","category","submap","repeat","locked"}]
             key is readable (code:10 becomes 1, mouse:272 LEFT MOUSE BUTTON);
             dispatcher is exec, lua (arg: a hl.dsp expression), a native
             dispatcher, "" for a Lua function nothing can replay, or keyd
             While keyd runs (haseen setup keyd), what it does with
             CapsLock is listed under CapsLock (dispatcher keyd, action
             the keyd line), and a bind on the modifiers holding CapsLock
             sends (SUPER + SHIFT + CTRL + ALT) has the combo
             CAPSLOCK + key; its mods stay those modifiers
  --reload   ask Hyprland to reload its config first, so an edit you just
             made is included
EOF
}

json=false
reload=false
for arg in "$@"; do
    case "$arg" in
    --json) json=true ;;
    --reload) reload=true ;;
    -h | --help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 2
        ;;
    esac
done

require_cmds hyprctl jq
$reload && hyprctl reload >/dev/null

binds="$(hyprctl binds -j)" || die "Hyprland is not answering (hyprctl binds)"

# Categories: the `-- Name ------` comment each `b("KEY", "Description", ...)`
# sits under, read from the Lua files that are actually loaded. The user's own
# files come last, so their section wins for a description they rebound.
categories() {
    local file
    for file in "$HASEEN_PATH/default/hypr"/*.lua "${XDG_CONFIG_HOME:-$HOME/.config}/hypr"/*.lua; do
        [[ -f $file ]] || continue
        awk '
            /^[[:space:]]*--[[:space:]]*[A-Z][^-]*-{3,}/ {
                section = $0
                sub(/^[[:space:]]*--[[:space:]]*/, "", section)
                sub(/[[:space:]]*-+[[:space:]]*$/, "", section)
                next
            }
            match($0, /^[[:space:]]*(local[[:space:]]+)?b\(/) {
                line = $0
                if (match(line, /"[^"]*"[[:space:]]*,[[:space:]]*"[^"]*"/) == 0) next
                field = substr(line, RSTART, RLENGTH)
                if (match(field, /,[[:space:]]*"[^"]*"$/) == 0) next
                desc = substr(field, RSTART, RLENGTH)
                sub(/^,[[:space:]]*"/, "", desc)
                sub(/"$/, "", desc)
                if (section != "" && desc != "")
                    printf "%s\t%s\n", desc, section
            }
        ' "$file"
    done
}

# modmask<TAB>description<TAB>key<TAB>kind<TAB>arg for every described bind in
# the Lua config, which knows the key of a `code:N` bind and what a `__lua`
# bind does. Without lua the sheet still lists every bind, less those two.
lua_binds() {
    have lua || return 0
    local config="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua"
    [[ -f $config ]] || config="$HASEEN_PATH/default/hypr/init.lua"
    lua "$HASEEN_PATH/lib/keybinds-scan.lua" "$config" 2>/dev/null || true
}

# keycode<TAB>SYMBOL from the compiled keymap; the number row is the fallback
# when xkbcli cannot answer, since haseen binds workspaces to code:10..19.
keysyms() {
    printf '10\t1\n11\t2\n12\t3\n13\t4\n14\t5\n15\t6\n16\t7\n17\t8\n18\t9\n19\t0\n'
    printf '20\tMINUS\n21\tEQUAL\n59\tCOMMA\n60\tPERIOD\n61\tSLASH\n'
    have xkbcli || return 0
    xkbcli compile-keymap </dev/null 2>/dev/null | awk '
        /xkb_keycodes/ { section = "codes"; next }
        /xkb_symbols/ { section = "syms"; next }
        section == "codes" && /^[[:space:]]*<[A-Za-z0-9_+-]+>[[:space:]]*=[[:space:]]*[0-9]+[[:space:]]*;/ {
            line = $0
            gsub(/[[:space:]<>;]/, "", line)
            split(line, kv, "=")
            code[kv[1]] = kv[2]
        }
        section == "syms" && /^[[:space:]]*key[[:space:]]*<[A-Za-z0-9_+-]+>[[:space:]]*\{[[:space:]]*\[/ {
            line = $0
            sub(/^[[:space:]]*key[[:space:]]*</, "", line)
            name = line
            sub(/>.*/, "", name)
            sub(/^[^[]*\[[[:space:]]*/, "", line)
            sub(/[[:space:],\]].*/, "", line)
            sym[name] = line
        }
        END {
            for (name in code)
                if (sym[name] != "" && sym[name] != "NoSymbol")
                    printf "%s\t%s\n", code[name], toupper(sym[name])
        }' || true
}

# What keyd does with CapsLock (`haseen setup keyd`), from the [main] lines of
# /etc/keyd/default.conf that name it, alone or in a chord:
#   row<TAB>combo<TAB>description<TAB>action  one per thing CapsLock does
#   hold<TAB>MODMASK                          the modifiers holding it sends,
#                                             when three or more
# Only while keyd runs: `haseen setup keyd off` leaves the config behind. A
# sysroot has no running units, so there an enabled keyd.service stands in.
keyd_capslock() {
    if in_sysroot; then
        local etc
        etc="$(sysroot_path /etc/systemd/system)"
        compgen -G "$etc/*.wants/keyd.service" >/dev/null || compgen -G "$etc/*.requires/keyd.service" >/dev/null || return 0
    else
        have systemctl && systemctl is-active --quiet keyd.service 2>/dev/null || return 0
    fi
    local conf
    conf="$(sysroot_path /etc/keyd/default.conf)"
    [[ -r $conf ]] || return 0
    awk '
        function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
        # keyd modifier letters (C-M-A-S) in the order the sheet writes
        # modifiers ($mods in the jq below).
        function mods(letters,    i, l, out) {
            out = ""
            for (i = 1; i <= 5; i++) {
                l = substr("MSCAG", i, 1)
                if (index(letters, l)) out = out (out == "" ? "" : "+") NAME[l]
            }
            return out
        }
        function count(letters,    i, c) {
            c = 0
            for (i = 1; i <= 5; i++) if (index(letters, substr("MSCAG", i, 1))) c++
            return c
        }
        function mask(letters,    i, l, m) {
            m = 0
            for (i = 1; i <= 5; i++) {
                l = substr("MSCAG", i, 1)
                if (index(letters, l)) m += BIT[l]
            }
            return m
        }
        # A key name as the sheet writes keys: capslock CAPSLOCK, rightalt
        # RIGHT ALT, esc ESCAPE.
        function keyname(k,    side) {
            k = tolower(k)
            if (k == "esc") return "ESCAPE"
            if (k ~ /^(left|right)(alt|shift|control|meta)$/) {
                side = k ~ /^left/ ? "LEFT " : "RIGHT "
                sub(/^(left|right)/, "", k)
            }
            if (k == "control") k = "ctrl"
            if (k == "meta") k = "super"
            return side toupper(k)
        }
        # A key keyd sends, with any modifier prefixes (C-S-x): CTRL+SHIFT+X.
        # "" when it is anything else (a macro, a layer, ...).
        function sends(k,    letters) {
            letters = ""
            while (k ~ /^[CMASG]-./) { letters = letters substr(k, 1, 1); k = substr(k, 3) }
            if (k !~ /^[a-z0-9_]+$/) return ""
            return (letters == "" ? "" : mods(letters) "+") keyname(k)
        }
        function chord(lhs,    n, part, i, out) {
            n = split(lhs, part, "+")
            out = ""
            for (i = 1; i <= n; i++) out = out (out == "" ? "" : " + ") keyname(trim(part[i]))
            return out
        }
        # A tab in a value would split the record.
        function row(combo, desc, action) {
            gsub(/\t/, " ", action)
            printf "row\t%s\t%s\t%s\n", combo, desc, action
        }
        BEGIN {
            NAME["M"] = "SUPER"; NAME["S"] = "SHIFT"; NAME["C"] = "CTRL"; NAME["A"] = "ALT"; NAME["G"] = "ALTGR"
            BIT["M"] = 64; BIT["S"] = 1; BIT["C"] = 4; BIT["A"] = 8; BIT["G"] = 128
            # The modifier layers keyd has built in.
            LAYER["control"] = "C"; LAYER["shift"] = "S"; LAYER["alt"] = "A"; LAYER["meta"] = "M"; LAYER["altgr"] = "G"
        }
        /^[ \t]*(#|$)/ { next }
        /^[ \t]*\[/ {
            section = trim($0)
            sub(/^\[/, "", section)
            sub(/\]$/, "", section)
            if (index(section, ":")) {
                name = substr(section, 1, index(section, ":") - 1)
                # keyd keeps the first modifier set a layer is given.
                if (!(name in HEADER)) {
                    HEADER[name] = 1
                    LAYER[name] = substr(section, index(section, ":") + 1)
                }
                section = name
            }
            next
        }
        section == "main" && index($0, "=") {
            lhs = tolower(trim(substr($0, 1, index($0, "=") - 1)))
            if (("+" lhs "+") !~ /\+capslock\+/) next
            # The same keys bound twice: keyd keeps the last.
            if (!(lhs in IDX)) {
                IDX[lhs] = ++n
                LHS[n] = lhs
            }
            RHS[IDX[lhs]] = trim(substr($0, index($0, "=") + 1))
        }
        END {
            for (i = 1; i <= n; i++) {
                combo = chord(LHS[i])
                rhs = RHS[i]
                layer = tap = ""
                if (rhs ~ /^(overload|overloadt|overloadt2|lettermod)\(.*\)$/) {
                    args = rhs
                    sub(/^[a-z0-9]+\(/, "", args)
                    sub(/\)$/, "", args)
                    split(args, arg, ",")
                    layer = trim(arg[1])
                    tap = sends(trim(arg[2]))
                } else if (rhs ~ /^layer\(.*\)$/) {
                    layer = rhs
                    sub(/^layer\(/, "", layer)
                    sub(/\)$/, "", layer)
                    layer = trim(layer)
                } else if (sends(rhs) != "") {
                    row(combo, "Press for " sends(rhs), rhs)
                    continue
                }
                # A layer without modifiers ([nav], [nav:layout]) holds none.
                held = layer in LAYER ? mods(LAYER[layer]) : ""
                if (held != "") {
                    row(combo, "Hold for " held, rhs)
                    # A chord of three or more modifiers is only ever pressed
                    # through the key that holds them all.
                    if (LHS[i] == "capslock" && count(LAYER[layer]) >= 3)
                        printf "hold\t%d\n", mask(LAYER[layer])
                }
                if (tap != "") row(combo, "Tap for " tap, rhs)
                if (held == "" && tap == "") row(combo, "", rhs)
            }
        }
    ' "$conf" || true
}

records="$(printf '%s' "$(categories)" | jq -R -s -c --argjson binds "$binds" --arg lua "$(lua_binds)" --arg syms "$(keysyms)" --arg keyd "$(keyd_capslock)" '
    def tsv: split("\n") | map(select(length > 0) | split("\t"));
    (tsv | map({key: .[0], value: .[1]}) | from_entries) as $cats
    # The last line for a code wins: the keymap over the fallback.
    | ($syms | tsv | map({key: .[0], value: .[1]}) | from_entries) as $sym
    | ($lua | tsv) as $lua
    | ($lua | map({key: "\(.[0])\t\(.[1])", value: .[2]}) | from_entries) as $luakey
    | ($lua | map({key: "\(.[0])\t\(.[1])\t\(.[2] | ascii_upcase)", value: {kind: .[3], arg: (.[4] // ""), section: (.[5] // "")}}) | from_entries) as $luado
    | {"272": "LEFT MOUSE BUTTON", "273": "RIGHT MOUSE BUTTON", "274": "MIDDLE MOUSE BUTTON",
       "275": "SIDE MOUSE BUTTON", "276": "EXTRA MOUSE BUTTON"} as $mouse
    | def keyname:
        if startswith("code:") then $sym[.[5:]] // .
        elif startswith("mouse:") then $mouse[.[6:]] // .
        elif . == "mouse_down" then "SCROLL DOWN"
        elif . == "mouse_up" then "SCROLL UP"
        elif . == "mouse_left" then "SCROLL LEFT"
        elif . == "mouse_right" then "SCROLL RIGHT"
        elif test("^[a-z]+$") or length == 1 then ascii_upcase
        else . end;
    [1, 2, 4, 8, 16, 32, 64, 128] as $bits
    | ["SHIFT", "CAPS", "CTRL", "ALT", "MOD2", "MOD3", "SUPER", "MOD5"] as $names
    | ($keyd | tsv) as $keyd
    # The modifiers holding CapsLock sends: a bind on exactly those is
    # pressed as CAPSLOCK + its key.
    | ($keyd | map(select(.[0] == "hold") | .[1] | tonumber) | first) as $hold
    | ($binds | map(
        . as $bind
        | (if .has_description then .description else "" end) as $desc
        # A Lua bind reports "SUPER + code:20" or, for code:N, nothing at all.
        | (.key | sub("^.* \\+ "; "")
            | if . == "" and $bind.keycode != 0 then "code:\($bind.keycode)" else . end
            | if . == "" then $luakey["\($bind.modmask)\t\($desc)"] // "" else . end) as $key
        | ($luado["\(.modmask)\t\($desc)\t\($key | ascii_upcase)"] // {kind: "", arg: "", section: ""}) as $src
        | (if .dispatcher == "__lua" then $src else {kind: .dispatcher, arg: .arg} end) as $do
        | select(.dispatcher != "__lua" or $desc != "")
        # In the order the sheet writes them: SUPER + SHIFT + CTRL + ALT.
        | ([[6, 0, 2, 3, 1, 4, 5, 7][] | select(($bind.modmask % ($bits[.] * 2)) >= $bits[.]) | $names[.]]) as $mods
        | ($key | keyname) as $name
        | {
            key: $name,
            mods: $mods,
            combo: (if .modmask == $hold then "CAPSLOCK + " + $name else ($mods + [$name]) | join(" + ") end),
            description: $desc,
            action: (if $do.kind == "exec" then ($do.arg | sub("^uwsm-app -- "; ""))
                elif $do.kind == "lua" or $do.kind == "" then $do.arg
                else $do.kind + (if $do.arg == "" then "" else " " + $do.arg end) end),
            dispatcher: $do.kind,
            arg: $do.arg,
            # The section the bind was written under: from the Lua call site
            # (loops included), else from the b("KEY", "Description") lines.
            category: (if $src.section != "" then $src.section
                else $cats[.description] // (if .submap == "" then "Other" else "Submap: " + .submap end) end),
            submap: .submap,
            repeat: .repeat,
            locked: .locked
        }))
    # What keyd itself does with CapsLock: a key, not a Hyprland bind.
    + ($keyd | map(select(.[0] == "row") | (.[1] | split(" + ")) as $keys | {
        key: $keys[-1],
        mods: $keys[:-1],
        combo: .[1],
        description: (.[2] // ""),
        action: (.[3] // ""),
        dispatcher: "keyd",
        arg: "",
        category: "CapsLock",
        submap: "",
        repeat: false,
        locked: false
    }))
    | sort_by(.category, .description, .combo)')" || die "could not read the bindings"

if $json; then
    printf '%s\n' "$records"
    exit 0
fi

jq -r '
    group_by(.category)[]
    | "\n\(.[0].category)",
      (.[] | "  \(.combo)\u0009\(if .description == "" then .action else .description end)")' <<<"$records" |
    expand -t 34
