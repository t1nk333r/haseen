#!/usr/bin/env bash
# haseen:summary Remove apps, packages, AUR packages, fonts and dev toolchains
# haseen:args <package|aur|flatpak ID|app NAME|font NAME|dev LANG> [--dry-run] [--yes]
#
# Picker adapted from omarchy bin/omarchy-pkg-remove (MIT, Copyright (c)
# David Heinemeier Hansson).
set -Eeuo pipefail
# shellcheck source=../share/haseen/lib/catalog.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/catalog.sh"

usage() {
    cat <<EOF
Usage: haseen remove <what> [args] [--dry-run] [--yes]

  package [NAME...]   explicitly installed packages; no NAME opens an fzf picker
  aur [NAME...]       foreign (AUR) packages; no NAME opens an fzf picker
  flatpak ID          a Flatpak app (user installation first, then system)
  app NAME            a catalogue app (see: haseen install app --list)
  font NAME           a catalogue Nerd Font
  dev LANG            a mise toolchain from the catalogue

Packages go with 'pacman -Rns' (their unneeded dependencies too). Flatpak
app data in ~/.var/app stays. Started without a terminal, it opens one.
EOF
}

in_floating_terminal "$@"
parse_common_flags "$@"
set -- "${REST[@]}"
(($# >= 1)) || {
    usage >&2
    exit 2
}
require_not_root
what="$1"
shift

# pick_installed PACMAN_QUERY_FLAGS — fzf over `pacman -Q<flags>`.
pick_installed() {
    require_cmds fzf
    pacman "$1" | fzf --multi --preview 'pacman -Qi {1}' --preview-window 'down:65%:wrap' \
        --preview-label 'tab: select' --preview-label-pos bottom
}

case "$what" in
package | aur)
    if (($# == 0)); then
        query=-Qqe
        [[ $what == aur ]] && query=-Qqm
        if $DRY_RUN; then
            echo "DRYRUN: pick packages from 'pacman $query' with fzf, then as root: pacman -Rns <picked>"
            exit 0
        fi
        mapfile -t pkgs < <(pick_installed "$query")
    else
        pkgs=("$@")
    fi
    ((${#pkgs[@]} > 0)) || { info "nothing selected"; exit 0; }
    check_pkg_names "${pkgs[@]}"
    pkg_remove "${pkgs[@]}"
    ;;
flatpak)
    (($# == 1)) || die "usage: haseen remove flatpak <app id>"
    flatpak_remove_app "$1"
    ;;
app)
    (($# == 1)) || die "usage: haseen remove app <name>"
    catalog_remove "$(catalog_resolve "$1")"
    ;;
font)
    (($# == 1)) || die "usage: haseen remove font <name>"
    catalog_remove "$(catalog_resolve "$1" font)"
    ;;
dev)
    (($# == 1)) || die "usage: haseen remove dev <lang>"
    catalog_remove "$(catalog_resolve "$1" development)"
    ;;
*)
    usage >&2
    exit 2
    ;;
esac
