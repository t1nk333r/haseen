#!/usr/bin/env bash
# haseen:summary Run the haseen Quickshell shell in the foreground (used by haseen-shell.service)
# haseen:args [qs options]
set -Eeuo pipefail
# shellcheck source=../share/haseen/lib/common.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"

usage() {
    cat <<EOF
Usage: haseen shell run [qs options]

Execs: qs -p \$HASEEN_PATH/shell [qs options]
Normally started by haseen-shell.service; extra options go to qs (e.g. -n).
EOF
}

case "${1:-}" in
-h | --help)
    usage
    exit 0
    ;;
esac

[[ -r $HASEEN_PATH/shell/shell.qml ]] || die "shell not found: $HASEEN_PATH/shell/shell.qml"
have qs || die "quickshell (qs) is not installed: haseen layer apply shell"
# Plugins call DMS's and Omarchy's commands. Compat/bin answers dms and
# ydotool, omarchy/bin every Omarchy command (architecture 5.4, plan 093);
# first on PATH, so a checkout's shell reaches them too, not only an
# installed tree's PREFIX/bin links.
export PATH="$HASEEN_PATH/shell/Compat/bin:$HASEEN_PATH/omarchy/bin:$PATH"
# The shell watches $HASEEN_USER_STATE/safe-mode (plan 061) and
# $HASEEN_USER_CONFIG/language (plan 109); a watch needs the directory to
# exist when it starts.
mkdir -p -- "$HASEEN_USER_STATE" "$HASEEN_USER_CONFIG"
exec qs -p "$HASEEN_PATH/shell" "$@"
