#!/usr/bin/env bash
# haseen:summary Let this user run sudo without a password (or undo it with --off)
# haseen:args [--off] [--dry-run] [--yes]
set -Eeuo pipefail
# shellcheck source=../share/haseen/lib/common.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"
# shellcheck source=../share/haseen/lib/terminal.sh
source "$HASEEN_PATH/lib/terminal.sh"

usage() {
    cat <<EOF
Usage: haseen setup passwordless-sudo [--off] [--dry-run] [--yes]

Writes /etc/sudoers.d/90-haseen-<user> with "<user> ALL=(ALL) NOPASSWD: ALL"
(mode 0440, checked with visudo first). Anything running as you can then
become root without asking: only do this on a single-user machine.
--off removes the file.
EOF
}

in_floating_terminal "$@"
parse_common_flags "$@"
off=false
for a in "${REST[@]}"; do
    case "$a" in
    --off) off=true ;;
    *)
        usage >&2
        exit 2
        ;;
    esac
done
require_not_root
user="$(id -un)"
[[ $user =~ ^[a-z_][a-z0-9_-]*$ ]] || die "unexpected user name '$user'"
file="/etc/sudoers.d/90-haseen-$user"

if $off; then
    run_root rm -f "$file"
    info "sudo asks for your password again"
    exit 0
fi
confirm "Allow $user to run sudo without a password?" || exit 1
rule="$user ALL=(ALL) NOPASSWD: ALL"
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
printf '# Written by `haseen setup passwordless-sudo`; --off removes it.\n%s\n' "$rule" >"$tmp"
chmod 0440 "$tmp"
if have visudo; then
    visudo -cqf "$tmp" || die "visudo rejected the rule"
fi
write_root_file "$file" 0440 <"$tmp"
info "passwordless sudo on for $user"
