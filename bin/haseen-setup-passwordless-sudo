#!/usr/bin/env bash
# haseen:summary Let this user run sudo without a password (or undo it with --off)
# haseen:args [--off] [--dry-run] [--yes]
set -Eeuo pipefail
# shellcheck source=../share/haseen/lib/common.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"
# shellcheck source=../share/haseen/lib/terminal.sh
source "$HASEEN_PATH/lib/terminal.sh"

usage() {
    cat <<EOF
Usage: haseen setup passwordless-sudo [--off] [--dry-run] [--yes]

Writes /etc/sudoers.d/90-haseen-<user> with "<user> ALL=(ALL) NOPASSWD: ALL"
(mode 0440, checked with visudo first). Anything running as you can then
become root without asking: only do this on a single-user machine.
--off removes it and every other passwordless grant for you: the timed one
(omarchy-sudo-passwordless) and Omarchy's, by user name (4.0.6) or by UID,
timed or permanent (4.5), with their expiry timers.
EOF
}

in_floating_terminal "$@"
parse_common_flags "$@"
off=false
for a in "${REST[@]}"; do
    case "$a" in
    --off) off=true ;;
    *)
        usage >&2
        exit 2
        ;;
    esac
done
require_not_root
user="$(id -un)"
uid="$(id -u)"
[[ $user =~ ^[a-z_][a-z0-9_-]*$ ]] || die "unexpected user name '$user'"
[[ $uid =~ ^[0-9]+$ ]] || die "unexpected user id '$uid'"
file="/etc/sudoers.d/90-haseen-$user"

if $off; then
    # Omarchy 4.5 names its grants by UID, not by user name
    # (bin/omarchy-sudo-passwordless@v4.5.0-rc1 rule_file), and keeps a
    # permanent one beside the timed: a grant left under either name would
    # keep sudo passwordless after "off" (plan 102).
    run_root rm -f "$file" "/etc/sudoers.d/99-haseen-nopasswd-$user" \
        "/etc/sudoers.d/99-omarchy-nopasswd-$user" "/etc/sudoers.d/99-omarchy-nopasswd-$uid" \
        "/etc/sudoers.d/99-omarchy-permanent-nopasswd-$uid"
    run_root systemctl stop "haseen-nopasswd-expire-$user.timer" "omarchy-nopasswd-expire-$user.timer" \
        "omarchy-nopasswd-expire-$uid-*.timer" 2>/dev/null || true
    info "sudo asks for your password again"
    exit 0
fi
confirm "Allow $user to run sudo without a password?" || exit 1
rule="$user ALL=(ALL) NOPASSWD: ALL"
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
printf '# Written by `haseen setup passwordless-sudo`; --off removes it.\n%s\n' "$rule" >"$tmp"
chmod 0440 "$tmp"
if have visudo; then
    visudo -cqf "$tmp" || die "visudo rejected the rule"
fi
write_root_file "$file" 0440 <"$tmp"
info "passwordless sudo on for $user"
