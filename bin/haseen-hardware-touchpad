#!/usr/bin/env bash
# haseen:summary Enable, disable or toggle the touchpad
# haseen:args [on|off|toggle] [--dry-run]
#
# Adapted from Omarchy bin/omarchy-toggle-input-device and omarchy-hw-touchpad
# (MIT, Copyright (c) David Heinemeier Hansson): find the device in
# `hyprctl devices`, switch it with hl.device, persist the disable.
set -Eeuo pipefail

# shellcheck source=../share/haseen/lib/common.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"

usage() {
    cat <<EOF
Usage: haseen hardware touchpad [on|off|toggle] [--dry-run]

Switches the first touchpad Hyprland reports. "off" persists across reloads in
\$HASEEN_USER_STATE/toggles/hypr/touchpad-disabled.lua.
EOF
}

TOGGLE_FILE="$HASEEN_USER_STATE/toggles/hypr/touchpad-disabled.lua"

parse_common_flags "$@"
set -- "${REST[@]}"
action=${1:-toggle}
(($# <= 1)) || { usage >&2; exit 2; }
case $action in
on | off) ;;
toggle) if [[ -f $TOGGLE_FILE ]]; then action=on; else action=off; fi ;;
*) usage >&2; exit 2 ;;
esac

device="$(hyprctl devices -j | jq -r '[.mice[]? | .name | select(test("touchpad|trackpad"; "i"))] | first // empty')"
# The name lands in generated Lua: only plain device names may pass.
[[ -n $device ]] || die "no touchpad found"
[[ $device =~ ^[A-Za-z0-9\ ._:-]+$ ]] || die "refusing unusual device name: $device"

lua="hl.device({ name = \"$device\", enabled = $([[ $action == on ]] && echo true || echo false) })"
if [[ $action == on ]]; then
    if $DRY_RUN; then echo "DRYRUN: rm -f $TOGGLE_FILE"; else rm -f "$TOGGLE_FILE"; fi
else
    printf '%s\n' "$lua" | write_user_file "$TOGGLE_FILE"
fi
run hyprctl eval "$lua"
$DRY_RUN && exit 0
state=$([[ $action == on ]] && echo enabled || echo disabled)
echo "Touchpad $state ($device)"
if have notify-send; then
    notify-send -a haseen "Touchpad $state" || true
fi
