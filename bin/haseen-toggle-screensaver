#!/usr/bin/env bash
# haseen:summary Allow or prevent the screensaver before the idle lock
# haseen:args [on|off|toggle|status] [--dry-run]
#
# Plan 019. State is the flag file $HASEEN_USER_STATE/flags/screensaver-off (exists =
# screensaver off). The shell reads it through qs.Haseen Flags (inotify, no
# polling): haseen.idle skips the screensaver and
# `haseen screensaver` refuses to start without --force.
set -Eeuo pipefail
# shellcheck source=../share/haseen/lib/common.sh
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"

usage() {
    cat <<EOF
Usage: haseen toggle screensaver [on|off|toggle|status] [--dry-run]

"off" skips the screensaver: the idle lock still comes at its time.
`haseen screensaver --force` still shows it.
Without an argument it toggles; "status" prints on or off.
State: \$HASEEN_USER_STATE/flags/screensaver-off (screensaver off while it exists).
EOF
}

FLAG="$HASEEN_USER_STATE/flags/screensaver-off"

parse_common_flags "$@"
set -- "${REST[@]}"
(($# <= 1)) || {
    usage >&2
    exit 2
}
action=${1:-toggle}

# The feature is on when the flag is absent.
is_on() { [[ ! -e $FLAG ]]; }

case $action in
on | off) ;;
toggle) if is_on; then action=off; else action=on; fi ;;
status)
    if is_on; then echo on; else echo off; fi
    exit 0
    ;;
*)
    usage >&2
    exit 2
    ;;
esac

if [[ $action == off ]]; then
    write_user_file "$FLAG" </dev/null
else
    run rm -f -- "$FLAG"
fi
$DRY_RUN && exit 0
echo "Screensaver $action"
if have notify-send; then
    notify-send -a haseen -u low "Screensaver $action" 2>/dev/null || true
fi
