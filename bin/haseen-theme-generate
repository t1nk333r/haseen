#!/usr/bin/env bash
# haseen:summary Build a theme from an image with matugen (Material You) and switch to it
# haseen:args <image> [--name N] [--scheme S] [--mode dark|light] [--no-apply] [--json] [--dry-run]
#
# matugen (InioX/matugen, GPL-2.0) runs as a separate program and only prints
# JSON (`--json hex --dry-run`); haseen takes no code from it. Its Material
# roles are mapped to colors.toml keys here, the anchors go through the same
# contrast floors as plan 064's palette clamp (core/internal/palette
# anchors.go: text 4.5:1, accent 3:1), measured and mixed with theme-lib's
# _theme_contrast and _theme_mix, and the image is copied in as the theme's
# background. The result is an ordinary user theme, so `haseen theme set`
# renders every template exactly as for a stock one.
set -Eeuo pipefail

BIN_DIR="$(dirname "$(readlink -f "$0")")"
HASEEN_PATH="${HASEEN_PATH:-$BIN_DIR/../share/haseen}"
export PATH="$BIN_DIR:$PATH"
# shellcheck source=../share/haseen/lib/common.sh
source "$HASEEN_PATH/lib/common.sh"
# shellcheck source=../share/haseen/layers/theme/theme-lib.sh
source "$HASEEN_PATH/layers/theme/theme-lib.sh"

MATUGEN_CONFIG="$HASEEN_PATH/layers/theme/matugen.toml"
# matugen's scheme types without the scheme- prefix. scheme-smart is left out:
# it picks one of these by itself, which a picker that names them only hides.
SCHEMES=(tonal-spot content expressive fidelity fruit-salad monochrome neutral rainbow vibrant)
# The first line of every colors.toml this command writes. A theme directory
# whose colors.toml starts otherwise is the user's and is never replaced.
GENERATED_MARK='# Generated by `haseen theme generate`'
# What theme_backgrounds finds; matugen reads these too.
IMAGE_TYPES=(jpg jpeg png webp gif bmp)
# Plan 064's floors (WCAG ratio x100, the unit _theme_contrast returns).
MIN_TEXT=450
MIN_ACCENT=300

usage() {
    cat <<EOF
Usage: haseen theme generate <image> [--name N] [--scheme S] [--mode dark|light]
                             [--no-apply] [--json] [--dry-run]

Runs matugen on the image and writes its Material You colours as the theme
<name> in ~/.config/haseen/themes/<name>/, with a copy of the image as the
theme's background, then switches to it. Foreground, accent and selection are
held to readable contrast (text 4.5:1, accent 3:1) and moved when they fall
short.

  --name N     theme name (default: the image's file name, e.g. Blue_Hour.jpg
               -> blue-hour). A stock theme's name, or a theme of yours that
               this command did not write, is refused.
  --scheme S   matugen scheme: ${SCHEMES[*]}
               (default: tonal-spot)
  --mode M     dark (default) or light
  --no-apply   write the theme but do not switch to it
  --json       print the palette as JSON and write nothing (the theme
               generator panel's preview)

Needs matugen (haseen install package matugen). The panel is haseen.themegen:
haseen plugin enable haseen.themegen, then menu Style > Theme Generator.
EOF
}

# slug FILE — the default theme name: the file name without its extension,
# lowercased, every run of other characters one dash, at most 48 characters.
# haseen.themegen's Themegen.js defaultName() is the same rule.
slug() {
    local s="${1##*/}"
    s="${s%.*}"
    s="$(printf '%s' "${s,,}" | LC_ALL=C tr -cs 'abcdefghijklmnopqrstuvwxyz0123456789' '-')"
    s="${s#-}"
    s="${s:0:48}"
    s="${s%-}"
    printf '%s' "${s:-generated}"
}

# far_end REF — REPLY = white or black, whichever contrasts more with REF: the
# direction plan 064's clampContrast moves a colour in.
far_end() {
    local white
    _theme_contrast "$1" "#ffffff"
    white=$REPLY
    _theme_contrast "$1" "#000000"
    if ((white >= REPLY)); then REPLY="#ffffff"; else REPLY="#000000"; fi
}

# clamp KEY REF FLOOR END — mix OUT[KEY] toward END in 5% steps until its
# contrast with REF reaches FLOOR; a colour that already passes is kept, so
# the clamp is idempotent. A move is recorded in CLAMPED.
clamp() {
    local key="$1" ref="$2" floor="$3" end="$4" colour="${OUT[$1]}" before amount
    _theme_contrast "$colour" "$ref" || die "matugen gave $key a value that is not a colour: $colour"
    before=$REPLY
    ((before >= floor)) && return 0
    for ((amount = 5; amount <= 100; amount += 5)); do
        _theme_mix "$colour" "$end" "$amount%"
        OUT[$key]=$REPLY
        _theme_contrast "${OUT[$key]}" "$ref"
        ((REPLY >= floor)) && break
    done
    CLAMPED+=("$key $(ratio "$before") -> $(ratio "$REPLY")")
}

ratio() { printf '%d.%02d:1' "$(($1 / 100))" "$(($1 % 100))"; }

# matugen_error — the cause from matugen's report ("Error:" then "   0: cause").
matugen_error() {
    local cause
    cause="$(sed -n 's/^ *0: //p' "$err" | head -n 1)"
    printf '%s' "${cause:-$(grep -m 1 . "$err" || echo "exit status $1")}"
}

name=""
scheme=tonal-spot
mode=dark
apply=true
json=false
REST=()
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
    case "${args[i]}" in
    --name) name="${args[++i]:-}" ;;
    --scheme) scheme="${args[++i]:-}" ;;
    --mode) mode="${args[++i]:-}" ;;
    --no-apply) apply=false ;;
    --json) json=true ;;
    *) REST+=("${args[i]}") ;;
    esac
done
parse_common_flags "${REST[@]+"${REST[@]}"}"
set -- "${REST[@]+"${REST[@]}"}"
(($# == 1)) || {
    usage >&2
    exit 2
}
image="$(readlink -f -- "$1")" || die "no such image: $1"
[[ -f $image ]] || die "no such image: $1"
ext="${image##*.}"
ext="${ext,,}"
[[ " ${IMAGE_TYPES[*]} " == *" $ext "* ]] || die "not an image haseen can use as a background (${IMAGE_TYPES[*]}): $1"
scheme="${scheme#scheme-}"
[[ " ${SCHEMES[*]} " == *" $scheme "* ]] || die "unknown scheme '$scheme' (${SCHEMES[*]})"
[[ $mode == dark || $mode == light ]] || die "mode must be dark or light, not '$mode'"
[[ -n $name ]] || name="$(slug "$image")"
[[ $name =~ ^[a-z0-9][a-z0-9._-]*$ ]] || die "invalid theme name: $name"
have matugen || die "matugen is not installed (haseen install package matugen)"

theme_dir="$THEME_USER_DIR/$name"
colors="$theme_dir/colors.toml"
background="$theme_dir/backgrounds/$(slug "$image").$ext"

# Whose the name is: new, an earlier run of this command, a stock theme, or a
# theme of the user's own. The panel shows it before Save.
target=new
if [[ -d $THEME_STOCK_DIR/$name ]]; then
    target=stock
elif [[ -e $theme_dir || -L $theme_dir ]]; then
    target=taken
    if [[ -d $theme_dir && ! -L $theme_dir && -f $colors && ! -L $colors ]] &&
        [[ "$(head -n 1 "$colors")" == "$GENERATED_MARK"* ]]; then
        target=generated
    fi
fi

# --- matugen -----------------------------------------------------------------
# --dry-run: no templates, hooks or wallpaper, only the JSON. -c: never the
# user's own matugen config. --source-color-index 0: the most dominant colour,
# without the interactive prompt matugen shows when an image has several.
err="$(mktemp)"
trap 'rm -f "$err"' EXIT
scheme_json="$(matugen image "$image" -t "scheme-$scheme" -m "$mode" --json hex --dry-run -q \
    --source-color-index 0 -c "$MATUGEN_CONFIG" 2>"$err")" ||
    die "matugen could not read colours from $1: $(matugen_error $?)"

declare -A M=()
while IFS=$'\t' read -r key value; do
    [[ $value =~ ^#[0-9a-fA-F]{6}$ ]] && M[$key]="${value,,}"
done < <(jq -r '(.colors | to_entries[] | [.key, .value.default.color]),
    (.palettes.neutral // {} | to_entries[] | ["neutral_\(.key)", .value.color]) | @tsv' <<<"$scheme_json" 2>/dev/null)
source_colour="${M[source_color]:-}"
[[ -n $source_colour ]] || die "matugen printed no source colour for $1"

# The ANSI hues come from a tonal-spot scheme of the same source colour (see
# matugen.toml): `matugen color` costs no image decode.
ansi_json="$(matugen color hex "$source_colour" -t scheme-tonal-spot -m "$mode" --json hex --dry-run -q \
    -c "$MATUGEN_CONFIG" 2>"$err")" || die "matugen could not build terminal colours: $(matugen_error $?)"
declare -A A=()
while IFS=$'\t' read -r key value; do
    [[ $value =~ ^#[0-9a-fA-F]{6}$ ]] && A[$key]="${value,,}"
done < <(jq -r '.colors | to_entries[] | [.key, .value.default.color] | @tsv' <<<"$ansi_json" 2>/dev/null)

# --- Material roles -> colors.toml -------------------------------------------
# The surface and its text; the primary role is the accent; the secondary
# container is the selection (Material's own choice for a selected row). The
# brighter foreground is a near-white neutral in dark mode, a near-black in
# light. Darker backgrounds are left to theme-lib's derived shades.
bright_tone=95
[[ $mode == light ]] && bright_tone=5
declare -A ROLE=(
    [background]=surface [foreground]=on_surface [accent]=primary
    [selection]=secondary_container [selection_foreground]=on_secondary_container
    [muted]=outline [dark_foreground]=on_surface_variant
    [lighter_background]=surface_container_high [bright_foreground]="neutral_$bright_tone"
)
declare -A OUT=([mode]=$mode)
for key in "${!ROLE[@]}"; do
    OUT[$key]="${M[${ROLE[$key]}]:-}"
    [[ -n ${OUT[$key]} ]] || die "matugen printed no ${ROLE[$key]} for $1"
done
# Each hue at its Material tone (80 dark, 40 light), and the bright variant
# halfway to its on-container tone (90 / 10): further from the background.
for hue in red yellow green cyan blue magenta; do
    [[ -n ${A[$hue]:-} && -n ${A[on_${hue}_container]:-} ]] || die "matugen printed no $hue"
    OUT[$hue]="${A[$hue]}"
    _theme_mix "${A[$hue]}" "${A[on_${hue}_container]}" 50%
    OUT[bright_$hue]=$REPLY
done

# --- readability clamp (plan 064 floors) -------------------------------------
CLAMPED=()
far_end "${OUT[background]}"
end=$REPLY
clamp foreground "${OUT[background]}" "$MIN_TEXT" "$end"
clamp accent "${OUT[background]}" "$MIN_ACCENT" "$end"
# The shell draws foreground text on the selection: pull it toward the
# background, which the clamped foreground already reads on.
clamp selection "${OUT[foreground]}" "$MIN_TEXT" "${OUT[background]}"
OUT[selection_background]="${OUT[selection]}"

KEYS=(accent selection selection_background selection_foreground muted
    background lighter_background foreground dark_foreground bright_foreground
    red yellow green cyan blue magenta
    bright_red bright_yellow bright_green bright_cyan bright_blue bright_magenta)

if $json; then
    for key in "${KEYS[@]}"; do printf '%s\t%s\n' "$key" "${OUT[$key]}"; done |
        jq -Rn --arg name "$name" --arg scheme "$scheme" --arg mode "$mode" --arg image "$image" \
            --arg source "$source_colour" --arg target "$target" --arg clamped "$(printf '%s\n' "${CLAMPED[@]+"${CLAMPED[@]}"}")" '
            {name: $name, scheme: $scheme, mode: $mode, image: $image, source: $source, target: $target,
             clamped: ($clamped | split("\n") | map(select(. != ""))),
             colors: ([inputs | split("\t") | {(.[0]): .[1]}] | add)}'
    exit 0
fi

case $target in
stock) die "$name is a stock theme; pick another --name" ;;
taken) die "$theme_dir is a theme of yours that haseen theme generate did not write; pick another --name" ;;
esac

toml() {
    printf '%s: matugen scheme-%s, %s, source %s.\n' "$GENERATED_MARK" "$scheme" "$mode" "$source_colour"
    printf 'mode = "%s"\n' "$mode"
    local key
    for key in "${KEYS[@]}"; do
        case $key in accent | background | foreground | red | bright_red) printf '\n' ;; esac
        printf '%s = "%s"\n' "$key" "${OUT[$key]}"
    done
}
generated="$(toml)"

for line in "${CLAMPED[@]+"${CLAMPED[@]}"}"; do info "clamped $line"; done

if $DRY_RUN; then
    echo "DRYRUN: write $colors (matugen scheme-$scheme, $mode, source $source_colour)"
    echo "DRYRUN: copy $image to $background"
    $apply && echo "DRYRUN: haseen theme set $name"
    exit 0
fi

mkdir -p "$theme_dir/backgrounds"
# One run per theme at a time (Save then Apply in the panel, or two terminals):
# a lock on the directory itself, so no lock file lands in the theme.
exec 9<"$theme_dir"
flock 9

# Byte-compare before writing: an unchanged palette must not touch the file, so
# nothing downstream (theme set, the shell's FileView, hooks) reacts.
if [[ -f $colors ]] && [[ "$(cat "$colors")" == "$generated" ]]; then
    info "palette unchanged for $name"
else
    printf '%s\n' "$generated" >"$colors.new"
    mv -f -- "$colors.new" "$colors"
    info "wrote $colors"
fi

# A copy, not a link: the theme keeps its background when the picture is moved
# or deleted. Images from an earlier run of this theme go.
if [[ "$(readlink -f -- "$background" 2>/dev/null || true)" != "$image" ]] && ! cmp -s -- "$image" "$background"; then
    cp -- "$image" "$background.new"
    mv -f -- "$background.new" "$background"
fi
find "$theme_dir/backgrounds" -mindepth 1 -maxdepth 1 ! -name "${background##*/}" -exec rm -rf -- {} +

$apply || exit 0
haseen-theme-set "$name"
