#!/usr/bin/env bash
# haseen:summary Start an explicitly selected installed service after exposure confirmation
# haseen:args [--dry-run] [--yes] [--expect-unit UNIT] [--expect-fragment PATH] SERVICE
set -Eeuo pipefail
source "${HASEEN_PATH:-$(dirname "$(readlink -f "$0")")/../share/haseen}/lib/common.sh"
source "$HASEEN_PATH/layers/vapt/workflow_actions.sh"
usage() { echo "Usage: haseen vapt service-start [--dry-run] [--yes] [--expect-unit UNIT] [--expect-fragment PATH] SERVICE"; }
parse_common_flags "$@"
vapt_service_cli start "${REST[@]}"
