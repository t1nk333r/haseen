[Unit]
Description=haseen: lock the screen before the machine sleeps
PartOf=graphical-session.target
After=graphical-session.target haseen-shell.service

[Service]
Type=simple
ExecStart=/usr/bin/env haseen lock before sleep
Restart=on-failure
RestartSec=2
Slice=app-graphical.slice

[Install]
WantedBy=graphical-session.target
