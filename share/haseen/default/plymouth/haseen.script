# haseen's Plymouth theme: the boot screen, and the box that asks for the disk
# password. Drawn, not composed from images, so a theme change is three colour
# substitutions; the two images, haseen's mark (logo.png, from the selected
# mark's SVG) and a solid square (block.png), are rendered in the accent
# colour when the theme is installed, so no binary asset lives in this
# repository either.
#
# Every string drawn here is ASCII (plan 174). In the initramfs plymouthd
# runs in the C locale, and its freetype label plugin decodes text with
# mbrtowc (src/plugins/controls/label-freetype/plugin.c, load_glyph), which
# fails there on any multibyte character: a block or a bullet comes out as
# the font's missing-glyph box. Solid shapes are block.png, stretched.
#
# haseen-plymouth-set substitutes the colour placeholders below with the
# current theme's values before installing this file.

bg_r = @@BG_R@@;
bg_g = @@BG_G@@;
bg_b = @@BG_B@@;
fg_r = @@FG_R@@;
fg_g = @@FG_G@@;
fg_b = @@FG_B@@;
accent_r = @@ACCENT_R@@;
accent_g = @@ACCENT_G@@;
accent_b = @@ACCENT_B@@;

Window.SetBackgroundTopColor(bg_r, bg_g, bg_b);
Window.SetBackgroundBottomColor(bg_r, bg_g, bg_b);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
# The screen's exact centre, in whole pixels: the scanner and the password
# prompt are centred on it in both directions, and the mark sits above it.
centre_x = Math.Int(screen_width / 2);
centre_y = Math.Int(screen_height / 2);

# --- the mark: above the password prompt, so it stays while the disk asks ----

logo = Image("logo.png");
if (logo) {
    logo_sprite = Sprite(logo);
    logo_sprite.SetX(centre_x - Math.Int(logo.GetWidth() / 2));
    logo_sprite.SetY(centre_y - 72 - logo.GetHeight());
    logo_sprite.SetZ(1);
}

# --- the scanner: a KITT sweep, so a slow boot does not look hung ------------
# One lit segment runs back and forth along a dim track, leaving a fading
# trail of ghosts at the positions it just passed.

track_width = Math.Int(screen_width / 4);
track_x = centre_x - Math.Int(track_width / 2);
bar_height = 4;
bar_y = centre_y - bar_height / 2;
seg_width = track_width / 6;
travel = track_width - seg_width;

# Plymouth's script module cannot make a blank image or set pixels (its Image
# is a file, a text label, or a transform of one): block.png, a square in the
# accent colour, stretched, is each bar. Without it (no ImageMagick when the
# theme was installed) an ASCII underscore stands in, so nothing draws as a
# missing glyph.
block = Image("block.png");
if (!block)
    block = Image.Text("_", accent_r, accent_g, accent_b);
seg = block.Scale(seg_width, bar_height);
track = block.Scale(track_width, bar_height);
track_sprite = Sprite(track);
track_sprite.SetX(track_x);
track_sprite.SetY(bar_y);
track_sprite.SetZ(1);
track_sprite.SetOpacity(0.12);

# Head plus four ghosts; ghost i shows where the head was i * lag frames ago.
ghosts = 5;
lag = 3;
for (i = 0; i < ghosts; i++) {
    scan[i] = Sprite(seg);
    scan[i].SetY(bar_y);
    scan[i].SetZ(2 + ghosts - i);
    scan[i].SetOpacity(1 / (1 + i * 1.2));
}

# Ping-pong position of frame t: 0 .. travel .. 0 over 2 * steps frames.
steps = 45;
fun scan_x(t) {
    if (t < 0)
        t = 0;
    p = t % (2 * steps);
    if (p > steps)
        p = 2 * steps - p;
    return track_x + travel * p / steps;
}

progress = 0;
fun show_scanner(on) {
    track_sprite.SetOpacity(0.12 * on);
    for (i = 0; i < ghosts; i++)
        scan[i].SetOpacity(on / (1 + i * 1.2));
}

# The script plugin calls this 50 times a second (FRAMES_PER_SECOND).
fun refresh_callback() {
    progress++;
    for (i = 0; i < ghosts; i++)
        scan[i].SetX(scan_x(progress - i * lag));
    caret_sprite.SetOpacity(prompt_on * caret_opacity(progress - caret_epoch));
}
Plymouth.SetRefreshFunction(refresh_callback);

# --- the password prompt -----------------------------------------------------
# No text on the splash: boot messages are ignored, and the disk password is
# asked with asterisks only. The field is KITT meets Person of Interest (owner,
# 2026-10-08): four thin corner brackets frame it like the Machine's
# surveillance boxes, and a block caret in the scanner's accent pulses at 1 Hz
# where the next asterisk goes, so the prompt shows before the first key.
# The caret and the arms are block.png stretched; the caret is one asterisk's
# cell, so it lines up with the text.
# The field takes the scanner's place: as wide as its track, centred on the
# screen's centre. Inside it the asterisks and the caret are one line,
# centred on the same point, so the prompt stays in the middle as it grows.

prompt_font = "Monospace 14";
prompt_pad = 12;
bracket_arm = 12;
bracket_line = 2;
bracket_opacity = 0.6;
# One blink is 50 frames, 1 s: lit for the first half, then the scanner's
# ghost falloff (1 / (1 + i * 1.2), i in trail steps of `lag` frames) fades it
# out, the way a KITT segment dies away. A key press restarts the cycle lit.
blink_frames = 50;

cell = Image.Text("*", accent_r, accent_g, accent_b, 1, prompt_font);
caret_image = block.Scale(cell.GetWidth(), cell.GetHeight());
caret_sprite = Sprite(caret_image);
caret_sprite.SetZ(11);
caret_sprite.SetOpacity(0);
arm_h = block.Scale(bracket_arm, bracket_line);
arm_v = block.Scale(bracket_line, bracket_arm);
# Corner c: horizontal arm bracket[c], vertical arm bracket[c + 4]; corners
# 1 and 3 are on the right, 2 and 3 at the bottom.
for (i = 0; i < 4; i++) {
    bracket[i] = Sprite(arm_h);
    bracket[i + 4] = Sprite(arm_v);
}
for (i = 0; i < 8; i++) {
    bracket[i].SetZ(10);
    bracket[i].SetOpacity(0);
}

bullets_sprite = Sprite();
bullets_sprite.SetZ(10);

prompt_on = 0;
caret_epoch = 0;

fun caret_opacity(t) {
    p = t % blink_frames;
    if (p < blink_frames / 2)
        return 1;
    return 1 / (1 + (p - blink_frames / 2 + 1) / lag * 1.2);
}

fun place_bracket(c, right, bottom, left_x, top_y, width, height) {
    hx = left_x;
    vx = left_x;
    if (right) {
        hx = left_x + width - bracket_arm;
        vx = left_x + width - bracket_line;
    }
    hy = top_y;
    vy = top_y;
    if (bottom) {
        hy = top_y + height - bracket_line;
        vy = top_y + height - bracket_arm;
    }
    bracket[c].SetX(hx);
    bracket[c].SetY(hy);
    bracket[c + 4].SetX(vx);
    bracket[c + 4].SetY(vy);
}

# Lay the field out around text_width pixels of asterisks: the asterisks and
# the caret after them centred as one line on the screen's centre, the
# brackets around them, widening past the track when a long passphrase needs
# it.
fun layout_prompt(text_width) {
    gap = 0;
    if (text_width > 0)
        gap = 2;
    line_width = text_width + gap + caret_image.GetWidth();
    field_width = track_width;
    if (line_width + 2 * prompt_pad > field_width)
        field_width = line_width + 2 * prompt_pad;
    field_height = caret_image.GetHeight() + 2 * prompt_pad;
    left_x = centre_x - Math.Int(field_width / 2);
    top_y = centre_y - Math.Int(field_height / 2);
    line_x = centre_x - Math.Int(line_width / 2);
    line_y = centre_y - Math.Int(caret_image.GetHeight() / 2);
    place_bracket(0, 0, 0, left_x, top_y, field_width, field_height);
    place_bracket(1, 1, 0, left_x, top_y, field_width, field_height);
    place_bracket(2, 0, 1, left_x, top_y, field_width, field_height);
    place_bracket(3, 1, 1, left_x, top_y, field_width, field_height);
    bullets_sprite.SetX(line_x);
    bullets_sprite.SetY(line_y);
    caret_sprite.SetX(line_x + text_width + gap);
    caret_sprite.SetY(line_y);
}

fun show_prompt(on) {
    prompt_on = on;
    for (i = 0; i < 8; i++)
        bracket[i].SetOpacity(bracket_opacity * on);
    bullets_sprite.SetOpacity(on);
    caret_sprite.SetOpacity(on);
}

fun display_password_callback(prompt, bullets) {
    show_scanner(0);

    # One asterisk per typed character (owner's choice), drawn as text so no
    # image ships with it.
    text_width = 0;
    if (bullets > 0) {
        dots = "";
        for (i = 0; i < bullets; i++)
            dots += "*";
        dot_image = Image.Text(dots, accent_r, accent_g, accent_b, 1, prompt_font);
        bullets_sprite.SetImage(dot_image);
        text_width = dot_image.GetWidth();
    }
    layout_prompt(text_width);
    show_prompt(1);
    if (bullets == 0)
        bullets_sprite.SetOpacity(0);
    caret_epoch = progress;
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    show_prompt(0);
    show_scanner(1);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun quit_callback() {
    show_scanner(0);
    show_prompt(0);
}
Plymouth.SetQuitFunction(quit_callback);
