[Plymouth Theme]
Name=haseen
Description=haseen boot screen, coloured by the current theme
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/haseen
ScriptFile=/usr/share/plymouth/themes/haseen/haseen.script
# The label font; the plymouth hook copies it into the initramfs. Inter has the
# bullet the password dots and the progress bar are drawn with.
Font=Inter 14
