# haseen fcitx5 defaults. Seeded once; fcitx5 owns the file afterwards.
#
# Switching: Super+i toggles between the group's first method (keyboard-us)
# and the last used one (keyboard-ara), the key Omarchy 4.5 gives "Switch input
# language". Not fcitx5's default Control+space: that is the prefix of the
# shipped herdr and tmux configs (../herdr/config.toml, ../tmux/tmux.conf), and
# fcitx5 sees a key before the focused terminal does (plan 190). Super+i is
# free in ../hypr/binds.lua, where SUPER+SPACE and every modifier on it are
# taken, and in herdr, tmux and foot.

[Hotkey]
# Pressing the trigger again walks the group instead of toggling, which makes
# the same key work if a third method is added later.
EnumerateWithTriggerKeys=True

[Hotkey/TriggerKeys]
0=Super+i

[Hotkey/AltTriggerKeys]
# Hold Shift to go back to the first method for as long as it is held.
0=Shift_L

[Hotkey/EnumerateForwardKeys]
0=Control+Shift_R

[Hotkey/EnumerateBackwardKeys]
0=Control+Shift_L

[Behavior]
# Sessions start in English; Super+i turns Arabic on.
ActiveByDefault=False
# Per-window state: the terminal stays English while a chat window stays Arabic.
ShareInputState=No
# A short on-screen note on switch, so the current script is never a guess.
ShowInputMethodInformation=True
ShowFirstInputMethodInformation=True
