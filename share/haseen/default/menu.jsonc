  "remove.development.symfony": {"icon":"","label":"Symfony","when":"haseen-pkg-present symfony-cli","action":"haseen remove package symfony-cli"},
  "remove.development.phoenix": {"icon":"","label":"Phoenix","when":"compgen -G \"$HOME/.mix/archives/phx_new*\"","action":"haseen config terminal -- mix archive.uninstall phx_new --force"},
  "remove.development.ocaml": {"icon":"","label":"OCaml","when":"haseen-pkg-present opam","action":"haseen remove package ocaml opam"},
