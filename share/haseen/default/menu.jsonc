{
  // haseen menu (plugin haseen.menu). Open with `haseen menu [path]`.
  // Format and engine adapted from Omarchy default/omarchy/omarchy-menu.jsonc
  // (MIT, Copyright (c) David Heinemeier Hansson). The tree is Omarchy 4's,
  // in its order, each row running haseen's command for it, with haseen's own
  // rows in the section they fit (plan 068, "Merged tree").
  //
  // Ids are object keys; dotted ids imply the tree (trigger.capture.qr sits
  // under trigger.capture). An entry with "action" runs it in bash, one with
  // "target" links to another submenu, anything else is a submenu.
  // Optional fields:
  //   aliases   extra names for `haseen menu <name>`; also searched
  //   title     header shown inside the submenu (defaults to label)
  //   parent    puts the entry under another id than its dotted prefix
  //   provider  fills the submenu when entered: apps, fonts,
  //             plugins-enable, plugins-disable, plugins-remove,
  //             catalog-install, catalog-remove
  //   when      bash guard; the row shows only once it succeeds
  //   checked   bash guard; appends ✓ when it succeeds
  //   disabled  bash guard; row stays listed, dim and unselectable
  //   hidden    true removes the entry (for ~/.config/haseen/menu.jsonc)
  // Guard helpers: haseen-pkg-present PKG…, haseen-cmd-present CMD…,
  // haseen-flag NAME (~/.local/state/haseen/flags/NAME exists).
  //
  // Install and Remove list the catalogue (default/catalog.json) by category.
  // The category submenus are declared here so they keep Omarchy's order; the
  // providers fill them, and a static row under one (install.gaming.xbox-cloud)
  // sits beside the catalogue's.
  //
  // Your overlay ~/.config/haseen/menu.jsonc merges key by key: name an id
  // and the fields to change, or a new id to add an entry.

  // Root Menu
  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications"],"provider":"apps"},
  "learn": {"icon":"󰧑","label":"Learn"},
  "trigger": {"icon":"󱓞","label":"Trigger"},
  "style": {"icon":"","label":"Style"},
  "setup": {"icon":"","label":"Setup","aliases":["settings"]},
  "install": {"icon":"󰉉","label":"Install","provider":"catalog-install"},
  "remove": {"icon":"󰭌","label":"Remove","aliases":["uninstall"],"provider":"catalog-remove"},
  "update": {"icon":"","label":"Update","aliases":["restart","refresh"]},
  "about": {"icon":"","label":"About","action":"haseen about"},
  "system": {"icon":"","label":"System","aliases":["power","power-menu"]},

  // Learn
  "learn.keybindings": {"icon":"","label":"Keybindings","aliases":["keybinds"],"action":"haseen keybinds list"},
  "learn.haseen": {"icon":"","label":"haseen","action":"xdg-open 'https://github.com/t1nk333r/haseen#readme'"},
  "learn.hyprland": {"icon":"","label":"Hyprland","action":"xdg-open 'https://wiki.hypr.land/'"},
  "learn.arch": {"icon":"󰣇","label":"Arch","action":"xdg-open 'https://wiki.archlinux.org/title/Main_page'"},
  "learn.neovim": {"icon":"","label":"Neovim","action":"xdg-open 'https://www.lazyvim.org/keymaps'"},
  "learn.bash": {"icon":"󱆃","label":"Bash","action":"xdg-open 'https://devhints.io/bash'"},
  "learn.tmux-keybindings": {"icon":"","label":"Tmux","when":"haseen-cmd-present tmux","action":"haseen tmux keybinds"},
  "learn.herdr-keybindings": {"icon":"","label":"Herdr","description":"herdr's config.toml: its key bindings","when":"haseen-cmd-present herdr","action":"haseen config edit \"${XDG_CONFIG_HOME:-$HOME/.config}/herdr/config.toml\""},

  // Trigger
  "trigger.emoji": {"icon":"","label":"Emoji","aliases":["emoji","emojis"],"action":"haseen shell ipc panel toggle haseen.emoji"},
  "trigger.reminder": {"icon":"󰢌","label":"Reminder","aliases":["reminder"]},
  "trigger.reminder.set": {"icon":"󰢌","label":"Set one","aliases":["reminder-set","remind"],"action":"haseen reminder set"},
  "trigger.reminder.show": {"icon":"󰢌","label":"Show all","action":"haseen reminder show"},
  "trigger.reminder.clear": {"icon":"󰢌","label":"Clear all","action":"haseen reminder clear"},
  "trigger.capture": {"icon":"","label":"Capture","aliases":["capture","screenshot","screenrecord","screen-record","screenrecording"]},
  "trigger.capture.screenshot": {"icon":"","label":"Screenshot","action":"haseen capture screenshot"},
  "trigger.capture.screenrecord-stop": {"icon":"","label":"Stop Screenrecording","when":"haseen-flag recording","action":"haseen capture screenrecord --stop"},
  "trigger.capture.screenrecord": {"icon":"","label":"Screenrecord","when":"! haseen-flag recording"},
  "trigger.capture.screenrecord.no-audio": {"icon":"","label":"With no audio","action":"haseen capture screenrecord"},
  "trigger.capture.screenrecord.desktop-audio": {"icon":"","label":"With desktop audio","action":"haseen capture screenrecord --desktop-audio"},
  "trigger.capture.screenrecord.microphone": {"icon":"","label":"With desktop + microphone audio","action":"haseen capture screenrecord --desktop-audio --microphone"},
  "trigger.capture.screenrecord.webcam": {"icon":"","label":"With desktop + microphone audio + webcam","when":"compgen -G '/dev/video*'","action":"haseen capture screenrecord --desktop-audio --microphone --webcam"},
  "trigger.capture.text": {"icon":"󰴑","label":"Text","action":"haseen capture text"},
  "trigger.capture.qr": {"icon":"󰐲","label":"QR Code","action":"haseen capture qr"},
  "trigger.capture.color": {"icon":"󰃉","label":"Color","action":"haseen capture color"},
  "trigger.transcode": {"icon":"󰧸","label":"Transcode","action":"haseen transcode"},
  "trigger.share": {"icon":"","label":"Share","aliases":["share"]},
  "trigger.share.clipboard": {"icon":"","label":"Clipboard","action":"haseen share clipboard"},
  "trigger.share.file": {"icon":"","label":"File","action":"haseen share file"},
  "trigger.share.folder": {"icon":"","label":"Folder","action":"haseen share folder"},
  "trigger.share.receive": {"icon":"󰥦","label":"Receive","action":"haseen share receive"},
  "trigger.toggle": {"icon":"󰔎","label":"Toggle","aliases":["toggle","toggles"]},
  "trigger.toggle.idle": {"icon":"󰅶","label":"Stay Awake","checked":"haseen-flag idle-off","action":"haseen toggle idle"},
  "trigger.toggle.dnd": {"icon":"󰂛","label":"Notifications","aliases":["dnd"],"description":"silence them","checked":"haseen-flag dnd","action":"haseen toggle dnd"},
  "trigger.toggle.screensaver": {"icon":"󱄄","label":"Screensaver","checked":"! haseen-flag screensaver-off","action":"haseen toggle screensaver"},
  "trigger.toggle.nightlight": {"icon":"󰔎","label":"Nightlight","checked":"haseen-flag nightlight","action":"haseen toggle nightlight"},
  "trigger.toggle.bar": {"icon":"󰍜","label":"Menu Bar","action":"haseen toggle bar"},
  "trigger.toggle.workspace-layout": {"icon":"󱂬","label":"Workspace Layout","action":"haseen toggle workspace-layout"},
  "trigger.toggle.gaps": {"icon":"","label":"Window Gaps","action":"haseen toggle gaps"},
  "trigger.toggle.one-window-ratio": {"icon":"","label":"1-Window Ratio","action":"haseen toggle one-window-ratio"},
  "trigger.toggle.animations": {"icon":"󰕟","label":"Animations","action":"haseen toggle animations"},
  "trigger.context": {"icon":"󰌨","label":"Context","aliases":["context","contexts"]},
  "trigger.context.normal": {"icon":"󰦛","label":"Normal","checked":"[[ \"$(haseen context status)\" == normal ]]","action":"haseen context normal"},
  "trigger.context.focus": {"icon":"󰣉","label":"Focus","checked":"[[ \"$(haseen context status)\" == focus ]]","action":"haseen context focus"},
  "trigger.context.game": {"icon":"󰊗","label":"Game","checked":"[[ \"$(haseen context status)\" == game ]]","action":"haseen context game"},
  "trigger.context.present": {"icon":"󰐨","label":"Present","checked":"[[ \"$(haseen context status)\" == present ]]","action":"haseen context present"},
  "trigger.context.auto-game": {"icon":"󰺷","label":"Game for Fullscreen Steam Games","checked":"[[ \"$(haseen context auto-game)\" != off ]]","action":"haseen context auto-game toggle"},
  "trigger.hardware": {"icon":"","label":"Hardware","aliases":["hardware","hw"]},
  "trigger.hardware.laptop-display": {"icon":"󰛧","label":"Laptop Display","when":"compgen -G '/sys/class/drm/card*-eDP-*'","action":"haseen hardware laptop-display"},
  "trigger.hardware.mirror-display": {"icon":"󰍹","label":"Mirror Display","when":"compgen -G '/sys/class/drm/card*-eDP-*'","action":"haseen hardware mirror-display"},
  "trigger.hardware.hybrid-gpu": {"icon":"","label":"Hybrid GPU","when":"compgen -G '/sys/class/drm/card1'","action":"haseen hardware hybrid-gpu"},
  "trigger.hardware.touchpad": {"icon":"󰟸","label":"Touchpad","when":"grep -qi touchpad /proc/bus/input/devices","action":"haseen hardware touchpad"},
  "trigger.hardware.touchpad-haptics": {"icon":"󰌌","label":"Touchpad Haptics"},
  "trigger.hardware.touchpad-haptics.low": {"icon":"󰌌","label":"low","when":"haseen-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == low ]]","action":"dell-xps-touchpad-haptics set low"},
  "trigger.hardware.touchpad-haptics.mid": {"icon":"󰌌","label":"mid","when":"haseen-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == mid ]]","action":"dell-xps-touchpad-haptics set mid"},
  "trigger.hardware.touchpad-haptics.high": {"icon":"󰌌","label":"high","when":"haseen-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == high ]]","action":"dell-xps-touchpad-haptics set high"},
  "trigger.hardware.touchscreen": {"icon":"󰆽","label":"Touchscreen","when":"grep -qi touchscreen /proc/bus/input/devices","action":"haseen hardware touchscreen"},
  "trigger.tests": {"icon":"󰓅","label":"Speed Test"},
  "trigger.tests.network": {"icon":"󰓅","label":"Network Speed Test","action":"haseen test network"},
  "trigger.tests.disk": {"icon":"󰋊","label":"Disk Speed Test","action":"haseen test disk"},

  // Style
  "style.theme": {"icon":"󰸌","label":"Theme","aliases":["theme","themes"],"action":"haseen shell ipc panel toggle haseen.themepicker"},
  "style.theme-generator": {"icon":"󰏘","label":"Theme Generator","aliases":["themegen","matugen","generate"],"description":"theme from an image (matugen)","when":"jq -e '.plugins[\"haseen.themegen\"].enabled == true' \"${XDG_CONFIG_HOME:-$HOME/.config}/haseen/shell.json\"","action":"haseen shell ipc panel toggle haseen.themegen"},
  "style.background": {"icon":"","label":"Background","aliases":["background","wallpaper"],"action":"haseen shell ipc panel toggle haseen.background"},
  "style.next-background": {"icon":"","label":"Next background","action":"haseen theme bg next"},
  "style.unlock": {"icon":"󰟵","label":"Unlock","aliases":["unlock","plymouth"],"description":"boot splash in the current theme's colours","action":"haseen config terminal -- haseen plymouth set"},
  "style.font": {"icon":"","label":"Font","aliases":["font"],"provider":"fonts"},
  "style.bar": {"icon":"󰍜","label":"Menu Bar"},
  "style.bar.position": {"icon":"","label":"Position"},
  "style.bar.position.top": {"icon":"󰁝","label":"Top","action":"haseen bar position top"},
  "style.bar.position.bottom": {"icon":"󰁅","label":"Bottom","action":"haseen bar position bottom"},
  "style.bar.position.left": {"icon":"󰁍","label":"Left","action":"haseen bar position left"},
  "style.bar.position.right": {"icon":"󰁔","label":"Right","action":"haseen bar position right"},
  "style.bar.transparency": {"icon":"󰂵","label":"Transparency","action":"haseen bar transparent toggle"},
  "style.bar.arrange": {"icon":"","label":"Arrange widgets","aliases":["arrange"],"action":"haseen bar arrange on"},
  "style.hyprland": {"icon":"","label":"Hyprland","description":"local.lua: look and feel, input and the rest","action":"haseen config edit \"$HOME/.config/hypr/local.lua\""},
  "style.screensaver": {"icon":"󱄄","label":"Screensaver"},
  "style.screensaver.text": {"icon":"","label":"Edit Text","action":"haseen branding screensaver text"},
  "style.screensaver.image": {"icon":"","label":"Set From Image","action":"haseen branding screensaver image"},
  "style.screensaver.default": {"icon":"","label":"Restore Default","action":"haseen branding screensaver reset"},
  "style.screensaver.style-ttfx": {"icon":"󱄄","label":"Text effects (ttfx)","checked":"[[ \"$(haseen screensaver style)\" == ttfx ]]","action":"haseen screensaver style ttfx"},
  "style.screensaver.style-native": {"icon":"󱄄","label":"Native","checked":"[[ \"$(haseen screensaver style)\" == native ]]","action":"haseen screensaver style native"},
  "style.screensaver.preview": {"icon":"","label":"Preview","action":"haseen screensaver --force"},
  "style.about": {"icon":"","label":"About"},
  "style.about.text": {"icon":"","label":"Edit Text","action":"haseen branding about text"},
  "style.about.image": {"icon":"","label":"Set From Image","action":"haseen branding about image"},
  "style.about.default": {"icon":"","label":"Restore Default","action":"haseen branding about reset"},
  "style.mark": {"icon":"󰷽","label":"Mark","aliases":["mark","logo","branding"],"title":"haseen's Mark"},
  "style.mark.kufic": {"icon":"󰷽","label":"Kufic","checked":"[[ \"$(haseen branding mark)\" == kufic ]]","action":"haseen branding mark kufic"},
  "style.mark.shield": {"icon":"󰷽","label":"Shield","checked":"[[ \"$(haseen branding mark)\" == shield ]]","action":"haseen branding mark shield"},
  "style.mark.gate": {"icon":"󰷽","label":"Gate","checked":"[[ \"$(haseen branding mark)\" == gate ]]","action":"haseen branding mark gate"},

  // Setup
  "setup.monitors": {"icon":"󰍹","label":"Monitors","action":"haseen config edit \"$HOME/.config/hypr/monitors.lua\""},
  "setup.display": {"icon":"󰃟","label":"Display","aliases":["brightness","backlight","display-panel"],"description":"brightness sliders, night light","when":"jq -e '.plugins[\"haseen.display\"].enabled == true' \"${XDG_CONFIG_HOME:-$HOME/.config}/haseen/shell.json\"","action":"haseen shell ipc panel toggle haseen.display"},
  "setup.keybindings": {"icon":"","label":"Keybindings","action":"haseen config edit \"$HOME/.config/hypr/bindings.lua\""},
  "setup.input": {"icon":"","label":"Input","description":"local.lua: input and anything else","action":"haseen config edit \"$HOME/.config/hypr/local.lua\""},
  "setup.kblayout": {"icon":"","label":"Keyboard Layout in the Bar","aliases":["kblayout","keyboard-layout"]},
  "setup.kblayout.on": {"icon":"󰄬","label":"Show","checked":"jq -e '.plugins[\"haseen.kblayout\"].enabled == true' \"${XDG_CONFIG_HOME:-$HOME/.config}/haseen/shell.json\"","action":"haseen plugin enable haseen.kblayout"},
  "setup.kblayout.off": {"icon":"󰅖","label":"Hide","action":"haseen plugin disable haseen.kblayout"},
  "setup.launcher": {"icon":"󰀻","label":"Launcher Prefixes","aliases":["launcher-prefixes","launcher-providers"],"title":"Launcher Prefixes"},
  "setup.launcher.windows": {"icon":"󰀻","label":"@ Windows","description":"switch to an open window"},
  "setup.launcher.windows.on": {"icon":"󰄬","label":"On","checked":"jq -e '.plugins[\"haseen.windows\"].enabled == true' \"${XDG_CONFIG_HOME:-$HOME/.config}/haseen/shell.json\"","action":"haseen plugin enable haseen.windows"},
  "setup.launcher.windows.off": {"icon":"󰅖","label":"Off","action":"haseen plugin disable haseen.windows"},
  "setup.launcher.emoji": {"icon":"","label":": Emoji","description":"search emoji, Enter copies"},
  "setup.launcher.emoji.on": {"icon":"󰄬","label":"On","checked":"jq -e '.plugins[\"haseen.emojisearch\"].enabled == true' \"${XDG_CONFIG_HOME:-$HOME/.config}/haseen/shell.json\"","action":"haseen plugin enable haseen.emojisearch"},
  "setup.launcher.emoji.off": {"icon":"󰅖","label":"Off","action":"haseen plugin disable haseen.emojisearch"},
  "setup.launcher.commands": {"icon":"","label":"/ Commands","description":"the menu's actions"},
  "setup.launcher.commands.on": {"icon":"󰄬","label":"On","checked":"jq -e '.plugins[\"haseen.commands\"].enabled == true' \"${XDG_CONFIG_HOME:-$HOME/.config}/haseen/shell.json\"","action":"haseen plugin enable haseen.commands"},
  "setup.launcher.commands.off": {"icon":"󰅖","label":"Off","action":"haseen plugin disable haseen.commands"},
  "setup.launcher.web": {"icon":"","label":"? Web Search","description":"open a search in the browser"},
  "setup.launcher.web.on": {"icon":"󰄬","label":"On","checked":"jq -e '.plugins[\"haseen.websearch\"].enabled == true' \"${XDG_CONFIG_HOME:-$HOME/.config}/haseen/shell.json\"","action":"haseen plugin enable haseen.websearch"},
  "setup.launcher.web.off": {"icon":"󰅖","label":"Off","action":"haseen plugin disable haseen.websearch"},
  "setup.keyd": {"icon":"󰌌","label":"CapsLock Hyper (keyd)","aliases":["keyd","hyper","capslock"]},
  "setup.keyd.status": {"icon":"󰌌","label":"Status","action":"haseen config terminal -- haseen setup keyd status"},
  "setup.keyd.on": {"icon":"󰄬","label":"Turn On","checked":"systemctl -q is-enabled keyd.service","action":"haseen setup keyd on"},
  "setup.keyd.off": {"icon":"󰅖","label":"Turn Off","action":"haseen setup keyd off"},
  "setup.ddc": {"icon":"󰍹","label":"Monitor Brightness (DDC/CI)","aliases":["ddc","ddcutil"]},
  "setup.ddc.status": {"icon":"󰍹","label":"Status","action":"haseen config terminal -- haseen setup ddc status"},
  "setup.ddc.on": {"icon":"󰄬","label":"Turn On","checked":"haseen-cmd-present ddcutil","action":"haseen setup ddc on"},
  "setup.ddc.off": {"icon":"󰅖","label":"Turn Off","action":"haseen setup ddc off"},
  "setup.network": {"icon":"󰛳","label":"Network","aliases":["network"]},
  "setup.network.dns": {"icon":"󰇖","label":"DNS","aliases":["dns"]},
  "setup.network.dns.dhcp": {"icon":"󰩟","label":"DHCP","checked":"[[ \"$(haseen setup dns)\" == dhcp ]]","action":"haseen setup dns dhcp"},
  "setup.network.dns.cloudflare": {"icon":"󰅟","label":"Cloudflare","checked":"[[ \"$(haseen setup dns)\" == cloudflare ]]","action":"haseen setup dns cloudflare"},
  "setup.network.dns.google": {"icon":"󰊭","label":"Google","checked":"[[ \"$(haseen setup dns)\" == google ]]","action":"haseen setup dns google"},
  "setup.network.dns.custom": {"icon":"","label":"Custom","checked":"[[ \"$(haseen setup dns)\" == custom ]]","action":"haseen setup dns custom"},
  "setup.network.qr": {"icon":"󰐲","label":"QR Code","aliases":["wifi-qr"],"description":"the Wi-Fi password","when":"nmcli -t -f TYPE,STATE device | grep -q '^wifi:connected'","action":"haseen config terminal -- nmcli device wifi show-password"},
  "setup.default": {"icon":"","label":"Defaults","aliases":["default","defaults"]},
  "setup.default.agent": {"icon":"󰚩","label":"Agent","title":"Default Agent"},
  "setup.default.agent.claude": {"icon":"󰛄","label":"Claude","when":"haseen-cmd-present claude","checked":"[[ \"$(haseen setup default agent)\" == claude ]]","action":"haseen setup default agent claude"},
  "setup.default.agent.codex": {"icon":"󰚩","label":"Codex","when":"haseen-cmd-present codex","checked":"[[ \"$(haseen setup default agent)\" == codex ]]","action":"haseen setup default agent codex"},
  "setup.default.agent.copilot": {"icon":"","label":"Copilot","when":"haseen-cmd-present copilot","checked":"[[ \"$(haseen setup default agent)\" == copilot ]]","action":"haseen setup default agent copilot"},
  "setup.default.agent.crush": {"icon":"󰋑","label":"Crush","when":"haseen-cmd-present crush","checked":"[[ \"$(haseen setup default agent)\" == crush ]]","action":"haseen setup default agent crush"},
  "setup.default.agent.cursor-agent": {"icon":"󰚩","label":"Cursor CLI","when":"haseen-cmd-present cursor-agent","checked":"[[ \"$(haseen setup default agent)\" == cursor-agent ]]","action":"haseen setup default agent cursor-agent"},
  "setup.default.agent.gemini": {"icon":"󰫢","label":"Gemini","when":"haseen-cmd-present gemini","checked":"[[ \"$(haseen setup default agent)\" == gemini ]]","action":"haseen setup default agent gemini"},
  "setup.default.agent.grok": {"icon":"󰚩","label":"Grok","when":"haseen-cmd-present grok","checked":"[[ \"$(haseen setup default agent)\" == grok ]]","action":"haseen setup default agent grok"},
  "setup.default.agent.hermes": {"icon":"󰚩","label":"Hermes","when":"haseen-cmd-present hermes","checked":"[[ \"$(haseen setup default agent)\" == hermes ]]","action":"haseen setup default agent hermes"},
  "setup.default.agent.muse": {"icon":"󰛤","label":"Muse Code","when":"haseen-cmd-present muse","checked":"[[ \"$(haseen setup default agent)\" == muse ]]","action":"haseen setup default agent muse"},
  "setup.default.agent.omp": {"icon":"󰚩","label":"omp","when":"haseen-cmd-present omp","checked":"[[ \"$(haseen setup default agent)\" == omp ]]","action":"haseen setup default agent omp"},
  "setup.default.agent.openclaw": {"icon":"󰚩","label":"OpenClaw","when":"haseen-cmd-present openclaw","checked":"[[ \"$(haseen setup default agent)\" == openclaw ]]","action":"haseen setup default agent openclaw"},
  "setup.default.agent.opencode": {"icon":"󰚩","label":"OpenCode","when":"haseen-cmd-present opencode","checked":"[[ \"$(haseen setup default agent)\" == opencode ]]","action":"haseen setup default agent opencode"},
  "setup.default.agent.pi": {"icon":"󰚩","label":"Pi","when":"haseen-cmd-present pi","checked":"[[ \"$(haseen setup default agent)\" == pi ]]","action":"haseen setup default agent pi"},
  "setup.default.browser": {"icon":"","label":"Browser","title":"Default Browser"},
  "setup.default.browser.zen": {"icon":"󰖟","label":"Zen","when":"haseen-cmd-present zen-browser || [[ -e /var/lib/flatpak/exports/bin/app.zen_browser.zen || -e ~/.local/share/flatpak/exports/bin/app.zen_browser.zen ]]","checked":"[[ \"$(haseen setup default browser)\" == zen ]]","action":"haseen setup default browser zen"},
  "setup.default.browser.chromium": {"icon":"","label":"Chromium","when":"haseen-cmd-present chromium || [[ -e /var/lib/flatpak/exports/bin/org.chromium.Chromium || -e ~/.local/share/flatpak/exports/bin/org.chromium.Chromium ]]","checked":"[[ \"$(haseen setup default browser)\" == chromium ]]","action":"haseen setup default browser chromium"},
  "setup.default.browser.helium": {"icon":"","label":"Helium","when":"haseen-cmd-present helium-browser","checked":"[[ \"$(haseen setup default browser)\" == helium ]]","action":"haseen setup default browser helium"},
  "setup.default.browser.chrome": {"icon":"󰊯","label":"Chrome","when":"haseen-cmd-present google-chrome-stable","checked":"[[ \"$(haseen setup default browser)\" == chrome ]]","action":"haseen setup default browser chrome"},
  "setup.default.browser.brave": {"icon":"󰖟","label":"Brave","when":"haseen-cmd-present brave","checked":"[[ \"$(haseen setup default browser)\" == brave ]]","action":"haseen setup default browser brave"},
  "setup.default.browser.brave-origin": {"icon":"󰖟","label":"Brave Origin","when":"haseen-cmd-present brave-origin","checked":"[[ \"$(haseen setup default browser)\" == brave-origin ]]","action":"haseen setup default browser brave-origin"},
  "setup.default.browser.edge": {"icon":"󰇩","label":"Edge","when":"haseen-cmd-present microsoft-edge-stable","checked":"[[ \"$(haseen setup default browser)\" == edge ]]","action":"haseen setup default browser edge"},
  "setup.default.browser.firefox": {"icon":"","label":"Firefox","when":"haseen-cmd-present firefox","checked":"[[ \"$(haseen setup default browser)\" == firefox ]]","action":"haseen setup default browser firefox"},
  "setup.default.terminal": {"icon":"","label":"Terminal","title":"Default Terminal"},
  "setup.default.terminal.foot": {"icon":"","label":"Foot","when":"haseen-cmd-present foot","checked":"[[ \"$(haseen setup default terminal)\" == foot ]]","action":"haseen setup default terminal foot"},
  "setup.default.terminal.alacritty": {"icon":"","label":"Alacritty","when":"haseen-cmd-present alacritty","checked":"[[ \"$(haseen setup default terminal)\" == alacritty ]]","action":"haseen setup default terminal alacritty"},
  "setup.default.terminal.ghostty": {"icon":"","label":"Ghostty","when":"haseen-cmd-present ghostty","checked":"[[ \"$(haseen setup default terminal)\" == ghostty ]]","action":"haseen setup default terminal ghostty"},
  "setup.default.terminal.kitty": {"icon":"","label":"Kitty","when":"haseen-cmd-present kitty","checked":"[[ \"$(haseen setup default terminal)\" == kitty ]]","action":"haseen setup default terminal kitty"},
