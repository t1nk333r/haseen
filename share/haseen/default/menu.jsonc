  "setup.default.editor.code": {"icon":"","label":"VSCode","aliases":["setup.default.editor.vscode"],"when":"haseen-cmd-present code","checked":"[[ \"$(haseen setup default editor)\" == code ]]","action":"haseen setup default editor code"},
