  "setup.default.editor.helix": {"icon":"","label":"Helix","when":"haseen-cmd-present helix || haseen-cmd-present hx","checked":"[[ \"$(haseen setup default editor)\" == helix ]]","action":"haseen setup default editor helix"},
  "setup.default.editor.vim": {"icon":"","label":"Vim","when":"haseen-cmd-present vim","checked":"[[ \"$(haseen setup default editor)\" == vim ]]","action":"haseen setup default editor vim"},
  "setup.default.editor.emacs": {"icon":"","label":"Emacs","when":"haseen-cmd-present emacs","checked":"[[ \"$(haseen setup default editor)\" == emacs ]]","action":"haseen setup default editor emacs"},
  "setup.plugin": {"icon":"󰐱","label":"Plugins","aliases":["plugin","plugins"]},
  "setup.plugin.enable": {"icon":"󰄬","label":"Enable Plugin","provider":"plugins-enable"},
  "setup.plugin.disable": {"icon":"󰅖","label":"Disable Plugin","provider":"plugins-disable"},
  "setup.plugin.add": {"icon":"󰖟","label":"Add Plugin","action":"haseen config plugin add"},
  "setup.plugin.remove": {"icon":"󰭌","label":"Remove Plugin","provider":"plugins-remove"},
  "setup.security": {"icon":"","label":"Security"},
  "setup.security.fingerprint": {"icon":"󰈷","label":"Fingerprint","action":"haseen setup fingerprint"},
  "setup.security.fido2": {"icon":"","label":"Fido2","action":"haseen setup fido2"},
  "setup.security.sshd": {"icon":"󰣀","label":"SSHD","action":"haseen setup sshd"},
  "setup.security.ssh-agent": {"icon":"󰣀","label":"SSH Agent","checked":"systemctl --user -q is-enabled gcr-ssh-agent.socket","action":"haseen setup ssh-agent"},
  "setup.security.passwordless-sudo": {"icon":"󰟵","label":"Passwordless Sudo","action":"haseen setup passwordless-sudo"},
  "setup.security.vapt": {"icon":"","label":"VAPT workstation","aliases":["vapt-workstation"],"description":"Installed status and explicit local helpers; nothing runs on entry.","when":"haseen vapt menu --enabled"},
  "setup.security.vapt.panel": {"icon":"","label":"Open panel","when":"haseen vapt menu --enabled","action":"haseen shell ipc panel toggle haseen.security"},
  "setup.security.vapt.tools": {"icon":"","label":"Installed tools","provider":"security-tools","when":"haseen vapt menu --enabled"},
  "setup.security.vapt.services": {"icon":"","label":"Installed services","provider":"security-services","when":"haseen vapt menu --enabled"},
  "setup.security.vapt.local": {"icon":"","label":"Local actions","provider":"security-local","when":"haseen vapt menu --enabled"},
  "setup.security.vapt.status": {"icon":"","label":"Status and sources","when":"haseen vapt menu --enabled","action":"haseen shell ipc panel toggle haseen.security"},
  "setup.secureboot": {"icon":"󰒃","label":"Secure Boot","aliases":["secureboot"]},
  "setup.secureboot.status": {"icon":"󰒃","label":"Status","action":"haseen config terminal -- haseen secureboot status"},
  "setup.secureboot.setup": {"icon":"󰒃","label":"Set Up","action":"haseen config terminal -- haseen secureboot setup"},
  "setup.config": {"icon":"","label":"Config"},
  "setup.config.hyprland": {"icon":"","label":"Hyprland","action":"haseen config edit \"$HOME/.config/hypr/hyprland.lua\""},
  "setup.config.nightlight": {"icon":"","label":"Hyprsunset","aliases":["setup.config.hyprsunset"],"description":"the nightlight: shell.json plugins.haseen.nightlight","action":"haseen config edit \"${XDG_CONFIG_HOME:-$HOME/.config}/haseen/shell.json\""},
  "setup.config.xcompose": {"icon":"󰞅","label":"XCompose","description":"for apps started after the edit","action":"haseen config edit \"$HOME/.XCompose\""},
  "setup.dotfiles": {"icon":"","label":"Dotfiles","aliases":["dotfiles","yadm"]},
  "setup.dotfiles.status": {"icon":"","label":"Status","action":"haseen config terminal -- haseen setup dotfiles status"},
  "setup.dotfiles.clone": {"icon":"","label":"Clone Repository","description":"yadm: backs up the files it replaces","action":"haseen config terminal -- bash -c 'haseen setup dotfiles status; read -rp \"Dotfiles git URL: \" u && [[ -n $u ]] && haseen setup dotfiles \"$u\"'"},
  "setup.power": {"icon":"󰁹","label":"Power and Battery","aliases":["battery","power-profile"],"description":"charge, time left, power profile, charge limit","when":"haseen battery status | grep -q .","action":"haseen shell ipc panel toggle haseen.battery"},
  "setup.battery-limit": {"icon":"󰁹","label":"Battery Charge Limit","aliases":["battery-limit","charge-limit"],"when":"compgen -G '/sys/class/power_supply/*/charge_control_end_threshold'"},
  "setup.battery-limit.status": {"icon":"󰁹","label":"Status","action":"haseen config terminal -- haseen setup battery-limit status"},
  "setup.battery-limit.80": {"icon":"󰁹","label":"Limit to 80%","action":"haseen battery limit set 80"},
  "setup.battery-limit.full": {"icon":"󰁹","label":"No Limit (100%)","action":"haseen battery limit off"},
  "setup.battery-limit.save": {"icon":"󰁹","label":"Keep the Current Limit","action":"haseen battery limit save"},
  "setup.battery-limit.on": {"icon":"󰄬","label":"Restore at Boot and Resume","checked":"systemctl -q is-enabled haseen-charge-limit.service","action":"haseen setup battery-limit on"},
  "setup.battery-limit.off": {"icon":"󰅖","label":"Stop Restoring","action":"haseen setup battery-limit off"},
  "setup.idle": {"icon":"󰒲","label":"Idle and Suspend","aliases":["idle","idle-suspend","sleep"],"description":"screensaver, lock, display off and suspend timeouts"},
  "setup.idle.status": {"icon":"","label":"Status","action":"haseen config terminal -- haseen setup idle status"},
  "setup.idle.ac": {"icon":"󰅶","label":"Timeouts on AC","description":"seconds, 0 = never; suspend is never by default","action":"haseen setup idle prompt"},
  "setup.idle.battery": {"icon":"󰁹","label":"Timeouts on Battery","description":"replace the AC values while unplugged","when":"haseen battery status | grep -q .","action":"haseen setup idle prompt --battery"},
  "setup.ai": {"icon":"󱚤","label":"Local AI","aliases":["ai"]},
  "setup.ai.status": {"icon":"󱚤","label":"Status","action":"haseen config terminal -- haseen ai status"},
  "setup.ai.pull": {"icon":"󰇚","label":"Pull Model","action":"haseen config terminal -- bash -c 'haseen ai pull; read -rp \"Model to pull: \" m && [[ -n $m ]] && haseen ai pull \"$m\"'"},
  "setup.ai.chat": {"icon":"󰭹","label":"Chat","action":"haseen shell ipc panel toggle haseen.ai"},

  // Install
  "install.package": {"icon":"󰣇","label":"Package","action":"haseen install package"},
  "install.aur": {"icon":"󰣇","label":"AUR","description":"Chaotic-AUR first","action":"haseen install aur"},
  "install.webapp": {"icon":"","label":"Web App","action":"haseen config terminal -- bash -c 'read -rp \"Name: \" n && read -rp \"URL: \" u && read -rp \"Icon URL (empty: the site'\\''s own): \" i && [[ -n $n && -n $u ]] && haseen webapp install \"$n\" \"$u\" ${i:+\"$i\"}'"},
  "install.style": {"icon":"","label":"Style"},
  "install.style.theme": {"icon":"󰸌","label":"Theme","aliases":["install.theme"],"description":"from a git repository (Omarchy theme format)","action":"haseen config terminal -- bash -c 'read -rp \"Theme git URL: \" u && [[ -n $u ]] && haseen theme install \"$u\"'"},
  "install.style.background": {"icon":"","label":"Background","action":"haseen config terminal -- bash -c 'read -r -e -p \"Image file: \" f && [[ -n $f ]] && haseen theme bg set \"${f/#\\~/$HOME}\"'"},
  // The catalogue's Font category, shown under Style as Omarchy has it.
  "install.font": {"icon":"","label":"Font","parent":"install.style","aliases":["install.style.font"]},
  "install.service": {"icon":"","label":"Service"},
  "install.development": {"icon":"󰵮","label":"Development"},
  "install.development.php": {"icon":"","label":"PHP","description":"php and composer","when":"! haseen-pkg-present php","action":"haseen install package php composer"},
  "install.development.laravel": {"icon":"","label":"Laravel","when":"haseen-cmd-present composer && [[ ! -x ${XDG_CONFIG_HOME:-$HOME/.config}/composer/vendor/bin/laravel ]]","action":"haseen config terminal -- composer global require laravel/installer"},
  "install.development.symfony": {"icon":"","label":"Symfony","when":"! haseen-pkg-present symfony-cli","action":"haseen install aur symfony-cli"},
  "install.development.phoenix": {"icon":"","label":"Phoenix","when":"haseen-cmd-present mix && ! compgen -G \"$HOME/.mix/archives/phx_new*\"","action":"haseen config terminal -- mix archive.install hex phx_new --force"},
  "install.development.ocaml": {"icon":"","label":"OCaml","description":"ocaml and opam","when":"! haseen-pkg-present opam","action":"haseen install package ocaml opam"},
  "install.editor": {"icon":"","label":"Editor"},
  "install.terminal": {"icon":"","label":"Terminal"},
  "install.browser": {"icon":"","label":"Browser"},
  "install.ai": {"icon":"󱚤","label":"AI"},
  "install.gaming": {"icon":"","label":"Gaming"},
  "install.gaming.xbox-cloud": {"icon":"","label":"Xbox Cloud Gaming","description":"web app","when":"[[ ! -f \"${XDG_DATA_HOME:-$HOME/.local/share}/applications/Xbox Cloud Gaming.desktop\" ]]","action":"haseen config terminal -- haseen webapp install 'Xbox Cloud Gaming' 'https://www.xbox.com/en-US/play' 'https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/xbox.png'"},

