# The vendor handler for text and source files: nvim in a window of
# $TERMINAL, for the same reason as haseen-yazi.desktop (nvim.desktop is
# Terminal=true; plan 037). TryExec hides the entry while neovim is not
# installed: it is a catalogue app, not a default package.
[Desktop Entry]
Type=Application
Name=Neovim
GenericName=Text Editor
Comment=Edit text files with nvim in your terminal
Icon=nvim
TryExec=nvim
Exec=haseen-terminal-run nvim %F
Terminal=false
NoDisplay=true
MimeType=text/plain;text/english;text/x-makefile;text/x-c++hdr;text/x-c++src;text/x-chdr;text/x-csrc;text/x-java;text/x-moc;text/x-pascal;text/x-tcl;text/x-tex;application/x-shellscript;text/x-c;text/x-c++;application/xml;text/xml;
Categories=Utility;TextEditor;
