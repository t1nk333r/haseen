/* haseen theme colours for Tensaku (the screenshot annotator).
 * Generated by `haseen theme set`; edits here are overwritten.
 * ~/.config/tensaku/overrides.css links to this render
 * (share/haseen/seeds/80-capture.sh). Tensaku 0.29.0 reads it as plain CSS
 * above its built-in stylesheet and falls back to that while it is missing
 * (src/main.rs read_css_overrides).
 *
 * Only the window chrome is themed; the annotation palette stays static in
 * Tensaku's config.toml (share/haseen/default/tensaku/config.toml says why).
 *
 * Classes from Tensaku 0.29.0 src/assets/default.css; the tool buttons are
 * GTK toggle buttons, so the selected tool is button:checked. */
.outer_box,
.bottom_row {
  background-color: {{ mix background foreground 6% }};
}

.toolbar {
  color: {{ foreground }};
  background-color: {{ mix background foreground 6% }};
}

.toolbar button:checked {
  color: {{ accent }};
}

.toast {
  color: {{ foreground }};
  background-color: {{ mix background foreground 12% }};
  border-radius: {{ radius }}px;
}
