/* haseen theme colours for satty (the screenshot annotator).
 * Generated by `haseen theme set`; edits here are overwritten.
 * ~/.config/satty/overrides.css links to this render
 * (share/haseen/seeds/80-capture.sh). Satty 0.22.0 reads it as plain CSS and
 * falls back to its built-in stylesheet while it is missing.
 *
 * Only the window chrome is themed; the annotation palette stays static in
 * satty's config.toml (share/haseen/default/satty/config.toml says why).
 *
 * Classes from Satty 0.22.0 src/assets/default.css. */
.outer_box {
  background-color: {{ mix background foreground 6% }};
}

.inner_box {
  background-color: {{ background }};
}

.toolbar {
  color: {{ foreground }};
  background-color: {{ mix background foreground 6% }};
}

.toast {
  color: {{ foreground }};
  background-color: {{ mix background foreground 12% }};
  border-radius: {{ radius }}px;
}

button.editing {
  color: {{ accent }};
}
