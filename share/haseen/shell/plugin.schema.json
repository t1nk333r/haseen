{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/t1nk33r/haseen/share/haseen/shell/plugin.schema.json",
  "title": "haseen shell plugin manifest",
  "description": "manifest.json of a haseen Quickshell plugin (docs/architecture.md section 5.2). Permissions are review metadata: QML cannot sandbox, so nothing here is enforced at runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "kinds", "entry"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
      "description": "Reverse-dotted id. Built-ins use haseen.*, user plugins <user>.*. Must equal the plugin directory name."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string"
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/kind" }
    },
    "entry": {
      "type": "object",
      "description": "One QML file per declared kind, relative to the plugin directory.",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/kind" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\0]+\\.qml$"
      }
    },
    "settings": {
      "type": "object",
      "description": "Settings the plugin reads from its `settings` property. Defaults are merged with shell.json plugins.<id>.settings.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "enum": ["string", "number", "integer", "boolean", "array", "object"] },
          "default": {},
          "description": { "type": "string" }
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["exec", "network", "network:local", "files:read", "files:write", "notifications"] }
    },
    "provides": {
      "type": "array",
      "description": "Shell roles this plugin answers. IPC calls for a role (launcher.toggle, lock.lock, notifications.*) go to the loaded plugin that provides it.",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kinds": { "contains": { "const": "bar-widget" } } } },
      "then": { "properties": { "entry": { "required": ["bar-widget"] } } }
    },
    {
      "if": { "properties": { "kinds": { "contains": { "const": "panel" } } } },
      "then": { "properties": { "entry": { "required": ["panel"] } } }
    },
    {
      "if": { "properties": { "kinds": { "contains": { "const": "service" } } } },
      "then": { "properties": { "entry": { "required": ["service"] } } }
    },
    {
      "if": { "properties": { "kinds": { "contains": { "const": "launcher-provider" } } } },
      "then": { "properties": { "entry": { "required": ["launcher-provider"] } } }
    },
    {
      "if": { "properties": { "kinds": { "contains": { "const": "overlay" } } } },
      "then": { "properties": { "entry": { "required": ["overlay"] } } }
    }
  ],
  "$defs": {
    "kind": {
      "enum": ["bar-widget", "panel", "service", "launcher-provider", "overlay"]
    }
  }
}
