#!/usr/bin/env bash
# omarchy-hyprland-monitor-modeless — exit 0 when Hyprland has an enabled
# monitor with no video mode (0x0: a monitor powered off at boot answered with
# a partial EDID), 1 when not, 2 when the compositor cannot say. Adapted from
# Omarchy bin/omarchy-hyprland-monitor-modeless (MIT, Copyright (c) David
# Heinemeier Hansson): unchanged; omarchy-hyprland-monitor-watch relies on the
# three exit codes (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-hyprland-monitor-modeless

haseen's answer to Omarchy's command: exit 0 when an enabled monitor is at 0x0,
1 when none is, 2 when Hyprland does not answer." "$@"

# Mirrors are absent from plain `monitors`, hence `all` and the disabled filter.
monitors=$(hyprctl monitors all -j 2>/dev/null) || exit 2
state=$(jq 'if any(.[]; .disabled != true and (.width == 0 or .height == 0)) then 0 else 1 end' \
    <<<"$monitors" 2>/dev/null || true)
case $state in
0 | 1) exit "$state" ;;
*) exit 2 ;;
esac
