#!/usr/bin/env bash
# omarchy-setup-security-sudoless-docker — add this user to the docker group,
# after a warning that it is root-equivalent. Adapted from Omarchy
# bin/omarchy-setup-security-sudoless-docker (MIT, Copyright (c) David Heinemeier Hansson):
# usermod through run_root, gum confirm became confirm,
# the reboot-required marker goes to haseen's store (omarchy-state), a
# missing docker group is refused instead of left to usermod, and the reboot
# is only offered at a terminal, never taken under --yes; OMARCHY_DEFER_REBOOT
# still defers it; --dry-run (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
# shellcheck source=../../lib/terminal.sh
source "$HASEEN_PATH/lib/terminal.sh"

usage() {
    cat <<EOF
Usage: omarchy-setup-security-sudoless-docker [--dry-run] [--yes]

haseen's answer to Omarchy's command: adds you to the docker group, so docker
runs without sudo after the next reboot. Membership is root-equivalent.
Undo it with omarchy-remove-security-sudoless-docker.
EOF
}
in_floating_terminal "$@"
parse_common_flags "$@"
((${#REST[@]} == 0)) || {
    usage >&2
    exit 2
}
require_not_root
user="${USER:-$(id -un)}"
oma="$HASEEN_OMARCHY_DIR/bin"

# The configured groups, not this session's: once enabled it stays enabled
# for the account even before the reboot that lets this session use it.
if ! "$oma/omarchy-sudo-docker" --configured; then
    echo "Sudoless Docker is already enabled: $user is in the docker group."
    echo "To disable it again, run: omarchy-remove-security-sudoless-docker"
    exit 0
fi
grep -q '^docker:' "$(sysroot_path /etc/group)" 2>/dev/null ||
    die "there is no docker group yet: install Docker first (haseen install app docker)"

cat <<'EOF'

WARNING: Enabling sudoless Docker adds you to the 'docker' group.

The Docker daemon runs as root, so membership in the docker group is
equivalent to passwordless root. Any process running as your user could
then run, for example:

    docker run -v /:/host alpine   # full read/write of the host, as root

and take over the machine with no password prompt. A single rogue script,
dependency, or plugin running as you is enough. It is convenient for
development, but it removes the protection haseen keeps by default, where
Docker access goes through a sudo prompt.

EOF

if ! confirm "Enable sudoless Docker? This gives anything running as you passwordless root."; then
    echo "Aborted. No changes made. Docker access still goes through a prompt."
    exit 0
fi
run_root usermod -aG docker "$user"
# A new group membership is only picked up by a fresh session; in practice
# only a reboot reliably applies it. Recorded for a later update to see.
state_flags=()
$DRY_RUN && state_flags+=(--dry-run)
"$oma/omarchy-state" set reboot-required "${state_flags[@]}"
echo
echo "Sudoless Docker ENABLED. It takes effect after a reboot."
echo "To disable it again: omarchy-remove-security-sudoless-docker"
echo

# An update that reuses this command defers the reboot to its own end.
[[ -z ${OMARCHY_DEFER_REBOOT:-} ]] || exit 0
if $DRY_RUN; then
    echo "DRYRUN: ask 'Reboot now to apply?' and on yes: omarchy-system-reboot"
    exit 0
fi
if $ASSUME_YES || [[ ! -t 0 ]]; then
    info "reboot when convenient to apply it"
    exit 0
fi
read -r -p "Reboot now to apply? [y/N] " reply
[[ $reply =~ ^[Yy]$ ]] || exit 0
exec "$oma/omarchy-system-reboot"
