#!/usr/bin/env bash
# omarchy-hw-nvidia — exit 0 when an NVIDIA GPU is present. Adapted from
# Omarchy bin/omarchy-hw-nvidia (MIT, Copyright (c) David Heinemeier Hansson):
# haseen's hw_probe_nvidia is the same sysfs test (class 0x03, vendor 0x10de),
# read through sysroot_path instead of OMARCHY_PCI_DEVICES_PATH (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
# shellcheck source=../../lib/hardware.sh
source "$HASEEN_PATH/lib/hardware.sh"
omarchy_help "Usage: omarchy-hw-nvidia

haseen's answer to Omarchy's command: exit 0 when a display-class PCI device
from NVIDIA is present (sysfs; lspci would wake a suspended GPU)." "$@"

hw_probe_nvidia
