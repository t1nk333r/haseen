#!/usr/bin/env bash
# omarchy-remove-service-1password — remove 1Password in whichever form is
# installed (Omarchy's 1password and 1password-cli packages, haseen's
# Flatpak) and the browser-extension file Omarchy's installer wrote. Adapted
# from Omarchy bin/omarchy-remove-service-1password (MIT, Copyright (c) David
# Heinemeier Hansson): sudo rm -> run_root, omarchy-pkg-drop -> haseen remove
# package and haseen remove app 1password; --dry-run prints the plan (plan
# 093). The vault stays on 1Password's servers; nothing local is deleted
# beyond what removing the app removes.
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
# shellcheck source=../remove-lib.sh
source "$HASEEN_OMARCHY_DIR/remove-lib.sh"

EXTENSION_ID="aeblfdkhhhdcdjpifhhbdiojplfjncoa"
EXTENSION_FILE="/usr/share/chromium/extensions/$EXTENSION_ID.json"

usage() {
    cat <<EOF
Usage: omarchy-remove-service-1password [--dry-run] [--yes]

haseen's answer to Omarchy's command: deletes $EXTENSION_FILE
(the 1Password extension Omarchy's installer adds to Chromium-family
browsers), removes 1password and 1password-cli, and the
com.onepassword.OnePassword Flatpak, whichever are installed (haseen remove).
EOF
}

in_floating_terminal "$@"
parse_common_flags "$@"
((${#REST[@]} == 0)) || {
    usage >&2
    exit 2
}
require_not_root

[[ -e $(sysroot_path "$EXTENSION_FILE") ]] && run_root rm -f -- "$EXTENSION_FILE"
remove_pkgs 1password 1password-cli
remove_flatpak_app 1password com.onepassword.OnePassword

echo ""
echo "1Password has been removed."
