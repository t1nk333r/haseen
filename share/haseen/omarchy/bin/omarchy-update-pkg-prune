#!/usr/bin/env bash
# omarchy-update-pkg-prune — prune the pacman package cache to the two newest
# versions of each package (the cache is the only offline downgrade path).
# Adapted from Omarchy bin/omarchy-update-pkg-prune (MIT,
# Copyright (c) David Heinemeier Hansson): paccache -rk2, a failure only warns.
# Changes: root through run_root; without paccache (pacman-contrib) it says so
# and skips rather than installing a package as a side effect of a cleanup;
# --dry-run (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"

usage() {
    cat <<EOF
Usage: omarchy-update-pkg-prune [--dry-run]

haseen's answer to Omarchy's command: paccache -rk2 as root, keeping the two
newest cached versions of every package.
EOF
}
parse_common_flags "$@"
((${#REST[@]} == 0)) || {
    usage >&2
    exit 2
}
require_not_root

printf '\e[32m\nPrune package cache\e[0m\n'
if ! have paccache && ! $DRY_RUN; then
    warn "paccache is not installed (haseen install package pacman-contrib); the package cache was not pruned"
    exit 0
fi
run_root paccache -rk2 || printf '\e[33mCould not prune the package cache.\e[0m\n' >&2
echo
