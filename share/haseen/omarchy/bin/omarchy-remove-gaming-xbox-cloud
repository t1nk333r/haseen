#!/usr/bin/env bash
# omarchy-remove-gaming-xbox-cloud — remove the Xbox Cloud Gaming web app,
# whether `haseen webapp install` wrote it (removed by haseen webapp remove)
# or Omarchy's installer did (its launcher runs omarchy-launch-webapp, which
# haseen's index does not see). Follows Omarchy
# bin/omarchy-remove-gaming-xbox-cloud (MIT, Copyright (c) David Heinemeier
# Hansson), which calls omarchy-webapp-remove "Xbox Cloud Gaming"; like that
# command it succeeds when the web app is not there. --dry-run prints the
# plan (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
# shellcheck source=../remove-lib.sh
source "$HASEEN_OMARCHY_DIR/remove-lib.sh"

usage() {
    cat <<EOF
Usage: omarchy-remove-gaming-xbox-cloud [--dry-run]

haseen's answer to Omarchy's command: removes the "Xbox Cloud Gaming" web app
launcher and its icon (haseen webapp remove for one haseen installed).
EOF
}

parse_common_flags "$@"
((${#REST[@]} == 0)) || {
    usage >&2
    exit 2
}
require_not_root
webapp_remove "Xbox Cloud Gaming" || true
