#!/usr/bin/env bash
# omarchy-network-password — prints the password of the Wi-Fi connection
# active on INTERFACE, for a Wi-Fi sharing panel. Adapted from Omarchy
# bin/omarchy-network-password (MIT, Copyright (c) David Heinemeier Hansson):
# the logic is Omarchy's (enterprise networks refused, WEP from wep-key0); the
# secret goes only to stdout, never into an argument. nmcli is pinned to the C
# locale so its answers do not depend on the language (plan 093). Read-only.
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-network-password <interface>

haseen's answer to Omarchy's command: prints the active Wi-Fi connection's
password on INTERFACE (read with nmcli)." "$@"

interface=${1:-}
[[ -n $interface ]] || {
    echo "Usage: omarchy-network-password <interface>" >&2
    exit 1
}
require_cmds nmcli
uuid=$(LC_ALL=C nmcli --get-values GENERAL.CON-UUID device show "$interface" 2>/dev/null | head -n 1 || true)
[[ -n $uuid && $uuid != "--" ]] || {
    echo "No active Wi-Fi connection" >&2
    exit 1
}

mapfile -t fields < <(LC_ALL=C nmcli --show-secrets --escape no --get-values \
    802-11-wireless-security.key-mgmt,802-11-wireless-security.psk,802-11-wireless-security.wep-key0 \
    connection show uuid "$uuid")
key_management=${fields[0]:-}
password=${fields[1]:-}
wep_key=${fields[2]:-}

[[ $key_management != *eap* && $key_management != *ieee8021x* ]] || {
    echo "Enterprise Wi-Fi has no shareable password" >&2
    exit 1
}
if [[ -z $key_management || $key_management == none ]]; then
    # NetworkManager models WEP as key-mgmt "none" plus a wep-key.
    password=$wep_key
    [[ -n $password ]] || {
        echo "This network has no password" >&2
        exit 1
    }
fi
[[ -n $password ]] || {
    echo "Could not read the Wi-Fi password" >&2
    exit 1
}
printf '%s\n' "$password"
