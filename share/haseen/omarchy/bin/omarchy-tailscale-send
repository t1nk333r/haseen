#!/usr/bin/env bash
# omarchy-tailscale-send — send files to a machine on the tailnet with
# Taildrop. Adapted from Omarchy bin/omarchy-tailscale-send (MIT, Copyright (c) David Heinemeier Hansson):
# the same arguments, messages and exit codes;
# with no file the chooser is haseen's answer to omarchy-file-select; toasts
# go through haseen-notification-send, without Omarchy's glyph; --dry-run
# prints the transfer (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"

usage() {
    cat <<EOF
Usage: omarchy-tailscale-send <machine> [file...] [--dry-run]

haseen's answer to Omarchy's command: sends the files to <machine> with
Taildrop (tailscale file cp). With no file, a file chooser opens. The outcome
is announced as a notification.
EOF
}

args=()
for arg in "$@"; do
    case "$arg" in
    -h | --help)
        usage
        exit 0
        ;;
    --dry-run) DRY_RUN=true ;;
    *) args+=("$arg") ;;
    esac
done
if ((${#args[@]} < 1)); then
    echo "Usage: omarchy-tailscale-send <machine> [file...]" >&2
    exit 1
fi
machine="${args[0]}"
# Address the machine by the name we were handed, but talk about it by its
# short name, so a MagicDNS name does not spill into every message.
name="${machine%%.*}"
files=("${args[@]:1}")
notify() { "$HASEEN_BIN/haseen-notification-send" "$@" || true; }

if ((${#files[@]} == 0)); then
    if $DRY_RUN; then
        echo "DRYRUN: choose files (omarchy-file-select), then: tailscale file cp --update-interval=0 -- <files> $machine:"
        exit 0
    fi
    # A command substitution keeps the chooser's exit status: one that never
    # opened must not read as someone deciding not to send.
    status=0
    picked="$("$HASEEN_OMARCHY_DIR/bin/omarchy-file-select" --title "Send to $name" --multiple)" || status=$?
    if ((status > 1)); then
        notify -u critical "Could not send to $name" "The file chooser did not open"
        exit 1
    fi
    [[ -n $picked ]] || exit 0
    readarray -t files <<<"$picked"
fi

if ((${#files[@]} == 1)); then
    what="$(basename -- "${files[0]}")"
else
    what="${#files[@]} files"
fi

if $DRY_RUN; then
    echo "DRYRUN: tailscale file cp --update-interval=0 -- ${files[*]} $machine:"
    exit 0
fi
have tailscale || {
    notify -u critical "Could not send to $name" "tailscale is not installed"
    exit 1
}
if error="$(tailscale file cp --update-interval=0 -- "${files[@]}" "$machine:" 2>&1)"; then
    notify "Sent to $name" "$what"
else
    notify -u critical "Could not send to $name" "${error:-Taildrop transfer failed}"
    exit 1
fi
