#!/usr/bin/env bash
# omarchy-audio-sink-availability — print "<sink-name><TAB>0|1" for every sink:
# 1 when it has no ports or one that is available. The physical sink a speaker
# tuning sits in front of is reported unavailable: picking it would bypass the
# tuning. Omarchy's audio panel reads it. Adapted from Omarchy
# bin/omarchy-audio-sink-availability (MIT, Copyright (c) David Heinemeier
# Hansson): the tuned sink comes from haseen's omarchy-audio-tuning
# fronted-sink (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-audio-sink-availability

Prints '<sink-name><TAB>0|1' per sink (pactl list sinks). Changes nothing." "$@"

fronted="$("$HASEEN_OMARCHY_DIR/bin/omarchy-audio-tuning" fronted-sink 2>/dev/null || true)"

pactl list sinks 2>/dev/null | awk -v fronted="$fronted" '
  function emit_sink() {
    if (name == "") return
    if (fronted != "" && name == fronted) {
      print name "\t0"
      return
    }
    print name "\t" ((port_count == 0 || available) ? 1 : 0)
  }
  /^Sink #/ {
    emit_sink()
    name = ""
    in_ports = 0
    port_count = 0
    available = 0
    next
  }
  /^[[:space:]]*Name:/ { name = $2; next }
  /^[[:space:]]*Ports:$/ { in_ports = 1; next }
  in_ports && /^\tActive Port:/ { in_ports = 0; next }
  in_ports && /^\t\t/ {
    port_count++
    if ($0 !~ /not available/) available = 1
    next
  }
  END { emit_sink() }
' || true
