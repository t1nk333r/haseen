#!/usr/bin/env bash
# omarchy-hw-asus-expertbook-b9406 — exit 0 on an ASUS ExpertBook B9406 with an Intel Panther Lake GPU. Adapted from Omarchy bin/omarchy-hw-asus-expertbook-b9406 (MIT, Copyright (c) David
# Heinemeier Hansson): the DMI match is haseen hw match (the same
# case-insensitive product name or family test, read through sysroot_path),
# the GPU test the adopted omarchy-hw-intel-ptl (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-hw-asus-expertbook-b9406

haseen's answer to Omarchy's command: exit 0 on an ASUS ExpertBook B9406 with an Intel Panther Lake GPU, 1 otherwise.
Prints nothing." "$@"

"$HASEEN_BIN/haseen-hw-match" "B9406" && "$HASEEN_OMARCHY_DIR/bin/omarchy-hw-intel-ptl"
