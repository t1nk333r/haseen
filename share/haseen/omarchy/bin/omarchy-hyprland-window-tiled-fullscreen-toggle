#!/usr/bin/env bash
# omarchy-hyprland-window-tiled-fullscreen-toggle — toggle tiled fullscreen
# (the client believes it is fullscreen, the tile keeps its size) for the
# focused window. Adapted from Omarchy
# bin/omarchy-hyprland-window-tiled-fullscreen-toggle (MIT, Copyright (c) David
# Heinemeier Hansson): the same fullscreen state, in the form Hyprland's
# config takes (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
# shellcheck source=../../lib/screen.sh
source "$HASEEN_PATH/lib/screen.sh"

# dispatch LUA LEGACY... — one Hyprland dispatcher: the Lua form when Hyprland
# reads a Lua config (screen_lua asks it once), else the legacy form. A dry run
# prints it instead.
hypr_lua=""
dispatch() {
    local lua="$1" args
    shift
    if [[ -z $hypr_lua ]]; then
        if screen_lua; then hypr_lua=yes; else hypr_lua=no; fi
    fi
    if [[ $hypr_lua == yes ]]; then args=(dispatch "$lua"); else args=(dispatch "$@"); fi
    if $DRY_RUN; then
        echo "DRYRUN: hyprctl ${args[*]}"
    else
        hyprctl "${args[@]}" >/dev/null
    fi
}

usage() {
    cat <<USAGE
Usage: omarchy-hyprland-window-tiled-fullscreen-toggle [--dry-run]

haseen's answer to Omarchy's command: toggles the focused window's client
fullscreen state (2) while it stays tiled.
USAGE
}
parse_common_flags "$@"

active="$(hyprctl activewindow -j)"
if [[ $(jq -r '.fullscreenClient // 0' <<<"$active") == 2 ]]; then
    dispatch 'hl.dsp.window.fullscreen_state({ internal = 0, client = 0 })' fullscreenstate 0 0
else
    dispatch 'hl.dsp.window.fullscreen_state({ internal = 0, client = 2 })' fullscreenstate 0 2
fi
