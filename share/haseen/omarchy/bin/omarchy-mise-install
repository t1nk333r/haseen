#!/usr/bin/env bash
# omarchy-mise-install — writes ~/.local/bin/COMMAND, a small wrapper that
# installs PACKAGE with mise on first use and runs its BIN. Adapted from
# Omarchy bin/omarchy-mise-install (MIT, Copyright (c) David Heinemeier
# Hansson): the command-name check, the quoting and the wrapper are Omarchy's;
# the wrapper is written through haseen's write_user_file so --dry-run shows
# it, and mise itself is installed with haseen install package when it is
# missing, since the wrapper cannot work without it (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
usage() {
    cat <<'USAGE'
Usage: omarchy-mise-install <package> [command-name [bin-name]] [--dry-run]

haseen's answer to Omarchy's command: writes ~/.local/bin/<command-name>, which
runs `mise use -g <package>` and then `mise x <package> -- <bin-name>`.
USAGE
}
parse_common_flags "$@"
set -- "${REST[@]+"${REST[@]}"}"

if [[ -z ${1:-} ]]; then
    echo "Usage: omarchy-mise-install <package> [command-name [bin-name]]"
    exit 1
fi
package=$1
command=${2:-$1}
bin=${3:-$command}

# The command name becomes a file name under ~/.local/bin, so a slash in it
# writes the wrapper somewhere else and the rm below deletes somewhere else. A
# leading dot hides it or walks up, and a leading dash reads as an option.
case "$command" in
*/* | .* | -* | *[[:cntrl:]]*)
    echo "omarchy-mise-install: '$command' is not usable as a command name" >&2
    exit 1
    ;;
esac

# The wrapper is shell source: quote the values so a package name carrying
# shell characters stays one argument, but keep values that are inert inside
# double quotes in the plain form mise backend options need.
printf -v package_arg '%q' "$package"
printf -v bin_arg '%q' "$bin"
case "$package" in
*'$'* | *'`'* | *'"'* | *'\'* | *'!'* | *[[:cntrl:]]*) ;;
*) package_arg="\"$package\"" ;;
esac
case "$bin" in
*'$'* | *'`'* | *'"'* | *'\'* | *'!'* | *[[:cntrl:]]*) ;;
*) bin_arg="\"$bin\"" ;;
esac

if ! have mise; then
    flags=(--yes)
    $DRY_RUN && flags+=(--dry-run)
    HASEEN_INLINE=1 haseen_cmd install package "${flags[@]}" mise ||
        die "mise is needed for the wrapper (haseen install package mise)"
fi

dest="$HOME/.local/bin/$command"
# Removed first, as Omarchy does: writing through an existing link would
# change whatever it points at. MISE_MINIMUM_RELEASE_AGE=0: these tools
# install on first run, and mise's cooldown would hold a fresh release back.
run rm -f -- "$dest"
write_user_file "$dest" <<WRAPPER
#!/bin/bash
export MISE_MINIMUM_RELEASE_AGE=0
mise use -g --quiet $package_arg || exit 1
exec mise x $package_arg -- $bin_arg "\$@"
WRAPPER
run chmod +x -- "$dest"
