#!/usr/bin/env bash
# omarchy-agent-account-mode — Omarchy switches accounts automatically near a
# limit, or notifies with a one-click switch (c05d90196, #13770). haseen's
# accounts (plan 108) switch only when told (haseen agent account use): the
# owner did not choose switching near a limit (plan 146), though haseen now
# collects every Claude account's limits. So this says how haseen switches,
# accepts manual, and refuses auto; it writes nothing. Translates Omarchy's command of the
# name (MIT, Copyright (c) David Heinemeier Hansson).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-agent-account-mode [claude|codex|grok] [manual|auto] [threshold]

haseen's answer to Omarchy's command: haseen switches accounts only when told
(haseen agent account use); auto is not available." "$@"
# shellcheck source=../../lib/agent-accounts.sh
source "$HASEEN_PATH/lib/agent-accounts.sh"
acct_parse_provider "$@" || {
    echo "Usage: omarchy-agent-account-mode [claude|codex|grok] [manual|auto] [threshold]" >&2
    exit 1
}
case "${ACCT_ARGS[0]:-manual}" in
manual) ;;
auto)
    omarchy_refuse "haseen agent account use $PROVIDER <account>" \
        "haseen switches accounts only when told; switching near a limit is not built (plan 146)."
    ;;
*)
    echo "Usage: omarchy-agent-account-mode [claude|codex|grok] [manual|auto] [threshold]" >&2
    exit 1
    ;;
esac
echo "$(acct_name "$PROVIDER") switches accounts when you say so: haseen agent account use $PROVIDER <account>"
