#!/usr/bin/env bash
# omarchy-theme-bg-switcher — Omarchy's background picker, answered by
# haseen's: opens the haseen.background panel, which sets the picked image
# itself. Omarchy's picker printed the chosen path for its caller to set
# (`bg=$(omarchy-theme-bg-switcher); [[ -n $bg ]] && omarchy-theme-bg-set
# "$bg"`); this one prints nothing, so such a caller has nothing left to do.
# Interface of Omarchy bin/omarchy-theme-bg-switcher (MIT, Copyright (c)
# David Heinemeier Hansson) (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"

omarchy_help "Usage: omarchy-theme-bg-switcher

haseen's answer to Omarchy's command: opens haseen's background picker (the
haseen.background panel), which applies the image you pick. Nothing is
printed: the panel sets the background itself. Fails when haseen's shell
does not answer." "$@"

"$HASEEN_BIN/haseen-shell-ipc" panel toggle haseen.background >/dev/null
