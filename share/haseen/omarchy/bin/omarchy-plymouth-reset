#!/usr/bin/env bash
# omarchy-plymouth-reset — puts haseen's boot splash back, in the current
# theme's colours: haseen plymouth set. Adapted from Omarchy
# bin/omarchy-plymouth-reset (MIT, Copyright (c) David Heinemeier Hansson),
# which restores Omarchy's splash and its SDDM login theme. haseen logs in
# with greetd, so there is no SDDM half (ADR 0001); the splash's hook and
# kernel command line go through drop-ins and the initramfs is rebuilt
# (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-plymouth-reset [--dry-run]

haseen's answer to Omarchy's command: haseen plymouth set (haseen's splash in
the current theme's colours). There is no SDDM theme: haseen uses greetd." "$@"
parse_common_flags "$@"
((${#REST[@]} == 0)) || {
    echo "Usage: omarchy-plymouth-reset [--dry-run]" >&2
    exit 1
}
info "no SDDM login theme to restore: haseen logs in with greetd"
flags=()
$DRY_RUN && flags+=(--dry-run)
haseen_exec plymouth-set "${flags[@]}"
