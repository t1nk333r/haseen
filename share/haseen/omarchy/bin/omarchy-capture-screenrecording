#!/usr/bin/env bash
# omarchy-capture-screenrecording — haseen's answer to Omarchy's command (plan
# 093; a shell shim since plan 057). Omarchy plugins (t1nk33r.privacy's stop
# button) start and stop recordings with this; here it is haseen's recorder, so
# its indicator and files are the ones haseen shows. Flags follow Omarchy
# bin/omarchy-capture-screenrecording (MIT, Copyright (c) David Heinemeier
# Hansson). haseen sizes the webcam overlay and keeps the output resolution
# itself, so --webcam-size and --resolution are dropped.
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-capture-screenrecording [--fullscreen] [--with-desktop-audio] [--with-microphone-audio] [--with-webcam] [--webcam-device=DEV] [--stop-recording]

haseen's answer to Omarchy's command: haseen capture screenrecord with the
flags translated (--webcam-size and --resolution are dropped)." "$@"

args=()
for arg in "$@"; do
    case $arg in
    --fullscreen) args+=(--fullscreen) ;;
    --with-desktop-audio) args+=(--desktop-audio) ;;
    --with-microphone-audio) args+=(--microphone) ;;
    --with-webcam) args+=(--webcam) ;;
    --webcam-device=*) args+=("$arg") ;;
    --stop-recording) args+=(--stop) ;;
    --webcam-size=* | --resolution=*) ;;
    *)
        printf 'omarchy-capture-screenrecording (haseen compat): %s is not supported (see: haseen capture screenrecord --help)\n' "$arg" >&2
        exit 2
        ;;
    esac
done
haseen_exec "capture-screenrecord" "${args[@]}"
