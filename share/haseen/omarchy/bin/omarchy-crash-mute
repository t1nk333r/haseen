#!/usr/bin/env bash
# omarchy-crash-mute — silence crash notifications for one program, or list
# the silenced ones. Adapted from Omarchy bin/omarchy-crash-mute@v4.5.0-rc1
# (MIT, Copyright (c) David Heinemeier Hansson): the same arguments, a path
# reduced to its basename as the watcher keys it; the flag is a file in
# $HASEEN_USER_STATE/toggles/crash-ignore/<program>, which haseen's crash
# watcher (haseen-crash-watch) reads before it announces a crash, instead of
# ~/.local/state/omarchy/toggles/crash-ignore; writes go through common.sh, so
# --dry-run prints them (plan 102). Trigger > Toggle > Crash Capture
# (omarchy-toggle-crash-capture) is the switch for all of them.
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-crash-mute [--] [<program>] [on|off|toggle] [--dry-run]

haseen's answer to Omarchy's command: without a program, lists the programs
whose crashes do not notify; with one, mutes it (on), unmutes it (off) or
flips it." "$@"
MUTES="$HASEEN_USER_STATE/toggles/crash-ignore"
usage() { echo "Usage: omarchy crash mute [--] [<program>] [on|off|toggle]" >&2; }

args=()
for a in "$@"; do
    if [[ $a == --dry-run ]]; then DRY_RUN=true; else args+=("$a"); fi
done
set -- "${args[@]}"
# A program may be named -h; `omarchy crash mute -- -h` is the way through.
[[ ${1:-} == "--" ]] && shift
if (($# == 0)); then
    found=0
    for entry in "$MUTES"/* "$MUTES"/.*; do
        [[ -f $entry ]] || continue
        printf '%s\n' "${entry##*/}"
        found=1
    done
    ((found)) || echo "No programs muted. Crashes all notify."
    exit 0
fi
program=${1##*/}
action=${2:-on}
if [[ -z $program || $program == "." || $program == ".." ]]; then
    echo "Not a program name: $1" >&2
    usage
    exit 1
fi
case $action in
on | off | toggle) ;;
*)
    echo "Not an action: $action" >&2
    usage
    exit 1
    ;;
esac
flag="$MUTES/$program"
if [[ $action == toggle ]]; then
    if [[ -f $flag ]]; then action=off; else action=on; fi
fi
if [[ $action == on ]]; then
    [[ -f $flag ]] || : | write_user_file "$flag"
else
    run rm -f -- "$flag"
fi
$DRY_RUN && exit 0
# What is now true, not what was asked: the flag is what the watcher reads.
if [[ -f $flag ]]; then
    echo "Muted crash notifications for $program."
else
    echo "Crash notifications for $program are back on."
fi
