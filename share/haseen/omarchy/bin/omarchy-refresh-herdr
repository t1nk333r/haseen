#!/usr/bin/env bash
# omarchy-refresh-herdr — replaces ~/.config/herdr/config.toml with haseen's default
# (share/haseen/default/herdr/config.toml), keeping the old file as a backup, then
# reloads herdr when it is running. Adapted from Omarchy bin/omarchy-refresh-herdr and
# omarchy-refresh-config (MIT, Copyright (c) David Heinemeier Hansson): the
# backup, the copy and the diff are Omarchy's, done the way haseen refresh
# does them (asks first unless --yes, <file>.bak.<timestamp>, --dry-run); the
# reload is Omarchy's omarchy-restart-herdr. haseen never replaces a user file
# unasked: this command is the explicit request (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
# shellcheck source=../../lib/terminal.sh
source "$HASEEN_PATH/lib/terminal.sh"

src="$HASEEN_PATH/default/herdr/config.toml"
dest="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/config.toml"

usage() {
    cat <<USAGE
Usage: omarchy-refresh-herdr [--dry-run] [--yes]

haseen's answer to Omarchy's command: replaces $dest with haseen's
default ($src), keeping your file as $dest.bak.<timestamp>, then
reloads herdr if it is running.
USAGE
}
in_floating_terminal "$@"
parse_common_flags "$@"
((${#REST[@]} == 0)) || {
    usage >&2
    exit 2
}
require_not_root
[[ -r $src ]] || die "default missing: $src"

if [[ -e $dest ]] && cmp -s -- "$src" "$dest"; then
    info "$dest is already haseen's default"
else
    confirm "Replace $dest with haseen's default? (the current file is kept as a backup)" ||
        die "cancelled; nothing changed"
    backup=""
    if [[ -e $dest ]]; then
        backup="$dest.bak.$(date +%Y%m%d-%H%M%S)"
        run cp -a -- "$dest" "$backup"
    fi
    run install -Dm644 -- "$src" "$dest"
    if [[ -n $backup ]] && ! $DRY_RUN; then
        info "replaced $dest with haseen's default (backup: $backup). Changes from your version:"
        diff -u -- "$backup" "$dest" || true
    fi
fi

# Only a running herdr server has a config to reload.
have herdr || exit 0
[[ $(herdr status server --json 2>/dev/null | jq -r .running 2>/dev/null) == true ]] || exit 0
if $DRY_RUN; then
    echo "DRYRUN: herdr server reload-config"
    exit 0
fi
reload="$(herdr server reload-config || true)"
jq -r '.result.diagnostics[]?, (.error.message | select(. != null))' <<<"$reload" >&2 || true
[[ $(jq -r '.result.status // "failed"' <<<"$reload" 2>/dev/null) != failed ]] || die "herdr could not reload $dest"
