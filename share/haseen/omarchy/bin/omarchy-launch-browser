#!/usr/bin/env bash
# omarchy-launch-browser — open the default browser, optionally on a URL or in
# a private window, then focus it. Omarchy panels, binds and its session's
# $BROWSER call it. Adapted from Omarchy bin/omarchy-launch-browser (MIT,
# Copyright (c) David Heinemeier Hansson): the --private mapping, the hand-off
# to a running browser and the focus afterwards are Omarchy's. Changes (plan
# 093): the private flag is chosen from the browser's desktop id, not by
# running its --help; a Flatpak browser runs as `flatpak run <app-id>`; the
# launch goes through uwsm-app only in a uwsm session. The default browser is
# never an entry that launches this command again, and $BROWSER is not read:
# Omarchy's session sets BROWSER=omarchy-launch-browser, which would loop.
# DRY_RUN=true prints the launch instead.
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"

omarchy_help "Usage: omarchy-launch-browser [--private] [url]

haseen's answer to Omarchy's command: opens the default browser (haseen setup
default browser), in a private window with --private, then focuses it when a
URL was given." "$@"

# desktop_file ID — the entry XDG reads for ID: the first in the data dirs,
# Flatpak's export dirs included (haseen's browsers are Flatpaks).
desktop_file() {
    local dir dirs=() home="${XDG_DATA_HOME:-$HOME/.local/share}"
    if [[ -n ${XDG_DATA_DIRS:-} ]]; then
        IFS=: read -ra dirs <<<"$XDG_DATA_DIRS"
    else
        dirs=("$(sysroot_path /usr/local/share)" "$(sysroot_path /usr/share)")
    fi
    for dir in "$home" "${dirs[@]}" "$home/flatpak/exports/share" "$(sysroot_path /var/lib/flatpak/exports/share)"; do
        if [[ -r $dir/applications/$1 ]]; then
            printf '%s\n' "$dir/applications/$1"
            return 0
        fi
    done
    return 1
}

# browser_argv ID — BROWSER_ARGV: the command the entry runs, `flatpak run
# <app-id>` for a Flatpak export (its Exec starts with flatpak).
browser_argv() {
    local file words=()
    file="$(desktop_file "$1")" || return 1
    read -ra words <<<"$(sed -n 's/^Exec=//p' "$file" | head -n1)"
    [[ -n ${words[0]:-} ]] || return 1
    if [[ ${words[0]##*/} == flatpak ]]; then
        BROWSER_ARGV=(flatpak run "${1%.desktop}")
    else
        BROWSER_ARGV=("${words[0]}")
    fi
}

# loops ID — the entry only routes back to Omarchy's launchers.
loops() {
    local file first
    [[ $1 == omarchy-browser.desktop ]] && return 0
    file="$(desktop_file "$1")" || return 1
    read -r first _ <<<"$(sed -n 's/^Exec=//p' "$file" | head -n1)"
    [[ ${first##*/} == omarchy-launch-browser || ${first##*/} == omarchy-launch-webapp ]]
}

# default_browser — the default browser's desktop id: Omarchy's fast
# mimeapps.list reader when haseen ships it, else xdg-settings, never through
# $BROWSER.
default_browser() {
    local id="" helper="$HASEEN_OMARCHY_DIR/bin/omarchy-cmd-default-browser"
    [[ -x $helper ]] && id="$("$helper" 2>/dev/null || true)"
    if [[ -z $id ]] || loops "$id"; then
        id="$(env -u BROWSER XDG_CURRENT_DESKTOP= xdg-settings get default-web-browser 2>/dev/null || true)"
    fi
    if [[ -z $id ]] || loops "$id"; then
        id="$(XDG_CURRENT_DESKTOP='' xdg-mime query default x-scheme-handler/https 2>/dev/null || true)"
    fi
    if [[ -n $id ]] && ! loops "$id"; then
        printf '%s\n' "$id"
    fi
}

browser="$(default_browser)"
[[ -n $browser ]] || die "no default web browser is set: haseen setup default browser zen"
browser_argv "$browser" || die "the default browser $browser has no desktop entry with an Exec line"

case ${browser,,} in
*firefox* | *zen* | *librewolf* | *waterfox* | *floorp*) private_flag=--private-window ;;
*edge*) private_flag=--inprivate ;;
*) private_flag=--incognito ;;
esac
args=()
url=""
for argument in "$@"; do
    if [[ $argument == --private ]]; then
        args+=("$private_flag")
    else
        args+=("$argument")
        [[ -n $url ]] || url=$argument
    fi
done
argv=("${BROWSER_ARGV[@]}" "${args[@]}")

# A running browser takes the command line over its own socket
# (omarchy-cmd-browser-handoff), which fails when none acknowledges it.
handoff="$HASEEN_OMARCHY_DIR/bin/omarchy-cmd-browser-handoff"
handed=false
if ! $DRY_RUN && [[ -x $handoff && ${argv[0]} != flatpak ]] && "$handoff" "${argv[@]}" 2>/dev/null; then
    handed=true
fi
if ! $handed; then
    if [[ -n ${UWSM_FINALIZE_VARNAMES:-}${UWSM_WAIT_VARNAMES:-} ]] && have uwsm-app; then
        argv=(uwsm-app -- "${argv[@]}")
    fi
    if $DRY_RUN; then
        echo "DRYRUN: setsid -f ${argv[*]}"
    else
        setsid -f "${argv[@]}" >/dev/null 2>&1 </dev/null
    fi
fi

# A URL opens in the running browser's window, which may be elsewhere: bring
# it forward. The class is the binary's name (google-chrome-stable's is
# google-chrome) or, for a Flatpak, the last part of its app id.
if [[ -n $url && -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
    if [[ ${BROWSER_ARGV[0]} == flatpak ]]; then
        name="${BROWSER_ARGV[2]##*.}"
        pattern="${name,,}"
    else
        pattern="^$(basename -- "${BROWSER_ARGV[0]}" -stable).*\$"
    fi
    focus="$HASEEN_OMARCHY_DIR/bin/omarchy-hyprland-focus-app"
    if $DRY_RUN; then
        echo "DRYRUN: $focus $pattern"
    elif [[ -x $focus ]]; then
        "$focus" "$pattern" >/dev/null 2>&1 || true
    fi
fi
