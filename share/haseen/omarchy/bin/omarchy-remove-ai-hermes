#!/usr/bin/env bash
# omarchy-remove-ai-hermes — remove Hermes Desktop the haseen way: stop Hermes
# and the gateway units that run its runtime, drop hermes-desktop through
# `haseen remove package`, delete the runtime and wrappers its installer
# wrote, then ask before deleting the chats and tokens. Adapted from Omarchy
# bin/omarchy-remove-ai-hermes (MIT, Copyright (c) David Heinemeier Hansson):
# the process sweep, the gateway-unit test and the bootstrap marker are
# Omarchy's; omarchy-pkg-drop -> haseen remove package; gum confirm -> a
# terminal question; every change goes through common.sh, so --dry-run prints
# the whole plan (plan 093).
#
# Data: the runtime (checkout, venv, uv, node, wrappers) goes unasked, as in
# Omarchy: it is program code the bootstrap marker proves the app installed.
# The chats, memories, skills and tokens in ~/.hermes and ~/.config/Hermes are
# asked about, default no; --yes keeps them, as Omarchy keeps them without a
# terminal. The /proc sweep is skipped against a fixture tree.
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
# shellcheck source=../remove-lib.sh
source "$HASEEN_OMARCHY_DIR/remove-lib.sh"

usage() {
    cat <<EOF
Usage: omarchy-remove-ai-hermes [--dry-run] [--yes]

haseen's answer to Omarchy's command: stops Hermes and its gateway units,
removes the hermes-desktop package (haseen remove package), deletes the Hermes
runtime under ~/.hermes and its wrappers in ~/.local/bin, then asks (default
no) before deleting ~/.hermes and ~/.config/Hermes. --yes keeps that data.
EOF
}

in_floating_terminal "$@"
parse_common_flags "$@"
((${#REST[@]} == 0)) || {
    usage >&2
    exit 2
}
require_not_root

unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

# hermes_holders check|stop — Hermes is closed here rather than asked to be:
# every process whose program, by its executable or what it was started as
# (for an interpreter, the script it runs or Hermes's own package named with
# -m), lives in the runtime or the package. Judged by the program alone: an
# editor open on a file in the runtime is the user's. `check` refuses if
# anything else holds Hermes's files (executable, working directory or a
# descriptor), so a refusal touches nothing: removing an open SQLite WAL
# leaves a live writer on a deleted generation. `stop` ends Hermes's own and
# refuses over whatever is left. A dry run only checks, and only warns.
hermes_holders() {
    local mode=$1
    in_sysroot && return 0
    have python3 || die "python3 is needed to find what holds Hermes's files"
    if $DRY_RUN; then
        [[ $mode == stop ]] && echo "DRYRUN: stop the Hermes processes still running (SIGTERM, then SIGKILL)"
        hermes_sweep check || warn "a real run would refuse here"
        return 0
    fi
    hermes_sweep "$mode"
}

hermes_sweep() {
    python3 - "$1" "$HOME" <<'PY'
import os
import re
import signal
import sys
import time
from pathlib import Path

mode, home = sys.argv[1], Path(sys.argv[2])
roots = [str((home / relative).resolve()) for relative in ('.hermes', '.config/Hermes')]
roots.append('/opt/hermes-desktop')
runtime = [str((home / relative).resolve()) for relative in ('.hermes/hermes-agent', '.hermes/node', '.hermes/bin')]
runtime.append('/opt/hermes-desktop')

def under(target, directories):
    target = target.removesuffix(' (deleted)')
    return any(target == directory or target.startswith(directory + '/') for directory in directories)

def processes():
    found = []
    for process in Path('/proc').iterdir():
        if not process.name.isdigit() or int(process.name) == os.getpid():
            continue
        try:
            if process.stat().st_uid != os.getuid():
                continue
            argv = [os.fsdecode(arg) for arg in (process / 'cmdline').read_bytes().split(b'\0')]
            program = []
            try:
                program.append(os.readlink(process / 'exe'))
            except OSError:
                pass
            touched = list(program)
            try:
                touched.append(os.readlink(process / 'cwd'))
            except OSError:
                pass
            try:
                for entry in (process / 'fd').iterdir():
                    try:
                        touched.append(os.readlink(entry))
                    except OSError:
                        pass
            except PermissionError:
                pass
            started_as = argv[:1]
            interpreter = bool(started_as) and re.fullmatch(r'(python[0-9.]*|node|bash|sh)', os.path.basename(started_as[0]))
            if interpreter:
                started_as = argv[:2]
            # Hermes's own package, run as a module from an activated venv.
            ours = any(under(target, runtime) for target in started_as + program) or \
                (bool(interpreter) and argv[1:3] and argv[1] == '-m' and argv[2].startswith('hermes_cli'))
            if ours or any(under(target, roots) for target in touched):
                try:
                    name = (process / 'comm').read_text().strip()
                except OSError:
                    name = '?'
                found.append((int(process.name), ours, name))
        except (FileNotFoundError, ProcessLookupError, PermissionError):
            continue
    return found

def named(entries):
    return ', '.join(f'{pid} {name}' for pid, ours, name in entries)

def refuse(entries):
    print('Something other than Hermes still has its files open (PIDs: ' + named(entries)
          + '). Close it, then run the removal again.', file=sys.stderr)
    sys.exit(1)

strangers = [entry for entry in processes() if not entry[1]]
if strangers:
    refuse(strangers)
if mode == 'check':
    sys.exit(0)

mine = [entry for entry in processes() if entry[1]]
if mine:
    print('Stopping Hermes (PIDs: ' + named(mine) + ')...')
    for signum, patience in ((signal.SIGTERM, 10), (signal.SIGKILL, 3)):
        for pid, ours, name in mine:
            try:
                os.kill(pid, signum)
            except ProcessLookupError:
                pass
        deadline = time.monotonic() + patience
        while mine and time.monotonic() < deadline:
            time.sleep(0.2)
            mine = [entry for entry in processes() if entry[1]]
        if not mine:
            break
    if mine:
        print('Hermes did not stop (PIDs: ' + named(mine) + '). Close it, then run the removal again.', file=sys.stderr)
        sys.exit(1)
left = processes()
if left:
    refuse(left)
PY
}

hermes_holders check

# The gateway unit `hermes gateway install` writes starts the runtime about to
# be deleted, so it goes with it, stopped before the processes are or systemd
# would start it again. Judged by what it starts: a unit running a Hermes kept
# elsewhere is somebody else's. A unit that will not stop aborts the removal:
# dropping the package would strand a live gateway on deleted code.
for unit_file in "$unit_dir"/hermes-gateway*.service; do
    [[ -f $unit_file ]] || continue
    grep '^ExecStart=' "$unit_file" | grep -F "$HOME/.hermes/hermes-agent/" >/dev/null || continue
    unit=${unit_file##*/}
    if quiet systemctl --user disable --now "$unit" || unit_stopped "$unit"; then
        # .bak is what `gateway install --force` leaves when it rewrites a unit.
        run rm -f -- "$unit_file" "$unit_file.bak" "$unit_dir/default.target.wants/$unit"
        quiet systemctl --user daemon-reload || true
        # A failed unit stays listed as "not-found failed" until it is reset.
        quiet systemctl --user reset-failed "$unit" || true
    else
        die "could not stop $unit; Hermes was not removed"
    fi
done

# An Omarchy install leaves a transient unit that hands the app its theme by
# running Hermes; it is stopped before the sweep reaches it.
quiet systemctl --user stop omarchy-hermes-theme.service || true

hermes_holders stop
remove_pkgs hermes-desktop

# Upstream's installer writes this marker once the runtime under ~/.hermes has
# landed; it alone tells that runtime from one the user installed. Without it
# nothing there is ours to delete unasked.
if [[ -f $HOME/.hermes/hermes-agent/.hermes-bootstrap-complete ]]; then
    run rm -rf -- "$HOME/.hermes/hermes-agent" "$HOME/.hermes/bootstrap-cache" \
        "$HOME/.hermes/bin" "$HOME/.hermes/node"
    # Only the wrappers pointing into ~/.hermes, matched as a plain string.
    for command in hermes hermes-agent hermes-acp; do
        wrapper="$HOME/.local/bin/$command"
        if [[ -f $wrapper && ! -L $wrapper ]] && grep -qF "$HOME/.hermes" "$wrapper"; then
            run rm -f -- "$wrapper"
        fi
    done
    # A Node Hermes brought along was linked next to its commands.
    for command in node npm npx; do
        link="$HOME/.local/bin/$command"
        if [[ -L $link && $(readlink "$link") == "$HOME/.hermes"/* ]]; then
            run rm -f -- "$link"
        fi
    done
fi

# What is left is the user's: chats, memories and skills in ~/.hermes, the
# connections and their encrypted tokens in ~/.config/Hermes. Asked whenever
# they exist, marker or not; the question names the paths, since a yes takes
# any runtime the app never owned with it.
data_removed=false
present "$HOME/.hermes" "$HOME/.config/Hermes"
if ((${#FOUND[@]})) && ask "Also delete ${FOUND[*]} ($(size_of "${FOUND[@]}"): chats, memories, skills, connections and tokens)?"; then
    hermes_holders stop
    run rm -rf -- "${FOUND[@]}"
    data_removed=true
fi

echo ""
echo "Hermes Desktop has been removed."
if $data_removed && ! $DRY_RUN; then
    echo "Its chats, memories, and settings in ~/.hermes and ~/.config/Hermes are gone too."
elif [[ -d $HOME/.hermes || -d $HOME/.config/Hermes ]]; then
    echo "Your chats, memories, and skills are still in ~/.hermes,"
    echo "and your connections and settings in ~/.config/Hermes."
fi
