#!/usr/bin/env bash
# omarchy-toggle-fullscreen-desktop — hide the bar and remove the window gaps
# together, or bring both back. Translated (a7486beb6, #10672): haseen toggle
# fullscreen-desktop, SUPER + CTRL + ALT + F's command since plan 105, does
# what this did since plan 102: the bar for the session, the gaps through
# haseen toggle gaps, and toggle leaves full screen only when both halves are
# in it, as Omarchy's.
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-toggle-fullscreen-desktop [toggle|on|off] [--dry-run]

haseen's answer to Omarchy's command: on hides the bar and removes the gaps,
off brings both back; toggle switches between the two." "$@"
parse_common_flags "$@"
action=${REST[0]:-toggle}
((${#REST[@]} <= 1)) || action=bad
case $action in
toggle | on | off) ;;
*)
    echo "Usage: omarchy-toggle-fullscreen-desktop [toggle|on|off]" >&2
    exit 1
    ;;
esac
flags=()
$DRY_RUN && flags+=(--dry-run)
haseen_exec toggle-fullscreen-desktop "$action" "${flags[@]}"
