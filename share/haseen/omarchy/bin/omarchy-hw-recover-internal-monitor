#!/usr/bin/env bash
# omarchy-hw-recover-internal-monitor — bring the laptop panel back at login
# when it was left disabled and no external monitor is connected any more.
# Adapted from Omarchy bin/omarchy-hw-recover-internal-monitor (MIT, Copyright
# (c) David Heinemeier Hansson): the toggle is haseen's
# toggles/hypr/laptop-display-off.lua (haseen hardware laptop-display off),
# which Hyprland loads at start even after undocking; the clamshell mark the
# adopted omarchy-hyprland-monitor-clamshell keeps goes with it. It removes
# files only: run it before Hyprland reads its config, or reload afterwards
# (plan 093). Omarchy's unit runs /usr/bin/omarchy-hw-recover-internal-monitor
# by path; haseen starts nothing by itself.
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"

TOGGLE="$HASEEN_USER_STATE/toggles/hypr/laptop-display-off.lua"
MARK="$HASEEN_USER_STATE/flags/clamshell-display-off"

usage() {
    cat <<USAGE
Usage: omarchy-hw-recover-internal-monitor [--dry-run]

haseen's answer to Omarchy's command: when $TOGGLE
exists and no external monitor is connected (sysfs), removes it, so the next
Hyprland start or reload enables the laptop display again.
USAGE
}
parse_common_flags "$@"
((${#REST[@]} == 0)) || {
    usage >&2
    exit 2
}

[[ -f $TOGGLE ]] || exit 0
"$HASEEN_OMARCHY_DIR/bin/omarchy-hw-external-monitors" && exit 0
run rm -f "$TOGGLE" "$MARK"
