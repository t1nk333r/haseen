#!/usr/bin/env bash
# omarchy-hyprland-workspace-layout-default — show or set the layout of
# workspaces without one of their own. Translated (149871896, #14482): haseen
# keeps a layout per workspace (haseen toggle workspace-layout) over Hyprland's
# general.layout, so this prints that default and accepts it unchanged; another
# default, or floating (which needs Omarchy's dock and titlebars), is refused
# with the haseen way (plan 102).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-hyprland-workspace-layout-default [dwindle|scrolling|floating]

haseen's answer to Omarchy's command: prints the default workspace layout
(Hyprland's general.layout); choose a workspace's own layout with haseen
toggle workspace-layout." "$@"
current=$(hyprctl getoption general.layout -j 2>/dev/null | jq -r '.str // empty' 2>/dev/null) || current=""
current=${current:-dwindle}
case ${1:-} in
"") echo "$current" ;;
dwindle | scrolling)
    [[ $1 == "$current" ]] && exit 0
    omarchy_refuse "haseen toggle workspace-layout $1 (the active workspace)" \
        "haseen sets the layout per workspace and keeps Hyprland's default ($current)."
    ;;
floating)
    omarchy_refuse "haseen toggle workspace-layout (dwindle or scrolling)" \
        "Omarchy's floating workspaces come with its dock and window titlebars, which haseen does not have."
    ;;
*)
    echo "Usage: omarchy-hyprland-workspace-layout-default [dwindle|scrolling|floating]" >&2
    exit 1
    ;;
esac
