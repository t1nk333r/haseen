#!/usr/bin/env bash
# omarchy-agent-account-use — choose which account new sessions use:
# haseen agent account use (plan 108). Until plan 108 this ran Omarchy's
# installed copy (c05d90196, #13770) against Omarchy's registry; haseen has
# accounts of its own now, and reads Omarchy's registry only while it has
# none (share/haseen/lib/agent-accounts.sh).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-agent-account-use [claude|codex|grok] [account|next]

haseen's answer to Omarchy's command: haseen agent account use." "$@"
haseen_exec agent-account-use "$@"
