#!/usr/bin/env bash
# omarchy-remove-ai-claude — remove the Claude desktop app: the running app is
# stopped first, its package through haseen remove, then ask before deleting
# its data. Adapted from Omarchy bin/omarchy-remove-ai-claude@v4.5.0-rc1 (MIT,
# Copyright (c) David Heinemeier Hansson): the packages and paths are
# Omarchy's; omarchy-pkg-drop -> haseen remove; Omarchy deletes the data
# without asking, haseen asks (default no; --yes keeps it, --purge or a yes at
# a terminal deletes it, remove-lib.sh); --dry-run prints the plan (plan 102).
# Not ~/.claude, ~/.claude.json or ~/.cache/claude-cli-nodejs: those are the
# Claude Code CLI's, a package of its own.
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
# shellcheck source=../remove-lib.sh
source "$HASEEN_OMARCHY_DIR/remove-lib.sh"
usage() {
    cat <<EOF
Usage: omarchy-remove-ai-claude [--dry-run] [--yes] [--purge]

haseen's answer to Omarchy's command: removes the Claude desktop app (haseen remove), then
asks (default no) before deleting its settings and caches; --yes keeps it, --purge deletes it.
EOF
}
in_floating_terminal "$@"
parse_common_flags "$@"
take_purge
((${#REST[@]} == 0)) || {
    usage >&2
    exit 2
}
require_not_root
# The app rewrites ~/.config/Claude while it runs: stop it first.
quiet pkill -x claude-desktop || true
remove_pkgs claude-desktop
delete_asked "Also delete its settings and caches" purge \
    "$HOME/.config/Claude" "$HOME/.cache/Claude" || true
echo ""
echo "the Claude desktop app has been removed."
