#!/usr/bin/env bash
# omarchy-tui-remove-all — remove every TUI launcher omarchy-tui-install
# wrote, and their icons. Adapted from Omarchy bin/omarchy-tui-remove-all
# (MIT, Copyright (c) David Heinemeier Hansson): the optional APP_DIR, the
# xdg-terminal-exec --app-id=TUI. match, the icon names and the messages.
# Changes: entries the haseen tui-install wrote (X-Haseen-TUI) count too; the
# list is shown and confirmed first (--yes answers), and the removals go
# through run (--dry-run) (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"

usage() {
    cat <<EOF
Usage: omarchy-tui-remove-all [APP_DIR] [--dry-run] [--yes]

haseen's answer to Omarchy's command: removes every TUI launcher in APP_DIR
(default \$XDG_DATA_HOME/applications) and its icon, after a confirmation.
EOF
}
parse_common_flags "$@"
set -- "${REST[@]}"
(($# <= 1)) || {
    usage >&2
    exit 2
}
require_not_root

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
APP_DIR="${1:-$DATA_HOME/applications}"
ICON_DIR="$DATA_HOME/icons/hicolor/256x256/apps"
OLD_ICON_DIR="$DATA_HOME/applications/icons"

echo "Scanning for TUIs in $APP_DIR..."
files=()
while IFS= read -r -d '' file; do
    if grep -q '^Exec=xdg-terminal-exec --app-id=TUI\.' "$file" 2>/dev/null ||
        grep -q '^X-Haseen-TUI=' "$file" 2>/dev/null; then
        files+=("$file")
    fi
done < <(find "$APP_DIR" -maxdepth 1 -name '*.desktop' -print0 2>/dev/null)

if ((${#files[@]} == 0)); then
    echo "No TUIs found."
    exit 0
fi
printf '  %s\n' "${files[@]##*/}"
confirm "Remove these ${#files[@]} TUI launcher(s)?" || {
    echo "Nothing removed."
    exit 1
}

for file in "${files[@]}"; do
    app_name="$(basename "$file" .desktop)"
    icon_name="$(printf '%s\n' "$app_name" | tr '[:upper:]' '[:lower:]' | sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//')"
    echo "Removing TUI: $app_name"
    run rm -f -- "$file" "$ICON_DIR/$icon_name.png" "$ICON_DIR/$app_name.png" "$OLD_ICON_DIR/$app_name.png"
done
have update-desktop-database && run update-desktop-database "$APP_DIR" >/dev/null 2>&1 || true
echo "TUIs removed successfully."
