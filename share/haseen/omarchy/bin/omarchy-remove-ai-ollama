#!/usr/bin/env bash
# omarchy-remove-ai-ollama — remove Ollama: stop and disable ollama.service,
# drop whichever ollama package is installed, then ask before deleting the
# models it pulled. Adapted from Omarchy bin/omarchy-remove-ai-ollama@v4.5.0-rc1
# (MIT, Copyright (c) David Heinemeier Hansson): the service goes first because
# it holds the models open; omarchy-pkg-drop -> haseen remove; Omarchy deletes
# /var/lib/ollama and ~/.ollama without asking, haseen asks (default no; --yes
# keeps them, --purge deletes them); root steps through run_root, so --dry-run
# prints the plan (plan 102).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
# shellcheck source=../remove-lib.sh
source "$HASEEN_OMARCHY_DIR/remove-lib.sh"
usage() {
    cat <<EOF
Usage: omarchy-remove-ai-ollama [--dry-run] [--yes] [--purge]

haseen's answer to Omarchy's command: disables ollama.service, removes the
ollama packages (haseen remove), then asks (default no) before deleting every
pulled model (/var/lib/ollama, ~/.ollama); --yes keeps them, --purge deletes them.
EOF
}
in_floating_terminal "$@"
parse_common_flags "$@"
take_purge
((${#REST[@]} == 0)) || {
    usage >&2
    exit 2
}
require_not_root
if $DRY_RUN; then
    run_root systemctl disable --now ollama.service
else
    run_root systemctl disable --now ollama.service 2>/dev/null || true
fi
remove_pkgs ollama ollama-cuda ollama-rocm ollama-vulkan
models=/var/lib/ollama
if [[ -e $(sysroot_path "$models") ]] && ask "Also delete the models in $models" purge; then
    run_root rm -rf -- "$models"
fi
delete_asked "Also delete your Ollama keys and models" purge "$HOME/.ollama" || true
echo ""
echo "Ollama has been removed."
