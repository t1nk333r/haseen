#!/usr/bin/env bash
# omarchy-restart-terminal — make running terminals reload their config.
# Adapted from Omarchy bin/omarchy-restart-terminal (MIT, Copyright (c) David Heinemeier Hansson):
# Alacritty's config gets a new mtime only (its contents
# are the user's and stay untouched), kitty SIGUSR1, ghostty SIGUSR2, each
# only when running; `pkill -x` instead of killall so --dry-run prints every
# step. foot has no reload signal; haseen's theme switch retints it instead
# (layers/theme/theme-lib.sh theme_retint_foot) (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"

usage() {
    cat <<EOF
Usage: omarchy-restart-terminal [--dry-run]

haseen's answer to Omarchy's command: Alacritty rereads a config whose file
time changed (touch, contents untouched); kitty (SIGUSR1) and ghostty
(SIGUSR2) reload when they run. foot has no reload; 'haseen theme set'
retints running foot windows itself.
EOF
}
# Other arguments are ignored, as upstream ignores them.
parse_common_flags "$@"

alacritty="${XDG_CONFIG_HOME:-$HOME/.config}/alacritty/alacritty.toml"
[[ ! -f $alacritty ]] || run touch -- "$alacritty"

if pgrep -x kitty >/dev/null 2>&1; then
    run pkill -USR1 -x kitty || true
fi
if pgrep -x ghostty >/dev/null 2>&1; then
    run pkill -USR2 -x ghostty || true
fi
