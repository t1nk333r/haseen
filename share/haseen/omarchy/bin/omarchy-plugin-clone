#!/usr/bin/env bash
# omarchy-plugin-clone — copies a haseen built-in plugin into
# ~/.config/haseen/plugins so you can edit it; the copy replaces the built-in.
# Adapted from Omarchy bin/omarchy-plugin-clone (MIT, Copyright (c) David
# Heinemeier Hansson): the same <source-id> [--edit], "My <name>" as the
# copy's name, a staged copy moved into place, the plugin turned on, a toast,
# then $EDITOR. Changes: the source is a haseen built-in (an Omarchy built-in
# id omarchy.X means haseen.X); the copy keeps the built-in's id, because
# haseen loads a plugin in ~/.config/haseen/plugins ahead of the built-in of
# the same id (haseen plugin list marks it user*), so its settings and its
# place in the bar carry over; there is no <user>.<id> rename and no
# clonedFrom. Nothing is written outside ~/.config/haseen/plugins, never
# under ~/.config/omarchy/plugins. --dry-run prints the copy (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
# shellcheck source=../../shell/lib/plugin.sh
source "$HASEEN_PATH/shell/lib/plugin.sh"

fail() {
    echo "omarchy-plugin-clone: $*" >&2
    exit 1
}

usage() {
    cat <<USAGE
Usage: omarchy-plugin-clone <source-id> [--edit] [--dry-run]

haseen's answer to Omarchy's command: copies the haseen built-in <source-id>
(omarchy.X means haseen.X) to ~/.config/haseen/plugins/<source-id>, named
"My <name>", where it replaces the built-in, and turns it on. --edit opens the
copy in \$EDITOR afterwards. Remove the copy to get the built-in back
(omarchy-plugin-remove <source-id>).
USAGE
}

source_id=""
edit_clone=false
if (($# > 0)) && [[ $1 != -* ]]; then
    source_id="$1"
    shift
fi
while (($# > 0)); do
    case "$1" in
    --edit) edit_clone=true ;;
    --dry-run) DRY_RUN=true ;;
    -h | --help)
        usage
        exit 0
        ;;
    *) fail "unknown clone option: $1" ;;
    esac
    shift
done
[[ -n $source_id ]] || fail "clone source is required"

id="$source_id"
[[ $id == omarchy.* ]] && id="haseen.${id#omarchy.}"
[[ $id =~ $PLUGIN_ID_RE ]] || fail "invalid plugin id '$source_id'"
src="$PLUGIN_BUILTIN_DIR/$id"
[[ -f $src/manifest.json ]] || fail "unknown built-in plugin: $source_id (haseen plugin list shows the built-ins)"
target="$PLUGIN_USER_DIR/$id"
[[ ! -e $target && ! -L $target ]] || fail "$target already exists"

# The copy must land in haseen's own directory: a plugins directory that is a
# link into Omarchy's or DankMaterialShell's would put it in theirs.
if [[ -e $PLUGIN_USER_DIR ]]; then
    real="$(readlink -f -- "$PLUGIN_USER_DIR")"
    for foreign in "$PLUGIN_OMARCHY_DIR" "$PLUGIN_DMS_DIR"; do
        [[ -e $foreign ]] || continue
        foreign="$(readlink -f -- "$foreign")"
        [[ $real != "$foreign" && $real != "$foreign"/* ]] ||
            fail "$PLUGIN_USER_DIR leads into $foreign, which haseen never writes"
    done
fi

name="$(jq -r '.name // .id' "$src/manifest.json")"
manifest="$(jq --arg name "My $name" '.name = $name' "$src/manifest.json")" ||
    fail "cannot read $src/manifest.json"

run mkdir -p -- "$PLUGIN_USER_DIR"
if $DRY_RUN; then
    stage="$PLUGIN_USER_DIR/.clone.XXXXXX"
else
    stage="$(mktemp -d "$PLUGIN_USER_DIR/.clone.XXXXXX")"
    trap '[[ -n ${stage:-} && -d $stage ]] && rm -rf -- "$stage"' EXIT
fi
# -L: the built-in's files themselves, never links back into the tree.
run cp -aL -- "$src/." "$stage/"
printf '%s\n' "$manifest" | write_user_file "$stage/manifest.json"
run mv -T -- "$stage" "$target"
stage=""

dry=()
$DRY_RUN && dry=(--dry-run)
"$HASEEN_BIN/haseen-plugin-enable" "$id" "${dry[@]+"${dry[@]}"}" ||
    warn "copied, but could not turn $id on (haseen plugin enable $id)"
# No notification server is no reason to fail a copy that is done.
run "$HASEEN_BIN/haseen-notification-send" "Editing cloned plugin" \
    "Your copy of $name now replaces the built-in." 2>/dev/null || true
echo "Cloned $source_id to $target and switched to $id"

if $edit_clone; then
    # Word-splitting is deliberate: EDITOR may carry flags.
    if $DRY_RUN; then
        # shellcheck disable=SC2086
        run ${EDITOR:-nvim} "$target"
        exit 0
    fi
    # shellcheck disable=SC2086
    exec ${EDITOR:-nvim} "$target"
fi
