#!/usr/bin/env bash
# omarchy-network-speedtest — measures live download or upload speed and
# prints one Mbps figure per sample until stopped, for a speed-test panel.
# Adapted from Omarchy bin/omarchy-network-speedtest (MIT, Copyright (c) David
# Heinemeier Hansson): fast.com's endpoints, eight curl workers spread over
# them, the interface's byte counters and the number format are Omarchy's.
# One change: a sample every 2 s instead of every second (haseen polls no
# faster, architecture 6); the figure is still Mbps over the sample. The
# network is used only while this runs, and the workers stop with it
# (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-network-speedtest [down|up]

haseen's answer to Omarchy's command: one Mbps figure per line, every 2 s,
while traffic to fast.com runs; stop it to end the test." "$@"

direction="${1:-}"
probe=1.1.1.1
parallel=8
url_count=3
interval=2

case "$direction" in
down | up) ;;
*)
    echo "Usage: omarchy-network-speedtest [down|up]" >&2
    exit 2
    ;;
esac

format_mbps() {
    awk -v value="$1" 'BEGIN {
        if (value <= 0) print "0.0"
        else if (value < 10) printf "%.1f\n", value
        else printf "%.0f\n", value
    }'
}

iface=$(ip route get "$probe" 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }' || true)
stats="$(sysroot_path "/sys/class/net/$iface/statistics")"
if [[ -z $iface || ! -r $stats/rx_bytes || ! -r $stats/tx_bytes ]]; then
    echo "No active network interface" >&2
    exit 1
fi
have curl || {
    echo "curl is required" >&2
    exit 1
}
require_cmds jq

fast_token="YXNkZmFzZGxmbnNkYWZoYXNkZmhrYWxm"
fast_api_url="https://api.fast.com/netflix/speedtest/v2?https=true&token=$fast_token&urlCount=$url_count"
mapfile -t fast_urls < <(curl -fsS "$fast_api_url" 2>/dev/null | jq -r '.targets[]?.url // empty' 2>/dev/null || true)
if ((${#fast_urls[@]} == 0)); then
    echo "Failed to fetch speed test endpoints" >&2
    exit 1
fi

traffic_pids=()
cleanup() {
    local pid
    for pid in "${traffic_pids[@]+"${traffic_pids[@]}"}"; do
        pkill -TERM -P "$pid" 2>/dev/null || true
        kill "$pid" 2>/dev/null || true
    done
    for pid in "${traffic_pids[@]+"${traffic_pids[@]}"}"; do
        wait "$pid" 2>/dev/null || true
    done
}
# A panel stops the test with SIGTERM: exit through the EXIT trap so the
# workers stop too.
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

# Round-robin over the returned URLs, spreading load across Netflix's nodes.
traffic_worker() {
    local urls=("$@") idx=$RANDOM url
    while true; do
        url=${urls[$((idx % ${#urls[@]}))]}
        if [[ $direction == down ]]; then
            curl -fsS -o /dev/null "$url" 2>/dev/null || return 0
        else
            dd if=/dev/zero bs=1M count=64 2>/dev/null |
                curl -fsS -o /dev/null -X POST --data-binary @- "$url" 2>/dev/null || return 0
        fi
        idx=$((idx + 1))
    done
}
for ((i = 0; i < parallel; i++)); do
    traffic_worker "${fast_urls[@]}" &
    traffic_pids+=("$!")
done

any_alive() {
    local pid
    for pid in "${traffic_pids[@]}"; do
        kill -0 "$pid" 2>/dev/null && return 0
    done
    return 1
}

counter=rx_bytes
[[ $direction == up ]] && counter=tx_bytes
before=$(<"$stats/$counter")
while any_alive; do
    sleep "$interval"
    after=$(<"$stats/$counter")
    rate=$(awk -v before="$before" -v after="$after" -v secs="$interval" 'BEGIN {
        if (after < before) print 0
        else print (after - before) * 8 / 1000000 / secs
    }')
    format_mbps "$rate"
    before=$after
done
