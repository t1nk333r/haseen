#!/usr/bin/env bash
# omarchy-remove-service-microsoft — remove the Microsoft Outlook, Word,
# Excel, PowerPoint, Teams and OneDrive web apps. Adapted from Omarchy
# bin/omarchy-remove-service-microsoft@v4.5.0-rc1 (MIT, Copyright (c) David
# Heinemeier Hansson): each one that is there goes through haseen's
# webapp_remove, which handles haseen's launchers and Omarchy's; --dry-run
# (plan 102).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
# shellcheck source=../remove-lib.sh
source "$HASEEN_OMARCHY_DIR/remove-lib.sh"
usage() {
    cat <<EOF
Usage: omarchy-remove-service-microsoft [--dry-run]

haseen's answer to Omarchy's command: removes the Microsoft Outlook, Word,
Excel, PowerPoint, Teams and OneDrive web apps that are installed.
EOF
}
parse_common_flags "$@"
((${#REST[@]} == 0)) || {
    usage >&2
    exit 2
}
for app in "Microsoft Outlook" "Microsoft Word" "Microsoft Excel" "Microsoft PowerPoint" "Microsoft Teams" "Microsoft OneDrive"; do
    webapp_remove "$app" || true
done
echo ""
echo "Microsoft Outlook, Word, Excel, PowerPoint, Teams, and OneDrive have been removed."
