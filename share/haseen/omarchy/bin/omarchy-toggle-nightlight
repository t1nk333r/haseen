#!/usr/bin/env bash
# omarchy-toggle-nightlight — Omarchy's night-light toggle, answered by
# haseen toggle nightlight: it flips haseen's flags/nightlight and
# haseen.nightlight drives hyprsunset at the configured temperature (Omarchy
# swaps hyprsunset between 4000 and 6500 K itself). --status prints Omarchy's
# {"enabled":…,"temperature":…} line from haseen's nightlight service. Follows
# Omarchy bin/omarchy-toggle-nightlight (MIT,
# Copyright (c) David Heinemeier Hansson): no output on a toggle, the --status
# JSON (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"

usage() {
    cat <<EOF
Usage: omarchy-toggle-nightlight [--status] [--dry-run]

haseen's answer to Omarchy's command: haseen toggle nightlight. --status
prints {"enabled":true|false,"temperature":K|null}.
EOF
}

status=false
args=()
for a in "$@"; do
    case $a in --status) status=true ;; *) args+=("$a") ;; esac
done
parse_common_flags "${args[@]}"
((${#REST[@]} == 0)) || {
    usage >&2
    exit 2
}

if $status; then
    # The running service knows the temperature it applies; without the shell
    # only the flag is known.
    out="$("$HASEEN_BIN/haseen-shell-ipc" nightlight status 2>/dev/null |
        jq -c '{enabled: (.enabled == true), temperature: ((.temperature | numbers) // null)}' 2>/dev/null || true)"
    if [[ -z $out ]]; then
        enabled=false
        [[ -e $HASEEN_USER_STATE/flags/nightlight ]] && enabled=true
        out="{\"enabled\":$enabled,\"temperature\":null}"
    fi
    printf '%s\n' "$out"
    exit 0
fi

if $DRY_RUN; then
    haseen_exec toggle-nightlight toggle --dry-run
fi
"$HASEEN_BIN/haseen-toggle-nightlight" toggle >/dev/null
