#!/usr/bin/env bash
# omarchy-bluetooth-power — turn Bluetooth on or off through the rfkill soft
# block, which systemd-rfkill keeps across reboots; is-on answers by exit code.
# Omarchy's Bluetooth panel and omarchy-bluetooth-device use it. Adapted from
# Omarchy bin/omarchy-bluetooth-power (MIT, Copyright (c) David Heinemeier
# Hansson): OMARCHY_BLUETOOTH_POWER_WAIT_SECONDS is
# HASEEN_BLUETOOTH_POWER_WAIT_SECONDS; on/off/toggle honour --dry-run (plan
# 093). rfkill and bluetoothctl run as the user, never through sudo.
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"

usage() {
    cat <<EOF
Usage: omarchy-bluetooth-power <on|off|toggle|is-on> [--dry-run]

  on, off, toggle  set the rfkill soft block (kept across reboots)
  is-on            exit 0 when any Bluetooth controller is powered
EOF
}
parse_common_flags "$@"

POWER_WAIT_SECONDS=${HASEEN_BLUETOOTH_POWER_WAIT_SECONDS:-2}

controllers() { timeout 2s bluetoothctl list 2>/dev/null | awk '{print $2}' || true; }

# Any controller counts: the block covers every radio at once, so the state is
# read the same way (a bare `bluetoothctl show` sees only the default one).
powered() {
    local controller
    for controller in $(controllers); do
        [[ $(timeout 2s bluetoothctl show "$controller" 2>/dev/null) == *"Powered: yes"* ]] && return 0
    done
    return 1
}

# One deadline around the whole wait: each probe can sit on its own timeout
# when D-Bus is wedged.
wait_powered() {
    local deadline=$((SECONDS + POWER_WAIT_SECONDS))
    while :; do
        powered && return 0
        ((SECONDS < deadline)) || return 1
        sleep 0.2
    done
}

power_on() {
    run rfkill unblock bluetooth
    $DRY_RUN && return 0
    # With AutoEnable at its default, bluetoothd powers the adapter up once the
    # block is gone; an adapter powered down without a block needs asking.
    wait_powered && return 0
    timeout 5s bluetoothctl power on >/dev/null 2>&1 || true
    wait_powered && return 0
    echo "omarchy-bluetooth-power: adapter did not come up" >&2
    return 1
}

case "${REST[0]:-}" in
on) power_on ;;
off) run rfkill block bluetooth ;;
toggle)
    if powered; then
        run rfkill block bluetooth
    else
        power_on
    fi
    ;;
is-on) powered ;;
*)
    echo "Usage: omarchy-bluetooth-power <on|off|toggle|is-on>" >&2
    exit 1
    ;;
esac
