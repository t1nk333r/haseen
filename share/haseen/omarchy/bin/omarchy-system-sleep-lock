#!/usr/bin/env bash
# omarchy-system-sleep-lock — lock before suspend and wait, within logind's
# delay budget, until the session lock is secure. Adapted from Omarchy
# bin/omarchy-system-sleep-lock (MIT, Copyright (c) David Heinemeier Hansson):
# the budget logic is upstream's; the lock is requested with
# haseen shell ipc lock lock, and its state read from haseen's answer to
# `omarchy-shell lock status` (haseen's lock marker plus the compositor's
# session lock; under DMS the compositor's lock alone, as DMS writes no
# marker); the failure toast goes through haseen-notification-send; the
# clamshell sync is dropped, as haseen's lid bind reconciles the display;
# Omarchy's "missing-pam" reply does not exist in haseen's shell; --dry-run
# prints the request. haseen's own lock-before-sleep is haseen-lock-before-sleep
# (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"

usage() {
    cat <<EOF
Usage: omarchy-system-sleep-lock [budget_ms] [--dry-run]

haseen's answer to Omarchy's command: asks haseen's shell to lock and waits
until the lock is secure, for at most budget_ms (default: what logind's
InhibitDelayMaxUSec leaves, capped at 12 s). Exit 1 and a critical
notification when the session was not secured in time.
EOF
}
parse_common_flags "$@"
oma="$HASEEN_OMARCHY_DIR/bin"

# Overrunning the budget is the failure this path exists to prevent: logind
# stops honouring the inhibitor and suspends mid-lock. Every call below is
# bounded by what is left of the budget.
budget_cap_ms=12000
lock_timeout_ms=1000
status_timeout_ms=500
poll_interval=0.1

# logind decides how long a delay inhibitor may hold the machine; leave it a
# fifth of its window (at least a second) to deliver PrepareForSleep.
derive_budget_ms() {
    local window
    window="$(timeout --kill-after=0.1s 1s busctl get-property \
        org.freedesktop.login1 /org/freedesktop/login1 \
        org.freedesktop.login1.Manager InhibitDelayMaxUSec 2>/dev/null || true)"
    window=${window##* }
    [[ $window =~ ^[0-9]+$ ]] && ((window > 0)) || window=5000000
    window=$((window / 1000))
    window=$((window - (window / 5 > 1000 ? window / 5 : 1000)))
    ((window < budget_cap_ms)) && echo "$window" || echo "$budget_cap_ms"
}

budget_ms="${REST[0]:-}"
if [[ ! $budget_ms =~ ^[0-9]+$ ]] || ((10#$budget_ms < 1 || 10#$budget_ms > budget_cap_ms)); then
    budget_ms="$(derive_budget_ms)"
fi
budget_ms=$((10#$budget_ms))

if $DRY_RUN; then
    echo "DRYRUN: $HASEEN_BIN/haseen-shell-ipc lock lock (then wait up to ${budget_ms}ms for a secure lock)"
    exit 0
fi

# EPOCHREALTIME uses the locale's decimal separator: drop every non-digit.
deadline_ms=$((10#${EPOCHREALTIME//[!0-9]/} / 1000 + budget_ms))
remaining_ms() { echo $((deadline_ms - 10#${EPOCHREALTIME//[!0-9]/} / 1000)); }

# bounded LIMIT_MS CMD... — CMD, cut off at LIMIT_MS or what is left.
bounded() {
    local limit=$1 remaining seconds
    shift
    remaining="$(remaining_ms)"
    ((remaining > 0)) || return 1
    ((limit < remaining)) || limit=$remaining
    printf -v seconds '%d.%03d' $((limit / 1000)) $((limit % 1000))
    OMARCHY_SHELL_IPC_TIMEOUT="$seconds" timeout --kill-after=0.1s "$seconds" "$@"
}

# Re-requesting is idempotent, so a request that may not have landed costs
# nothing to repeat; the status poll is what confirms success.
request_lock() { bounded "$lock_timeout_ms" "$HASEEN_BIN/haseen-shell-ipc" lock lock >/dev/null 2>&1 || true; }

# secure: done. locking: the shell has the request. Anything else: ask again.
lock_state() {
    local json
    json="$(bounded "$status_timeout_ms" "$oma/omarchy-shell" lock status 2>/dev/null || true)"
    if [[ $(jq -r '.secure // false' <<<"$json" 2>/dev/null) == true ]]; then
        echo secure
    elif [[ $(active_shell) == dms ]] &&
        bounded "$status_timeout_ms" "$oma/omarchy-hyprland-session-locked" >/dev/null 2>&1; then
        echo secure
    elif [[ $(jq -r '.requested // false' <<<"$json" 2>/dev/null) == true ]]; then
        echo locking
    else
        echo idle
    fi
}

# logind suspends whether or not this wait succeeded: the notification is the
# only way anyone finds out, on the screen they unlock into.
report_unsecured() {
    printf 'omarchy-system-sleep-lock: suspending without a secure lock (%s)\n' "$1" >&2
    "$HASEEN_BIN/haseen-notification-send" -u critical "Screen did not lock before suspend" \
        "The session was left unlocked ($1)." >/dev/null 2>&1 || true
    exit 1
}

request_lock
while (($(remaining_ms) > 0)); do
    case "$(lock_state)" in
    secure) exit 0 ;;
    locking) ;;
    *) request_lock ;;
    esac
    sleep "$poll_interval"
done
report_unsecured "the shell did not secure the session within ${budget_ms}ms"
