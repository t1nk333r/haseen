#!/usr/bin/env bash
# omarchy-agent-account-rename — rename an account: haseen agent account
# rename (plan 108). Until plan 108 this ran Omarchy's installed copy
# (c05d90196, #13770) against Omarchy's registry; haseen has accounts of its
# own now, and reads Omarchy's registry only while it has none
# (share/haseen/lib/agent-accounts.sh).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-agent-account-rename [claude|codex|grok] <account> <name>

haseen's answer to Omarchy's command: haseen agent account rename." "$@"
haseen_exec agent-account-rename "$@"
