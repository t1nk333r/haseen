#!/usr/bin/env bash
# omarchy-agent-account-rename — rename an account. haseen has no account
# registry of its own yet (plan 108 builds haseen's accounts): this runs
# Omarchy's installed copy (c05d90196, #13770), whose state stays where
# Omarchy keeps it (~/.local/state/omarchy/agents/accounts) and whose calls to
# other omarchy-* names reach haseen's answers, and refuses where Omarchy is
# not installed; a dry run prints the call (plan 102). Copying accounts to
# another machine (omarchy-agent-account-copy and -transfer) is refused
# outright.
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-agent-account-rename [claude|codex|grok] <account> <name>

haseen's answer to Omarchy's command: runs Omarchy's own omarchy-agent-account-rename
(haseen keeps one account per agent until it has accounts of its own)." "$@"
omarchy_passthrough "none: haseen keeps one account per agent; sign in with the agent's own CLI" \
    "haseen has no agent accounts of its own yet, and Omarchy's are not installed here." "$@"
