#!/usr/bin/env bash
# omarchy-theme-bg-current — the current background's name the way Omarchy's
# menus and plugins read it: current/background -> .../1-some-image.png
# prints "Some Image", "Unknown" when none is set, exit 0 either way. The
# image is `haseen theme bg current`'s. Follows Omarchy
# bin/omarchy-theme-bg-current (MIT, Copyright (c) David Heinemeier
# Hansson); its perl prettifier became GNU sed (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"

omarchy_help "Usage: omarchy-theme-bg-current

haseen's answer to Omarchy's command: prints the name of the current haseen
background (file name without extension or leading number, dashes as spaces,
words capitalised), or Unknown when none is set." "$@"

if bg="$(haseen_cmd theme-bg current 2>/dev/null)" && [[ -n $bg ]]; then
    # Omarchy names the image the link chain ends at.
    bg="$(readlink -f -- "$bg" 2>/dev/null || printf '%s' "$bg")"
    basename -- "$bg" | sed -E 's/\.[^.]+$//; s/^[0-9]+-//; s/-/ /g; s/\b(\w)/\u\1/g'
else
    echo "Unknown"
fi
