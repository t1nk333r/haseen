#!/usr/bin/env bash
# omarchy-hyprland-corners — show or set window corners: the theme's, sharp or
# rounded. Adapted from Omarchy bin/omarchy-hyprland-corners@v4.5.0-rc1 (MIT,
# Copyright (c) David Heinemeier Hansson) and its
# default/hypr/toggles/corners-{sharp,rounded}.lua: sharp and rounded are
# toggle files in $HASEEN_USER_STATE/toggles/hypr, which haseen's Hyprland
# config loads after the theme's shared window radius, so they win; "theme"
# removes both; writes go through common.sh, so --dry-run prints them (plan
# 102).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-hyprland-corners [theme|sharp|rounded] [--dry-run]

haseen's answer to Omarchy's command: prints the corner choice, or sets it
(theme follows the theme's window radius)." "$@"
parse_common_flags "$@"
TOGGLES_DIR="$HASEEN_USER_STATE/toggles/hypr"
if ((${#REST[@]} == 0)); then
    if [[ -f $TOGGLES_DIR/corners-sharp.lua ]]; then
        echo sharp
    elif [[ -f $TOGGLES_DIR/corners-rounded.lua ]]; then
        echo rounded
    else
        echo theme
    fi
    exit 0
fi
choice=${REST[0]}
case $choice in
theme) label="Window corners follow the theme" ;;
sharp)
    label="Sharp window corners"
    lua='-- Square window corners, whatever the theme sets (omarchy-hyprland-corners).
hl.config({ decoration = { rounding = 0 } })'
    ;;
rounded)
    label="Rounded window corners"
    lua='-- Round window corners, whatever the theme sets (omarchy-hyprland-corners).
hl.config({ decoration = { rounding = 6, rounding_power = 3 } })'
    ;;
*)
    echo "Usage: omarchy-hyprland-corners [theme|sharp|rounded]" >&2
    exit 1
    ;;
esac
# The new choice is saved before the old one goes, so a failed save keeps it.
[[ $choice == theme ]] || printf '%s\n' "$lua" | write_user_file "$TOGGLES_DIR/corners-$choice.lua"
for mode in sharp rounded; do
    [[ $mode == "$choice" ]] || run rm -f -- "$TOGGLES_DIR/corners-$mode.lua"
done
run hyprctl reload >/dev/null
$DRY_RUN && exit 0
"$HASEEN_BIN/haseen-notification-send" "$label" >/dev/null 2>&1 || true
