#!/usr/bin/env bash
# omarchy-theme-set-hermes — publish the current haseen theme to Hermes as the
# skin "haseen" (one theme unit for its desktop app, TUI and CLI; its gateway
# watches the skin file and repaints on change). Adapted from Omarchy
# bin/omarchy-theme-set-hermes (MIT, Copyright (c) David Heinemeier Hansson):
# the skin validation, the private snapshot and the atomic publish into
# ~/.hermes/skins and every profile's skins are Omarchy's. Changes: haseen
# renders no hermes.yaml at theme set, so the skin is current/theme/hermes.yaml
# when the theme ships one, else Omarchy's hermes.yaml template rendered from
# the current colors.toml; the skin is named haseen, not omarchy; Hermes is
# switched to it (its own `hermes config set display.skin`, and only over
# Hermes' default skin) only with --activate or --wait, never by default,
# where Omarchy also did it on every theme set; Hermes counts as ready when
# haseen's omarchy-install-hermes-cli --check says so, or, without it, when
# ~/.local/bin/hermes exists; --dry-run prints and starts nothing (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
# shellcheck source=../themed/lib.sh
source "$HASEEN_OMARCHY_DIR/themed/lib.sh"

HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}"
HERMES_CONFIG_PATH="$HERMES_HOME/config.yaml"
HERMES_SKIN_NAME=haseen
# The command the readiness probe vets, rather than whichever hermes is on PATH.
HERMES_COMMAND="$HOME/.local/bin/hermes"
# Written by the desktop app once the runtime its first launch provisions is in.
HERMES_BOOTSTRAP_MARKER="$HERMES_HOME/hermes-agent/.hermes-bootstrap-complete"
HERMES_WAIT_LIMIT=$((30 * 60))

usage() {
    cat <<EOF
Usage: omarchy-theme-set-hermes [--activate] [--wait] [--dry-run]

haseen's answer to Omarchy's command: publishes the current haseen theme as
the Hermes skin '$HERMES_SKIN_NAME' in $HERMES_HOME/skins (and every profile's
skins) once Hermes has been set up.
  --activate  also switch Hermes to it when Hermes is on its default skin
  --wait      like --activate, first waiting (up to 30 minutes) for Hermes'
              first-launch setup to finish
EOF
}
parse_common_flags "$@"
activate=false
wait_setup=false
for arg in "${REST[@]}"; do
    case "$arg" in
    --activate) activate=true ;;
    --wait)
        activate=true
        wait_setup=true
        ;;
    *)
        usage >&2
        exit 1
        ;;
    esac
done

# A theme switch may run this beside other hooks; only --activate explains.
note() {
    if $activate; then echo "$*" >&2; fi
}

if ! omarchy_theme_file hermes.yaml; then
    $activate || exit 0
    echo "Hermes skin source missing: no current haseen theme to render it from." >&2
    echo "Set one first: haseen theme set <name>" >&2
    exit 1
fi
source_path="$REPLY"

# The first launch takes minutes and may be abandoned; the readiness probe
# would start Hermes to answer, so poll for the marker instead (every 10 s).
if $wait_setup && ! $DRY_RUN; then
    waited=0
    until [[ -f $HERMES_BOOTSTRAP_MARKER && -f $HERMES_CONFIG_PATH ]]; do
        if ((waited >= HERMES_WAIT_LIMIT)); then
            echo "Hermes did not finish setting up within $((HERMES_WAIT_LIMIT / 60)) minutes; run omarchy-theme-set-hermes --activate once it has." >&2
            exit 0
        fi
        sleep 10
        waited=$((waited + 10))
    done
fi

# The config is what Hermes writes once it has actually run.
if [[ ! -f $HERMES_CONFIG_PATH ]]; then
    note "Hermes is not set up yet; launch it once, then run omarchy-theme-set-hermes --activate."
    exit 0
fi

# Hermes parses the skin as YAML and hands its strings to every surface, so only
# the name, a plain description and #rrggbb colours may reach it, in the order
# YAML needs them. YAML breaks lines on bytes grep does not, so the bytes are
# counted first, NUL included.
skin_is_well_formed() {
    local skin="$1"
    [[ -f $skin ]] &&
        (($(LC_ALL=C tr -d ' -~\n' <"$skin" | wc -c) == 0)) &&
        awk -v name="name: $HERMES_SKIN_NAME" '
          bad { next }
          /^#/ || /^[[:space:]]*$/ { next }
          !seen_name { if ($0 == name) seen_name = 1; else bad = 1; next }
          !seen_colors {
            if ($0 == "colors:") seen_colors = 1
            else if (!seen_description && $0 ~ /^description: [A-Za-z0-9 ,.()-]{0,200}$/) seen_description = 1
            else bad = 1
            next
          }
          /^  [a-z_]{1,64}: "#[0-9a-fA-F]{6}"$/ { colors++; next }
          { bad = 1 }
          END { exit (bad || !seen_colors || colors == 0) }
        ' "$skin"
}

# The check has to cover the bytes that get published, and the theme can change
# underneath between the two, so a private copy is taken and that is checked.
omarchy_themed_scratch
hermes_snapshot="$REPLY/$HERMES_SKIN_NAME.yaml"
take_snapshot() {
    cp -- "$source_path" "$hermes_snapshot" 2>/dev/null && skin_is_well_formed "$hermes_snapshot"
}
if ! take_snapshot; then
    echo "Skipping Hermes skin: hermes.yaml is not a plain color palette." >&2
    exit 0
fi

# A profile is a Hermes home of its own; existing ones get the skin, none are
# made, and one that cannot take it does not cost the others.
publish_skin_everywhere() {
    local profile
    omarchy_publish "$hermes_snapshot" "$HERMES_HOME/skins/$HERMES_SKIN_NAME.yaml" || {
        echo "Could not publish the Hermes skin to $HERMES_HOME/skins." >&2
        return 1
    }
    for profile in "$HERMES_HOME"/profiles/*/; do
        [[ -d $profile ]] || continue
        omarchy_publish "$hermes_snapshot" "${profile%/}/skins/$HERMES_SKIN_NAME.yaml" ||
            note "Could not publish the skin to the Hermes profile $(basename "$profile")."
    done
}
publish_skin_everywhere

# Choosing a skin is Hermes' setting: haseen leaves it to the user.
$activate || exit 0

if $DRY_RUN; then
    echo "DRYRUN: timeout 30 $HERMES_COMMAND config set display.skin $HERMES_SKIN_NAME (when Hermes is ready and on its default skin)"
    exit 0
fi

# The probe vets the command before anything here runs it.
hermes_ready() {
    local check="$HASEEN_OMARCHY_DIR/bin/omarchy-install-hermes-cli"
    if [[ -x $check ]]; then
        "$check" --check >/dev/null 2>&1
    else
        [[ -x $HERMES_COMMAND ]]
    fi
}
if ! hermes_ready; then
    note "Hermes is not ready, so the haseen skin is published but not active."
    note "Once Hermes runs, activate it with: hermes config set display.skin $HERMES_SKIN_NAME"
    exit 0
fi

# Only Hermes' own default is replaced, so a skin chosen in Hermes stays; an
# answer that did not come is not a default.
if ! current_skin="$(timeout 15 "$HERMES_COMMAND" config get display.skin 2>/dev/null)"; then
    note "Hermes did not say which skin it is on, so the haseen skin is published but not active."
    exit 0
fi
if [[ -n $current_skin && $current_skin != default && $current_skin != "$HERMES_SKIN_NAME" ]]; then
    note "Hermes is set to the '$current_skin' skin; leaving it. Switch with: hermes config set display.skin $HERMES_SKIN_NAME"
    exit 0
fi

# Hermes' own writer: it updates the active profile's config and touches the
# skin file so a running gateway broadcasts the change. A refusal is cosmetic.
if ! run timeout 30 "$HERMES_COMMAND" config set display.skin "$HERMES_SKIN_NAME" >/dev/null 2>&1; then
    note "Hermes refused to switch skins, so the haseen skin is published but not active."
    exit 0
fi
note "Hermes is on the haseen skin."

# The desktop applies a skin only from a broadcast, and a config written before
# the gateway seeded its watcher goes unannounced; a later write is announced.
# The theme may have changed underneath in the meantime, so it is checked again.
if $wait_setup; then
    sleep 60
    if omarchy_theme_file hermes.yaml && source_path="$REPLY" && take_snapshot; then
        publish_skin_everywhere || true
    fi
fi
