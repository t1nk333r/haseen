#!/usr/bin/env bash
# omarchy-agent-account-remove — forget an added account and delete its home
# here (never logs out): haseen agent account remove (plan 108). Until plan
# 108 this ran Omarchy's installed copy (c05d90196, #13770); haseen has
# accounts of its own now. Omarchy's command asks only on a terminal, so
# without one haseen's is told --yes.
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-agent-account-remove [claude|codex|grok] <account>

haseen's answer to Omarchy's command: haseen agent account remove." "$@"
if [[ -t 0 ]]; then
    haseen_exec agent-account-remove "$@"
fi
haseen_exec agent-account-remove --yes "$@"
