#!/usr/bin/env bash
# omarchy-cmd-browser-handoff — hand a command line to the running
# Chromium-based browser over its profile's SingletonSocket. Exit 0 when the
# browser acknowledged it, 1 when the caller must launch the browser itself.
# Adapted from Omarchy bin/omarchy-cmd-browser-handoff (MIT, Copyright (c)
# David Heinemeier Hansson): unchanged; needs socat (plan 093). Helium is not
# in the table: its /usr/bin entry is a wrapper, which only running it can
# honour.
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-cmd-browser-handoff <browser-command> [browser-args...]

Sends the arguments to the running browser (Chromium, Chrome, Brave, Brave
Origin or Edge) over its own SingletonSocket. Exits 0 when it acknowledged,
1 otherwise (launch it instead). Changes nothing on disk." "$@"

(($# >= 1)) || exit 1
config="${XDG_CONFIG_HOME:-$HOME/.config}"

# Only the browsers themselves: a wrapper in their place may pick a profile or
# add flags of its own, which only running it can honour.
case $(type -P "$1" || true) in
/usr/bin/chromium) profile=chromium flags=chromium-flags.conf ;;
/usr/bin/google-chrome-stable) profile=google-chrome flags=chrome-flags.conf ;;
/usr/bin/brave) profile=BraveSoftware/Brave-Browser flags=brave-flags.conf ;;
/usr/bin/brave-origin) profile=BraveSoftware/Brave-Origin flags=brave-origin-flags.conf ;;
/usr/bin/microsoft-edge-stable) profile=microsoft-edge flags=microsoft-edge-stable-flags.conf ;;
*) exit 1 ;;
esac
shift

# The running browser already has the process flags a flags file sets. Any
# other flag there may be meant for each launch, and a data directory from the
# environment is another browser, so leave those to the launcher.
if [[ -n ${CHROME_USER_DATA_DIR:-}${CHROME_CONFIG_HOME:-} ]] ||
    cat "$(sysroot_path "/etc/$flags")" "$config/$flags" 2>/dev/null | sed 's/#.*//' | tr -s '[:space:]' '\n' |
    grep -vE '^(--(ozone-platform|ozone-platform-hint|password-store|enable-features|load-extension)=.*|--no-default-browser-check)?$' | grep -q .; then
    exit 1
fi
for arg in "$@"; do
    [[ $arg == --user-data-dir* ]] && exit 1
done

# The socket lives in a /tmp dir, which another user could recreate once a
# crashed browser's is cleaned away, so only a socket of our own gets the URL.
socket="$config/$profile/SingletonSocket"
[[ -S $socket && -O $socket ]] || exit 1

reply="$({
    printf 'START\0%s\0browser' "$PWD"
    printf '\0%s' "$@"
} | socat -t2 - "UNIX-CONNECT:$socket" 2>/dev/null || true)"
[[ $reply == ACK ]]
