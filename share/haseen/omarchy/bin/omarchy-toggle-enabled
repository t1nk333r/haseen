#!/usr/bin/env bash
# omarchy-toggle-enabled — exit 0 when an Omarchy toggle is on, 1 when it is
# off, read from the store haseen's omarchy-toggle writes: haseen's own flag
# for a name that means the same (screensaver-off), the running bar for
# bar-off, else $HASEEN_USER_STATE/toggles/omarchy/<name>. Adapted from
# Omarchy bin/omarchy-toggle-enabled (MIT,
# Copyright (c) David Heinemeier Hansson): same contract, read-only; the store
# moves out of ~/.local/state/omarchy/toggles (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-toggle-enabled <flag-name>

haseen's answer to Omarchy's command: exits 0 when the flag omarchy-toggle
keeps is on, 1 when it is off. Read-only." "$@"

name=${1:-}
# A name that would leave the store is never a set flag.
[[ -n $name && $name != */* && $name != .* ]] || exit 1

case $name in
screensaver-off) [[ -e $HASEEN_USER_STATE/flags/$name ]] ;;
bar-off)
    # The bar's hidden state is the session's, not a file (haseen bar toggle).
    hidden="$("$HASEEN_BIN/haseen-shell-ipc" bar status 2>/dev/null | jq -r '.hidden // false' 2>/dev/null || true)"
    [[ $hidden == true ]]
    ;;
*) [[ -e $HASEEN_USER_STATE/toggles/omarchy/$name ]] ;;
esac
