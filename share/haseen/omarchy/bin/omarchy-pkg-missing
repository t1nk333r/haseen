#!/usr/bin/env bash
# omarchy-pkg-missing — exit 0 when any named package is not installed, 1
# when they all are (none named: 1). Adapted from Omarchy
# bin/omarchy-pkg-missing (MIT, Copyright (c) David Heinemeier Hansson): the
# same contract, with haseen's fixture-aware pkg_installed probe (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
# shellcheck source=../../lib/packages.sh
source "$HASEEN_PATH/lib/packages.sh"
omarchy_help "Usage: omarchy-pkg-missing <packages...>

haseen's answer to Omarchy's command: exits 0 when any of the packages is
missing, 1 when all are installed. Read-only." "$@"

for pkg in "$@"; do
    [[ $pkg =~ $PKG_NAME_RE ]] && pkg_installed "$pkg" || exit 0
done
exit 1
