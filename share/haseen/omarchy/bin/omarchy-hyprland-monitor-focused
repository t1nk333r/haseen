#!/usr/bin/env bash
# omarchy-hyprland-monitor-focused — print the focused Hyprland monitor's name.
# Adapted from Omarchy bin/omarchy-hyprland-monitor-focused (MIT, Copyright (c)
# David Heinemeier Hansson): unchanged query (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-hyprland-monitor-focused

haseen's answer to Omarchy's command: prints the name of the focused Hyprland
monitor." "$@"

hyprctl monitors -j | jq -r '.[] | select(.focused == true).name'
