#!/usr/bin/env bash
# omarchy-agent-account-add — sign in to another Claude, Codex or Grok
# subscription in a home of its own: haseen agent account add (plan 108).
# Until plan 108 this ran Omarchy's installed copy (c05d90196, #13770); haseen
# has accounts of its own now. --events, the progress protocol of Omarchy's
# agents panel, is dropped: haseen's command prints plain lines, and the
# result is its exit status.
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-agent-account-add [--check] [--events] [--reauth <account>] [claude|codex|grok] [label]

haseen's answer to Omarchy's command: haseen agent account add." "$@"
args=()
for a in "$@"; do
    [[ $a == --events ]] || args+=("$a")
done
haseen_exec agent-account-add "${args[@]}"
