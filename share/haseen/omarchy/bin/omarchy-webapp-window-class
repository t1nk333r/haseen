#!/usr/bin/env bash
# omarchy-webapp-window-class — print the window class Chromium gives a web
# app opened at a URL (chrome-<host>_<path>-Default), for a launcher's
# StartupWMClass. Adapted from Omarchy
# bin/omarchy-webapp-window-class@v4.5.0-rc1 (MIT, Copyright (c) David
# Heinemeier Hansson), unchanged (plan 102).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-webapp-window-class <url>

haseen's answer to Omarchy's command: prints the window class Chromium gives
a web app opened at <url>." "$@"
url=${1:-}
if [[ -z $url ]]; then
    echo "Usage: omarchy-webapp-window-class <url>" >&2
    exit 1
fi
address=${url#*://}
address=${address%%[?#]*}
host=${address%%/*}
path=${address:${#host}}
host=${host##*@}
host=${host%%:*}
printf 'chrome-%s_%s-Default\n' "${host,,}" "${path:-/}" | sed 's|/|_|g'
