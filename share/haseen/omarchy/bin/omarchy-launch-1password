#!/usr/bin/env bash
# omarchy-launch-1password — start 1Password at scale factor 1, else install
# it (Omarchy binds SUPER + SHIFT + SLASH to it). Adapted from Omarchy
# bin/omarchy-launch-1password (MIT, Copyright (c) David Heinemeier Hansson):
# a packaged 1password still comes first; haseen's catalogue 1Password is the
# Flathub com.onepassword.OnePassword, run as `flatpak run` with the same
# flag; with neither, `haseen install app 1password` opens its own terminal.
# The launch goes through uwsm-app only in a uwsm session (plan 093).
# DRY_RUN=true prints the launch instead.
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"

omarchy_help "Usage: omarchy-launch-1password

haseen's answer to Omarchy's command: starts 1Password (the package, else the
Flatpak) with --force-device-scale-factor=1, else installs it (haseen install
app 1password)." "$@"

# 1Password reads the display scale itself and comes up oversized next to
# every other window on a scaled monitor (Omarchy's note).
ref=com.onepassword.OnePassword
if have 1password; then
    argv=(1password --force-device-scale-factor=1)
elif [[ -d ${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/app/$ref || -d $(sysroot_path /var/lib/flatpak/app)/$ref ]]; then
    argv=(flatpak run "$ref" --force-device-scale-factor=1)
else
    $DRY_RUN && exec "$HASEEN_BIN/haseen-install" app 1password --dry-run
    exec "$HASEEN_BIN/haseen-install" app 1password
fi
if [[ -n ${UWSM_FINALIZE_VARNAMES:-}${UWSM_WAIT_VARNAMES:-} ]] && have uwsm-app; then
    argv=(uwsm-app -- "${argv[@]}")
fi
if $DRY_RUN; then
    echo "DRYRUN: setsid ${argv[*]}"
    exit 0
fi
exec setsid "${argv[@]}"
