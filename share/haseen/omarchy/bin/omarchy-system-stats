#!/usr/bin/env bash
# omarchy-system-stats — print CPU and memory figures for a shell panel.
# Ported from Omarchy bin/omarchy-system-stats (MIT, Copyright (c) David Heinemeier Hansson)
# unchanged: both output contracts stay exactly as
# Omarchy's power panel and bar widget read them; the proc files are read
# through sysroot_path (fixtures); read-only (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"

omarchy_help "Usage: omarchy-system-stats [--bar-widget]

haseen's answer to Omarchy's command. Prints, tab-separated:
  (default)     cpu<TAB>N%  and  memory<TAB>U.UGB / TGB
  --bar-widget  cpu<TAB>idle<TAB>total (/proc/stat jiffies),
                memory<TAB>percent used, load<TAB>1-minute load" "$@"

STAT="$(sysroot_path /proc/stat)"
MEMINFO="$(sysroot_path /proc/meminfo)"
LOADAVG="$(sysroot_path /proc/loadavg)"

bar_widget_stats() {
    awk '
    NR == 1 {
      idle = $5
      total = 0
      for (i = 2; i <= NF; i++) total += $i
      printf "cpu\t%s\t%s\n", idle, total
    }
  ' "$STAT"

    awk '
    /^MemTotal:/ { total = $2 }
    /^MemAvailable:/ { avail = $2 }
    END {
      if (total > 0) printf "memory\t%.2f\n", ((total - avail) / total) * 100
    }
  ' "$MEMINFO"

    awk '{ print "load\t" $1 }' "$LOADAVG"
}

case "${1:-}" in
"") ;;
--bar-widget)
    bar_widget_stats
    exit
    ;;
*)
    echo "Usage: omarchy-system-stats [--bar-widget]" >&2
    exit 1
    ;;
esac

cpu="$(top -bn1 | awk '/^%?Cpu/ {
  gsub(/,/, "")
  for (i = 1; i <= NF; i++) {
    if ($(i + 1) == "id") {
      printf "%.0f%%", 100 - $i
      exit
    }
  }
}')" || true # awk leaves early: top may die of SIGPIPE, which pipefail reports

awk -v cpu="$cpu" '
  /^MemTotal:/ { total = $2 }
  /^MemAvailable:/ { avail = $2 }
  END {
    used = total - avail
    printf "cpu\t%s\n", cpu
    printf "memory\t%.1fGB / %.0fGB\n", used / 1024 / 1024, total / 1024 / 1024
  }
' "$MEMINFO"
