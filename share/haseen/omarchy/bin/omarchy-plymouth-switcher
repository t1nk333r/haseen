#!/usr/bin/env bash
# omarchy-plymouth-switcher — picks the theme that colours the boot splash
# and prints its name, or "default"; nothing, exit 0, when cancelled, as
# Omarchy's does through omarchy-menu-images. Adapted from Omarchy
# bin/omarchy-plymouth-switcher (MIT, Copyright (c) David Heinemeier
# Hansson): Omarchy shows preview-unlock.png thumbnails from ~/.cache/omarchy;
# haseen's themes ship no splash previews (the splash is drawn by a script in
# the theme's colours), so the names are listed in haseen's menu (haseen menu
# select), the current one first: "default" (follow the current theme), then
# haseen theme list. The caller runs omarchy-plymouth-reset or
# omarchy-plymouth-set-by-theme on the answer (plan 093). Read-only.
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-plymouth-switcher

haseen's answer to Omarchy's command: lists default and haseen's themes in
haseen's menu and prints the one chosen for the boot splash." "$@"

current="$("$HASEEN_OMARCHY_DIR/bin/omarchy-plymouth-current" 2>/dev/null || true)"
names=(default)
mapfile -t -O 1 names < <(haseen_cmd theme-list 2>/dev/null || true)
rows=()
[[ -z $current ]] || rows+=($'󰌾\t'"$current"$'\tcurrent')
for name in "${names[@]}"; do
    [[ -n $name && $name != "$current" ]] && rows+=($'󰌾\t'"$name")
done

selection="$(printf '%s\n' "${rows[@]}" | haseen_cmd menu-select "Unlock screen" --width 400)" || exit 0
printf '%s\n' "${selection%%$'\t'*}"
