#!/bin/bash -p
# omarchy-hw-platform — print the hardware platform: x86, aarch64,
# aarch64-apple, aarch64-qualcomm, aarch64-n1x or aarch64-gb10. Ported from
# Omarchy bin/omarchy-hw-platform@v4.5.0-rc1 (MIT, Copyright (c) David
# Heinemeier Hansson) unchanged in what it reads and answers, because
# Omarchy's /etc/mkinitcpio.conf.d/00-omarchy-hooks.conf runs whichever
# omarchy-hw-platform PATH finds first on every initramfs build and stops the
# build when it fails
# (etc/mkinitcpio.conf.d/00-omarchy-hooks.conf@v4.5.0-rc1:10-13): haseen's
# sits first, so it must answer exactly as Omarchy's does (plan 102).
#
# It stands alone, as Omarchy's does: it sources nothing of haseen's, so a
# root caller without HOME (mkinitcpio from a pacman hook) gets its answer.
# Changes: an unprivileged caller's fixture root is HASEEN_SYSROOT (its proc,
# sys and image root) in place of Omarchy's
# OMARCHY_PROC_ROOT/SYS_ROOT/IMAGE_ROOT; --help. Privileged mode (-p) keeps
# exported functions and BASH_ENV out, so a launch without it is refused; root
# starts over in an empty environment and reads only the live paths with a
# fixed PATH, never a fixture.
#
# Platform names are the CPU architecture, then the hardware family when it
# needs handling of its own; "aarch64*" always means ARM. Device-tree ARM
# laptops name their board in the device tree's root compatible strings
# ("apple,<model>" on Apple Silicon, "qcom,<soc>" on Snapdragon). NVIDIA N1x
# laptops are the ARM machines with ACPI NVDA0200 or PCI 10de:2e06; NVIDIA
# GB10 desktops (DGX Spark and the like) have PCI 10de:2e12. While an image is
# being built (not booted) the builder's root-owned manifest
# /var/lib/omarchy/image/target names the platform. Neither IO nor luna is
# ARM: only the x86 answer runs on the owner's machines; the rest is exercised
# by fixtures (tests/test-omarchy-45.sh).
if [[ $- != *p* ]]; then
    echo "Refusing an unsafe Bash startup." >&2
    exit 126
fi

case ${1:-} in
-h | --help)
    printf '%s\n' "Usage: omarchy-hw-platform" "" \
        "haseen's answer to Omarchy's command: prints x86, aarch64, aarch64-apple," \
        "aarch64-qualcomm, aarch64-n1x or aarch64-gb10, as Omarchy's detector does."
    exit 0
    ;;
esac

if ((EUID == 0)) && [[ ${1:-} != --clean-environment ]]; then
    exec /usr/bin/env -i PATH=/usr/bin /bin/bash -p -- "${BASH_SOURCE[0]}" --clean-environment "$@"
fi

if ((EUID == 0)); then
    export PATH=/usr/bin
    root=""
else
    root=${HASEEN_SYSROOT:-}
fi

if [[ -z $root ]]; then
    proc=/proc
    sources=(/proc/device-tree/compatible /sys/firmware/devicetree/base/compatible)
    sys=/sys
    image_root=""
    image_dir=/var/lib/omarchy/image
    image_owner=0
else
    proc=$root/proc
    sources=("$root/proc/device-tree/compatible" "$root/sys/firmware/devicetree/base/compatible")
    sys=$root/sys
    image_root=$root
    image_dir=$root/var/lib/omarchy/image
    image_owner=$EUID
fi
manifest=$image_dir/target

contradiction() {
    echo "Error: contradictory platform identity: $1" >&2
    exit 1
}

if ! machine=$(uname -m) || [[ -z $machine ]]; then
    echo "Error: cannot read the CPU architecture" >&2
    exit 1
fi

# A booted system is one systemd runs as PID 1 from this root; an image build
# shows no /run/systemd/system, another root for PID 1, or a PID 1 that is not
# systemd. What cannot be seen never makes a build.
booted() {
    local comm
    [[ -d $image_root/run/systemd/system ]] || return 1
    if [[ -n $proc && -e $proc/1/root ]]; then
        [[ $proc/1/root -ef $image_root/ ]] || return 1
    fi
    if [[ -n $proc && -r $proc/1/comm ]]; then
        read -r comm <"$proc/1/comm" && [[ $comm == "systemd" ]] || return 1
    fi
}

# Owned by root (the test's own user for a fixture), not a symlink, and not
# writable by anyone else.
trusted() {
    local owner mode
    [[ -e $1 && ! -L $1 ]] || return 1
    read -r owner mode < <(stat -c '%u %a' -- "$1") || return 1
    [[ $owner =~ ^[0-9]+$ && $mode =~ ^[0-7]+$ ]] && ((owner == image_owner && (8#$mode & 8#022) == 0))
}

# The manifest: format=1, platform= one of the names (the old names
# apple-silicon, generic-aarch64, generic and qualcomm still read), comments
# and unknown keys ignored, any other line refused.
image_platform() {
    local line key value format="" platform=""
    if [[ ! -d $image_dir || ! -f $manifest ]] || ! trusted "$image_dir" || ! trusted "$manifest"; then
        echo "Error: the image manifest $manifest is not a root-owned regular file" >&2
        return 1
    fi
    while IFS= read -r line || [[ -n $line ]]; do
        [[ -n $line && $line != \#* ]] || continue
        if [[ $line != *=* ]]; then
            echo "Error: the image manifest $manifest is malformed: $line" >&2
            return 1
        fi
        key=${line%%=*}
        value=${line#*=}
        case $key in
        format) format=$value ;;
        platform) platform=$value ;;
        esac
    done <"$manifest"
    if [[ $format != "1" ]]; then
        echo "Error: the image manifest $manifest is not format=1" >&2
        return 1
    fi
    case $platform in
    apple-silicon) platform=aarch64-apple ;;
    generic-aarch64) platform=aarch64 ;;
    generic) platform=x86 ;;
    qualcomm) platform=aarch64-qualcomm ;;
    esac
    if [[ ! $platform =~ ^(x86|aarch64|aarch64-apple|aarch64-qualcomm|aarch64-n1x|aarch64-gb10)$ ]]; then
        echo "Error: the image manifest $manifest names no known platform: ${platform:-none}" >&2
        return 1
    fi
    echo "$platform"
}

if [[ -n $image_dir ]] && [[ -e $manifest || -L $manifest ]] && ! booted; then
    platform=$(image_platform) || exit 1
    if [[ $platform == "x86" ]]; then
        [[ $machine != "aarch64" ]] || contradiction "$manifest names $platform hardware but the CPU is $machine"
    else
        [[ $machine == "aarch64" ]] || contradiction "$manifest names $platform hardware but the CPU is $machine"
    fi
    echo "$platform"
    exit 0
fi

vendor=""
vendor_source=""
for source in "${sources[@]}"; do
    [[ -r $source ]] || continue
    apple=0
    qcom=0
    mapfile -d '' -t tokens <"$source"
    for token in "${tokens[@]}"; do
        [[ $token == "apple,"* ]] && apple=1
        [[ $token == "qcom,"* ]] && qcom=1
    done
    if ((apple && qcom)); then
        contradiction "$source names both Apple and Qualcomm hardware"
    elif ((apple)); then
        found=apple
    elif ((qcom)); then
        found=qcom
    else
        found=none
    fi
    if [[ -n $vendor && $vendor != "$found" ]]; then
        contradiction "$vendor_source says $vendor but $source says $found"
    fi
    vendor=$found
    vendor_source=$source
done

# pci_device_with VENDOR DEVICE — the first PCI device of that id, if any.
pci_device_with() {
    local device pci_vendor pci_device
    for device in "$sys"/bus/pci/devices/*; do
        [[ -r $device/vendor && -r $device/device ]] || continue
        read -r pci_vendor <"$device/vendor" || continue
        read -r pci_device <"$device/device" || continue
        if [[ $pci_vendor == "$1" && $pci_device == "$2" ]]; then
            printf '%s\n' "$device"
            return 0
        fi
    done
    return 1
}

# An NVIDIA N1x: ACPI NVDA0200, or PCI 10de:2e06.
n1x_source=""
for device in "$sys"/bus/acpi/devices/NVDA0200:*; do
    [[ -d $device ]] && {
        n1x_source=$device
        break
    }
done
[[ -n $n1x_source ]] || n1x_source=$(pci_device_with 0x10de 0x2e06) || n1x_source=""

# An NVIDIA GB10 desktop: PCI 10de:2e12.
gb10_source=$(pci_device_with 0x10de 0x2e12) || gb10_source=""

if [[ -n $n1x_source && -n $gb10_source ]]; then
    contradiction "$n1x_source is an NVIDIA N1x but $gb10_source is an NVIDIA GB10"
fi
if [[ -n $n1x_source ]]; then
    [[ $vendor != apple && $vendor != qcom ]] ||
        contradiction "$vendor_source names $vendor hardware but $n1x_source is an NVIDIA N1x"
    [[ $machine == "aarch64" ]] || contradiction "$n1x_source is an NVIDIA N1x but the CPU is $machine"
    echo aarch64-n1x
    exit 0
fi
if [[ -n $gb10_source ]]; then
    [[ $vendor != apple && $vendor != qcom ]] ||
        contradiction "$vendor_source names $vendor hardware but $gb10_source is an NVIDIA GB10"
    [[ $machine == "aarch64" ]] || contradiction "$gb10_source is an NVIDIA GB10 but the CPU is $machine"
    echo aarch64-gb10
    exit 0
fi

case $vendor in
apple | qcom)
    [[ $machine == "aarch64" ]] || contradiction "$vendor_source names $vendor hardware but the CPU is $machine"
    if [[ $vendor == "apple" ]]; then
        echo aarch64-apple
    else
        echo aarch64-qualcomm
    fi
    ;;
*)
    if [[ $machine == "aarch64" ]]; then
        echo aarch64
    else
        echo x86
    fi
    ;;
esac
