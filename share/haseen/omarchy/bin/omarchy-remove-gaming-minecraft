#!/usr/bin/env bash
# omarchy-remove-gaming-minecraft — remove the Minecraft launcher in whichever
# form is installed (Omarchy's minecraft-launcher package, haseen's Flatpak),
# then, after asking, its worlds, mods and caches. Adapted from Omarchy
# bin/omarchy-remove-gaming-minecraft (MIT, Copyright (c) David Heinemeier
# Hansson): the data paths are Omarchy's, plus the Flatpak's ~/.var/app
# directory; omarchy-pkg-drop -> haseen remove package and haseen remove app
# minecraft; --dry-run prints the plan (plan 093).
#
# Data: Omarchy deletes the worlds without asking; here they are asked about,
# default no, and --yes deletes them as Omarchy does.
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
# shellcheck source=../remove-lib.sh
source "$HASEEN_OMARCHY_DIR/remove-lib.sh"

usage() {
    cat <<EOF
Usage: omarchy-remove-gaming-minecraft [--dry-run] [--yes]

haseen's answer to Omarchy's command: removes minecraft-launcher and the
com.mojang.Minecraft Flatpak, whichever is installed (haseen remove), then
asks (default no; --yes deletes, as Omarchy does) before deleting ~/.minecraft
with its worlds and mods, the launcher's settings and its caches.
EOF
}

in_floating_terminal "$@"
parse_common_flags "$@"
((${#REST[@]} == 0)) || {
    usage >&2
    exit 2
}
require_not_root

ID=com.mojang.Minecraft
remove_pkgs minecraft-launcher
remove_flatpak_app minecraft "$ID"
data_removed=false
delete_asked "Also delete Minecraft's worlds, mods, settings and caches" yes \
    "$HOME/.minecraft" "$HOME/.config/Minecraft Launcher" "$HOME/.local/share/minecraft-launcher" \
    "$HOME/.cache/minecraft" "$HOME/.var/app/$ID" && data_removed=true

echo ""
if $data_removed && ! $DRY_RUN; then
    echo "Minecraft and its data have been removed."
else
    echo "Minecraft has been removed."
fi
