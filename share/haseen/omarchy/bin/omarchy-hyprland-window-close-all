#!/usr/bin/env bash
# omarchy-hyprland-window-close-all — close every window, then go to workspace
# 1. Adapted from Omarchy bin/omarchy-hyprland-window-close-all (MIT,
# Copyright (c) David Heinemeier Hansson): the same dispatches, in the form
# Hyprland's config takes; one window refusing to close does not stop the
# rest (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
# shellcheck source=../../lib/screen.sh
source "$HASEEN_PATH/lib/screen.sh"

# dispatch LUA LEGACY... — one Hyprland dispatcher: the Lua form when Hyprland
# reads a Lua config (screen_lua asks it once), else the legacy form. A dry run
# prints it instead.
hypr_lua=""
dispatch() {
    local lua="$1" args
    shift
    if [[ -z $hypr_lua ]]; then
        if screen_lua; then hypr_lua=yes; else hypr_lua=no; fi
    fi
    if [[ $hypr_lua == yes ]]; then args=(dispatch "$lua"); else args=(dispatch "$@"); fi
    if $DRY_RUN; then
        echo "DRYRUN: hyprctl ${args[*]}"
    else
        hyprctl "${args[@]}" >/dev/null
    fi
}

usage() {
    cat <<USAGE
Usage: omarchy-hyprland-window-close-all [--dry-run]

haseen's answer to Omarchy's command: asks every window to close, then focuses
workspace 1.
USAGE
}
parse_common_flags "$@"

clients="$(hyprctl clients -j 2>/dev/null || echo '[]')"
while read -r addr; do
    [[ $addr =~ ^0x[0-9a-fA-F]+$ ]] || continue
    dispatch "hl.dsp.window.close({ window = \"address:$addr\" })" closewindow "address:$addr" || true
done < <(jq -r '.[]?.address' <<<"$clients" 2>/dev/null || true)

dispatch 'hl.dsp.focus({ workspace = "1" })' workspace 1 || true
