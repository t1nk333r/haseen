#!/usr/bin/env bash
# omarchy-install-openclaw-cli — install OpenClaw as the one self-updating copy
# under ~/.openclaw, seeded from the openclaw package, and move the gateway and
# node user services the old package installed onto it. Ported from Omarchy
# bin/omarchy-install-openclaw-cli (MIT, Copyright (c) David Heinemeier
# Hansson): the modes and exit codes (--check 0/1, --now, exit 79 for an
# OpenClaw of the user's own, usage exit 1, the EUID refusal), the PATH and
# unit probes and the service move are Omarchy's. Changes:
# omarchy-pkg-present/add -> pkg_installed and haseen install app openclaw
# (repos, Chaotic-AUR, [omarchy], then the AUR); the record of services a run
# stopped is $HASEEN_USER_STATE/openclaw-stopped, and a role Omarchy's own
# record (~/.local/state/omarchy/openclaw-stopped, only read) names as stopped
# by an interrupted Omarchy run is taken over while its unit is still the old
# package's; the gateway waits poll every 2 s, not every second; messages name
# haseen; the seed is read through sysroot_path; every change goes through
# common.sh, so --dry-run prints the plan, stopping where a step's result
# decides what follows (plan 093).
#
# The installer it runs, /usr/share/openclaw/install-cli.sh, is the package's
# own file, installed by pacman, never a download; it installs the package's
# own openclaw.tgz.
#
# A copy in /usr belongs to pacman, and upstream's updater refuses to touch
# it. The openclaw package is therefore the seed rather than the runtime: the
# release haseen installs and the installer that came with it. The CLI, the
# gateway service and the web app all run the copy under ~/.openclaw.
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
# shellcheck source=../../lib/packages.sh
source "$HASEEN_PATH/lib/packages.sh"

usage() {
    cat <<EOF
Usage: omarchy-install-openclaw-cli <--check|--now> [--dry-run] [--yes]

haseen's answer to Omarchy's command:
  --check  exit 0 when OpenClaw is installed as the self-updating copy in
           ~/.openclaw and is the openclaw every session runs, else 1
  --now    install it: haseen install app openclaw, then the package's
           install-cli.sh into ~/.openclaw; exit 79 when an OpenClaw of your
           own is in the way
EOF
}

mode=""
for arg in "$@"; do
    case "$arg" in
    --dry-run) DRY_RUN=true ;;
    --yes | -y) ASSUME_YES=true ;;
    -h | --help)
        usage
        exit 0
        ;;
    *)
        if [[ -n $mode ]]; then
            usage >&2
            exit 1
        fi
        mode=$arg
        ;;
    esac
done

# dry_stop STEP... — a dry run reached a step whose result the rest depends
# on: print what follows and stop there, successfully.
dry_stop() {
    local step
    for step in "$@"; do echo "DRYRUN: then $step"; done
    exit 0
}

# Everything here runs the user's own files, --check included.
if ((EUID == 0)); then
    echo "Run this command as your desktop user, without sudo." >&2
    exit 1
fi

# haseen's OpenClaw is the default one, in ~/.openclaw with the default unit,
# whatever another profile, unit or state directory a shell selects; a service
# installed from here would otherwise carry that selection.
unset OPENCLAW_PROFILE OPENCLAW_SYSTEMD_UNIT OPENCLAW_WRAPPER OPENCLAW_HOME OPENCLAW_STATE_DIR OPENCLAW_CONFIG_PATH

prefix="$HOME/.openclaw"
runtime_command="$prefix/bin/openclaw"
command_path="$HOME/.local/bin/openclaw"
seed="$(sysroot_path /usr/share/openclaw)"
# The services a run stopped, kept until a run completes: one that fails after
# the stop leaves them stopped, and the next would take them for stopped by the
# user. Omarchy's own record is read, never written.
stopped_dir="$HASEEN_USER_STATE/openclaw-stopped"
omarchy_stopped_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/openclaw-stopped"

# Usable means the command answers, not that the file is there: upstream's
# wrapper execs the prefix's own Node, so a prefix missing either fails here.
runtime_runs() {
    [[ -f $runtime_command && -x $runtime_command ]] &&
        timeout 30 "$runtime_command" --version >/dev/null 2>&1
}

# The name on PATH is a link to the runtime's command. A link already aimed
# there, even a dangling one, is ours to rewrite; anything else is the user's.
command_ours() {
    [[ ! -e $command_path && ! -L $command_path ]] || [[ $(readlink -- "$command_path") == "$runtime_command" ]]
}

# What the agent launcher, the web app and a terminal run is whichever
# openclaw their PATH finds first, and the order differs between them (mise's
# shims, /usr/local/bin, ~/.local/bin). So the runtime has to be the only
# openclaw in any of those places, wherever each sits.
session_openclaws() {
    local shims=${MISE_SHIMS_DIR:-${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/shims}
    PATH="$shims:$HOME/.local/share/mise/shims:/usr/local/bin:$PATH:$HOME/.local/bin" type -aP openclaw
}

# Any openclaw a session might run other than the expected one, the runtime's
# unless another is named.
foreign_openclaw() {
    local expected=${1:-$runtime_command} found
    while IFS= read -r found; do
        if [[ $(realpath -m -- "$found") != "$(realpath -m -- "$expected")" ]]; then
            echo "$found"
            return 0
        fi
    done < <(session_openclaws)
    return 1
}

on_path() {
    session_openclaws >/dev/null && ! foreign_openclaw >/dev/null
}

# Nothing yet, or only the runtime's command.
path_clear() {
    ! foreign_openclaw >/dev/null
}

# Until the package ships the seed, the openclaw package is still OpenClaw
# itself, in /usr: --check takes it as installed, and --now installs it and
# stops there.
package_is_openclaw() {
    [[ ! -r $seed/install-cli.sh || ! -r $seed/openclaw.tgz ]]
}

# A machine that already moved has its OpenClaw in ~/.openclaw, and the
# package being OpenClaw again only puts an older copy ahead of it on PATH.
moved_before() {
    [[ -e $runtime_command ]] || { [[ -L $command_path ]] && command_ours; }
}

# While the package is OpenClaw itself its command is the one OpenClaw.
package_command=/usr/bin/openclaw

package_shadowed() {
    local found
    found=$(foreign_openclaw "$package_command") || return 1
    echo "Another openclaw is on PATH at $found, which haseen could run instead of $package_command." >&2
    echo "Remove it, then run omarchy-install-openclaw-cli --now again." >&2
}

package_in_the_way() {
    echo "OpenClaw is set up in $prefix, but the openclaw package is OpenClaw itself again and comes first on PATH." >&2
    echo "The update that brings the openclaw package back as the seed puts this right." >&2
}

# The package counts too: without it --now has a pacman step to take, and
# answering yes here would run that where no terminal can ask for a password.
installed() {
    pkg_installed openclaw && runtime_runs && on_path
}

# A unit's ExecStart, as the program and the script it is handed: the first
# argument that is not an option.
unit_program() {
    local words
    read -ra words <<<"$(sed -n 's/^ExecStart=//p' "$1" | head -1)"
    echo "${words[0]:-}"
}

unit_script() {
    local words word
    read -ra words <<<"$(sed -n 's/^ExecStart=//p' "$1" | head -1)"
    for word in "${words[@]:1}"; do
        if [[ $word != -* ]]; then
            echo "$word"
            return
        fi
    done
}

# The runtime's own OpenClaw, as upstream's installer lays it out.
runs_runtime() {
    [[ $(unit_script "$1") == "$prefix"/tools/*/lib/node_modules/openclaw/* ]]
}

unit_path() {
    echo "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/openclaw-$1.service"
}

# A gateway service already running some other OpenClaw. Upstream's installer
# rewrites a loaded gateway service to the copy it has just installed, so
# seeding beside one would take it over.
foreign_gateway() {
    local unit
    unit=$(unit_path gateway)
    [[ -f $unit ]] && ! runs_runtime "$unit" && ! on_old_package "$unit"
}

# Still the old package's: its script, or the runtime's script on the old
# package's Node. Any other Node, Bun or script is the user's.
on_old_package() {
    [[ $(unit_script "$1") == /usr/lib/node_modules/openclaw/* ]] ||
        { [[ $(unit_program "$1") == "/usr/bin/node" ]] && runs_runtime "$1"; }
}

unit_active() { systemctl --user is-active --quiet "openclaw-$1.service" 2>/dev/null; }

# Stopped before anything is installed: still running the old code from
# deleted files, such a service holds the state directory the newer runtime
# has to migrate, which upstream's installer does the moment it finds one.
stop_legacy_services() {
    local role
    for role in "${moving[@]}"; do
        if [[ " ${running[*]} " == *" $role "* ]]; then
            run mkdir -p "$stopped_dir"
            run touch "$stopped_dir/$role"
        fi
        if ! run systemctl --user stop "openclaw-$role.service"; then
            echo "Could not stop the OpenClaw $role service, so OpenClaw was not moved to $prefix." >&2
            return 1
        fi
        if [[ " ${running[*]} " == *" $role "* ]]; then
            stopped+=("$role")
        fi
    done
}

# Not moved yet: still on the old package, or running before and not now.
unsettled() {
    on_old_package "$(unit_path "$1")" ||
        { [[ " ${running[*]} " == *" $1 "* ]] && ! unit_active "$1"; }
}

# The local gateway's own answer, on the port its service is started with.
gateway_answers() {
    local out port
    port=$(systemctl --user show -P ExecStart openclaw-gateway.service 2>/dev/null |
        sed -n 's/.*argv\[\]=[^;]* --port[= ]\([0-9][0-9]*\).*/\1/p' | head -1)
    out=$(env -u OPENCLAW_GATEWAY_URL -u OPENCLAW_GATEWAY_PORT -u OPENCLAW_GATEWAY_TOKEN -u OPENCLAW_GATEWAY_PASSWORD \
        ${port:+OPENCLAW_GATEWAY_PORT="$port"} timeout -k 5 10 "$runtime_command" health --json --timeout 3000 2>/dev/null) &&
        jq -e '.ok == true' <<<"$out" >/dev/null 2>&1
}

# Waits out systemd's restarts, for two minutes at most, asking every 2 s; a
# gateway that failed or stopped is not coming back on its own.
gateway_serves() {
    local deadline=$((SECONDS + 120)) state
    while ((SECONDS < deadline)); do
        gateway_answers && return 0
        state=$(systemctl --user show -P ActiveState openclaw-gateway.service 2>/dev/null) || state=failed
        [[ $state == active || $state == activating || $state == reloading ]] || return 1
        sleep 2
    done
    return 1
}

# A started gateway can still exit seconds later: a newer runtime refuses the
# agent database an older OpenClaw left until doctor migrates it.
settle_gateway() {
    gateway_serves && return 0
    echo "Repairing OpenClaw's state for $prefix..."
    if ! run systemctl --user stop openclaw-gateway.service; then
        echo "Could not stop the OpenClaw gateway service to repair it. Stop it, then run omarchy-install-openclaw-cli --now again." >&2
        return 1
    fi
    run "$runtime_command" doctor --fix --non-interactive </dev/null || true
    run systemctl --user start openclaw-gateway.service || true
    gateway_serves && return 0
    echo "The OpenClaw gateway does not answer after moving to $prefix. See: journalctl --user -u openclaw-gateway.service" >&2
    return 1
}

# Whatever is still unsettled is installed again from the runtime, on the
# runtime's own Node, and then has to have settled. A plan shows the steps;
# only a real run has a result to judge.
rehome_services() {
    local role node pin=()
    if node=$(realpath -e -- "$prefix/tools/node/bin/node" 2>/dev/null); then
        pin=(--runtime-path "$node")
    fi
    for role in "${moving[@]}"; do
        if $DRY_RUN || unsettled "$role"; then
            echo "Moving the OpenClaw $role service to $prefix..."
            run "$runtime_command" "$role" install --force "${pin[@]}" || true
        fi
        if ! $DRY_RUN && { on_old_package "$(unit_path "$role")" || { [[ $role != gateway ]] && unsettled "$role"; }; }; then
            echo "Could not move the OpenClaw $role service to $prefix. Finish with: openclaw $role install --force" >&2
            return 1
        fi
        # Installing a service enables and starts it; one the user had left
        # stopped or disabled goes back to that.
        if [[ " ${running[*]} " != *" $role "* ]]; then
            run systemctl --user stop "openclaw-$role.service" || true
        fi
        if [[ " ${enabled[*]} " != *" $role "* ]]; then
            run systemctl --user disable "openclaw-$role.service" 2>/dev/null || true
        fi
        $DRY_RUN && continue
        if [[ $role == gateway && " ${running[*]} " == *" gateway "* ]]; then
            settle_gateway || return 1
        fi
        if unit_active "$role"; then
            run rm -f -- "$stopped_dir/$role"
        fi
    done
}

# Said on any failure that leaves a service this run stopped not running.
stopped_note() {
    local role
    for role in "${stopped[@]}"; do
        if ! unit_active "$role"; then
            echo "The OpenClaw $role service was stopped for this and is not running now; it starts again once this completes." >&2
        fi
    done
}

case "$mode" in
--check)
    if pkg_installed openclaw && package_is_openclaw; then
        if moved_before || package_shadowed 2>/dev/null; then exit 1; else exit 0; fi
    fi
    if installed; then exit 0; else exit 1; fi
    ;;
--now)
    if pkg_installed openclaw && package_is_openclaw; then
        if moved_before; then
            package_in_the_way
            exit 1
        fi
        if package_shadowed; then exit 1; fi
        exit 0
    fi
    ;;
*)
    echo "Usage: omarchy-install-openclaw-cli <--check|--now>" >&2
    exit 1
    ;;
esac

# Refused before anything is installed or touched: the command's name, what
# PATH finds, and a gateway running another OpenClaw all have to be clear.
# Each is an OpenClaw of the user's own, and these refusals exit with a status
# no tool run here uses, so a caller can tell them from a failed setup.
users_own=79
if ! command_ours; then
    echo "$command_path is not the OpenClaw haseen set up. Move it aside, then run omarchy-install-openclaw-cli --now again." >&2
    exit "$users_own"
fi
if ! path_clear; then
    echo "Another openclaw is on PATH at $(foreign_openclaw), which haseen could run instead of $runtime_command." >&2
    echo "Remove it, then run omarchy-install-openclaw-cli --now again." >&2
    exit "$users_own"
fi

# A runtime that already answers is never reinstalled: it may be past the
# packaged release by its own updates, and seeding would take it back.
seeding=false
if ! runtime_runs; then
    seeding=true
fi
if [[ $seeding == "true" ]] && foreign_gateway; then
    echo "The OpenClaw gateway service runs another OpenClaw, which setting one up in $prefix would take over." >&2
    echo "Remove that gateway with 'openclaw gateway uninstall', then run omarchy-install-openclaw-cli --now again." >&2
    exit "$users_own"
fi

if ! pkg_installed openclaw; then
    echo "Installing OpenClaw..."
    flags=()
    $DRY_RUN && flags+=(--dry-run)
    $ASSUME_YES && flags+=(--yes)
    HASEEN_INLINE=1 "$HASEEN_BIN/haseen-install" app openclaw "${flags[@]}"
    $DRY_RUN && dry_stop "when the package ships the seed: set up OpenClaw in $prefix with $seed/install-cli.sh" \
        "link $command_path to $runtime_command and move the gateway and node services the old package installed"
fi
if package_is_openclaw; then
    if moved_before; then
        package_in_the_way
        exit 1
    fi
    if package_shadowed; then exit 1; fi
    echo "OpenClaw runs from its package until an update brings the release that sets up the self-updating copy."
    exit 0
fi

# What the old package installed, and what of it was running and enabled,
# read before anything changes.
moving=()
running=()
enabled=()
stopped=()
for role in gateway node; do
    if [[ -f $(unit_path "$role") ]] && on_old_package "$(unit_path "$role")"; then
        moving+=("$role")
        if unit_active "$role"; then
            running+=("$role")
        fi
        if systemctl --user is-enabled --quiet "openclaw-$role.service" 2>/dev/null; then
            enabled+=("$role")
        fi
        # An Omarchy run that stopped this service and was interrupted left
        # its record behind, with the unit still the old package's: the
        # service was running, so it runs again once this completes.
        if [[ -e $omarchy_stopped_dir/$role && ! -e $stopped_dir/$role ]] && ! unit_active "$role"; then
            run mkdir -p "$stopped_dir"
            run touch "$stopped_dir/$role"
        fi
    fi
done

trap 'status=$?; ((status == 0)) || stopped_note' EXIT
stop_legacy_services

if [[ $seeding == "true" ]]; then
    # Every choice the installer reads from the environment is named, so an
    # OPENCLAW_INSTALL_METHOD or OPENCLAW_PREFIX left in a shell cannot move it.
    echo "Setting up OpenClaw in $prefix..."
    run bash "$seed/install-cli.sh" --install-method npm --prefix "$prefix" --version "$seed/openclaw.tgz" --no-onboard || true
    $DRY_RUN && dry_stop "link $command_path to $runtime_command" \
        "move the services ${moving[*]:-(none)} to $prefix and start again the ones this run stopped"
    if ! runtime_runs; then
        echo "OpenClaw setup did not complete. Re-run this command after resolving the installer error." >&2
        exit 1
    fi
fi

run mkdir -p "${command_path%/*}"
run ln -sfn "$runtime_command" "$command_path"

rehome_services

# One whose file is in none of the directories the running user manager loads
# units from was removed since; without the list it is tried. The list comes
# from D-Bus as JSON because systemctl show quotes a path with spaces.
unit_removed() {
    local paths dir
    local -a dirs
    paths=$(busctl --user --json=short get-property org.freedesktop.systemd1 /org/freedesktop/systemd1 \
        org.freedesktop.systemd1.Manager UnitPath 2>/dev/null | jq -r '.data[]' 2>/dev/null) && [[ -n $paths ]] || return 1
    mapfile -t dirs <<<"$paths"
    for dir in "${dirs[@]}"; do
        [[ ! -e $dir/openclaw-$1.service && ! -L $dir/openclaw-$1.service ]] || return 1
    done
}

# Whether the command the user manager runs for a service, drop-ins included,
# is the runtime's.
manager_runs_runtime() {
    local argv
    argv=$(systemctl --user show -P ExecStart "openclaw-$1.service" 2>/dev/null |
        sed -n 's/.*argv\[\]=\([^;]*\) ;.*/\1/p' | head -1)
    [[ -n $argv ]] && runs_runtime <(printf 'ExecStart=%s\n' "$argv")
}

# A service a failed run stopped was running before it, so it runs again now,
# whether this run moved it or an earlier one already had.
for role in gateway node; do
    if [[ -e $stopped_dir/$role ]]; then
        if ! unit_removed "$role"; then
            if ! unit_active "$role" && ! run systemctl --user start "openclaw-$role.service"; then
                echo "Could not start the OpenClaw $role service again. Start it with: systemctl --user start openclaw-$role.service" >&2
                exit 1
            fi
            if ! $DRY_RUN && [[ $role == gateway ]] && manager_runs_runtime gateway && ! settle_gateway; then
                exit 1
            fi
        fi
        run rm -f -- "$stopped_dir/$role"
    fi
done

if ! $DRY_RUN && ! on_path; then
    echo "$runtime_command is ready, but another openclaw is on PATH at $(foreign_openclaw), which haseen could run instead." >&2
    echo "Remove it, then run omarchy-install-openclaw-cli --now again." >&2
    exit 1
fi
