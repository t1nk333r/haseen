#!/usr/bin/env bash
# omarchy-hyprland-workspace-layout-toggle — step the active workspace's
# layout. Translated onto haseen toggle workspace-layout: it cycles dwindle,
# scrolling and floating as Omarchy 4.5 does (plan 105), so `back`
# (SUPER + ALT + L, default/hypr/bindings/tiling.lua@v4.5.0-rc1:15) is haseen's
# back and `next` its toggle (plan 102).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-hyprland-workspace-layout-toggle [back] [--dry-run]

haseen's answer to Omarchy's command: steps the active workspace through
dwindle, scrolling and floating, or back (haseen toggle workspace-layout)." "$@"
parse_common_flags "$@"
if ((${#REST[@]} > 1)) || [[ ${#REST[@]} -eq 1 && ${REST[0]} != back && ${REST[0]} != next ]]; then
    echo "Usage: omarchy-hyprland-workspace-layout-toggle [back]" >&2
    exit 1
fi
flags=()
$DRY_RUN && flags+=(--dry-run)
step=toggle
[[ ${REST[0]:-} == back ]] && step=back
haseen_exec toggle-workspace-layout "$step" "${flags[@]}"
