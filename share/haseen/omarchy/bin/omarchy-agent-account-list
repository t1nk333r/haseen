#!/usr/bin/env bash
# omarchy-agent-account-list — list the Claude, Codex and Grok accounts:
# haseen agent account list (plan 108). Until plan 108 this ran Omarchy's
# installed copy (c05d90196, #13770) against Omarchy's registry; haseen has
# accounts of its own now, and reads Omarchy's registry only while it has
# none (share/haseen/lib/agent-accounts.sh). Copying accounts to another
# machine (omarchy-agent-account-copy and -transfer) stays refused.
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-agent-account-list [claude|codex|grok] [--json]

haseen's answer to Omarchy's command: haseen agent account list." "$@"
haseen_exec agent-account-list "$@"
