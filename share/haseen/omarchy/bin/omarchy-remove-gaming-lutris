#!/usr/bin/env bash
# omarchy-remove-gaming-lutris — remove Lutris in whichever form is installed
# (Omarchy's packages with Wine, winetricks and umu-launcher; haseen's
# Flatpak), then, after asking, their configs and caches and ~/.wine.
# Adapted from Omarchy bin/omarchy-remove-gaming-lutris (MIT, Copyright (c)
# David Heinemeier Hansson): the package list and data paths are Omarchy's,
# plus the Flatpak's ~/.var/app directory; omarchy-pkg-drop -> haseen remove
# package, which here leaves a package another one still needs (a shared Wine
# or python-protobuf failed Omarchy's whole removal); --dry-run prints the
# plan (plan 093).
#
# Data: Omarchy deletes it all without asking; here it is asked, default no,
# and --yes deletes it as Omarchy does. ~/.wine is the default Wine prefix,
# which other Windows programs may share: the question names it.
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
# shellcheck source=../remove-lib.sh
source "$HASEEN_OMARCHY_DIR/remove-lib.sh"

usage() {
    cat <<EOF
Usage: omarchy-remove-gaming-lutris [--dry-run] [--yes]

haseen's answer to Omarchy's command: removes lutris, wine-staging, wine-mono,
wine-gecko, winetricks, python-protobuf and umu-launcher (those installed and
not needed by another package) and the net.lutris.Lutris Flatpak, then asks
(default no; --yes deletes, as Omarchy does) before deleting their configs and
caches and the Wine prefix ~/.wine.
EOF
}

in_floating_terminal "$@"
parse_common_flags "$@"
((${#REST[@]} == 0)) || {
    usage >&2
    exit 2
}
require_not_root

ID=net.lutris.Lutris
remove_pkgs lutris wine-staging wine-mono wine-gecko winetricks python-protobuf umu-launcher
remove_flatpak_app lutris "$ID"
data_removed=false
delete_asked "Also delete the Lutris, umu and Wine configs and caches, and the Wine prefix ~/.wine (shared by every Wine program)" yes \
    "$HOME/.config/lutris" "$HOME/.local/share/lutris" "$HOME/.cache/lutris" \
    "$HOME/.local/share/umu" "$HOME/.cache/umu" "$HOME/.wine" "$HOME/.cache/wine" \
    "$HOME/.cache/winetricks" "$HOME/.var/app/$ID" && data_removed=true

echo ""
if $data_removed && ! $DRY_RUN; then
    echo "Lutris, Wine, umu-launcher, and their configs have been removed."
else
    echo "Lutris has been removed."
fi
