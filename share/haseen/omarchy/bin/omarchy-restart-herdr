#!/usr/bin/env bash
# omarchy-restart-herdr — make a running herdr server reload its config
# (haseen ships herdr with the desktop layer). Adapted from Omarchy
# bin/omarchy-restart-herdr (MIT, Copyright (c) David Heinemeier Hansson): the
# same contract (exit 0 with no server, diagnostics and the error on stderr,
# exit 1 on a failed reload); a reply that is not JSON also counts as failed;
# --dry-run prints the reload (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"

usage() {
    cat <<EOF
Usage: omarchy-restart-herdr [--dry-run]

haseen's answer to Omarchy's command: when a herdr server runs, asks it to
reload its config (herdr server reload-config); prints the reload's
diagnostics on stderr and exits 1 when the reload failed. Nothing to do when
no server runs.
EOF
}
# Other arguments are ignored, as upstream ignores them.
parse_common_flags "$@"

have herdr || exit 0
[[ $(herdr status server --json 2>/dev/null | jq -r '.running' 2>/dev/null) == true ]] || exit 0

if $DRY_RUN; then
    echo "DRYRUN: herdr server reload-config"
    exit 0
fi
# The reply carries the outcome; herdr's own exit status is not the contract.
reload="$(herdr server reload-config)" || true
jq -r '.result.diagnostics[]?, (.error.message | select(. != null))' <<<"$reload" >&2 2>/dev/null || true
status="$(jq -r '.result.status // "failed"' <<<"$reload" 2>/dev/null)" || status=failed
if [[ -z $status || $status == failed ]]; then
    jq -e . <<<"$reload" >/dev/null 2>&1 || printf '%s\n' "${reload:-herdr gave no reply}" >&2
    exit 1
fi
