#!/usr/bin/env bash
# omarchy-theme-set-pi — publish the current haseen theme to the Pi coding
# agent as the theme "haseen" (~/.pi/agent/themes/haseen.json). Adapted from
# Omarchy bin/omarchy-theme-set-pi (MIT, Copyright (c) David Heinemeier
# Hansson): haseen renders no pi.json at theme set, so the theme file is
# current/theme/pi.json when the theme ships one, else Omarchy's pi.json
# template rendered from the current colors.toml; the theme is named haseen,
# not omarchy-system; a render with an unresolved placeholder is not
# published. Pi's settings.json is changed only with --activate, never by
# default (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
# shellcheck source=../themed/lib.sh
source "$HASEEN_OMARCHY_DIR/themed/lib.sh"

PI_AGENT_DIR="$HOME/.pi/agent"
PI_THEME_PATH="$PI_AGENT_DIR/themes/haseen.json"
PI_SETTINGS_PATH="$PI_AGENT_DIR/settings.json"
PI_THEME_NAME=haseen

usage() {
    cat <<EOF
Usage: omarchy-theme-set-pi [--activate] [--dry-run]

haseen's answer to Omarchy's command: writes the current haseen theme to
$PI_THEME_PATH when Pi's agent directory exists.
  --activate  also create the directory if needed and set "theme":
              "$PI_THEME_NAME" in $PI_SETTINGS_PATH
EOF
}
parse_common_flags "$@"
activate=false
for arg in "${REST[@]}"; do
    case "$arg" in
    --activate) activate=true ;;
    *)
        usage >&2
        exit 1
        ;;
    esac
done

if ! omarchy_theme_file pi.json; then
    if $activate; then
        echo "Pi theme source missing: no current haseen theme to render it from." >&2
        echo "Set one first: haseen theme set <name>" >&2
        exit 1
    fi
    exit 0
fi
source_path="$REPLY"

$activate || [[ -d $PI_AGENT_DIR ]] || exit 0

if omarchy_unresolved "$source_path"; then
    echo "Skipping Pi theme: pi.json has unresolved colors." >&2
    exit 0
fi

omarchy_publish "$source_path" "$PI_THEME_PATH"

$activate || exit 0
if [[ -f $PI_SETTINGS_PATH ]]; then
    omarchy_json_set "$PI_SETTINGS_PATH" '.theme = $theme' --arg theme "$PI_THEME_NAME" ||
        die "could not update $PI_SETTINGS_PATH (is it valid JSON?)"
else
    printf '{\n  "theme": "%s"\n}\n' "$PI_THEME_NAME" | write_user_file "$PI_SETTINGS_PATH"
fi
