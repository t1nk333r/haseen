#!/usr/bin/env bash
# omarchy-sudo-passwordless — toggle passwordless sudo for this user for a
# limited time (default 15 minutes). Adapted from Omarchy
# bin/omarchy-sudo-passwordless (MIT, Copyright (c) David Heinemeier Hansson):
# the rule is haseen's drop-in /etc/sudoers.d/99-haseen-nopasswd-<user>,
# checked with visudo and written through write_root_file (mode 0440); its
# expiry is a transient root timer haseen-nopasswd-expire-<user> started with
# run_root systemd-run, as upstream's; the rule also carries sudo's own
# NOTAFTER, so it lapses on time even when the timer is lost to a reboot
# (upstream only cleaned up at the next run); disabling also removes an
# Omarchy rule left from before; gum confirm became a typed "enable"
# (confirm_typed), which --yes does not give; --dry-run/--yes.
# haseen's permanent rule (haseen setup passwordless-sudo,
# 90-haseen-<user>) is never touched (plan 093). Omarchy 4.5 names its grants
# by UID (/etc/sudoers.d/99-omarchy-nopasswd-<uid> and a permanent
# 99-omarchy-permanent-nopasswd-<uid>, bin/omarchy-sudo-passwordless@v4.5.0-rc1
# rule_file) and adds --active, --disable and permanent: a grant of either
# Omarchy counts as on and every one goes when it is turned off; --active
# answers by exit code; permanent is haseen setup passwordless-sudo (plan 102).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
# shellcheck source=../../lib/terminal.sh
source "$HASEEN_PATH/lib/terminal.sh"

usage() {
    cat <<EOF
Usage: omarchy-sudo-passwordless [MINUTES|--active|--disable] [--dry-run] [--yes]

haseen's answer to Omarchy's command. Off: allows sudo without a password for
MINUTES (default 15), after a warning; it then turns itself off. On: turns it
off now, or with MINUTES restarts the countdown from now. A grant Omarchy
wrote (by user name, or by UID as Omarchy 4.5 does) counts as on and is
removed with haseen's. --disable turns it off and never on; --active exits 0
while sudo runs commands for you without a password, 1 otherwise. For a
permanent rule see haseen setup passwordless-sudo. Turning it on takes a typed
"enable" at the terminal; --yes does not give it.
EOF
}
in_floating_terminal "$@"
parse_common_flags "$@"
bad_usage() {
    echo "Usage: omarchy-sudo-passwordless [MINUTES|permanent|--active|--disable]" >&2
    exit 1
}
((${#REST[@]} <= 1)) || bad_usage
ARG="${REST[0]:-}"
MODE=toggle
case $ARG in
--active) MODE=active ARG="" ;;
--disable) MODE=disable ARG="" ;;
permanent)
    omarchy_refuse "haseen setup passwordless-sudo (haseen setup passwordless-sudo --off undoes it)" \
        "A permanent grant is haseen's own rule, written and removed by haseen setup passwordless-sudo."
    ;;
"" | [0-9]*) [[ -z $ARG || $ARG =~ ^[0-9]+$ ]] || bad_usage ;;
*) bad_usage ;;
esac
MINUTES=$((10#${ARG:-15}))
require_not_root

user="$(id -un)"
uid="$(id -u)"
[[ $user =~ ^[a-z_][a-z0-9_-]*$ ]] || die "unexpected user name '$user'"
[[ $uid =~ ^[0-9]+$ ]] || die "unexpected user id '$uid'"
NOPASSWD_FILE="/etc/sudoers.d/99-haseen-nopasswd-$user"
TIMER_NAME="haseen-nopasswd-expire-$user"
# Omarchy's grants for this user: 4.0.6 named the file by user name, 4.5 by
# UID, with a permanent one beside it; 4.5's expiry timers carry a token.
OMARCHY_FILES=("/etc/sudoers.d/99-omarchy-nopasswd-$user" "/etc/sudoers.d/99-omarchy-nopasswd-$uid"
    "/etc/sudoers.d/99-omarchy-permanent-nopasswd-$uid")
OMARCHY_TIMERS=("omarchy-nopasswd-expire-$user.timer" "omarchy-nopasswd-expire-$uid-*.timer")

# --active: sudo's long listing tags a passwordless entry !authenticate; -n
# never prompts, so without a grant the listing fails (Omarchy's test).
if [[ $MODE == active ]]; then
    policy="$(run_root -n -l -l -- /usr/bin/true 2>/dev/null)" || exit 1
    grep -q '!authenticate' <<<"$policy"
    exit
fi

timer_active() { systemctl is-active --quiet "$1.timer" 2>/dev/null; }

# rule_present FILE — the drop-in exists. /etc/sudoers.d is root-only on a
# real host, so asking needs sudo, as upstream's `sudo test -f`; a dry run
# cannot ask and goes by the expiry timer instead.
rule_present() {
    local dir
    dir="$(sysroot_path /etc/sudoers.d)"
    if [[ -r $dir && -x $dir ]]; then
        [[ -f $(sysroot_path "$1") ]]
        return
    fi
    if $DRY_RUN; then
        timer_active "$TIMER_NAME"
        return
    fi
    run_root test -f "$1"
}

# write_rule — the rule, valid until MINUTES from now (sudo's NOTAFTER is UTC).
RULE_TMP=""
trap 'rm -f -- "$RULE_TMP"' EXIT
write_rule() {
    local until
    until="$(date -u -d "+$MINUTES minutes" +%Y%m%d%H%M%SZ)"
    RULE_TMP="$(mktemp)"
    printf '# Written by omarchy-sudo-passwordless (haseen); expires %s.\n%s ALL=(ALL) NOTAFTER=%s NOPASSWD: ALL\n' \
        "$until" "$user" "$until" >"$RULE_TMP"
    chmod 0440 "$RULE_TMP"
    if have visudo; then
        visudo -cqf "$RULE_TMP" || die "visudo rejected the rule"
    fi
    write_root_file "$NOPASSWD_FILE" 0440 <"$RULE_TMP"
}

arm_expiry() {
    if run_root systemd-run --on-active="${MINUTES}m" --timer-property=AccuracySec=1s \
        --unit="$TIMER_NAME" --description="haseen: passwordless sudo for $user expires" \
        /usr/bin/rm -f -- "$NOPASSWD_FILE"; then
        return 0
    fi
    echo "Failed to schedule passwordless sudo expiry. Revoking access now." >&2
    if ! run_root rm -f -- "$NOPASSWD_FILE"; then
        echo "CRITICAL: Could not remove $NOPASSWD_FILE. Remove it as root immediately." >&2
    fi
    return 1
}

# omarchy_present — any of Omarchy's grants for this user is there, asked as
# rule_present asks (one sudo test for all of them).
omarchy_present() {
    local dir f
    dir="$(sysroot_path /etc/sudoers.d)"
    if [[ -r $dir && -x $dir ]]; then
        for f in "${OMARCHY_FILES[@]}"; do
            [[ -e $(sysroot_path "$f") ]] && return 0
        done
        return 1
    fi
    $DRY_RUN && return 1
    run_root test -e "${OMARCHY_FILES[0]}" -o -e "${OMARCHY_FILES[1]}" -o -e "${OMARCHY_FILES[2]}"
}

# disable_all — every passwordless grant this command or Omarchy's wrote for
# this user, and their expiry timers.
disable_all() {
    run_root rm -f -- "$NOPASSWD_FILE" "${OMARCHY_FILES[@]}"
    run_root systemctl stop "$TIMER_NAME.timer" "${OMARCHY_TIMERS[@]}" 2>/dev/null || true
    echo "Passwordless sudo has been DISABLED. Sudo will require a password again."
}

echo "Toggle passwordless sudo..."

present=false
rule_present "$NOPASSWD_FILE" && present=true
# A rule whose timer is gone (a reboot) is stale: remove it first.
if $present && ! timer_active "$TIMER_NAME"; then
    run_root rm -f -- "$NOPASSWD_FILE"
    present=false
fi
omarchy=false
omarchy_present && omarchy=true

if [[ $MODE == disable ]]; then
    if $present || $omarchy; then
        disable_all
    else
        echo "Passwordless sudo is already DISABLED."
    fi
    exit 0
fi

if $present || $omarchy; then
    if [[ -n $ARG ]]; then
        # A new countdown replaces whatever grant was on, Omarchy's included,
        # once haseen's timed rule is in place (as Omarchy 4.5 replaces one
        # duration with another).
        run_root systemctl stop "$TIMER_NAME.timer" 2>/dev/null || true
        write_rule
        arm_expiry || exit 1
        if $omarchy; then
            run_root rm -f -- "${OMARCHY_FILES[@]}"
            run_root systemctl stop "${OMARCHY_TIMERS[@]}" 2>/dev/null || true
        fi
        echo "Passwordless sudo timer updated. It will now automatically disable in $MINUTES minutes."
    else
        disable_all
    fi
    exit 0
fi

cat <<EOF

WARNING: This will allow ANY process running as your user to
execute ANY command as root WITHOUT a password for $MINUTES minutes.

This is useful for AI agents that need to run sudo commands,
but it significantly weakens the security of your system.
Anyone or anything with access to your user account gets full root.

Passwordless sudo will automatically disable after $MINUTES minutes.
Run this command again to disable it early.

EOF
if confirm_typed "Enable passwordless sudo for $MINUTES minutes? This is a significant security risk!" enable; then
    write_rule
    arm_expiry || exit 1
    $DRY_RUN && exit 0
    echo
    echo "Passwordless sudo has been ENABLED. It will automatically disable in $MINUTES minutes."
    echo "It lapses on time across a restart as well."
else
    echo "Aborted. No changes made."
fi
