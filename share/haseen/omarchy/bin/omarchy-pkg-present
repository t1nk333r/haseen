#!/usr/bin/env bash
# omarchy-pkg-present — exit 0 when every named package is installed, 1 when
# any is missing (none named: 0). Adapted from Omarchy bin/omarchy-pkg-present
# (MIT, Copyright (c) David Heinemeier Hansson): the same contract, which
# Omarchy scripts and menu "when" clauses test; the probe is haseen's
# pkg_installed, which reads a fixture under HASEEN_SYSROOT (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
# shellcheck source=../../lib/packages.sh
source "$HASEEN_PATH/lib/packages.sh"
omarchy_help "Usage: omarchy-pkg-present <packages...>

haseen's answer to Omarchy's command: exits 0 when all the packages are
installed, 1 when any is missing. Read-only." "$@"

for pkg in "$@"; do
    # A name pacman could not have installed is not installed; checking it
    # first also keeps a dash-led word from reading as a pacman option.
    [[ $pkg =~ $PKG_NAME_RE ]] && pkg_installed "$pkg" || exit 1
done
exit 0
