#!/usr/bin/env bash
# omarchy-remove-security-fido2 — take FIDO2 security-key authentication out of
# sudo and polkit: the pam_u2f line `haseen setup fido2` adds goes without
# asking; other pam_u2f lines (Omarchy's, with its authfile in /etc/fido2, or
# the user's) are shown and go after a question. Then Omarchy's /etc/fido2,
# and pam-u2f and libfido2 when nothing still uses them. Adapted from Omarchy
# bin/omarchy-remove-security-fido2 (MIT, Copyright (c) David Heinemeier
# Hansson): sudo sed -i -> whole-file rewrites through write_root_file (a dry
# run prints each new file), sudo rm -> run_root, omarchy-pkg-drop -> haseen
# remove package, which keeps libfido2 when another package needs it (it made
# Omarchy's removal fail); --dry-run prints the plan (plan 093).
#
# Questions: the foreign pam_u2f lines are asked about (default no; --yes
# removes them, as Omarchy does without asking). haseen's key registrations in
# ~/.config/Yubico/u2f_keys, pam_u2f's default file that other PAM services
# can read too, are asked about, default no; --yes keeps them.
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
# shellcheck source=../remove-lib.sh
source "$HASEEN_OMARCHY_DIR/remove-lib.sh"

# What bin/haseen-setup-fido2 writes.
HASEEN_PAM_LINE="auth      sufficient pam_u2f.so cue"
KEYS="${XDG_CONFIG_HOME:-$HOME/.config}/Yubico/u2f_keys"
PAM_FILES=(/etc/pam.d/sudo /etc/pam.d/polkit-1)

usage() {
    cat <<EOF
Usage: omarchy-remove-security-fido2 [--dry-run] [--yes]

haseen's answer to Omarchy's command: removes "$HASEEN_PAM_LINE"
(haseen setup fido2) from ${PAM_FILES[*]}, shows any other pam_u2f lines
and removes them after asking (--yes removes them), deletes Omarchy's
/etc/fido2, asks (--yes keeps it) before deleting $KEYS, and removes pam-u2f
and libfido2 when no pam_u2f line is left and no other package needs them.
EOF
}

in_floating_terminal "$@"
parse_common_flags "$@"
((${#REST[@]} == 0)) || {
    usage >&2
    exit 2
}
require_not_root

echo "Removing FIDO2 security keys from authentication."
PAM_KEPT=false
for f in "${PAM_FILES[@]}"; do
    pam_drop "$f" "$HASEEN_PAM_LINE" 'pam_u2f\.so'
done

# Omarchy's authfile. rm -rf on a symlink removes the link, never its target,
# so a dangling link cannot carry a later setup's authfile elsewhere. Kept
# while a kept pam_u2f line may still name it.
authdir=/etc/fido2
if [[ -e $(sysroot_path "$authdir") || -L $(sysroot_path "$authdir") ]]; then
    if $PAM_KEPT; then
        info "kept $authdir: the pam_u2f lines left in place may read it"
    else
        run_root rm -rf -- "$authdir"
    fi
fi

delete_asked "Also delete your registered security keys" no "$KEYS" || true

if $PAM_KEPT; then
    info "kept pam-u2f and libfido2: pam_u2f lines are still in use"
else
    remove_pkgs pam-u2f libfido2
fi
echo "FIDO2 authentication has been removed."
