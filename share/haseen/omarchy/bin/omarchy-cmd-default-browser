#!/usr/bin/env bash
# omarchy-cmd-default-browser — print the default web browser's desktop entry
# id (e.g. chromium.desktop), read from mimeapps.list the way xdg-mime does;
# exit 1 when there is none. Omarchy's browser and web-app launchers use it.
# Adapted from Omarchy bin/omarchy-cmd-default-browser (MIT, Copyright (c)
# David Heinemeier Hansson): unchanged; omarchy-browser.desktop is still
# skipped, since that routing entry exists where Omarchy is installed (plan
# 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-cmd-default-browser

Prints the desktop entry id of the default web browser; exits 1 when none is
set." "$@"

IFS=: read -ra data_dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
IFS=: read -ra config_dirs <<<"${XDG_CONFIG_HOME:-$HOME/.config}:${XDG_CONFIG_DIRS:-/etc/xdg}"
IFS=: read -ra desktops <<<"${XDG_CURRENT_DESKTOP:-}"

# Installed means the command of the entry the launchers will read, the first
# one found, still resolves: an entry can outlive the browser it launched.
installed() {
    local data_dir command
    for data_dir in "${data_dirs[@]}"; do
        [[ -r $data_dir/applications/$1 ]] || continue
        command=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$data_dir/applications/$1" | head -1)
        [[ -n $command ]] && command -v "$command" >/dev/null
        return
    done
    return 1
}

for config_dir in "${config_dirs[@]}"; do
    for desktop in "${desktops[@]}" ""; do
        list="$config_dir/${desktop:+${desktop,,}-}mimeapps.list"
        [[ -f $list ]] || continue
        entries=$(awk '
      /^\[Default Applications\]/ { section = 1; next }
      /^\[/ { section = 0 }
      section && index($0, "x-scheme-handler/http=") == 1 { print substr($0, 23); exit }
    ' "$list")
        # omarchy-browser.desktop only routes links back through Omarchy's
        # launcher, so the browser is whatever is listed after it.
        IFS=';' read -ra entries <<<"$entries"
        for entry in "${entries[@]}"; do
            if [[ -n $entry && $entry != omarchy-browser.desktop ]] && installed "$entry"; then
                echo "$entry"
                exit 0
            fi
        done
    done
done

# Nothing set in a config dir: let xdg-settings search the data dirs and caches.
browser=$(env -u BROWSER XDG_CURRENT_DESKTOP= xdg-settings get default-web-browser 2>/dev/null || true)
if [[ -z $browser || $browser == omarchy-browser.desktop ]]; then
    browser=$(XDG_CURRENT_DESKTOP='' xdg-mime query default x-scheme-handler/https 2>/dev/null || true)
fi
[[ -n $browser && $browser != omarchy-browser.desktop ]] && echo "$browser"
