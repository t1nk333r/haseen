#!/usr/bin/env bash
# omarchy-cmd-terminal-cwd — print the working directory of the shell in the
# focused terminal window, or $HOME. Omarchy's terminal and file-manager
# launchers start in it. Adapted from Omarchy bin/omarchy-cmd-terminal-cwd
# (MIT, Copyright (c) David Heinemeier Hansson): a kitty remote-control socket
# may be named haseen-kitty-<pid> as well as Omarchy's omarchy-kitty-<pid>;
# /proc and /etc/shells are read through sysroot_path, so tests use fixtures
# (plan 093).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-cmd-terminal-cwd

Prints the current directory of the shell in the focused terminal window
(kitty over its remote-control socket, else /proc), or \$HOME." "$@"

terminal_pid="$(hyprctl activewindow 2>/dev/null | awk '/pid:/ {print $2}' || true)"
cwd=""
socket=""
if [[ $terminal_pid =~ ^[0-9]+$ ]]; then
    for name in haseen-kitty omarchy-kitty; do
        [[ -S ${XDG_RUNTIME_DIR:-/tmp}/$name-$terminal_pid ]] || continue
        socket="${XDG_RUNTIME_DIR:-/tmp}/$name-$terminal_pid"
        break
    done
fi

# children PID — the child processes of PID, the last one last.
children() {
    if in_sysroot; then
        local list
        list="$(sysroot_path "/proc/$1/task/$1/children")"
        [[ -r $list ]] && tr ' ' '\n' <"$list" | grep .
    else
        pgrep -P "$1"
    fi
}

if [[ -n $socket ]]; then
    cwd="$(kitten @ --to "unix:$socket" ls --match "state:focused" 2>/dev/null |
        jq -r '.[].tabs[].windows[].cwd // empty' 2>/dev/null || true)"
elif [[ $terminal_pid =~ ^[0-9]+$ ]]; then
    shell_pid="$(children "$terminal_pid" 2>/dev/null | tail -n1 || true)"
    if [[ -n $shell_pid ]]; then
        cwd="$(readlink -f "$(sysroot_path "/proc/$shell_pid/cwd")" 2>/dev/null || true)"
        shell="$(readlink -f "$(sysroot_path "/proc/$shell_pid/exe")" 2>/dev/null || true)"
        # Only a login shell's directory is the user's: a pager or editor
        # running in the terminal has its own.
        grep -Fqsx -- "$shell" "$(sysroot_path /etc/shells)" || cwd=""
    fi
fi

if [[ -n $cwd && -d $cwd ]]; then
    echo "$cwd"
else
    echo "$HOME"
fi
