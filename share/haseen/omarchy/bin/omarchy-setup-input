#!/usr/bin/env bash
# omarchy-setup-input — add a Japanese, Korean or Chinese input method.
# Translated (0b9dace01, #14433): the method's fcitx5 engine (Omarchy's
# default/input-methods/presets.json: fcitx5-mozc, -hangul, -chinese-addons,
# -chewing, -table-extra) is installed through haseen install, then
# fcitx5-configtool opens to add it to the group, instead of Omarchy's Python
# helper rewriting fcitx5's profile; without a method, fcitx5-configtool opens
# (plan 102).
set -Eeuo pipefail
# shellcheck source=../lib.sh
source "$(dirname "$(readlink -f "$0")")/../lib.sh"
omarchy_help "Usage: omarchy-setup-input [mozc|hangul|pinyin|chewing|cangjie5] [--dry-run] [--yes]

haseen's answer to Omarchy's command: installs the input method's fcitx5
engine (haseen install) and opens fcitx5-configtool to add it." "$@"
parse_common_flags "$@"
((${#REST[@]} <= 1)) || {
    echo "Usage: omarchy setup input [mozc|hangul|pinyin|chewing|cangjie5]" >&2
    exit 1
}
case ${REST[0]:-} in
"") package="" ;;
mozc) package=fcitx5-mozc ;;
hangul) package=fcitx5-hangul ;;
pinyin) package=fcitx5-chinese-addons ;;
chewing) package=fcitx5-chewing ;;
cangjie5) package=fcitx5-table-extra ;;
*)
    echo "Unknown input method: ${REST[0]}" >&2
    exit 1
    ;;
esac
if [[ -n $package ]]; then
    flags=()
    $DRY_RUN && flags+=(--dry-run)
    $ASSUME_YES && flags+=(--yes)
    "$HASEEN_BIN/haseen-install" package "$package" "${flags[@]}"
    echo "Add it to the input group in fcitx5's settings; Control+Space keeps switching."
fi
have fcitx5-configtool || $DRY_RUN || die "fcitx5-configtool is not installed (haseen layer apply desktop)"
run setsid -f fcitx5-configtool
